{
  "name": "harvard-public-record",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Independent public-source review of donor influence and institutional access at Harvard University. Not affiliated with Harvard University.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "audit": "node scripts/audit.mjs",
    "check": "npm run test && npm run build && node scripts/check-dist.mjs",
    "check:links": "node scripts/check-links.mjs",
    "smoke": "node scripts/smoke.mjs",
    "progress": "node scripts/progress.mjs",
    "factcheck": "node scripts/factcheck.mjs",
    "verify:build": "node scripts/worksheets.mjs && node scripts/verify-console.mjs",
    "verify:apply": "node scripts/apply-verification.mjs",
    "review-pack": "npm run build && node scripts/review-pack.mjs",
    "right-of-reply": "node scripts/right-of-reply.mjs",
    "prelaunch": "npm run check && node scripts/smoke.mjs --all && node scripts/audit.mjs --strict"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/source-serif-4": "^5.2.8",
    "astro": "^5.1.0"
  }
}
