---
import Base from '../layouts/Base.astro';
import Grade from '../components/Grade.astro';
import State from '../components/State.astro';
import Callout from '../components/Callout.astro';
import { claims } from '../data/claims';
import { sources } from '../data/sources';
const topics = [...new Set(claims.map((c) => c.topic))];
const slug = (t: string) => t.toLowerCase().replace(/[^a-z]+/g, '-').replace(/^-|-$/g, '');
const count = (s: string) => claims.filter((c) => c.state === s).length;
const pending = claims.filter((c) => !c.checked).length;
---
<Base
  title="Claim ledger"
  description="Every factual claim the site makes, one row each, with its evidence state, reliability grade, sources, caveats and verification status."
  eyebrow="Reference"
  lede={`The ${claims.length} factual claims behind the site’s pages, one row each. Each row shows how strong the evidence is, what it rests on, and the limits that should travel with it.`}
  reviewed="2026-11-20"
>
  <ul class="figures full">
    <li><span class="num">{claims.length}</span><span class="lbl">Claims in the ledger</span></li>
    <li><span class="num">{count('verified')}</span><span class="lbl">Verified implementation</span></li>
    <li><span class="num">{count('activity')}</span><span class="lbl">Documented activity</span></li>
    <li><span class="num">{count('intent')}</span><span class="lbl">Stated intent or allegation</span></li>
    <li><span class="num">{count('none')}</span><span class="lbl">Statements of absence</span></li>
  </ul>
  <Callout title="Verification status">
    <p>{pending} of {claims.length} claims are pending a check against the original documents. A claim is marked checked only when every source listed for it has been opened and read.</p>
  </Callout>
  <p class="small sans">Download: <a href="/claims.csv">CSV</a> · <a href="/claims.json">JSON</a>. How to read the columns: <a href="/methodology/">methodology</a>.</p>

  {topics.map((t) => (
    <>
      <h2 id={slug(t)}>{t}</h2>
      <div class="table-wrap full">
        <table class="stack">
          <thead><tr><th>Ref.</th><th>Claim</th><th>State</th><th>Grade</th><th>Sources</th><th>Checked</th></tr></thead>
          <tbody>
            {claims.filter((c) => c.topic === t).map((c) => (
              <tr id={c.id}>
                <th style="white-space:nowrap">{c.id}</th>
                <td data-label="Claim">
                  {c.claim}
                  {c.caveat && <span class="small muted" style="display:block;margin-top:.3rem">Caveat: {c.caveat}</span>}
                  <span class="small sans" style="display:block;margin-top:.3rem"><a href={c.page}>Where it appears</a></span>
                </td>
                <td data-label="State"><State s={c.state} /></td>
                <td data-label="Grade"><Grade g={c.grade} /></td>
                <td data-label="Sources">
                  {c.sources.map((id) => <a class="small sans" style="display:block" href={`/sources/${id}/`}>{sources[id].publisher.split(',')[0]}{sources[id].date ? `, ${sources[id].date!.slice(0, 4)}` : ''}</a>)}
                </td>
                <td data-label="Checked" class="small sans">{c.checked ?? 'Pending'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  ))}
</Base>
