---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const all = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
  return all.map((entry) => {
    const same = all.filter((g) => g.data.series === entry.data.series);
    const i = same.findIndex((g) => g.id === entry.id);
    return { params: { slug: entry.id }, props: { entry, prev: same[i - 1], next: same[i + 1] } };
  });
}
const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description} eyebrow={`Guide · ${entry.data.series}`} lede={entry.data.description}>
  <p class="small sans muted">For {entry.data.audience.toLowerCase()}. General guidance, not legal advice.</p>
  <Content />
  <nav class="pager full" aria-label="More in this series">
    {prev ? <a href={`/guides/${prev.id}/`}><span>Previous</span>{prev.data.title}</a> : <span></span>}
    {next ? <a href={`/guides/${next.id}/`} class="next"><span>Next</span>{next.data.title}</a> : <span></span>}
  </nav>
  <p class="small sans"><a href="/guides/">All guides</a></p>
</Base>
