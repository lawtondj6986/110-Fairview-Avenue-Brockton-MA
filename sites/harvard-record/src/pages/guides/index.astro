---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
const series = ['Primers', 'Evaluating an institution', 'Reading documents', 'Research methods', 'Worked examples', 'Templates'].filter((s) => guides.some((g) => g.data.series === s));
const blurbs: Record<string, string> = {
  'Primers': 'How the machinery works: money, governance, complaints, research and records, explained from the ground up.',
  'Worked examples': 'The site’s methods applied step by step to its own record, using only claims already in the ledger.',
  'Evaluating an institution': 'For prospective students, students and alumni weighing how a university handles safety, money and accountability.',
  'Reading documents': 'How to read the kinds of record this site relies on, and what each can and cannot tell you.',
  'Research methods': 'The working methods behind this site, written so that others can apply and check them.',
  'Templates': 'Fill-in letters, requests and record sheets.',
};
const slug = (t: string) => t.toLowerCase().replace(/[^a-z]+/g, '-');
---
<Base
  title="Guides"
  description="Practical guides to evaluating a university, reading official documents, and doing careful public-source research, with templates."
  eyebrow="Reference"
  lede={`${guides.length} practical guides in four series. They are general and apply to any university.`}
>
  {series.map((s) => (
    <>
      <h2 id={slug(s)}>{s}</h2>
      <p>{blurbs[s]}</p>
      <ul class="cards full">
        {guides.filter((g) => g.data.series === s).map((g) => (
          <li><a class="card" href={`/guides/${g.id}/`}><h3>{g.data.title}</h3><p>{g.data.description}</p><span class="more">For {g.data.audience.toLowerCase()}</span></a></li>
        ))}
      </ul>
    </>
  ))}
</Base>
