---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const laws = (await getCollection('law')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const groups = ['Federal', 'Massachusetts', 'Other'].filter((j) => laws.some((l) => l.data.jurisdiction === j));
---
<Base
  title="Law explainers"
  description="Plain-language explainers of the statutes and regulations that frame the public record on campus safety, research, genetic privacy and charitable giving."
  eyebrow="Reference"
  lede={`${laws.length} statutes and regulations explained: what each one does, who it covers, what it does not do, and how it is commonly misread.`}
>
  {groups.map((j) => (
    <>
      <h2 id={j.toLowerCase()}>{j === 'Other' ? 'General principles' : j}</h2>
      <div class="table-wrap full">
        <table class="stack">
          <thead><tr><th>Law</th><th>Citation</th><th>In brief</th></tr></thead>
          <tbody>
            {laws.filter((l) => l.data.jurisdiction === j).map((l) => (
              <tr>
                <th><a href={`/law/${l.id}/`}>{l.data.title}</a></th>
                <td data-label="Citation" class="small sans">{l.data.citation}</td>
                <td data-label="In brief">{l.data.short}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  ))}
  <p class="small sans muted">These pages explain the law in general terms. They are not legal advice, and laws change: check the official text linked on each page.</p>
</Base>
