---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  return (await getCollection('law')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.short} eyebrow={`Law explainer · ${entry.data.jurisdiction}`} lede={entry.data.short}>
  <div class="table-wrap full">
    <table class="stack"><tbody>
      <tr><th>Citation</th><td>{entry.data.citation}</td></tr>
      <tr><th>Enforced by</th><td>{entry.data.enforcedBy}</td></tr>
      {entry.data.links.length > 0 && <tr><th>Official text</th><td>{entry.data.links.map((l: { label: string; url: string }, i: number) => <>{i > 0 && ' · '}<a href={l.url} rel="noopener external">{l.label}</a></>)}</td></tr>}
    </tbody></table>
  </div>
  <Content />
  <p class="small sans muted">A general explanation, not legal advice. Laws and regulations change; rely on the official text. <a href="/law/">All explainers</a></p>
</Base>
