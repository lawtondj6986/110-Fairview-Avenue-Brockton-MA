---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { claims } from '../data/claims';
import { sources } from '../data/sources';
import { faq } from '../data/faq';
const [g, l, gu] = await Promise.all([getCollection('glossary'), getCollection('law'), getCollection('guides')]);
---
<Base title="Reference" description="Glossary, law explainers, practical guides, the claim ledger and the source register." eyebrow="Reference" lede="The working material behind the site, and general reference to help you read any university’s public record." toc={false} article={false}>
  <ul class="cards full">
    <li><a class="card" href="/briefing/"><h3>The record on one page</h3><p>The key documented points with their evidence states and caveats, ready to print.</p><span class="more">Printable briefing</span></a></li>
    <li><a class="card" href="/ledger/"><h3>Claim ledger</h3><p>Every factual claim the site makes, with its evidence state, grade, sources and caveats.</p><span class="more">{claims.length} claims</span></a></li>
    <li><a class="card" href="/sources/"><h3>Source register</h3><p>Every source cited, with a record page showing where it is used and what rests on it.</p><span class="more">{Object.keys(sources).length} sources</span></a></li>
    <li><a class="card" href="/named/"><h3>People and bodies named</h3><p>Why each name appears, what the cited record says, and what it does not say.</p><span class="more">Fairness index</span></a></li>
    <li><a class="card" href="/glossary/"><h3>Glossary</h3><p>Legal, fundraising, governance, genetics and sourcing terms in plain language.</p><span class="more">{g.length} terms</span></a></li>
    <li><a class="card" href="/law/"><h3>Law explainers</h3><p>What each statute does, who it covers, what it does not do, and how it is misread.</p><span class="more">{l.length} explainers</span></a></li>
    <li><a class="card" href="/guides/"><h3>Guides</h3><p>Evaluating an institution, reading official documents, research methods, and templates.</p><span class="more">{gu.length} guides</span></a></li>
    <li><a class="card" href="/faq/"><h3>Frequently asked questions</h3><p>Short answers about the site, the evidence grades and the record.</p><span class="more">{faq.flatMap((s) => s.items).length} questions</span></a></li>
    <li><a class="card" href="/search/"><h3>Search</h3><p>Search pages, glossary terms, explainers, guides, claims and sources.</p><span class="more">Whole site</span></a></li>
    <li><a class="card" href="/updates/"><h3>Update log</h3><p>Every edition, update and correction, newest first.</p><span class="more">Also available as a feed</span></a></li>
  </ul>
</Base>
