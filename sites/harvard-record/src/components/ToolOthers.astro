---
import { tools } from '../lib/tools/list';
interface Props { current: string }
const { current } = Astro.props;
---
<nav class="tool-others" aria-label="Other tools">
  <p class="tool-others-title">Other tools</p>
  <ul>
    {tools.filter((t) => t.href !== current).map((t) => <li><a href={t.href}>{t.title}</a></li>)}
    <li><a href="/tools/">All tools</a></li>
  </ul>
</nav>
