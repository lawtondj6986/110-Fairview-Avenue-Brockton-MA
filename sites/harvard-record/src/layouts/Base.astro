---
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { site, nav } from '../config';
import { sources } from '../data/sources';
import { grades } from '../data/grades';
import { processCitations, formatDate, slugify } from '../lib/citations';
import { linkTerms } from '../lib/terms';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  lede?: string;
  reviewed?: string;      // ISO date this page was last reviewed against its sources
  basis?: string;         // one line: what the page mainly rests on
  toc?: boolean;
  article?: boolean;
  terms?: boolean;        // link the first mention of each glossary term to its definition
  termExclude?: string[]; // glossary ids not to link on this page
}
const { title, description, eyebrow, lede, reviewed, basis, toc = true, article = true, terms = false, termExclude = [] } = Astro.props;

const path = Astro.url.pathname;
const canonical = new URL(path, site.url).href;
const isHome = path === '/';
const fullTitle = isHome ? `${site.name} | Independent public-source review` : `${title} | ${site.name}`;

// ---- Render the page body, then number citations and build the reference list ----
let rendered = await Astro.slots.render('default');
// Markdown content carries no heading ids we control, so make sure every h2 has one.
rendered = rendered.replace(/<h2>([\s\S]*?)<\/h2>/g, (_m: string, inner: string) => `<h2 id="${slugify(inner.replace(/<[^>]+>/g, ''))}">${inner}</h2>`);
const cited = processCitations(rendered, sources, path);
const { order, uses, headings: found } = cited;
let body = cited.html;
if (terms) {
  const glossary = (await getCollection('glossary')).map((e) => ({ id: e.id, term: e.data.term, short: e.data.short, aliases: e.data.aliases }));
  body = linkTerms(body, glossary, { exclude: termExclude }).html;
}
const headings = toc ? [...found] : [];
if (order.length && toc) headings.push({ id: 'references', text: 'References' });
const showToc = headings.length > 2;
const fmt = formatDate;

const jsonld = {
  '@context': 'https://schema.org',
  '@type': article && !isHome ? 'Article' : 'WebSite',
  ...(article && !isHome
    ? { headline: title, dateModified: reviewed, mainEntityOfPage: canonical, author: { '@type': 'Organization', name: site.name }, publisher: { '@type': 'Organization', name: site.name } }
    : { name: site.name, url: site.url }),
  description,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Update log" href="/updates.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#14233b" />
    <meta property="og:type" content={isHome ? 'website' : 'article'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="notice" role="note" aria-label="Non-affiliation notice">
      <div class="wrap">{site.disclaimerShort} <a href="/about/#disclaimer">Read the full disclaimer</a>.</div>
    </div>
    <header class="masthead">
      <div class="wrap">
        <a class="wordmark" href="/">
          <strong>{site.name}</strong>
          <span>Independent · Public sources only</span>
        </a>
        <nav class="nav" aria-label="Primary">
          <details open id="site-nav">
            <summary>Sections</summary>
            <ul>
              {nav.map((n) => (
                <li><a href={n.href} aria-current={path === n.href ? 'page' : (n.href === '/reference/' && /^\/(glossary|law|guides|ledger|faq|search|sources|updates|named|briefing)\//.test(path)) ? 'true' : undefined} title={n.long}>{n.label}</a></li>
              ))}
            </ul>
          </details>
          <script is:inline>
            // Collapsed by default on small screens; without JavaScript the list simply stays open.
            if (matchMedia('(max-width: 61.99rem)').matches) document.getElementById('site-nav').removeAttribute('open');
          </script>
        </nav>
      </div>
    </header>

    <main id="main">
      <div class="wrap">
        <header class="page-head">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          <h1>{title}</h1>
          {lede && <p class="lede">{lede}</p>}
          {(reviewed || basis) && (
            <ul class="meta">
              {reviewed && <li><b>Last reviewed</b> <time datetime={reviewed}>{fmt(reviewed)}</time></li>}
              {basis && <li><b>Rests mainly on</b> {basis}</li>}
              <li><a href="/about/#corrections">Report an error</a></li>
            </ul>
          )}
        </header>

        <div class:list={['layout', { 'has-toc': showToc }]}>
          {showToc && (
            <nav class="toc" aria-label="On this page">
              <h2>On this page</h2>
              <ol>{headings.map((h) => <li><a href={`#${h.id}`}>{h.text}</a></li>)}</ol>
            </nav>
          )}
          <div>
            <article class="prose"><Fragment set:html={body} /></article>

            {order.length > 0 && (
              <section class="refs prose" aria-labelledby="references">
                <h2 id="references">References</h2>
                <p class="small muted sans">
                  Each source carries a reliability grade. See <a href="/methodology/">how sources are graded</a>.
                  Entries marked “pending check” were compiled from published summaries and have not yet been re-read against the original page.
                </p>
                <ol class="full">
                  {order.map((id, i) => {
                    const s = sources[id];
                    return (
                      <li id={`ref-${i + 1}`}>
                        <span class="n">{i + 1}.</span>
                        <span>
                          <a class={`grade grade-${s.grade}`} href={`/methodology/#grade-${s.grade.toLowerCase()}`} title={`${s.grade}: ${grades[s.grade].label}`}>{s.grade}</a>{' '}
                          {s.url ? <a class="src-title" href={s.url} rel="noopener external">{s.title}</a> : <span class="src-title">{s.title}</span>}
                          <span class="back" aria-label="Back to text">
                            {Array.from({ length: uses[id] }, (_, k) => <a href={`#cite-${i + 1}-${k + 1}`} aria-label={`Back to citation ${k + 1}`}>↑{uses[id] > 1 ? String.fromCharCode(97 + k) : ''}</a>)}
                          </span>
                          <span class="src-meta">
                            {[s.author, s.publisher, fmt(s.date)].filter(Boolean).join(' · ')}
                            {!s.checked && ' · pending check'}
                          </span>
                          {s.note && <span class="src-note">{s.note}</span>}
                        </span>
                      </li>
                    );
                  })}
                </ol>
              </section>
            )}
          </div>
        </div>
      </div>
    </main>

    <footer class="footer">
      <div class="wrap">
        <div class="cols">
          <div>
            <h2>{site.name}</h2>
            <p>{site.tagline}</p>
          </div>
          <div>
            <h2>Sections</h2>
            <ul>{nav.slice(1).map((n) => <li><a href={n.href}>{n.long ?? n.label}</a></li>)}</ul>
          </div>
          <div>
            <h2>Standards</h2>
            <ul>
              <li><a href="/methodology/">How sources are graded</a></li>
              <li><a href="/sources/">Full source register</a></li>
              <li><a href="/status/">Verification status</a></li>
              <li><a href="/briefing/">The record on one page</a></li>
              <li><a href="/ledger/">Claim ledger</a></li>
              <li><a href="/faq/">Questions and answers</a></li>
              <li><a href="/named/">People and bodies named</a></li>
              <li><a href="/search/">Search</a></li>
              <li><a href="/privacy/">Privacy</a></li>
              <li><a href="/accessibility/">Accessibility</a></li>
              <li><a href="/updates/">Update log</a></li>
              <li><a href="/about/#corrections">Corrections policy</a></li>
              <li><a href={`mailto:${site.correctionsEmail}`}>{site.correctionsEmail}</a></li>
            </ul>
          </div>
        </div>
        <p class="legal" id="site-disclaimer">{site.disclaimerLong}</p>
      </div>
    </footer>
  </body>
</html>
