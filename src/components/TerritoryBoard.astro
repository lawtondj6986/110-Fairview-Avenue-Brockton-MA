---
/**
 * The Territory Board — Market Lock exclusivity, one business per category per
 * place. Reused per market (South Shore, MA; Broward County, FL).
 *
 * `claimed` is the operating hook: when a Market Lock client signs, add
 * { place, industry } (slugs). The board shows the territory as locked —
 * never the client's name — and offers the next caller a waitlist.
 */
import { INDUSTRIES } from '../lib/industries';

interface Props {
  market: string; // e.g. "the South Shore"
  state: string; // "MA" | "FL"
  placeNoun: string; // "town" | "city"
  places: { slug: string; name: string }[];
  placeHrefBase?: string; // e.g. "/south-shore/" → links each place to its page; omit if no pages
  claimed: { place: string; industry: string }[];
}
const { market, state, placeNoun, places, placeHrefBase = '', claimed } = Astro.props;
const total = places.length * INDUSTRIES.length;
---

<section class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
  <div
    id="board"
    data-claimed={JSON.stringify(claimed)}
    data-state={state}
    data-place-base={placeHrefBase}
    class="rounded-2xl border border-navy-100 bg-white p-6 shadow-lg sm:p-8"
  >
    <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-brass-600">Check a territory</p>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <div>
        <label for="tb-place" class="mb-1 block text-sm font-medium capitalize text-navy-900">{placeNoun}</label>
        <select id="tb-place" class="w-full rounded-md border border-navy-100 bg-white px-3 py-2.5 text-sm text-navy-900 focus:border-brass-500 focus:outline-none focus:ring-2 focus:ring-brass-500/20">
          <option value="">Select a {placeNoun}…</option>
          {places.map((p) => <option value={p.slug}>{p.name}</option>)}
        </select>
      </div>
      <div>
        <label for="tb-cat" class="mb-1 block text-sm font-medium text-navy-900">Category</label>
        <select id="tb-cat" class="w-full rounded-md border border-navy-100 bg-white px-3 py-2.5 text-sm text-navy-900 focus:border-brass-500 focus:outline-none focus:ring-2 focus:ring-brass-500/20">
          <option value="">Select a category…</option>
          {INDUSTRIES.map((i) => <option value={i.slug}>{i.name}</option>)}
        </select>
      </div>
    </div>

    <div id="tb-result" class="mt-6 hidden rounded-xl border border-brass-400/50 bg-navy-950 p-6">
      <p id="tb-status" class="font-mono text-[11px] font-bold uppercase tracking-[0.2em] text-brass-300"></p>
      <p id="tb-headline" class="mt-2 font-display text-2xl font-bold text-white"></p>
      <p id="tb-body" class="mt-2 text-sm leading-relaxed text-navy-100/85"></p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a id="tb-cta" href="/contact/" class="rounded-md bg-brass-500 px-5 py-2.5 text-sm font-semibold text-navy-950 transition-colors hover:bg-brass-300"></a>
        <a href="/pricing/" class="rounded-md border border-white/25 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-brass-300 hover:text-brass-300">Market Lock pricing</a>
        <a id="tb-place-link" href="#" class="hidden rounded-md border border-white/25 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-brass-300 hover:text-brass-300">The {placeNoun} page</a>
      </div>
    </div>

    <p id="tb-hint" class="mt-4 text-xs text-ink-500">Pick a {placeNoun} and a category. Open territories go to the first business that locks them — in writing, for 12 months.</p>
  </div>
</section>

<section class="bg-paper">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brass-600">How exclusivity works</p>
      <h2 class="mx-auto mt-3 max-w-3xl text-3xl font-bold leading-tight text-navy-900">A territory is a promise we make in writing — and one we can only make once.</h2>
      <p class="mx-auto mt-3 max-w-2xl text-ink-500">Most agencies will happily run the same playbook for you and your competitor across the street, and take both checks. Market Lock is built on the opposite rule.</p>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        [
          ['01', `One per category, per ${placeNoun}`, `A roofer and a dentist can both hold the same ${placeNoun}. Two roofers cannot. The lock is by category and ${placeNoun}, and it is written into the engagement.`],
          ['02', 'Your competitor gets a no', 'While you hold the territory, a competitor in your category calling us for Market Lock is declined — and told why.'],
          ['03', 'Twelve months, first right to renew', 'The term is a year. You renew first. If you walk away, the territory reopens to the next business that calls.'],
          ['04', 'The whole machine, behind the lock', 'Lead Engine (sub-60-second response, CRM, follow-up), paid media, a monthly content system, and answer-engine optimization — the full stack, pointed at one territory.'],
        ].map(([n, h, b], i) => (
          <div class="reveal rounded-xl border border-navy-100 bg-white p-6 shadow-sm" style={`--reveal-delay: ${(i % 4) * 60}ms`}>
            <p class="font-mono text-xs font-bold text-brass-600">{n}</p>
            <h3 class="mt-1 text-base font-bold text-navy-900">{h}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-500">{b}</p>
          </div>
        ))
      }
    </div>
    <p class="mx-auto mt-8 max-w-2xl text-center text-sm text-ink-700">
      <strong class="text-navy-900">Published:</strong> $20,000–$30,000 to build + $3,500–$6,000/month · 12-month exclusive ·
      <a href="/guarantees/" class="font-semibold text-teal-600 hover:text-teal-700">written guarantees</a> apply — the same in {market}.
    </p>
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <div class="text-center">
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brass-600">The map</p>
    <h2 class="mt-3 text-3xl font-bold text-navy-900">{places.length} {placeNoun === 'town' ? 'towns' : 'cities'}. {INDUSTRIES.length} categories each. {total} territories.</h2>
  </div>
  <div class="mt-10 grid gap-3 sm:grid-cols-3 lg:grid-cols-4">
    {
      places.map((p) => {
        const taken = claimed.filter((c) => c.place === p.slug).length;
        const inner = (
          <>
            <span class="text-sm font-semibold text-navy-900 group-hover:text-brass-600">{p.name}</span>
            <span class={`font-mono text-[11px] font-bold ${taken ? 'text-brass-600' : 'text-teal-600'}`}>{INDUSTRIES.length - taken} open</span>
          </>
        );
        return placeHrefBase ? (
          <a href={`${placeHrefBase}${p.slug}/`} class="group flex items-center justify-between rounded-lg border border-navy-100 bg-white px-4 py-3 transition-colors hover:border-brass-400">{inner}</a>
        ) : (
          <div class="group flex items-center justify-between rounded-lg border border-navy-100 bg-white px-4 py-3">{inner}</div>
        );
      })
    }
  </div>
  <div class="mt-8 flex flex-wrap justify-center gap-2">
    {INDUSTRIES.map((i) => <a href={`/industries/${i.slug}/`} class="rounded-full border border-navy-100 bg-paper px-3 py-1 text-xs font-semibold text-navy-900 transition-colors hover:border-brass-400 hover:text-brass-600">{i.name}</a>)}
  </div>
</section>

<script>
  function initBoard() {
    const root = document.getElementById('board');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const claimed: { place: string; industry: string }[] = JSON.parse(root.dataset.claimed || '[]');
    const state = root.dataset.state || '';
    const placeBase = root.dataset.placeBase || '';
    const place = document.getElementById('tb-place') as HTMLSelectElement;
    const cat = document.getElementById('tb-cat') as HTMLSelectElement;
    const result = document.getElementById('tb-result')!;
    const hint = document.getElementById('tb-hint')!;

    function update() {
      if (!place.value || !cat.value) { result.classList.add('hidden'); hint.classList.remove('hidden'); return; }
      const placeName = place.selectedOptions[0].textContent || '';
      const catName = cat.selectedOptions[0].textContent || '';
      const isLocked = claimed.some((c) => c.place === place.value && c.industry === cat.value);
      const status = document.getElementById('tb-status')!;
      const headline = document.getElementById('tb-headline')!;
      const body = document.getElementById('tb-body')!;
      const cta = document.getElementById('tb-cta') as HTMLAnchorElement;
      const placeLink = document.getElementById('tb-place-link') as HTMLAnchorElement;
      if (placeBase) { placeLink.href = `${placeBase}${place.value}/`; placeLink.classList.remove('hidden'); }

      if (isLocked) {
        status.textContent = 'Locked';
        status.className = 'font-mono text-[11px] font-bold uppercase tracking-[0.2em] text-brass-300';
        headline.textContent = `${catName} in ${placeName} is held by an ICS client.`;
        body.textContent = 'This territory is under a 12-month exclusive. We can put you first in line for renewal, or lock a neighboring territory or an adjacent category today.';
        cta.textContent = 'Get in line for this territory →';
        cta.href = `/contact/?${new URLSearchParams({ interest: 'AI systems & marketing', message: `Market Lock — waitlist for ${catName} in ${placeName}, ${state}. Please notify me if it reopens, and tell me what's adjacent.` }).toString()}`;
      } else {
        status.textContent = 'Open';
        status.className = 'font-mono text-[11px] font-bold uppercase tracking-[0.2em] text-teal-400';
        headline.textContent = `${catName} in ${placeName} is open.`;
        body.textContent = `Nobody holds this territory. The first ${catName.toLowerCase()} business in ${placeName} to lock it gets the whole machine — and a written no to every competitor who calls after.`;
        cta.textContent = `Lock ${catName} in ${placeName} →`;
        cta.href = `/contact/?${new URLSearchParams({ interest: 'AI systems & marketing', message: `Market Lock — I want to lock ${catName} in ${placeName}, ${state}. Published pricing is fine; let's talk scope and the 12-month term.` }).toString()}`;
      }
      try { (window as unknown as { va?: (e: string, o: unknown) => void }).va?.('event', { name: 'territory-check', data: { state, place: place.value, industry: cat.value, locked: isLocked } }); } catch { /* best-effort */ }
      hint.classList.add('hidden');
      result.classList.remove('hidden');
    }
    place.addEventListener('change', update);
    cat.addEventListener('change', update);

    // Deep link: /territories/?place=brockton&cat=roofing pre-selects and shows the result.
    const q = new URLSearchParams(location.search);
    const wantPlace = q.get('place');
    const wantCat = q.get('cat');
    if (wantPlace && Array.from(place.options).some((o) => o.value === wantPlace)) place.value = wantPlace;
    if (wantCat && Array.from(cat.options).some((o) => o.value === wantCat)) cat.value = wantCat;
    if (wantPlace || wantCat) {
      update();
      if (place.value && cat.value) result.scrollIntoView({ behavior: 'smooth', block: 'center' });
      else root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }
  document.addEventListener('astro:page-load', initBoard);
</script>
