---
/**
 * A letter from Daniel — the founder, in the first person.
 * Rendered on the homepage and at /letter/ (its shareable permalink).
 */
import { SITE, FOUNDER } from '../config';
import { LETTER_PARAGRAPHS } from '../lib/letter';

interface Props {
  /** Show the "read it at its own address" link (homepage) or the share/print row (/letter/). */
  standalone?: boolean;
}
const { standalone = false } = Astro.props;

const tel = SITE.phone.replace(/[^\d+]/g, '');
const dateline = 'October 2026 · Brockton, Massachusetts';
const replyHref =
  '/contact/?interest=' +
  encodeURIComponent('Something else') +
  '&message=' +
  encodeURIComponent("Daniel — I read your letter. Here's my situation: ");

---

<section class={standalone ? 'bg-paper' : 'border-t border-navy-100 bg-paper'} id="letter">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <!-- Left rail: who's writing -->
      <div class="lg:sticky lg:top-24 lg:self-start">
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.25em] text-brass-600">A letter from Daniel</p>
        <h2 class="mt-3 font-display text-3xl font-bold leading-tight text-navy-900 sm:text-4xl">
          Why I built a firm that does both.
        </h2>
        <div class="mt-6 flex items-center gap-4">
          <img
            src={FOUNDER.image}
          srcset="/images/daniel-lawton-320.webp 320w, /images/daniel-lawton-640.webp 640w, /images/daniel-lawton-960.webp 960w"
          sizes="96px"
            alt={`${FOUNDER.name}, founder of ${SITE.name}`}
            class="h-20 w-20 shrink-0 rounded-xl border-2 border-teal-500/50 object-cover object-top shadow-md"
            width="800"
            height="1524"
            loading="lazy"
          />
          <div>
            <p class="font-display text-lg font-bold text-navy-900">{FOUNDER.name}</p>
            <p class="text-xs font-semibold uppercase tracking-widest text-teal-600">{FOUNDER.title}</p>
            <p class="mt-1 text-xs text-ink-500">{FOUNDER.education.school} '{String(FOUNDER.education.year).slice(2)} · {FOUNDER.hometown}</p>
          </div>
        </div>
        <p class="mt-6 text-sm leading-relaxed text-ink-500">
          Four minutes. No pitch deck. If it sounds like someone you'd want across the table, the phone number at the
          bottom is mine.
        </p>
        {
          standalone ? (
            <div class="mt-6 flex flex-wrap gap-2 print:hidden">
              <button type="button" id="letter-share" class="rounded-md border border-navy-100 bg-white px-4 py-2 text-sm font-semibold text-navy-900 hover:border-teal-500 hover:text-teal-700">Copy a link to this letter</button>
              <button type="button" id="letter-print" class="rounded-md border border-navy-100 bg-white px-4 py-2 text-sm font-semibold text-navy-900 hover:border-teal-500 hover:text-teal-700">Print / Save as PDF</button>
            </div>
          ) : (
            <p class="mt-6 text-sm print:hidden">
              <a href="/letter/" class="font-semibold text-teal-600 hover:text-teal-700">Read it at its own address, or send it to a partner →</a>
            </p>
          )
        }
      </div>

      <!-- The letter -->
      <article class="relative rounded-2xl border border-navy-100 bg-white p-6 shadow-sm sm:p-10 print:border-0 print:p-0 print:shadow-none">
        <div class="absolute left-0 top-8 h-16 w-1 rounded-r bg-brass-400" aria-hidden="true"></div>
        <p class="font-mono text-[11px] font-bold uppercase tracking-[0.2em] text-ink-500">{dateline}</p>
        <p class="mt-6 font-display text-xl font-bold text-navy-900">To the owner reading this after hours,</p>
        <div class="mt-5 space-y-5 text-[17px] leading-[1.75] text-ink-700">
          {LETTER_PARAGRAPHS.map((p) => <p>{p}</p>)}
        </div>
        <div class="mt-8 border-t border-navy-100 pt-6">
          <p class="font-display text-3xl font-bold italic tracking-tight text-navy-900" aria-hidden="true">Daniel</p>
          <p class="mt-2 text-sm font-bold text-navy-900">{FOUNDER.name}</p>
          <p class="text-sm text-ink-500">{FOUNDER.title}, {SITE.name} · {FOUNDER.hometown}</p>
          <p class="mt-1 text-sm">
            <a href={`tel:${tel}`} class="font-semibold text-teal-600 hover:text-teal-700">{SITE.phone}</a>
            <span class="text-ink-500"> · </span>
            <a href={`mailto:${SITE.email}`} class="font-semibold text-teal-600 hover:text-teal-700">{SITE.email}</a>
          </p>
        </div>
        <div class="mt-8 flex flex-wrap gap-3 print:hidden">
          <a href={replyHref} class="rounded-md bg-teal-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-teal-700">Reply to this letter</a>
          <a href={`tel:${tel}`} class="rounded-md border border-navy-100 px-5 py-2.5 text-sm font-semibold text-navy-900 transition-colors hover:border-teal-500 hover:text-teal-700">Call {SITE.phone}</a>
          <a href="/about/" class="rounded-md border border-navy-100 px-5 py-2.5 text-sm font-semibold text-navy-900 transition-colors hover:border-brass-500 hover:text-brass-600">The full story</a>
        </div>
      </article>
    </div>
  </div>
</section>

{
  standalone && (
    <script>
      function init() {
        const share = document.getElementById('letter-share') as HTMLButtonElement | null;
        const print = document.getElementById('letter-print') as HTMLButtonElement | null;
        if (share && !share.dataset.ready) {
          share.dataset.ready = '1';
          share.addEventListener('click', async () => {
            const url = location.origin + '/letter/';
            try {
              await navigator.clipboard.writeText(url);
              share.textContent = 'Link copied';
            } catch {
              share.textContent = url;
            }
            setTimeout(() => (share.textContent = 'Copy a link to this letter'), 2500);
          });
        }
        if (print && !print.dataset.ready) {
          print.dataset.ready = '1';
          print.addEventListener('click', () => window.print());
        }
      }
      init();
      document.addEventListener('astro:page-load', init);
    </script>
  )
}
