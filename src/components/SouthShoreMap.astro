---
/**
 * The South Shore, as a map: 29 towns, the corridors threaded through them,
 * hover for the read, click for the page. Schematic by design — positions
 * are approximate centroids and routes are simplified polylines.
 */
import { TOWNS } from '../lib/towns';
import { TOWN_GEO, CORRIDORS } from '../lib/town-geo';
import { INDUSTRIES } from '../lib/industries';
import { CLAIMED_MA, lockedInPlace } from '../lib/claimed';

const W = 760;
const H = 700;
const PAD = 70;
const lons = TOWN_GEO.map((t) => t.lon);
const lats = TOWN_GEO.map((t) => t.lat);
const minLon = Math.min(...lons);
const maxLon = Math.max(...lons);
const minLat = Math.min(...lats);
const maxLat = Math.max(...lats);
const aspect = 1 / Math.cos((42.1 * Math.PI) / 180); // degrees of latitude are longer on the page than degrees of longitude
const scale = Math.min((W - 2 * PAD) / (maxLon - minLon), (H - 2 * PAD) / ((maxLat - minLat) * aspect));
const x = (lon: number) => PAD + (lon - minLon) * scale;
const y = (lat: number) => PAD + (maxLat - lat) * scale * aspect;

const points = TOWN_GEO.map((g) => {
  const t = TOWNS.find((tt) => tt.slug === g.slug)!;
  return { ...g, name: t.name, county: t.county, position: t.position, corridors: t.corridors, X: x(g.lon), Y: y(g.lat), open: INDUSTRIES.length - lockedInPlace(CLAIMED_MA, g.slug) };
});
const byslug = Object.fromEntries(points.map((p) => [p.slug, p]));
const paths = CORRIDORS.map((c) => ({ ...c, d: c.towns.map((s, i) => `${i ? 'L' : 'M'}${byslug[s].X.toFixed(1)} ${byslug[s].Y.toFixed(1)}`).join(' '), mid: byslug[c.towns[Math.floor(c.towns.length / 2)]] }));
---

<div class="grid gap-6 lg:grid-cols-[1.4fr_1fr]" id="ss-map">
  <div class="rounded-2xl border border-navy-100 bg-navy-950 p-3 sm:p-5">
    <svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full" role="img" aria-labelledby="ss-map-title ss-map-desc">
      <title id="ss-map-title">Schematic map of the 29 South Shore towns ICS serves</title>
      <desc id="ss-map-desc">Town positions are approximate and routes are simplified. Hover or focus a town for its read; select it to open its market page.</desc>
      <defs>
        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M40 0H0V40" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="1" />
        </pattern>
      </defs>
      <rect width={W} height={H} fill="url(#grid)" />
      <text x={W - 16} y={H - 14} text-anchor="end" fill="rgba(219,228,240,0.45)" font-size="11" font-family="ui-monospace, monospace">Atlantic → · schematic, positions approximate</text>

      {paths.map((p) => (
        <path d={p.d} fill="none" stroke={p.tone === 'teal' ? 'rgba(45,212,191,0.35)' : 'rgba(201,162,39,0.35)'} stroke-width="3" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray={p.tone === 'teal' ? '0' : '6 6'} />
      ))}
      {paths.map((p) => (
        <text x={p.mid.X + 8} y={p.mid.Y - 10} fill={p.tone === 'teal' ? 'rgba(45,212,191,0.75)' : 'rgba(201,162,39,0.8)'} font-size="10" font-weight="700" font-family="ui-monospace, monospace">{p.route}</text>
      ))}

      {points.map((p) => (
        <a href={`/south-shore/${p.slug}/`} class="ss-town" data-slug={p.slug} data-name={p.name} data-county={p.county} data-position={p.position} data-corridors={p.corridors.slice(0, 4).join(' · ')} data-open={p.open}>
          <title>{p.name}, MA — {p.position}</title>
          <circle cx={p.X} cy={p.Y} r={p.slug === 'brockton' ? 11 : 7} fill={p.slug === 'brockton' ? '#c9a227' : '#14b8a6'} stroke="#06132a" stroke-width="2.5" class="ss-dot" />
          {p.slug === 'brockton' && <circle cx={p.X} cy={p.Y} r="17" fill="none" stroke="rgba(201,162,39,0.5)" stroke-width="1.5" />}
          <text x={p.X + (p.dx ?? 10)} y={p.Y + (p.dy ?? 4)} text-anchor={p.anchor ?? 'start'} fill="#f8fafc" font-size={p.slug === 'brockton' ? 14 : 12} font-weight={p.slug === 'brockton' ? 700 : 600} font-family="Inter Variable, ui-sans-serif, system-ui, sans-serif" class="ss-label">{p.name}</text>
        </a>
      ))}
    </svg>
    <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 px-1 text-[11px] text-navy-100/60">
      <span><span class="inline-block h-2.5 w-2.5 rounded-full bg-brass-400 align-middle"></span> Headquarters</span>
      <span><span class="inline-block h-2.5 w-2.5 rounded-full bg-teal-500 align-middle"></span> Town with its own market page</span>
      <span><span class="inline-block h-0.5 w-5 bg-teal-400/60 align-middle"></span> Route 3 / 3A</span>
      <span><span class="inline-block h-0.5 w-5 border-t-2 border-dashed border-brass-400/70 align-middle"></span> Inland corridors</span>
    </p>
  </div>

  <aside class="rounded-2xl border border-navy-100 bg-white p-6 shadow-sm" id="ss-panel" aria-live="polite">
    <p class="font-mono text-[11px] font-bold uppercase tracking-[0.25em] text-teal-600" id="ssp-county">Plymouth County · Headquarters</p>
    <h3 class="mt-1 font-display text-2xl font-bold text-navy-900" id="ssp-name">Brockton</h3>
    <p class="mt-2 text-sm italic leading-relaxed text-ink-500" id="ssp-position">{byslug['brockton'].position}</p>
    <p class="mt-3 text-xs text-ink-500"><span class="font-semibold text-navy-900">Corridors:</span> <span id="ssp-corridors">{byslug['brockton'].corridors.slice(0, 4).join(' · ')}</span></p>
    <p class="mt-3 text-xs text-ink-500"><span class="font-semibold text-navy-900">Market Lock:</span> <span id="ssp-open">{byslug['brockton'].open}</span> of {INDUSTRIES.length} categories open</p>
    <div class="mt-5 flex flex-wrap gap-2">
      <a id="ssp-page" href="/south-shore/brockton/" class="rounded-md bg-navy-900 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-600">The Brockton page →</a>
      <a id="ssp-compare" href="/south-shore/compare/?a=brockton&b=abington" class="rounded-md border border-navy-100 px-4 py-2 text-sm font-semibold text-navy-900 hover:border-teal-500 hover:text-teal-700">Compare it →</a>
    </div>
    <p class="mt-5 text-xs text-ink-500">Hover or tap a town. Positions are approximate and the routes are simplified; the market pages are not.</p>
  </aside>
</div>

<style>
  .ss-town { cursor: pointer; outline: none; }
  .ss-town .ss-dot { transition: r 0.15s ease, fill 0.15s ease; }
  .ss-town:hover .ss-dot, .ss-town:focus .ss-dot, .ss-town.is-active .ss-dot { r: 10; fill: #f8fafc; }
  .ss-town:hover .ss-label, .ss-town:focus .ss-label, .ss-town.is-active .ss-label { fill: #2dd4bf; }
</style>

<script>
  function initMap() {
    const root = document.getElementById('ss-map');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const $ = (id: string) => document.getElementById(id)!;
    let active: Element | null = root.querySelector('.ss-town[data-slug="brockton"]');
    active?.classList.add('is-active');
    const show = (el: HTMLElement) => {
      const d = el.dataset;
      $('ssp-county').textContent = `${d.county} County${d.slug === 'brockton' ? ' · Headquarters' : ''}`;
      $('ssp-name').textContent = d.name!;
      $('ssp-position').textContent = d.position!;
      $('ssp-corridors').textContent = d.corridors!;
      $('ssp-open').textContent = d.open!;
      ($('ssp-page') as HTMLAnchorElement).href = `/south-shore/${d.slug}/`;
      $('ssp-page').textContent = `The ${d.name} page →`;
      ($('ssp-compare') as HTMLAnchorElement).href = `/south-shore/compare/?a=${d.slug}&b=${d.slug === 'brockton' ? 'abington' : 'brockton'}`;
      active?.classList.remove('is-active');
      active = el;
      el.classList.add('is-active');
    };
    root.querySelectorAll<HTMLElement>('.ss-town').forEach((el) => {
      el.addEventListener('mouseenter', () => show(el));
      el.addEventListener('focus', () => show(el));
      // On touch, the first tap selects; the second tap follows the link.
      el.addEventListener('click', (ev) => {
        if (window.matchMedia('(hover: none)').matches && active !== el) {
          ev.preventDefault();
          show(el);
        }
      });
    });
  }
  initMap();
  document.addEventListener('astro:page-load', initMap);
</script>
