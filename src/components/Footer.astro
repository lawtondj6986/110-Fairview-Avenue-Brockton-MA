---
import { SITE } from '../config';
import { TOWNS } from '../lib/towns';
import Logo from './Logo.astro';

const year = new Date().getFullYear();

/** Three short columns instead of one long list: what we sell, what's free, who we are. */
const columns: { title: string; links: [string, string][] }[] = [
  {
    title: 'What we do',
    links: [
      ['Commercial Real Estate', '/commercial-real-estate/'],
      ['AI Systems & Marketing', '/ai-services/'],
      ['Published Pricing', '/pricing/'],
      ['Commercial Intelligence', '/intelligence/'],
      ['Political Research', '/political/'],
      ['Custom Platforms', '/platforms/'],
      ['Retail Consultants', '/retail/'],
      ['QuoteBrain', '/quotebrain/'],
      ['Private Clients', '/private-clients/'],
      ['Partners & Referrals', '/partners/'],
      ['Fort Lauderdale & Broward, FL', '/broward/'],
      ['Boca Raton & Palm Beach, FL', '/palm-beach/'],
    ],
  },
  {
    title: 'Free, and proof',
    links: [
      ['Start Here: 45-Second Fit Finder', '/start/'],
      ['Build Your Own Proposal', '/proposal/'],
      ['Free Tools — The Whole Shelf', '/tools/'],
      ['Five CRE Deal Tools', '/deal-tools/'],
      ['The Territory Board', '/territories/'],
      ['Listings', '/listings/'],
      ['Case Studies', '/case-studies/'],
      ['Scoreboard', '/scoreboard/'],
      ['Guarantees', '/guarantees/'],
      ['Insights', '/insights/'],
      ['The Glossary', '/glossary/'],
    ],
  },
  {
    title: 'The firm',
    links: [
      ['About Daniel Lawton', '/about/'],
      ['A Letter from Daniel', '/letter/'],
      ['The Group', '/group/'],
      ['Discretion & Confidentiality', '/confidential/'],
      ['Workshops', '/workshops/'],
      ['Press & Media Kit', '/press/'],
      ['Contact', '/contact/'],
    ],
  },
];
const firstTowns = TOWNS.slice(0, 8);
const moreTowns = TOWNS.slice(8);
---

<footer class="bg-navy-950 text-navy-100">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-2.5">
          <Logo class="h-10 w-10" />
          <div class="leading-tight">
            <p class="font-display font-bold text-white">Innovative Commercial Strategies</p>
            <p class="text-xs uppercase tracking-widest text-teal-400">CRE Advisory + AI Systems</p>
          </div>
        </div>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-navy-100/80">
          Commercial real estate advisory and done-for-you AI systems for South Shore business owners — one advisor from
          signed offer to automated operations.
        </p>
        <p class="mt-4 text-sm text-navy-100/80">
          {SITE.address.locality}, {SITE.address.region} ·
          <a href={`tel:${SITE.phone.replace(/[^\d+]/g, '')}`} class="hover:text-teal-400">{SITE.phone}</a>
        </p>
        <p class="text-sm text-navy-100/80"><a href={`mailto:${SITE.email}`} class="hover:text-teal-400">{SITE.email}</a></p>
        <p class="mt-2 text-xs text-navy-100/60">{SITE.license}</p>
        <a
          href="/contact/"
          class="mt-5 inline-block rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-700"
        >
          Book a Strategy Call
        </a>
      </div>

      {
        columns.map((col) => (
          <nav aria-label={col.title}>
            <p class="font-display text-sm font-semibold uppercase tracking-wider text-white">{col.title}</p>
            <ul class="mt-3 space-y-2 text-sm">
              {col.links.map(([label, href]) => (
                <li>
                  <a href={href} class="text-navy-100/80 hover:text-teal-400">{label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-10 border-t border-white/10 pt-6 text-sm leading-relaxed text-navy-100/70">
      <a href="/south-shore/" class="font-semibold text-white hover:text-teal-400">Serving the South Shore</a>
      <span class="text-navy-100/50"> · </span>
      {firstTowns.map((t, i) => (
        <>
          <a href={`/south-shore/${t.slug}/`} class="hover:text-teal-400">{t.name}</a>{i < firstTowns.length - 1 ? ' · ' : ''}
        </>
      ))}
      <details class="inline">
        <summary class="inline cursor-pointer list-none text-teal-400 hover:text-teal-300 [&::-webkit-details-marker]:hidden"> · and {moreTowns.length} more towns</summary>
        <span>
          {' · '}
          {moreTowns.map((t, i) => (
            <>
              <a href={`/south-shore/${t.slug}/`} class="hover:text-teal-400">{t.name}</a>{i < moreTowns.length - 1 ? ' · ' : ''}
            </>
          ))}
          {' — and surrounding Plymouth, Norfolk & Bristol County communities.'}
        </span>
      </details>
    </div>

    <div class="mt-6 flex flex-col gap-2 border-t border-white/10 pt-6 text-xs text-navy-100/60 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.name}. All rights reserved.</p>
      <p>
        <a href="/privacy/" class="hover:text-teal-400">Privacy</a> ·
        <a href="/terms/" class="hover:text-teal-400">Terms</a> ·
        <a href={SITE.social.linkedin} rel="noopener" class="hover:text-teal-400">LinkedIn</a>
      </p>
    </div>
  </div>
</footer>
