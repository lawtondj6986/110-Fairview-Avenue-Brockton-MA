---
import { SITE, NAV } from '../config';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="bg-navy-950 text-navy-100">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 md:grid-cols-4">
      <div class="md:col-span-2">
        <div class="flex items-center gap-2.5">
          <Logo class="h-10 w-10" />
          <div class="leading-tight">
            <p class="font-display font-bold text-white">Innovative Commercial Strategies</p>
            <p class="text-xs uppercase tracking-widest text-teal-400">CRE Advisory + AI Systems</p>
          </div>
        </div>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-navy-100/80">
          Commercial real estate advisory and done-for-you AI systems for South Shore business owners — one advisor from
          signed offer to automated operations.
        </p>
        <p class="mt-4 text-sm text-navy-100/80">
          {SITE.address.locality}, {SITE.address.region} ·
          <a href={`mailto:${SITE.email}`} class="hover:text-teal-400">{SITE.email}</a> ·
          <a href={`tel:${SITE.phone.replace(/[^\d+]/g, '')}`} class="hover:text-teal-400">{SITE.phone}</a>
        </p>
        <p class="mt-2 text-xs text-navy-100/60">{SITE.license}</p>
      </div>

      <nav aria-label="Footer">
        <p class="font-display text-sm font-semibold uppercase tracking-wider text-white">Explore</p>
        <ul class="mt-3 space-y-2 text-sm">
          {
            NAV.map((item) => (
              <li>
                <a href={item.href} class="text-navy-100/80 hover:text-teal-400">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li><a href="/workshops/" class="text-navy-100/80 hover:text-teal-400">Workshops</a></li>
          <li><a href="/contact/" class="text-navy-100/80 hover:text-teal-400">Contact</a></li>
        </ul>
      </nav>

      <div>
        <p class="font-display text-sm font-semibold uppercase tracking-wider text-white">Serving the South Shore</p>
        <p class="mt-3 text-sm leading-relaxed text-navy-100/70">
          {SITE.serviceAreas.join(' · ')} — and surrounding Plymouth, Norfolk &amp; Bristol County communities.
        </p>
        <a
          href="/contact/"
          class="mt-5 inline-block rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-500"
        >
          Book a Strategy Call
        </a>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-2 border-t border-white/10 pt-6 text-xs text-navy-100/50 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.name}. All rights reserved.</p>
      <p>
        <a href="/privacy/" class="hover:text-teal-400">Privacy</a> ·
        <a href="/terms/" class="hover:text-teal-400">Terms</a> ·
        <a href={SITE.social.linkedin} rel="noopener" class="hover:text-teal-400">LinkedIn</a>
      </p>
    </div>
  </div>
</footer>
