---
import { SITE } from '../config';

/**
 * AI Readiness Score — tap-through assessment island.
 * Score + grade show immediately; the full category breakdown and 90-day
 * plan are gated behind name + phone (same capture pattern as QuoteBrain:
 * mailto handoff now, silent POST when SITE.formEndpoint is configured).
 */
---

<div
  id="ars"
  class="mx-auto max-w-2xl rounded-2xl border border-white/10 bg-navy-950 p-6 shadow-2xl sm:p-8"
  data-form-endpoint={SITE.formEndpoint}
  data-email={SITE.email}
>
  <!-- INTRO -->
  <div id="ars-intro">
    <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-teal-400">
      AI Readiness Score · Free
    </p>
    <h2 class="mt-2 text-2xl font-bold text-white sm:text-3xl">Ten questions. Two minutes. No typing.</h2>
    <p class="mt-3 text-sm leading-relaxed text-navy-100/80">
      The same assessment we run at the start of every Operator Session — scoring your lead response, reputation
      engine, back-office automation, and search visibility against what the best-run businesses in your market do.
    </p>
    <button id="ars-start" type="button" class="mt-6 w-full rounded-md bg-teal-600 px-6 py-3.5 font-semibold text-white transition-colors hover:bg-teal-500 sm:w-auto sm:px-10">
      Start the Assessment →
    </button>
  </div>

  <!-- QUESTION -->
  <div id="ars-quiz" class="hidden">
    <div class="flex items-center justify-between gap-4">
      <p id="ars-cat" class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-teal-400"></p>
      <p id="ars-step" class="font-mono text-xs text-navy-100/60"></p>
    </div>
    <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-navy-800">
      <div id="ars-bar" class="h-full rounded-full bg-teal-500 transition-all duration-300" style="width: 0%"></div>
    </div>
    <h3 id="ars-q" class="mt-6 min-h-[3.5rem] text-xl font-bold leading-snug text-white sm:text-2xl"></h3>
    <div id="ars-opts" class="mt-5 space-y-3"></div>
    <button id="ars-back" type="button" class="mt-5 text-sm font-semibold text-navy-100/60 transition-colors hover:text-teal-400">
      ← Back
    </button>
  </div>

  <!-- RESULT -->
  <div id="ars-result" class="hidden text-center">
    <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-navy-100/60">Your AI Readiness Score</p>
    <p class="mt-2 font-display text-7xl font-bold text-white"><span id="ars-score">0</span><span class="text-3xl text-navy-100/50">/100</span></p>
    <p id="ars-grade" class="mt-3 font-display text-xl font-bold text-teal-400"></p>
    <p id="ars-summary" class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-navy-100/80"></p>
    <button id="ars-unlock" type="button" class="mt-7 w-full rounded-md bg-brass-500 px-6 py-3.5 font-bold text-navy-950 transition-colors hover:bg-brass-300 sm:w-auto sm:px-10">
      Get My Full Breakdown + 90-Day Plan →
    </button>
    <p class="mt-2 text-[11px] text-navy-100/50">Free · printable · no obligation</p>
  </div>

  <!-- GATE -->
  <div id="ars-gate" class="hidden">
    <p class="text-sm font-semibold text-white">Where should the breakdown go?</p>
    <div class="mt-3 grid gap-3 sm:grid-cols-3">
      <input id="ars-name" type="text" placeholder="Your name" autocomplete="name" class="ars-input" />
      <input id="ars-phone" type="tel" placeholder="Phone" autocomplete="tel" class="ars-input" />
      <input id="ars-mail" type="email" placeholder="Email (optional)" autocomplete="email" class="ars-input" />
    </div>
    <button id="ars-generate" type="button" class="mt-4 rounded-md bg-teal-600 px-6 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-teal-500">
      Show My Breakdown
    </button>
    <p id="ars-gate-err" class="mt-2 hidden text-xs text-brass-300">Name and phone are required.</p>
  </div>
</div>

<!-- PLAN DOC (outside the dark card; white, printable) -->
<div id="ars-doc" class="print-area mx-auto mt-6 hidden max-w-2xl rounded-xl bg-white p-6 shadow-lg sm:p-8">
  <div class="flex items-start justify-between gap-4 border-b border-navy-100 pb-5">
    <div class="flex items-center gap-3">
      <img src="/images/ics-logo-mark.jpg" alt="" class="h-12 w-12 rounded-lg" width="160" height="160" />
      <div>
        <p class="font-display text-lg font-bold text-navy-900">AI Readiness Report</p>
        <p class="text-xs text-ink-500">Innovative Commercial Strategies · icsgroup.ai · {SITE.phone}</p>
      </div>
    </div>
    <div class="text-right">
      <p class="font-display text-3xl font-bold text-navy-900"><span id="ars-doc-score"></span><span class="text-base text-ink-500">/100</span></p>
      <p id="ars-doc-date" class="mt-1 text-xs text-ink-500"></p>
    </div>
  </div>
  <p id="ars-doc-meta" class="mt-4 text-sm text-ink-700"></p>

  <h3 class="mt-6 font-display text-sm font-bold uppercase tracking-wider text-navy-900">Category breakdown</h3>
  <div id="ars-doc-cats" class="mt-3 space-y-4"></div>

  <h3 class="mt-8 font-display text-sm font-bold uppercase tracking-wider text-navy-900">Your 90-day plan — worst gap first</h3>
  <ol id="ars-doc-plan" class="mt-3 space-y-4"></ol>

  <p class="mt-6 text-[11px] leading-relaxed text-ink-500">
    Assessment scored against the systems benchmark ICS installs for South Shore businesses. Every recommendation
    above maps to a fixed-scope system with published pricing and written guarantees — icsgroup.ai/pricing.
  </p>
  <div class="mt-5 flex flex-wrap gap-3 print:hidden">
    <button id="ars-print" type="button" class="rounded-md bg-navy-900 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-navy-700">
      Print / Save as PDF
    </button>
    <a id="ars-emailit" href="#" class="rounded-md bg-teal-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-teal-500">
      Email It to ICS — Book the Operator Session
    </a>
  </div>
</div>

<style>
  .ars-input {
    width: 100%;
    border-radius: 0.375rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: #0b1f3a;
    color: #f8fafc;
    padding: 0.55rem 0.75rem;
    font-size: 0.875rem;
  }
  .ars-input:focus {
    outline: none;
    border-color: #14b8a6;
    box-shadow: 0 0 0 2px rgba(20, 184, 166, 0.25);
  }
</style>

<script>
  import { QUESTIONS, CATEGORIES, PRESCRIPTIONS, grade, type CategoryKey } from '../lib/readiness';

  function init() {
    const root = document.getElementById('ars');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';

    const el = (id: string) => document.getElementById(id)!;
    const show = (id: string) => el(id).classList.remove('hidden');
    const hide = (id: string) => el(id).classList.add('hidden');

    let idx = 0;
    const answers: number[] = [];

    function renderQuestion() {
      const q = QUESTIONS[idx];
      el('ars-cat').textContent = CATEGORIES[q.category].name;
      el('ars-step').textContent = `${idx + 1} / ${QUESTIONS.length}`;
      (el('ars-bar') as HTMLElement).style.width = `${(idx / QUESTIONS.length) * 100}%`;
      el('ars-q').textContent = q.text;
      el('ars-opts').innerHTML = '';
      q.options.forEach((opt, i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className =
          'block w-full rounded-lg border border-white/15 bg-navy-900 px-4 py-3 text-left text-sm font-medium text-navy-100 transition-colors hover:border-teal-400 hover:text-white';
        b.textContent = opt.label;
        b.addEventListener('click', () => {
          answers[idx] = i;
          idx++;
          idx < QUESTIONS.length ? renderQuestion() : renderResult();
        });
        el('ars-opts').appendChild(b);
      });
      (el('ars-back') as HTMLElement).style.visibility = idx === 0 ? 'hidden' : 'visible';
    }

    function scores() {
      const byCat: Record<CategoryKey, number> = { speed: 0, reputation: 0, operations: 0, visibility: 0 };
      QUESTIONS.forEach((q, i) => {
        byCat[q.category] += answers[i] != null ? q.options[answers[i]].points : 0;
      });
      const total = Object.values(byCat).reduce((s, n) => s + n, 0);
      return { byCat, total };
    }

    function renderResult() {
      hide('ars-quiz');
      show('ars-result');
      const { total } = scores();
      const g = grade(total);
      el('ars-grade').textContent = g.label;
      el('ars-summary').textContent = g.summary;
      // animate the counter
      const scoreEl = el('ars-score');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) {
        scoreEl.textContent = String(total);
        return;
      }
      const start = performance.now();
      const tick = (now: number) => {
        const p = Math.min((now - start) / 1100, 1);
        scoreEl.textContent = String(Math.round(total * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }

    el('ars-start').addEventListener('click', () => {
      hide('ars-intro');
      show('ars-quiz');
      renderQuestion();
    });
    el('ars-back').addEventListener('click', () => {
      if (idx > 0) {
        idx--;
        renderQuestion();
      }
    });
    el('ars-unlock').addEventListener('click', () => {
      show('ars-gate');
      el('ars-gate').scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    el('ars-generate').addEventListener('click', () => {
      const name = (el('ars-name') as HTMLInputElement).value.trim();
      const phone = (el('ars-phone') as HTMLInputElement).value.trim();
      const email = (el('ars-mail') as HTMLInputElement).value.trim();
      if (!name || !phone) {
        show('ars-gate-err');
        return;
      }
      hide('ars-gate-err');

      const { byCat, total } = scores();
      const g = grade(total);
      el('ars-doc-score').textContent = String(total);
      el('ars-doc-date').textContent = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
      el('ars-doc-meta').innerHTML = `<strong>Prepared for:</strong> ${name} · ${phone}${email ? ' · ' + email : ''} — <strong>${g.label}.</strong> ${g.summary}`;

      const cats = (Object.keys(CATEGORIES) as CategoryKey[]).map((k) => ({
        key: k,
        name: CATEGORIES[k].name,
        pts: byCat[k],
        max: CATEGORIES[k].max,
        pct: byCat[k] / CATEGORIES[k].max,
      }));
      el('ars-doc-cats').innerHTML = cats
        .map(
          (c) => `
          <div>
            <div class="flex items-baseline justify-between text-sm">
              <span class="font-semibold text-navy-900">${c.name}</span>
              <span class="font-mono text-xs text-ink-500">${c.pts}/${c.max}</span>
            </div>
            <div class="mt-1.5 h-2 overflow-hidden rounded-full bg-navy-100">
              <div class="h-full rounded-full ${c.pct >= 0.7 ? 'bg-teal-500' : c.pct >= 0.4 ? 'bg-brass-500' : 'bg-red-400'}" style="width:${Math.max(c.pct * 100, 4)}%"></div>
            </div>
          </div>`
        )
        .join('');

      // Prescribe only real gaps (<80% of category max), worst first
      const gaps = [...cats].sort((a, b) => a.pct - b.pct).filter((c) => c.pct < 0.8).slice(0, 3);
      el('ars-doc-plan').innerHTML = gaps.length
        ? gaps
            .map((c, i) => {
              const rx = PRESCRIPTIONS[c.key];
              return `
          <li class="rounded-lg border border-navy-100 bg-paper p-4">
            <p class="text-sm font-bold text-navy-900">${i + 1}. ${c.name} — ${c.pts}/${c.max}</p>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-700">${rx.fix}</p>
            <p class="mt-2 text-xs font-semibold text-teal-600">ICS fix: ${rx.system}</p>
          </li>`;
            })
            .join('')
        : `<li class="rounded-lg border border-teal-500/40 bg-paper p-4 text-sm leading-relaxed text-ink-700">No major gaps — you're running ahead of your market. The 90-day play is measurement and territory defense: verify every number on a dashboard, lock exclusivity in your trade, and stay ahead as AI search reshapes who gets found.</li>`;

      const body = encodeURIComponent(
        `AI Readiness Score submission\n\nName: ${name}\nPhone: ${phone}\nEmail: ${email}\nScore: ${total}/100 (${g.label})\n` +
          cats.map((c) => `${c.name}: ${c.pts}/${c.max}`).join('\n') +
          `\n\nPlease book my Operator Session.`
      );
      (el('ars-emailit') as HTMLAnchorElement).href =
        `mailto:${root.dataset.email}?subject=${encodeURIComponent(`AI Readiness Score ${total}/100 — ${name}`)}&body=${body}`;

      if (root.dataset.formEndpoint) {
        fetch(root.dataset.formEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ source: 'ai-readiness', name, phone, email, score: total, grade: g.label, ...Object.fromEntries(cats.map((c) => [c.key, c.pts])) }),
        }).catch(() => {});
      }

      hide('ars-gate');
      show('ars-doc');
      el('ars-doc').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    document.getElementById('ars-print')?.addEventListener('click', () => window.print());
  }

  document.addEventListener('astro:page-load', init);
</script>
