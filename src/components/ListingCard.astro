---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'listings'>;
}
const { entry } = Astro.props;
const { title, town, state, price, dealType, propertyType, sqft, status, image, sample } = entry.data;

const statusStyles: Record<string, string> = {
  available: 'bg-teal-100 text-teal-600',
  'under-agreement': 'bg-brass-300/30 text-brass-600',
  sold: 'bg-navy-100 text-navy-700',
  leased: 'bg-navy-100 text-navy-700',
};
const statusLabels: Record<string, string> = {
  available: dealType === 'sale' ? 'For Sale' : 'For Lease',
  'under-agreement': 'Under Agreement',
  sold: 'Sold',
  leased: 'Leased',
};
---

<a
  href={`/listings/${entry.id}/`}
  class="group overflow-hidden rounded-xl border border-navy-100 bg-white shadow-sm transition-shadow hover:shadow-md"
>
  <div class="relative aspect-[16/10] overflow-hidden bg-navy-100">
    <img src={image} alt={title} class="h-full w-full object-cover" loading="lazy" />
    <span class:list={['absolute left-3 top-3 rounded-full px-3 py-1 text-xs font-semibold', statusStyles[status]]}>
      {statusLabels[status]}
    </span>
    {
      sample && (
        <span class="absolute right-3 top-3 rounded-full bg-navy-900/80 px-3 py-1 text-xs font-semibold text-white">
          Sample Listing
        </span>
      )
    }
  </div>
  <div class="p-5">
    <p class="text-xs font-semibold uppercase tracking-widest text-teal-600 capitalize">
      {propertyType.replace('-', ' ')} · {town}, {state}
    </p>
    <h3 class="mt-1.5 text-lg font-bold text-navy-900 group-hover:text-teal-600">{title}</h3>
    <div class="mt-3 flex items-center justify-between text-sm">
      <span class="font-display text-lg font-bold text-navy-900">{price}</span>
      {sqft && <span class="text-ink-500">{sqft} SF</span>}
    </div>
  </div>
</a>
