---
/**
 * "The short version" — ten seconds of truth under the hero of every long
 * selling page: one number, three facts, and jump links to the parts people
 * actually came for. Read it and leave, or read it and keep going.
 */
interface Props {
  number: string;
  numberLabel: string;
  facts: string[];
  jumps: [label: string, href: string][];
}
const { number, numberLabel, facts, jumps } = Astro.props;
---

<section class="border-b border-navy-100 bg-paper" aria-label="The short version">
  <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6">
    <div class="grid gap-5 rounded-xl border border-navy-100 bg-white p-5 shadow-sm sm:p-6 lg:grid-cols-[auto_1fr_auto] lg:items-center lg:gap-8">
      <div class="lg:min-w-[9rem] lg:border-r lg:border-navy-100 lg:pr-8">
        <p class="font-mono text-[10px] font-bold uppercase tracking-[0.25em] text-brass-600">The short version</p>
        <p class="mt-1 font-display text-4xl font-bold leading-none text-navy-900">{number}</p>
        <p class="mt-1.5 text-xs leading-snug text-ink-500">{numberLabel}</p>
      </div>
      <ul class="space-y-1.5 text-sm leading-relaxed text-ink-700">
        {facts.map((f) => (
          <li class="flex gap-2"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-teal-500" aria-hidden="true"></span><span>{f}</span></li>
        ))}
      </ul>
      <nav class="flex flex-wrap gap-2 lg:max-w-[14rem] lg:flex-col" aria-label="Skip to">
        <span class="w-full font-mono text-[10px] font-bold uppercase tracking-[0.25em] text-ink-500">Skip to</span>
        {jumps.map(([label, href]) => (
          <a href={href} class="rounded-md border border-navy-100 px-3 py-1.5 text-xs font-semibold text-navy-900 transition-colors hover:border-teal-500 hover:text-teal-700">{label} →</a>
        ))}
      </nav>
    </div>
  </div>
</section>
