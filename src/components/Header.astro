---
import { NAV } from '../config';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href));
---

<header class="sticky top-0 z-50 border-b border-navy-100 bg-paper/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6 2xl:max-w-[1400px]">
    <a href="/" class="flex items-center gap-2.5" aria-label="Innovative Commercial Strategies — home">
      <img src="/images/ics-logo-mark.jpg" alt="" class="h-10 w-10 rounded-lg" width="160" height="160" />
      <span class="leading-tight lg:hidden 2xl:block">
        <span class="block whitespace-nowrap font-display text-sm font-bold tracking-tight text-navy-900">Innovative Commercial Strategies</span>
        <span class="block text-[11px] font-medium uppercase tracking-widest text-teal-600">CRE Advisory + AI Systems</span>
      </span>
    </a>

    <nav class="hidden items-center gap-5 lg:flex xl:gap-6" aria-label="Main">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              'whitespace-nowrap text-sm font-medium transition-colors hover:text-teal-600',
              isActive(item.href) ? 'text-teal-600' : 'text-ink-700',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <button
        type="button"
        data-open-search
        aria-label="Search the site (Cmd+K)"
        class="flex items-center gap-1.5 rounded-md border border-navy-100 px-2.5 py-2 text-ink-500 transition-colors hover:border-teal-500 hover:text-teal-600"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />
        </svg>
        <kbd class="font-mono text-[10px]">⌘K</kbd>
      </button>
      <a
        href="/contact/"
        class="whitespace-nowrap rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-teal-500"
      >
        Book a Strategy Call
      </a>
    </nav>

    <div class="flex items-center gap-2 lg:hidden">
      <button
        type="button"
        data-open-search
        aria-label="Search the site"
        class="flex h-10 w-10 items-center justify-center rounded-md border border-navy-100 text-navy-900"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />
        </svg>
      </button>

    <!-- Mobile menu (no-JS friendly) -->
    <details class="relative">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-md border border-navy-100 text-navy-900 [&::-webkit-details-marker]:hidden"
        aria-label="Open menu"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M3 5h14M3 10h14M3 15h14" />
        </svg>
      </summary>
      <nav
        class="absolute right-0 mt-2 flex w-64 flex-col gap-1 rounded-lg border border-navy-100 bg-white p-3 shadow-lg"
        aria-label="Mobile"
      >
        {
          NAV.map((item) => (
            <a href={item.href} class="rounded-md px-3 py-2 text-sm font-medium text-ink-700 hover:bg-paper hover:text-teal-600">
              {item.label}
            </a>
          ))
        }
        <a href="/workshops/" class="rounded-md px-3 py-2 text-sm font-medium text-ink-700 hover:bg-paper hover:text-teal-600">
          Workshops
        </a>
        <a href="/contact/" class="mt-1 rounded-md bg-teal-600 px-3 py-2 text-center text-sm font-semibold text-white hover:bg-teal-500">
          Book a Strategy Call
        </a>
      </nav>
    </details>
    </div>
  </div>
</header>
