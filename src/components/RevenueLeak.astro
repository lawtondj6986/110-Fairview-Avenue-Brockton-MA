---
/**
 * Revenue Leak Calculator — loss-framing widget for the AI Systems page.
 * Computes what slow response + dead follow-up cost per year from the
 * owner's own numbers, with the assumptions shown. Planning math, honestly
 * labeled — same house style as QuoteBrain's cap-band line.
 */
---

<div id="leak" class="rounded-2xl border border-white/10 bg-navy-950 p-6 shadow-2xl sm:p-8">
  <div class="grid gap-6 lg:grid-cols-5">
    <div class="lg:col-span-2">
      <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-teal-400">
        The Revenue Leak · Your numbers
      </p>
      <h2 class="mt-2 text-2xl font-bold text-white">What is doing nothing costing you?</h2>
      <div class="mt-5 grid gap-4">
        <div>
          <label for="rl-job" class="rl-label">Average job / customer value ($)</label>
          <input id="rl-job" type="number" min="0" step="250" value="2500" class="rl-input" />
        </div>
        <div>
          <label for="rl-leads" class="rl-label">New leads per month</label>
          <input id="rl-leads" type="number" min="0" step="1" value="20" class="rl-input" />
        </div>
        <div>
          <label for="rl-close" class="rl-label">Close rate when you respond fast (%)</label>
          <input id="rl-close" type="number" min="1" max="100" step="1" value="30" class="rl-input" />
        </div>
        <div>
          <label for="rl-speed" class="rl-label">Typical first response today</label>
          <select id="rl-speed" class="rl-input">
            <option value="1">Under 5 minutes</option>
            <option value="0.55">Within the hour</option>
            <option value="0.35" selected>Same day</option>
            <option value="0.25">Next day or later</option>
          </select>
        </div>
        <label class="flex cursor-pointer items-center gap-2.5 text-sm text-navy-100">
          <input type="checkbox" id="rl-followup" class="h-4 w-4 accent-teal-500" />
          Every quote gets systematic follow-up today
        </label>
      </div>
    </div>

    <div class="flex flex-col justify-between rounded-xl border border-brass-500/40 bg-navy-900 p-6 lg:col-span-3">
      <div>
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-navy-100/60">
          Estimated annual leak
        </p>
        <p id="rl-total" class="mt-2 font-display text-5xl font-bold text-brass-300 sm:text-6xl">$0</p>
        <div id="rl-lines" class="mt-5 space-y-2 border-t border-white/10 pt-4 font-mono text-xs text-navy-100/80"></div>
        <p id="rl-pitch" class="mt-5 text-sm font-semibold leading-relaxed text-white"></p>
      </div>
      <div class="mt-6">
        <p class="text-[11px] leading-relaxed text-navy-100/50">
          Planning math from your inputs. Response-rate factors reflect the widely replicated finding that contact and
          qualification rates collapse as minutes pass after an inquiry; follow-up factor assumes disciplined day
          2/5/10 sequences recover a conservative share of quoted-but-silent work. Your dashboard measures the real
          thing once the system is on.
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href="/ai-readiness/" class="rounded-md bg-teal-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-teal-500">
            Score My Business Free →
          </a>
          <a href="/contact/" class="rounded-md border border-white/25 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-teal-400 hover:text-teal-400">
            Talk to Daniel
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .rl-input {
    width: 100%;
    border-radius: 0.375rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: #0b1f3a;
    color: #f8fafc;
    padding: 0.55rem 0.75rem;
    font-size: 0.875rem;
  }
  .rl-input:focus {
    outline: none;
    border-color: #14b8a6;
    box-shadow: 0 0 0 2px rgba(20, 184, 166, 0.25);
  }
  .rl-label {
    display: block;
    margin-bottom: 0.3rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(219, 228, 240, 0.8);
  }
</style>

<script>
  function initLeak() {
    const root = document.getElementById('leak');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const fmt = (n: number) => '$' + Math.round(n).toLocaleString('en-US');

    function update() {
      const job = Math.max(0, +$('rl-job').value || 0);
      const leads = Math.max(0, +$('rl-leads').value || 0);
      const close = Math.min(100, Math.max(1, +$('rl-close').value || 0)) / 100;
      const speedMult = parseFloat($('rl-speed').value);
      const hasFollowup = ($('rl-followup') as HTMLInputElement).checked;

      const annualLeads = leads * 12;
      const jobsAtBest = annualLeads * close;
      const jobsNow = jobsAtBest * speedMult;
      const speedLeak = (jobsAtBest - jobsNow) * job;
      // Follow-up recovers a conservative 15% of quoted-but-unclosed work
      const followupLeak = hasFollowup ? 0 : annualLeads * (1 - close * speedMult) * 0.15 * close * job;
      const total = speedLeak + followupLeak;

      $('rl-total').textContent = fmt(total);
      document.getElementById('rl-lines')!.innerHTML =
        `<div class="flex justify-between gap-3"><span class="text-navy-100/60">Slow first response</span><span>${fmt(speedLeak)} / yr</span></div>` +
        (hasFollowup
          ? ''
          : `<div class="flex justify-between gap-3"><span class="text-navy-100/60">No quote follow-up</span><span>${fmt(followupLeak)} / yr</span></div>`) +
        `<div class="flex justify-between gap-3"><span class="text-navy-100/60">Jobs slipping away</span><span>~${Math.round((total / Math.max(job, 1)) * 10) / 10} / yr</span></div>`;

      document.getElementById('rl-pitch')!.textContent =
        total > 20000
          ? `Lead Engine installs for $12,000–$18,000. Your leak is ${fmt(total)} a year. That's the whole pitch.`
          : total > 0
            ? `Even a tight operation leaks. ${fmt(total)} a year buys back a lot of Saturdays.`
            : 'Enter your numbers — most owners are surprised.';
    }
    ['rl-job', 'rl-leads', 'rl-close', 'rl-speed', 'rl-followup'].forEach((id) => $(id).addEventListener('input', update));
    update();
  }
  document.addEventListener('astro:page-load', initLeak);
</script>
