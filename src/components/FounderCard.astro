---
/**
 * The founder, on every page that sells. Two variants:
 *  - "band": a full-width "who you'll actually work with" strip for service pages
 *  - "byline": a compact author card for articles
 */
import { SITE } from '../config';

interface Props {
  variant?: 'band' | 'byline';
  heading?: string;
  line?: string;
}
const {
  variant = 'band',
  heading = "Who you'll actually work with",
  line = "One licensed advisor who also builds the systems. No account manager, no hand-off, no queue — the person on this page is the person on the call.",
} = Astro.props;
const tel = SITE.phone.replace(/[^\d+]/g, '');
---

{
  variant === 'byline' ? (
    <aside class="mt-12 flex items-start gap-5 rounded-xl border border-navy-100 bg-paper p-5 sm:items-center">
      <img
        src="/images/daniel-lawton.jpg"
        alt={SITE.founder}
        width="800"
        height="1524"
        loading="lazy"
        class="h-20 w-20 shrink-0 rounded-xl border-2 border-teal-500/50 object-cover object-top"
      />
      <div>
        <p class="font-mono text-[11px] font-bold uppercase tracking-[0.2em] text-brass-600">Written by</p>
        <p class="mt-0.5 font-display text-lg font-bold text-navy-900">{SITE.founder}</p>
        <p class="text-sm leading-relaxed text-ink-500">
          Founder of {SITE.name}. {SITE.license}. Builder-operator — founded a newsroom that publishes daily and a retail
          platform that runs a storefront; negotiates buildings and builds the revenue systems inside them.
        </p>
        <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm font-semibold">
          <a href="/about/" class="text-teal-600 hover:text-teal-700">The founder's story →</a>
          <a href="/contact/" class="text-navy-900 hover:text-teal-600">Talk to Daniel</a>
        </p>
      </div>
    </aside>
  ) : (
    <section class="bg-navy-950">
      <div class="mx-auto flex max-w-6xl flex-col items-center gap-8 px-4 py-12 sm:px-6 lg:flex-row lg:items-center">
        <img
          src="/images/daniel-lawton.jpg"
          alt={`${SITE.founder}, founder of ${SITE.name}`}
          width="800"
          height="1524"
          loading="lazy"
          class="aspect-[4/5] w-40 shrink-0 rounded-2xl border-2 border-teal-500/50 object-cover object-top shadow-2xl sm:w-48"
        />
        <div class="text-center lg:text-left">
          <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brass-300">{heading}</p>
          <p class="mt-2 font-display text-2xl font-bold text-white sm:text-3xl">{SITE.founder}</p>
          <p class="mt-1 text-sm font-semibold uppercase tracking-widest text-teal-400">Founder · Licensed MA Real Estate Salesperson · AI systems builder</p>
          <p class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-navy-100/85 lg:mx-0">{line}</p>
          <div class="mt-5 flex flex-wrap justify-center gap-3 lg:justify-start">
            <a href="/contact/" class="rounded-md bg-teal-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-teal-700">Book a call with Daniel</a>
            <a href={`tel:${tel}`} class="rounded-md border border-white/25 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-teal-400 hover:text-teal-400">{SITE.phone}</a>
            <a href="/about/" class="rounded-md border border-white/25 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-brass-300 hover:text-brass-300">The story</a>
          </div>
        </div>
      </div>
    </section>
  )
}
