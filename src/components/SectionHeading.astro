---
interface Props {
  eyebrow?: string;
  heading: string;
  body?: string;
  align?: 'left' | 'center';
  dark?: boolean;
}
const { eyebrow, heading, body, align = 'left', dark = false } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  {
    eyebrow && (
      <p class:list={['text-xs font-semibold uppercase tracking-[0.2em]', dark ? 'text-teal-400' : 'text-teal-600']}>
        {eyebrow}
      </p>
    )
  }
  <h2 class:list={['mt-2 text-3xl font-bold sm:text-4xl', dark ? 'text-white' : 'text-navy-900']}>{heading}</h2>
  {body && <p class:list={['mt-4 text-lg leading-relaxed', dark ? 'text-navy-100/85' : 'text-ink-500']}>{body}</p>}
</div>
