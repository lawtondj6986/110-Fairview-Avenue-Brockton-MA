---
/**
 * City Compare — Town Compare's sibling for the two Florida markets. Any two
 * cities side by side: position, corridors, who buys there, the operator's
 * read, open Market Lock categories, neighbors. Same mechanics as the South
 * Shore tool: hidden cards rendered once, two cloned into the slots, ?a=&b=.
 */
import type { BrowardCity } from '../lib/broward';
import { INDUSTRIES } from '../lib/industries';
import { lockedInPlace, type Claim } from '../lib/claimed';
import CityCard from './CityCard.astro';
import ShareKit from './ShareKit.astro';

interface Props {
  cities: BrowardCity[];
  base: string; // '/broward/' or '/palm-beach/'
  boardHref: string;
  county: string;
  defaultA: string;
  defaultB: string;
  claimed: Claim[];
}
const { cities, base, boardHref, county, defaultA, defaultB, claimed } = Astro.props;
const sorted = [...cities].sort((a, b) => a.name.localeCompare(b.name));
const cards = cities.map((c) => ({
  ...c,
  open: INDUSTRIES.length - lockedInPlace(claimed, c.slug),
  neighborCities: c.neighbors.map((n) => cities.find((x) => x.slug === n)).filter(Boolean) as BrowardCity[],
}));
const cardA = cards.find((c) => c.slug === defaultA)!;
const cardB = cards.find((c) => c.slug === defaultB)!;
const sel = 'w-full rounded-md border border-navy-100 bg-white px-3 py-2.5 text-sm text-navy-900 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-100';
---

<section class="mx-auto max-w-6xl px-4 py-10 sm:px-6" id="compare" data-default-a={defaultA} data-default-b={defaultB} data-base={base}>
  <div class="grid gap-4 sm:grid-cols-[1fr_auto_1fr] sm:items-end">
    <label class="block">
      <span class="mb-1 block text-sm font-medium text-navy-900">City A</span>
      <select id="town-a" class={sel}>{sorted.map((c) => <option value={c.slug}>{c.name}</option>)}</select>
    </label>
    <button type="button" id="swap" class="rounded-md border border-navy-100 px-4 py-2.5 text-sm font-semibold text-navy-900 hover:border-teal-500 hover:text-teal-700" aria-label="Swap cities">⇄ Swap</button>
    <label class="block">
      <span class="mb-1 block text-sm font-medium text-navy-900">City B</span>
      <select id="town-b" class={sel}>{sorted.map((c) => <option value={c.slug}>{c.name}</option>)}</select>
    </label>
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-2">
    <div id="slot-a" class="min-w-0"><CityCard c={cardA} county={county} base={base} boardHref={boardHref} total={INDUSTRIES.length} /></div>
    <div id="slot-b" class="min-w-0"><CityCard c={cardB} county={county} base={base} boardHref={boardHref} total={INDUSTRIES.length} /></div>
  </div>

  <div class="mt-8 flex flex-wrap gap-3 print:hidden">
    <a id="bring" href="/contact/" class="rounded-md bg-teal-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-teal-700">Bring these two cities to Daniel →</a>
    <button type="button" id="share" class="rounded-md border border-navy-100 px-5 py-2.5 text-sm font-semibold text-navy-900 hover:border-teal-500 hover:text-teal-700">Copy a shareable link</button>
    <button type="button" id="print" class="rounded-md border border-navy-100 px-5 py-2.5 text-sm font-semibold text-navy-900 hover:border-teal-500 hover:text-teal-700">Print / Save as PDF</button>
    <ShareKit what="a Florida city comparison" />
  </div>
  <p class="mt-3 text-xs text-ink-500">
    The read on each city is the same copy that lives on its page. Systems, retail platforms, and custom builds in Florida; brokerage is Massachusetts-licensed, and a Florida property transaction is handled alongside a licensed Florida broker.
  </p>

  <div hidden id="town-cards">
    {cards.map((c) => (
      <div data-town-card={c.slug}><CityCard c={c} county={county} base={base} boardHref={boardHref} total={INDUSTRIES.length} /></div>
    ))}
  </div>
</section>

<script>
  function initCityCompare() {
    const root = document.getElementById('compare');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const a = document.getElementById('town-a') as HTMLSelectElement;
    const b = document.getElementById('town-b') as HTMLSelectElement;
    const slotA = document.getElementById('slot-a')!;
    const slotB = document.getElementById('slot-b')!;
    const bring = document.getElementById('bring') as HTMLAnchorElement;
    const share = document.getElementById('share') as HTMLButtonElement;
    const valid = (v: string | null) => !!v && !!document.querySelector(`[data-town-card="${v}"]`);
    const q = new URLSearchParams(location.search);
    a.value = valid(q.get('a')) ? q.get('a')! : root.dataset.defaultA!;
    b.value = valid(q.get('b')) ? q.get('b')! : root.dataset.defaultB!;
    if (a.value === b.value) b.value = Array.from(b.options).find((o) => o.value !== a.value)!.value;

    function fill(slot: HTMLElement, slug: string) {
      const card = document.querySelector(`[data-town-card="${slug}"] article`);
      slot.innerHTML = '';
      if (card) slot.appendChild(card.cloneNode(true));
      slot.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((btn) =>
        btn.addEventListener('click', () => {
          const other = slot === slotA ? b : a;
          other.value = btn.dataset.pick!;
          render();
          other.scrollIntoView({ behavior: 'smooth', block: 'center' });
        })
      );
    }
    function render() {
      fill(slotA, a.value);
      fill(slotB, b.value);
      const nameA = a.selectedOptions[0].textContent;
      const nameB = b.selectedOptions[0].textContent;
      const url = new URL(location.href);
      url.searchParams.set('a', a.value);
      url.searchParams.set('b', b.value);
      history.replaceState(null, '', url.toString());
      bring.href = `/contact/?${new URLSearchParams({
        interest: 'AI systems & marketing',
        message: `City Compare — I'm deciding between ${nameA} and ${nameB} for my business. Here is the comparison I ran: ${url.toString()}\n\nMy business: \nWhat I do and who I serve: `,
      }).toString()}`;
      try {
        (window as unknown as { va?: (e: string, o: unknown) => void }).va?.('event', { name: 'city-compare', data: { a: a.value, b: b.value, base: root!.dataset.base } });
      } catch {
        /* best-effort */
      }
    }
    a.addEventListener('change', render);
    b.addEventListener('change', render);
    document.getElementById('swap')!.addEventListener('click', () => {
      const t = a.value;
      a.value = b.value;
      b.value = t;
      render();
    });
    share.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(location.href);
        share.textContent = 'Link copied';
      } catch {
        share.textContent = location.href;
      }
      setTimeout(() => (share.textContent = 'Copy a shareable link'), 2500);
    });
    document.getElementById('print')!.addEventListener('click', () => window.print());
    render();
  }
  initCityCompare();
  document.addEventListener('astro:page-load', initCityCompare);
</script>
