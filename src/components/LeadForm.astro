---
import { SITE } from '../config';

interface Props {
  heading?: string;
  compact?: boolean;
}
const { heading = 'Tell us where you want to go', compact = false } = Astro.props;
---

<form action={SITE.formEndpoint} method="POST" class="rounded-xl border border-navy-100 bg-white p-6 shadow-sm sm:p-8">
  <h3 class="text-xl font-bold text-navy-900">{heading}</h3>
  <p class="mt-1 text-sm text-ink-500">We respond within one business day. No spam, no obligation.</p>

  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    <div>
      <label for="name" class="mb-1 block text-sm font-medium text-navy-900">Name</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        autocomplete="name"
        class="w-full rounded-md border border-navy-100 px-3 py-2 text-sm focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-100"
      />
    </div>
    <div>
      <label for="email" class="mb-1 block text-sm font-medium text-navy-900">Email</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        class="w-full rounded-md border border-navy-100 px-3 py-2 text-sm focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-100"
      />
    </div>
    <div>
      <label for="phone" class="mb-1 block text-sm font-medium text-navy-900">Phone <span class="text-ink-500">(optional)</span></label>
      <input
        type="tel"
        id="phone"
        name="phone"
        autocomplete="tel"
        class="w-full rounded-md border border-navy-100 px-3 py-2 text-sm focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-100"
      />
    </div>
    <div>
      <label for="interest" class="mb-1 block text-sm font-medium text-navy-900">I'm interested in</label>
      <select
        id="interest"
        name="interest"
        required
        class="w-full rounded-md border border-navy-100 bg-white px-3 py-2 text-sm focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-100"
      >
        <option value="">Select one…</option>
        <option value="buying">Buying commercial property</option>
        <option value="selling">Selling or leasing my property</option>
        <option value="ai-services">AI systems &amp; marketing for my business</option>
        <option value="both">Both — property and AI services</option>
        <option value="other">Something else</option>
      </select>
    </div>
  </div>

  {
    !compact && (
      <div class="mt-4">
        <label for="message" class="mb-1 block text-sm font-medium text-navy-900">
          What's going on in your business?
        </label>
        <textarea
          id="message"
          name="message"
          rows="4"
          class="w-full rounded-md border border-navy-100 px-3 py-2 text-sm focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-100"
          placeholder="E.g., outgrowing our current shop, looking at buildings on Route 28, and our quoting process is a mess…"
        />
      </div>
    )
  }

  <!-- Honeypot field for spam bots -->
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

  <button
    type="submit"
    class="mt-6 w-full rounded-md bg-teal-600 px-6 py-3 font-semibold text-white shadow-sm transition-colors hover:bg-teal-500 sm:w-auto"
  >
    Send — Get a Response Within 1 Business Day
  </button>
</form>
