---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaSection from '../../components/CtaSection.astro';

export async function getStaticPaths() {
  const entries = await getCollection('case-studies', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, client, location, package: pkg, summary, stats, testimonial, illustrative } = entry.data;
---

<Base title={`${title} | ICS Case Study`} description={summary} ogType="article">
  <article>
    <header class="bg-navy-900">
      <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-teal-400">
          Case Study · {client} · {location}
        </p>
        <h1 class="mt-4 text-3xl font-bold leading-tight text-white sm:text-4xl">{title}</h1>
        <p class="mt-4 max-w-2xl text-lg text-navy-100/85">{summary}</p>
        <p class="mt-6 inline-block rounded-full border border-teal-400/40 px-4 py-1.5 text-sm font-semibold text-teal-400">
          Package: {pkg}
        </p>
      </div>
    </header>

    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <div class="-mt-8 grid gap-4 rounded-xl border border-navy-100 bg-white p-6 shadow-md sm:grid-cols-2 lg:grid-cols-4">
        {
          stats.map((stat) => (
            <div class="text-center">
              <p class="font-display text-2xl font-bold text-navy-900">{stat.value}</p>
              <p class="mt-1 text-xs leading-snug text-ink-500">{stat.label}</p>
            </div>
          ))
        }
      </div>

      <div class="prose-ics py-12">
        <Content />
        {
          testimonial && (
            <figure class="mt-10 rounded-xl bg-navy-900 p-8 not-italic">
              <blockquote class="border-none p-0 text-lg font-medium leading-relaxed text-white">
                “{testimonial.quote}”
              </blockquote>
              <figcaption class="mt-4 text-sm text-teal-400">
                — {testimonial.name}, {testimonial.title}
              </figcaption>
            </figure>
          )
        }
        {
          illustrative && (
            <p class="mt-8 rounded-lg bg-paper p-4 text-xs text-ink-500">
              This case study uses illustrative figures representative of the engagement type while client permissions
              and verified metrics are finalized.
            </p>
          )
        }
      </div>
    </div>
  </article>

  <CtaSection
    heading="Your business could be the next case study"
    body="Book a free strategy call — we'll map which of these systems fits your operation and what results to expect."
  />
</Base>
