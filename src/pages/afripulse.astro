---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';

const title = 'AfriPulse Times — Investor Brief | Innovative Commercial Strategies';
const description =
  'The investor brief for AfriPulse Times: a pan-African digital newsroom engineered to run itself — automated story flow, a command-center dashboard, a live news map — live in production and raising for a large-scale rollout.';

const product = [
  ['Automated story flow', 'Curated RSS pipelines pull reporting from across the continent into one review queue, 24/7. The front page refreshes itself — no overnight shift, no stale homepage, ever.'],
  ['The command center', "One dashboard runs the entire operation: ingest, queue, publish, feature, kill. The admin panel is the newsroom — a lean team operates at a scale that traditionally required a floor of editors."],
  ['The live news map', "Stories appear geographically as they land — the continent's pulse at a glance, updating automatically. The feature readers remember, and one no off-the-shelf news product ships."],
  ['The editorial layer', 'Automation feeds the queue; an editorial board sets the standard. Human judgment rides on top of machine speed — review, approval, and a front page someone is accountable for.'],
];

const whyNow = [
  ['The audience', "Africa's internet population is among the fastest-growing on earth — a generation coming online mobile-first, hungry for coverage that treats the continent as the main story rather than a footnote."],
  ['The cost structure', 'Legacy newsrooms scale headcount with coverage. AfriPulse scales software: the automation architecture means coverage breadth grows with feeds and compute, not payroll.'],
  ['The moat', 'Custom-engineered platform, fully owned — no CMS vendor, no platform landlord, no per-seat licensing. The command center and live map are proprietary and already running in production.'],
  ['The proof', 'This is not a deck describing a product that might exist. The platform is live, publishing daily, at afripulsetimes.com — open it right now and watch it work.'],
];
---

<Base title={title} description={description}>
  <!-- BRIEF -->
  <section class="bg-navy-950 print:bg-white">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 sm:py-16 print:py-6">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brass-300 print:text-navy-900">Investor brief · Confidential conversation welcome</p>
        <button
          id="print-brief"
          class="rounded-md border border-white/25 px-4 py-2 text-sm font-semibold text-white transition-colors hover:border-brass-300 hover:text-brass-300 print:hidden"
        >
          Print / Save as PDF
        </button>
      </div>
      <h1 class="mt-5 text-4xl font-bold leading-tight text-white sm:text-5xl print:text-navy-900">
        AfriPulse Times
      </h1>
      <p class="mt-3 max-w-2xl text-xl font-semibold text-teal-400">
        A pan-African digital newsroom engineered to run itself.
      </p>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-navy-100/90 print:text-ink-700">
        Live in production at
        <a href="https://www.afripulsetimes.com" rel="noopener" class="font-semibold text-brass-300 underline-offset-4 hover:underline print:text-navy-900">afripulsetimes.com</a>
        — publishing daily, operated from a single command center, and now actively raising for a large-scale
        rollout across the continent.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6 print:py-4">
    <h2 class="text-2xl font-bold text-navy-900">The product, in four systems</h2>
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {
        product.map(([h, b], i) => (
          <div class="reveal rounded-xl border border-navy-100 bg-white p-6 shadow-sm print:border-navy-100 print:shadow-none" style={`--reveal-delay: ${(i % 2) * 70}ms`}>
            <h3 class="font-display text-lg font-bold text-navy-900">{h}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-500">{b}</p>
          </div>
        ))
      }
    </div>

    <h2 class="mt-12 text-2xl font-bold text-navy-900 print:mt-6">Why this, why now</h2>
    <div class="mt-6 space-y-4">
      {
        whyNow.map(([h, b]) => (
          <div class="reveal flex gap-4">
            <span class="mt-1 font-mono text-sm font-bold text-teal-600">→</span>
            <p class="text-sm leading-relaxed text-ink-700">
              <strong class="text-navy-900">{h}.</strong> {b}
            </p>
          </div>
        ))
      }
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2 print:mt-6">
      <div class="reveal rounded-xl bg-navy-900 p-7 print:border print:border-navy-100 print:bg-white">
        <h2 class="text-xl font-bold text-white print:text-navy-900">The founder</h2>
        <p class="mt-3 text-sm leading-relaxed text-navy-100/85 print:text-ink-700">
          AfriPulse Times was founded and engineered by {SITE.founder}, founder of Innovative Commercial Strategies —
          a builder-operator whose working platforms include a live-inventory retail system running a Massachusetts
          storefront daily (store-reported business up 300% since launch). The pattern across every build: automate
          the flow, keep judgment human, make the whole operation legible on one screen.
        </p>
        <a href="/about/" class="mt-4 inline-block text-sm font-semibold text-teal-400 hover:text-teal-500 print:hidden">
          Full background →
        </a>
      </div>
      <div class="reveal rounded-xl border border-brass-300 bg-white p-7" style="--reveal-delay: 80ms">
        <h2 class="text-xl font-bold text-navy-900">The conversation</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-700">
          The platform is built and running; the raise funds the rollout — expanded coverage, editorial hands in the
          command center, and audience growth across the continent. Detailed financials, traction data, and the
          rollout plan are shared directly, under confidentiality where preferred.
        </p>
        <div class="mt-4 space-y-1 text-sm font-semibold">
          <p><a href={`mailto:${SITE.email}?subject=${encodeURIComponent('AfriPulse Times — investor conversation')}`} class="text-teal-600 hover:text-teal-500">{SITE.email}</a></p>
          <p><a href={`tel:${SITE.phone.replace(/[^\d+]/g, '')}`} class="text-teal-600 hover:text-teal-500">{SITE.phone}</a></p>
          <p class="pt-1"><a href="https://www.afripulsetimes.com" rel="noopener" class="text-brass-600 hover:text-brass-500">See it live: afripulsetimes.com →</a></p>
        </div>
      </div>
    </div>

    <p class="mt-10 text-xs leading-relaxed text-ink-500 print:mt-6">
      This page is an introduction, not an offering. Nothing here is an offer to sell or a solicitation to buy
      securities; any investment discussion proceeds through proper documentation with counsel on both sides.
      The build story behind the platform is published at
      <a href="/case-studies/afripulse-times-media-platform/" class="font-semibold text-teal-600 hover:text-teal-500">icsgroup.ai/case-studies/afripulse-times-media-platform</a>.
    </p>
  </section>
</Base>

<style>
  @media print {
    :global(header),
    :global(footer),
    :global(#money-bar) {
      display: none !important;
    }
    :global(body) {
      background: white !important;
    }
    :global(.reveal) {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  function initPrint() {
    const btn = document.getElementById('print-brief');
    if (!btn || btn.dataset.ready) return;
    btn.dataset.ready = '1';
    btn.addEventListener('click', () => window.print());
  }
  document.addEventListener('astro:page-load', initPrint);
</script>
