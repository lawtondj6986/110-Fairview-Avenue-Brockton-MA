---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import CtaSection from '../components/CtaSection.astro';
import FounderLetter from '../components/FounderLetter.astro';
import { SITE } from '../config';

const allCaseStudies = (await getCollection('case-studies', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const caseStudies = allCaseStudies.slice(0, 3);
const testimonials = allCaseStudies
  .filter((entry) => entry.data.testimonial)
  .slice(0, 3)
  .map((entry) => ({ ...entry.data.testimonial!, slug: entry.id }));

const title = 'Innovative Commercial Strategies | Commercial Real Estate + AI Systems, South Shore MA';
const description =
  "The South Shore's AI-powered commercial real estate firm. We help contractors, retailers, and medical practices buy, sell, and lease commercial property — then install the marketing and automation systems that grow the business inside it.";
---

<Base title={title} description={description} offerCatalog>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-navy-900">
    <!-- circuit-meets-floorplan background motif -->
    <svg
      class="pointer-events-none absolute inset-y-0 right-0 hidden h-full w-1/2 opacity-[0.12] lg:block"
      viewBox="0 0 600 600"
      fill="none"
      aria-hidden="true"
    >
      <path class="draw-line" d="M120 520V220l160-110v410" stroke="#2DD4BF" stroke-width="3" stroke-linejoin="round"></path>
      <path class="draw-line" d="M280 520V300l160 55v165" stroke="#2DD4BF" stroke-width="3" stroke-linejoin="round"></path>
      <path d="M440 340h90m0 0V190" stroke="#2DD4BF" stroke-width="3" stroke-linecap="round"></path>
      <circle cx="530" cy="160" r="14" fill="#2DD4BF"></circle>
      <circle cx="560" cy="420" r="14" fill="#2DD4BF"></circle>
      <path d="M530 340l30 80" stroke="#2DD4BF" stroke-width="3" stroke-linecap="round"></path>
      <path d="M60 520h480" stroke="#2DD4BF" stroke-width="3" stroke-linecap="round"></path>
    </svg>

    <div class="relative mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
    <div>
      <p class="reveal text-xs font-semibold uppercase tracking-[0.25em] text-teal-400">
        Commercial Real Estate Advisory + AI Systems · Brockton &amp; the South Shore
      </p>
      <h1 class="reveal mt-5 max-w-3xl text-4xl font-bold leading-tight text-white sm:text-5xl lg:text-6xl" style="--reveal-delay: 100ms">
        Your broker shouldn't hand you the keys and disappear.
      </h1>
      <p class="reveal mt-6 max-w-2xl text-lg leading-relaxed text-navy-100/90" style="--reveal-delay: 200ms">
        ICS is the only South Shore firm where the advisor who negotiates your commercial building also builds the AI
        systems, marketing engine, and workflows that make it produce revenue from day one. Built by an operator who
        has built and run real businesses — measured in booked work, not page views.
      </p>
      <div class="reveal mt-9 flex flex-wrap gap-4" style="--reveal-delay: 300ms">
        <a
          href="/contact/"
          class="rounded-md bg-teal-600 px-6 py-3 font-semibold text-white shadow-lg transition-colors hover:bg-teal-700"
        >
          Book a Free Strategy Call
        </a>
        <a
          href="/case-studies/"
          class="rounded-md border border-white/25 px-6 py-3 font-semibold text-white transition-colors hover:border-teal-400 hover:text-teal-400"
        >
          See Client Results
        </a>
      </div>
      <a href="/about/" class="reveal mt-8 flex items-center gap-4 rounded-xl border border-white/10 bg-white/5 p-3 pr-4 lg:hidden" style="--reveal-delay: 400ms">
        <img
          src="/images/daniel-lawton.jpg"
          srcset="/images/daniel-lawton-320.webp 320w, /images/daniel-lawton-640.webp 640w, /images/daniel-lawton-960.webp 960w"
          sizes="96px"
          alt={`${SITE.founder}, founder of ${SITE.name}`}
          class="h-24 w-20 shrink-0 rounded-lg border-2 border-teal-500/50 object-cover object-top shadow-lg"
          width="800"
          height="1524"
          loading="eager"
          fetchpriority="high"
        />
        <span class="text-sm leading-snug text-navy-100/80">
          <span class="block font-display text-base font-bold text-white">{SITE.founder}</span>
          <span class="block text-[11px] font-semibold uppercase tracking-widest text-brass-300">Founder</span>
          <span class="mt-1 block italic text-navy-100/70">"The operator thing isn't a metaphor."</span>
          <span class="mt-1 block text-xs font-semibold text-teal-400">The founder's story →</span>
        </span>
      </a>
      <p class="mt-6 text-sm text-navy-100/60">
        Serving {SITE.serviceAreas.slice(0, 6).join(', ')} and the greater South Shore · {SITE.license}
      </p>
    </div>

    <!-- THE FOUNDER — the face of the business -->
    <figure class="reveal relative hidden justify-self-center lg:block" style="--reveal-delay: 250ms">
      <div class="absolute -inset-3 rounded-3xl bg-teal-500/15 blur-2xl" aria-hidden="true"></div>
      <img
        src="/images/daniel-lawton.jpg"
          srcset="/images/daniel-lawton-320.webp 320w, /images/daniel-lawton-640.webp 640w, /images/daniel-lawton-960.webp 960w"
          sizes="(min-width: 1280px) 320px, 288px"
        alt={`${SITE.founder}, founder of ${SITE.name}`}
        class="relative aspect-[4/5] w-72 rounded-2xl border-2 border-teal-500/50 object-cover object-top shadow-2xl xl:w-80"
        width="800"
        height="1524"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption class="relative -mt-10 ml-6 w-[calc(100%-1.5rem)] rounded-xl border border-brass-400/50 bg-navy-950/95 p-4 shadow-xl backdrop-blur">
        <p class="font-display text-lg font-bold text-white">{SITE.founder}</p>
        <p class="mt-0.5 text-xs font-semibold uppercase tracking-widest text-brass-300">Founder</p>
        <p class="mt-2 text-sm italic leading-snug text-navy-100/80">"The operator thing isn't a metaphor."</p>
        <a href="/about/" class="mt-2 inline-block text-xs font-semibold text-teal-400 hover:text-teal-300">The founder's story →</a>
      </figcaption>
    </figure>
    </div>
  </section>

  <!-- WELCOME MAT — three doors for first-time visitors -->
  <section class="border-b border-navy-100 bg-paper">
    <div class="mx-auto grid max-w-6xl gap-px overflow-hidden px-4 py-5 sm:grid-cols-3 sm:px-6">
      {
        [
          ['New here?', 'Four questions match you to the right system — 45 seconds, no email.', '/start/', 'Take the Fit Finder →'],
          ['Just browsing?', 'Seventeen working tools, all free, all ungated — calculators, scores, the whole playbook.', '/tools/', 'Open the Free Shelf →'],
          ['Just want numbers?', 'Prices published, guarantees in writing, and a proposal you can build yourself in sixty seconds.', '/proposal/', 'Build your own proposal →'],
        ].map(([q, body, href, cta], i) => (
          <a href={href} class="group flex flex-col px-4 py-3 transition-colors hover:bg-white sm:border-l sm:border-navy-100 sm:first:border-l-0">
            <p class="font-mono text-[11px] font-bold uppercase tracking-widest text-brass-600">{q}</p>
            <p class="mt-1 flex-1 text-sm leading-snug text-ink-500">{body}</p>
            <p class="mt-2 text-sm font-semibold text-teal-600 group-hover:text-teal-700">{cta}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- TWO ENGINES -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <SectionHeading
      eyebrow="Two engines, one advisor"
      heading="Most firms do one side of this. We do both — on purpose."
      body="A building is a means to an end: more revenue, more room to operate, less chaos. So we handle the transaction and the systems that come after it."
      align="center"
    />
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      <div class="rounded-xl border border-navy-100 bg-white p-8 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-widest text-brass-600">Engine 1</p>
        <h3 class="mt-2 text-2xl font-bold text-navy-900">Commercial Real Estate Advisory</h3>
        <p class="mt-3 leading-relaxed text-ink-500">
          Buyer, seller, tenant, and landlord representation for sub-$3M commercial property — the deals national firms
          ignore and residential agents aren't built for. Every listing gets institutional-grade marketing:
          AI-produced offering memoranda, drone and virtual tours, targeted campaigns, and property-level SEO.
        </p>
        <ul class="mt-5 space-y-2 text-sm text-ink-700">
          <li class="flex gap-2"><span class="text-teal-600">✓</span> Sales &amp; leasing representation</li>
          <li class="flex gap-2"><span class="text-teal-600">✓</span> Site-selection analysis with real data</li>
          <li class="flex gap-2"><span class="text-teal-600">✓</span> Big-building marketing for every listing</li>
        </ul>
        <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2">
          <a href="/commercial-real-estate/" class="font-semibold text-teal-600 hover:text-teal-700">
            Explore CRE services →
          </a>
          <a href="/deal-tools/" class="font-semibold text-brass-600 hover:text-brass-500">
            Every seat at the table: five free deal tools →
          </a>
        </div>
      </div>
      <div class="rounded-xl border border-navy-100 bg-white p-8 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-widest text-brass-600">Engine 2</p>
        <h3 class="mt-2 text-2xl font-bold text-navy-900">AI Systems &amp; Marketing</h3>
        <p class="mt-3 leading-relaxed text-ink-500">
          Done-for-you AI revenue systems for Main Street businesses: websites that generate leads, instant-quote
          calculators, automated follow-up and booking, review engines — packaged as JobSite, Lead Engine, and Market
          Lock, with pricing published and guarantees in writing.
        </p>
        <ul class="mt-5 space-y-2 text-sm text-ink-700">
          <li class="flex gap-2"><span class="text-teal-600">✓</span> JobSite / Lead Engine / Market Lock systems</li>
          <li class="flex gap-2"><span class="text-teal-600">✓</span> AI marketing, SEO &amp; answer-engine optimization</li>
          <li class="flex gap-2"><span class="text-teal-600">✓</span> Measured in leads, hours saved, and revenue</li>
        </ul>
        <a href="/ai-services/" class="mt-6 inline-block font-semibold text-teal-600 hover:text-teal-700">
          Explore AI services →
        </a>
      </div>
    </div>
  </section>

  <!-- PROOF — case studies, owners' words, and two live platforms in one place -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading
        eyebrow="Proof, not promises"
        heading="Judge us on numbers you can check"
        body="Every engagement is measured in leads, hours saved, and revenue — and written up so you can hold us to it."
      />
      <a href="/case-studies/" class="font-semibold text-teal-600 hover:text-teal-700">All case studies →</a>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {caseStudies.map((entry) => <CaseStudyCard entry={entry} />)}
    </div>
    {
      testimonials.length > 0 && (
        <div class="mt-6 grid gap-4 md:grid-cols-3">
          {testimonials.map((t, i) => (
            <figure class="reveal rounded-xl border border-navy-100 bg-paper p-5" style={`--reveal-delay: ${i * 70}ms`}>
              <blockquote class="text-sm italic leading-relaxed text-ink-700">“{t.quote}”</blockquote>
              <figcaption class="mt-3 text-xs text-ink-500">
                <span class="font-semibold text-navy-900">{t.name}</span> · {t.title} ·
                <a href={`/case-studies/${t.slug}/`} class="font-semibold text-teal-600 hover:text-teal-700">the numbers →</a>
              </figcaption>
            </figure>
          ))}
        </div>
      )
    }
    <div class="mt-8 flex flex-col gap-4 rounded-xl bg-navy-950 p-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-navy-100/85">
        <span class="font-semibold text-white">Two platforms we built are live right now.</span> Click either one and judge the work yourself.
      </p>
      <div class="flex flex-wrap gap-2">
        <a href="https://www.afripulsetimes.com" rel="noopener" class="rounded-md border border-white/25 px-4 py-2 text-sm font-semibold text-white transition-colors hover:border-teal-400 hover:text-teal-400">AfriPulse Times · daily newsroom ↗</a>
        <a href="https://outbackarms.com" rel="noopener" class="rounded-md border border-white/25 px-4 py-2 text-sm font-semibold text-white transition-colors hover:border-teal-400 hover:text-teal-400">Outback Arms · retail, up 300% ↗</a>
      </div>
    </div>
  </section>

  <!-- SYSTEMS TEASER -->
  <section class="bg-paper">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <SectionHeading
        eyebrow="Three systems · Published pricing"
        heading="JobSite. Lead Engine. Market Lock."
        body="Fixed scope, published price ranges, written quote in 48 hours, and guarantees with consequences. No 'contact us for pricing.'"
        align="center"
      />
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          [
            {
              name: 'JobSite',
              price: '$6,500–$9,500 + $450–$700/mo',
              outcome: 'The conversion storefront — live in 21 days, guaranteed, with QuoteBrain™ and measurable lead flow.',
              items: ['21-day launch guarantee', 'Instant-quote calculator', 'Reviews + tracking + dashboard'],
            },
            {
              name: 'Lead Engine',
              price: '$12,000–$18,000 + $1,500–$2,500/mo',
              outcome: 'The follow-up machine — every lead answered in under 60 seconds, 24/7, and chased to a decision.',
              items: ['AI response <60s, guaranteed', 'CRM + quote follow-up sequences', 'Proof Engine content automation'],
            },
            {
              name: 'Market Lock',
              price: '$20,000–$30,000 + $3,500–$6,000/mo',
              outcome: 'Territory dominance — one business per trade, per market. Your competitor calling us gets a no.',
              items: ['Exclusive territory', 'Paid media + monthly Reels system', 'AEO + quarterly on-site strategy day'],
            },
          ].map((tier, i) => (
            <div
              class:list={[
                'reveal flex flex-col rounded-xl border p-8',
                i === 1 ? 'border-teal-500 bg-navy-900 text-white shadow-lg' : 'border-navy-100 bg-white shadow-sm',
              ]}
              style={`--reveal-delay: ${i * 80}ms`}
            >
              <h3 class:list={['text-2xl font-bold', i === 1 ? 'text-white' : 'text-navy-900']}>{tier.name}</h3>
              <p class:list={['mt-1 font-mono text-xs font-semibold', i === 1 ? 'text-teal-400' : 'text-teal-600']}>{tier.price}</p>
              <p class:list={['mt-3 text-sm leading-relaxed', i === 1 ? 'text-navy-100/85' : 'text-ink-500']}>{tier.outcome}</p>
              <ul class:list={['mt-5 flex-1 space-y-2 text-sm', i === 1 ? 'text-navy-100/90' : 'text-ink-700']}>
                {tier.items.map((item) => (
                  <li class="flex gap-2">
                    <span class="text-teal-500">✓</span> {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="mt-10 text-center">
        <a href="/pricing/" class="font-semibold text-teal-600 hover:text-teal-700">
          See full published pricing →
        </a>
      </div>
    </div>
  </section>

  <!-- THE TERRITORY BOARD — scarcity, front and center -->
  <section class="bg-navy-950">
    <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-6 px-4 py-10 sm:px-6 lg:flex-row lg:items-center">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brass-300">Market Lock · The Territory Board</p>
        <p class="mt-2 max-w-2xl text-xl font-bold leading-snug text-white sm:text-2xl">
          One business per category, per town. 29 towns × 12 categories = 348 exclusive territories. Whoever locks it first, keeps it.
        </p>
        <p class="mt-2 text-sm text-navy-100/70">Your competitor calling after you gets a no — in writing. Check whether yours is still open.</p>
      </div>
      <a href="/territories/" class="shrink-0 rounded-md bg-brass-500 px-6 py-3 font-semibold text-navy-950 transition-colors hover:bg-brass-300">
        Check my territory →
      </a>
    </div>
  </section>

  <!-- GUARANTEES STRIP -->
  <section class="bg-navy-950">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <div class="grid gap-8 text-center sm:grid-cols-2 lg:grid-cols-4">
        {
          [
            ['21 days', 'to launch, or $1,000/week credit'],
            ['<60 sec', 'lead response, 24/7, measured monthly'],
            ['90 days', 'to measurable proof, or we work free'],
            ['100%', 'yours — code, accounts, data, always'],
          ].map(([value, label], i) => (
            <a href="/guarantees/" class="reveal group" style={`--reveal-delay: ${i * 60}ms`}>
              <p class="font-display text-4xl font-bold text-white transition-colors duration-150 group-hover:text-teal-400">{value}</p>
              <p class="mt-2 text-sm text-navy-100/70">{label}</p>
            </a>
          ))
        }
      </div>
      <p class="mt-8 text-center text-sm">
        <a href="/guarantees/" class="font-semibold text-teal-400 hover:text-teal-500">Four guarantees, in writing, with consequences →</a>
      </p>
    </div>
  </section>

  <!-- ALSO UNDER THIS ROOF — one line each, no pitch -->
  <section class="border-y border-navy-100 bg-paper">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.25em] text-brass-600">Also under this roof</p>
      <div class="mt-5 grid gap-px overflow-hidden rounded-xl border border-navy-100 bg-navy-100 sm:grid-cols-2 lg:grid-cols-5">
        {
          [
            ['Commercial Intelligence', 'Know before you sign. Public sources, lawful methods.', '/intelligence/'],
            ['Political Research', 'Opposition books and vulnerability audits under a published methods code.', '/political/'],
            ['Custom Platforms', 'When the business is the software, we build the business.', '/platforms/'],
            ['Retail Consultants', 'Live-inventory storefronts for hard and regulated categories.', '/retail/'],
            ['Private Clients', 'Portfolios and mid-size companies, served quietly.', '/private-clients/'],
          ].map(([t, b, h]) => (
            <a href={h} class="group bg-white p-5 transition-colors hover:bg-paper">
              <p class="font-display text-base font-bold text-navy-900 group-hover:text-teal-600">{t}</p>
              <p class="mt-1 text-xs leading-relaxed text-ink-500">{b}</p>
            </a>
          ))
        }
      </div>
      <p class="mt-4 text-sm text-ink-500">
        Twelve industries, twenty-nine South Shore towns, and Broward and Palm Beach Counties in season —
        <a href="/industries/" class="font-semibold text-teal-600 hover:text-teal-700">find your industry</a> ·
        <a href="/south-shore/" class="font-semibold text-teal-600 hover:text-teal-700">your town</a> ·
        <a href="/broward/" class="font-semibold text-teal-600 hover:text-teal-700">Fort Lauderdale</a> ·
        <a href="/palm-beach/" class="font-semibold text-teal-600 hover:text-teal-700">Boca Raton</a> ·
        <a href="/glossary/" class="font-semibold text-teal-600 hover:text-teal-700">the glossary</a>
      </p>
    </div>
  </section>

  <!-- A LETTER FROM DANIEL — the founder, first person -->
  <FounderLetter />

  <CtaSection />
</Base>
