---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaSection from '../../components/CtaSection.astro';
import FounderCard from '../../components/FounderCard.astro';
import { SITE } from '../../config';

const terms = (await getCollection('glossary', ({ data }) => !data.draft)).sort((a, b) =>
  a.data.term.localeCompare(b.data.term, 'en', { sensitivity: 'base' })
);

const CATS = {
  cre: { name: 'Commercial real estate', blurb: 'The words in a lease, a purchase agreement, a lender’s term sheet, and a zoning hearing.', href: '/commercial-real-estate/' },
  ai: { name: 'AI systems & marketing', blurb: 'What the pitch deck means, what to measure, and what ICS’s own systems are called.', href: '/ai-services/' },
  intel: { name: 'Intelligence & research', blurb: 'The public records, the methods, the analytic standards, and the lines that are never crossed.', href: '/intelligence/' },
} as const;

const byCat = (c: keyof typeof CATS) => terms.filter((t) => t.data.category === c);
const letters = Array.from(new Set(terms.map((t) => t.data.term[0].toUpperCase()))).sort();

const title = `The ICS Glossary — ${terms.length} terms from the deal, the pitch, and the file | Innovative Commercial Strategies`;
const description = `${terms.length} plain-English definitions of the words South Shore business owners hear in a commercial lease, an AI marketing pitch, and a due diligence brief, each with why it matters locally and two straight answers. From cap rate to speed to lead to source grading.`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'DefinedTermSet',
    '@id': `${SITE.url}/glossary/#set`,
    name: 'The ICS Glossary',
    description,
    url: `${SITE.url}/glossary/`,
    hasDefinedTerm: terms.map((t) => ({
      '@type': 'DefinedTerm',
      name: t.data.term,
      description: t.data.short,
      url: `${SITE.url}/glossary/${t.id}/`,
    })),
  },
];
---

<Base title={title} description={description} schema={schema}>
  <section class="bg-navy-950">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.25em] text-brass-300">The glossary · {terms.length} terms · Plain English</p>
      <h1 class="reveal mt-4 max-w-3xl text-4xl font-bold leading-tight text-white sm:text-5xl" style="--reveal-delay: 100ms">
        Every word they use on you, defined.
      </h1>
      <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-navy-100/90" style="--reveal-delay: 200ms">
        The lease, the lender, the agency pitch, the research file. Each term gets a definition, the reason it matters on
        the South Shore, and two straight answers. Ask any of them in the search box and the answer comes back.
      </p>
      <p class="reveal mt-6 flex flex-wrap gap-1.5" style="--reveal-delay: 300ms">
        {letters.map((l) => (
          <a href={`#letter-${l}`} class="rounded border border-white/15 px-2 py-0.5 font-mono text-xs font-semibold text-navy-100/80 hover:border-teal-400 hover:text-teal-400">{l}</a>
        ))}
      </p>
    </div>
  </section>

  <section class="border-b border-navy-100 bg-paper">
    <div class="mx-auto grid max-w-6xl gap-px overflow-hidden px-4 py-5 sm:grid-cols-3 sm:px-6">
      {
        (Object.keys(CATS) as (keyof typeof CATS)[]).map((c) => (
          <a href={`#${c}`} class="group flex flex-col px-4 py-3 transition-colors hover:bg-white sm:border-l sm:border-navy-100 sm:first:border-l-0">
            <p class="font-mono text-[11px] font-bold uppercase tracking-widest text-brass-600">{CATS[c].name} · {byCat(c).length}</p>
            <p class="mt-1 flex-1 text-sm leading-snug text-ink-500">{CATS[c].blurb}</p>
            <p class="mt-2 text-sm font-semibold text-teal-600 group-hover:text-teal-700">Jump to the terms →</p>
          </a>
        ))
      }
    </div>
  </section>

  {
    (Object.keys(CATS) as (keyof typeof CATS)[]).map((c) => (
      <section id={c} class="mx-auto max-w-6xl scroll-mt-24 px-4 py-14 sm:px-6">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="font-mono text-xs font-semibold uppercase tracking-[0.25em] text-teal-600">{CATS[c].name}</p>
            <h2 class="mt-2 font-display text-3xl font-bold text-navy-900">{byCat(c).length} terms</h2>
          </div>
          <a href={CATS[c].href} class="text-sm font-semibold text-teal-600 hover:text-teal-700">The practice page →</a>
        </div>
        <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {byCat(c).map((t) => (
            <li id={`letter-${t.data.term[0].toUpperCase()}`} class="scroll-mt-24">
              <a href={`/glossary/${t.id}/`} class="lift group flex h-full flex-col rounded-xl border border-navy-100 bg-white p-5 shadow-sm">
                <p class="font-display text-base font-bold leading-snug text-navy-900 group-hover:text-teal-600">{t.data.term}</p>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-500">{t.data.short}</p>
                {t.data.tool && <p class="mt-3 text-xs font-semibold text-brass-600">Tool: {t.data.tool.label}</p>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <FounderCard
    heading="Written by the person who uses these words for a living"
    line="One licensed advisor who negotiates the buildings, builds the systems, and runs the research. If a term here is not clear, ask it in the search box or call."
  />
  <CtaSection heading="Hearing one of these in a deal right now?" body="Call before you sign. A straight read on the term, the clause, or the pitch, usually in one conversation." />
</Base>
