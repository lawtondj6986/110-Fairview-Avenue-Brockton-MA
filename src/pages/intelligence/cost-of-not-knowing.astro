---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config';

const title = 'The Cost of Not Knowing — Due-Diligence Calculator | ICS';
const description =
  'Before you sign: what does NOT knowing actually cost? A free, no-email calculator that weighs the amount at stake against the odds something material is hiding in the public record — and compares it to the price of a brief. Planning math, honestly labeled.';
---

<Base title={title} description={description}>
  <section class="bg-navy-950">
    <div class="mx-auto max-w-4xl px-4 py-12 text-center sm:px-6 sm:py-16">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.25em] text-brass-300">Free · 1 minute · No email</p>
      <h1 class="reveal mx-auto mt-4 max-w-2xl text-4xl font-bold leading-tight text-white sm:text-5xl" style="--reveal-delay: 100ms">
        What is <span class="text-brass-300">not</span> knowing worth?
      </h1>
      <p class="reveal mx-auto mt-4 max-w-xl text-lg leading-relaxed text-navy-100/90" style="--reveal-delay: 200ms">
        Most deals are clean. This is the math on the ones that aren't — and why a brief is insurance, not paranoia.
        Your numbers, your assumptions, nothing sent anywhere.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <div id="cnk" class="rounded-2xl border border-navy-100 bg-navy-950 p-6 shadow-2xl sm:p-8">
      <div class="grid gap-6 lg:grid-cols-5">
        <div class="lg:col-span-2">
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-brass-300">Your situation</p>
          <h2 class="mt-2 text-2xl font-bold text-white">The decision in front of you</h2>
          <div class="mt-5 grid gap-4">
            <div>
              <label for="cnk-amount" class="cnk-label">Amount at stake ($)</label>
              <input id="cnk-amount" type="number" min="0" step="25000" value="500000" class="cnk-input" />
              <p class="mt-1 text-[11px] text-navy-100/50">Purchase price, loan, contract value, or what you'd lose if it goes wrong.</p>
            </div>
            <div>
              <label for="cnk-known" class="cnk-label">How well do you actually know the other side / the asset?</label>
              <select id="cnk-known" class="cnk-input">
                <option value="0.05">Thoroughly — long relationship, verified history</option>
                <option value="0.15" selected>Reasonably — some homework done</option>
                <option value="0.30">Barely — mostly their word and a handshake</option>
              </select>
            </div>
            <div>
              <label for="cnk-sev" class="cnk-label">If a material problem surfaced after you committed, the hit would be</label>
              <select id="cnk-sev" class="cnk-input">
                <option value="0.10">A haircut — ~10% of the amount</option>
                <option value="0.30" selected>Serious — ~30%</option>
                <option value="0.60">Deal-breaking — ~60%+</option>
              </select>
            </div>
          </div>
        </div>

        <div class="flex flex-col justify-between rounded-xl border border-brass-500/40 bg-navy-900 p-6 lg:col-span-3">
          <div>
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-navy-100/60">Expected exposure</p>
            <p id="cnk-total" class="mt-2 font-display text-5xl font-bold text-brass-300 sm:text-6xl">$0</p>
            <div id="cnk-lines" class="mt-5 space-y-2 border-t border-white/10 pt-4 font-mono text-xs text-navy-100/80"></div>
            <p id="cnk-pitch" class="mt-5 text-sm font-semibold leading-relaxed text-white"></p>
          </div>
          <div class="mt-6">
            <p class="text-[11px] leading-relaxed text-navy-100/50">
              Planning math from your inputs: Exposure = amount × residual-unknown odds × downside severity. The
              "residual" reflects how much you don't yet know — exactly what a public-record brief is built to close.
              Most engagements confirm you're clear, which is worth knowing too.
            </p>
            <div class="mt-4 flex flex-wrap gap-3">
              <a href="/intelligence/" class="rounded-md bg-brass-500 px-5 py-2.5 text-sm font-semibold text-navy-950 transition-colors hover:bg-brass-300">
                Request a Brief →
              </a>
              <a href="/intelligence/dossier/" class="rounded-md border border-white/25 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-brass-300 hover:text-brass-300">
                The Deep Dossier
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <p class="mt-6 text-center text-xs text-ink-500">
      For the business decision behind the number — property, counterparty, competitive —
      <a href="/intelligence/" class="font-semibold text-teal-600 hover:text-teal-500">see the intelligence practice →</a>
    </p>
  </section>
</Base>

<style>
  .cnk-input {
    width: 100%;
    border-radius: 0.375rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: #0b1f3a;
    color: #f8fafc;
    padding: 0.55rem 0.75rem;
    font-size: 0.875rem;
  }
  .cnk-input:focus {
    outline: none;
    border-color: #c9a227;
    box-shadow: 0 0 0 2px rgba(201, 162, 39, 0.25);
  }
  .cnk-label {
    display: block;
    margin-bottom: 0.3rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(219, 228, 240, 0.8);
  }
</style>

<script>
  function initCNK() {
    const root = document.getElementById('cnk');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const $ = (id) => document.getElementById(id);
    const fmt = (n) => '$' + Math.round(n).toLocaleString('en-US');

    function update() {
      const amount = Math.max(0, +$('cnk-amount').value || 0);
      const residual = parseFloat($('cnk-known').value);
      const sev = parseFloat($('cnk-sev').value);
      const exposure = amount * residual * sev;

      $('cnk-total').textContent = fmt(exposure);
      $('cnk-lines').innerHTML =
        `<div class="flex justify-between gap-3"><span class="text-navy-100/60">Amount at stake</span><span>${fmt(amount)}</span></div>` +
        `<div class="flex justify-between gap-3"><span class="text-navy-100/60">Residual unknown</span><span>${Math.round(residual * 100)}%</span></div>` +
        `<div class="flex justify-between gap-3"><span class="text-navy-100/60">Downside if it surfaces</span><span>${Math.round(sev * 100)}%</span></div>`;

      $('cnk-pitch').textContent =
        exposure > 50000
          ? `A public-record brief costs a small fraction of ${fmt(exposure)} — and if it comes back clean, you sign with proof instead of hope.`
          : exposure > 0
            ? `Even here, a brief is cheap certainty — and on a deal you know this well, confirming it is the point.`
            : 'Enter the amount at stake to see the exposure.';
    }
    ['cnk-amount', 'cnk-known', 'cnk-sev'].forEach((id) => $(id).addEventListener('input', update));
    update();
  }
  document.addEventListener('astro:page-load', initCNK);
</script>
