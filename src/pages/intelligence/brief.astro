---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config';

const title = 'The Intelligence Practice — Confidential Capabilities Brief | ICS';
const description =
  'A one-page confidential capabilities brief for the ICS intelligence practice: the four desks and their price bands, the analytic standards the work is held to, the lines it will not cross, the proof to check, and how to start — a single link to send, or print and hand across the table.';

const desks = [
  {
    name: 'Commercial Intelligence',
    price: 'Scoped to the question — a focused, written engagement',
    body: 'Counterparty and vendor diligence, property and title research, competitive intelligence, and digital-exposure checks — delivered as a sourced, confidential brief you can act on and defend.',
    href: '/intelligence/',
  },
  {
    name: 'The Deep Dossier',
    price: 'Premier tier — scoped privately, in writing',
    body: 'The institutional-grade file: full public-record aggregation, beneficial-ownership mapping, sanctions and PEP screening, financial exposure from the public record, web-archive forensics, and image provenance — BLUF-briefed, every source graded.',
    href: '/intelligence/dossier/',
  },
  {
    name: 'Political Research',
    price: 'Vulnerability audits $3,500–$7,500 · opposition books $7,500–$15,000',
    body: 'Public-record research for races that intend to win — vulnerability audits, sourced opposition books, rapid-response desks, and ballot-question landscapes — under a published methods code, one client per race.',
    href: '/political/',
  },
  {
    name: 'Discretion & Confidentiality',
    price: 'The trust layer — confidential both directions',
    body: 'Need-to-know handling by one accountable person, conflict walls with one-side-only representation, secure delivery, and nothing retained beyond the engagement. The subject never learns we looked; nobody learns you asked.',
    href: '/confidential/',
  },
];

const standards = [
  ['Sourced and graded', 'Every finding carries a source grade on the A–F / 1–6 reliability-and-credibility scale. You see not just what we found, but how much weight it can bear.'],
  ['Confidence, stated', 'Each conclusion is rated high, moderate, or low. A maybe is labeled a maybe — we never dress a guess as a fact.'],
  ['Hypotheses tested', 'The damaging explanation is tested against the innocent one, and the file states which the evidence actually supports — and how strongly.'],
  ['Fact vs. assessment', 'The record is one column; our analysis is another, clearly marked. You always know where the document ends and our judgment begins.'],
];

const lines = [
  'Public and business capacity only — officials, organizations, and the principals behind a transaction. Not private individuals’ personal lives.',
  'Public records and lawful, open-source methods only — no surveillance, no device access, no location tracking.',
  'No private banking or financial records, ever — no pretexting, no impersonation, no misuse of credentialed databases.',
  'No consumer reports — nothing for hiring, tenant-screening, or credit decisions governed by the FCRA.',
  'Every claim footnoted to a pullable source — if the record can’t carry it, it isn’t in the file.',
];

const proof = [
  ['A sample Deep Dossier', 'Fully fictional — BLUF, ownership map, graded sources, a worked competing-hypotheses finding.', '/intelligence/dossier/sample/'],
  ['A sample opposition book', 'Fully fictional — findings, footnotes, and a usability rating on every item.', '/political/sample/'],
  ['The due-diligence checklist', 'Free and printable — the public-record items to verify before you sign anything.', '/intelligence/due-diligence-checklist/'],
  ['The 60-second scoper', 'Not sure which desk? Three questions, no email, an indicative price band.', '/intelligence/scope/'],
];
---

<Base title={title} description={description}>
  <!-- BRIEF HEADER -->
  <section class="bg-navy-950 print:bg-white">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 sm:py-16 print:py-6">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brass-300 print:text-navy-900">Confidential capabilities brief · The intelligence practice</p>
        <button
          id="print-brief"
          class="rounded-md border border-white/25 px-4 py-2 text-sm font-semibold text-white transition-colors hover:border-brass-300 hover:text-brass-300 print:hidden"
        >
          Print / Save as PDF
        </button>
      </div>
      <h1 class="mt-5 text-4xl font-bold leading-tight text-white sm:text-5xl print:text-navy-900">
        Know before you sign.
      </h1>
      <p class="mt-3 max-w-2xl text-xl font-semibold text-brass-300 print:text-brass-600">
        Public-record intelligence for decisions that can’t be un-made.
      </p>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-navy-100/90 print:text-ink-700">
        Most expensive mistakes were knowable — the information was public, sitting in registries, dockets, and
        filings, waiting for someone relentless enough to assemble all of it. This is that practice: we read to the
        bottom of the lawful record, grade what we find, and put it in writing. Quietly. One page here; the full site
        at <span class="font-semibold text-brass-300 print:text-navy-900">icsgroup.ai/intelligence</span>.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6 print:py-4">
    <!-- THE DESKS -->
    <h2 class="text-2xl font-bold text-navy-900">The desks, and what they cost</h2>
    <p class="mt-1 text-sm text-ink-500">Published price bands where the work is standardized; a written scope for everything bespoke — always before you commit a dollar.</p>
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {
        desks.map((d, i) => (
          <a href={d.href} class="reveal lift block rounded-xl border border-navy-100 bg-white p-6 shadow-sm print:border-navy-100 print:shadow-none" style={`--reveal-delay: ${(i % 2) * 70}ms`}>
            <h3 class="font-display text-lg font-bold text-navy-900">{d.name}</h3>
            <p class="mt-1 font-mono text-xs font-semibold text-brass-600">{d.price}</p>
            <p class="mt-2 text-sm leading-relaxed text-ink-500">{d.body}</p>
          </a>
        ))
      }
    </div>

    <!-- THE STANDARDS -->
    <h2 class="mt-12 text-2xl font-bold text-navy-900 print:mt-6">How the work is done</h2>
    <p class="mt-1 text-sm text-ink-500">A pile of records is not a dossier. The craft is in the discipline applied to every finding — the standards professional intelligence work is held to, applied to lawful open sources.</p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        standards.map(([h, b]) => (
          <div class="reveal flex gap-3">
            <span class="mt-0.5 font-mono text-sm font-bold text-teal-600">▲</span>
            <p class="text-sm leading-relaxed text-ink-700">
              <strong class="text-navy-900">{h}.</strong> {b}
            </p>
          </div>
        ))
      }
    </div>

    <!-- THE LINES -->
    <div class="mt-12 rounded-xl border border-navy-100 bg-paper p-6 print:mt-6 print:bg-white">
      <h2 class="text-2xl font-bold text-navy-900">The lines — published on purpose</h2>
      <p class="mt-1 text-sm text-ink-500">The capabilities are powerful precisely because they stay inside the law. A file gathered cleanly can be used anywhere — in a negotiation, in front of counsel, in a boardroom. That is the whole point of doing it right.</p>
      <ul class="mt-4 space-y-2.5">
        {
          lines.map((l) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 shrink-0 font-mono text-sm font-bold text-teal-600">✓</span>
              <p class="text-sm leading-relaxed text-ink-700">{l}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- PROOF -->
    <h2 class="mt-12 text-2xl font-bold text-navy-900 print:mt-6">See the standard</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        proof.map(([h, b, href]) => (
          <a href={href} class="reveal block rounded-lg border border-navy-100 bg-white p-5 shadow-sm transition-colors hover:border-brass-400 print:shadow-none">
            <p class="font-display text-base font-bold text-navy-900">{h} <span class="text-brass-600">→</span></p>
            <p class="mt-1 text-sm leading-relaxed text-ink-500">{b}</p>
            <p class="mt-1.5 font-mono text-[11px] text-ink-500 print:block">icsgroup.ai{href}</p>
          </a>
        ))
      }
    </div>

    <!-- HOW TO START -->
    <div class="mt-12 grid gap-6 lg:grid-cols-[1.4fr_1fr] print:mt-6">
      <div class="reveal rounded-xl bg-navy-900 p-7 print:border print:border-navy-100 print:bg-white">
        <h2 class="text-xl font-bold text-white print:text-navy-900">How to start — confidentially</h2>
        <p class="mt-3 text-sm leading-relaxed text-navy-100/85 print:text-ink-700">
          Tell us the subject and the decision riding on it. We’ll tell you what the lawful record can deliver, what
          it can’t, and what it would cost — in writing, before you commit a dollar. The conversation itself is
          confidential; the subject never learns you asked.
        </p>
        <div class="mt-4 space-y-1 text-sm font-semibold">
          <p><a href={`mailto:${SITE.email}?subject=${encodeURIComponent('Intelligence practice — confidential inquiry')}`} class="text-brass-300 hover:text-brass-200 print:text-navy-900">{SITE.email}</a></p>
          <p><a href={`tel:${SITE.phone.replace(/[^\d+]/g, '')}`} class="text-brass-300 hover:text-brass-200 print:text-navy-900">{SITE.phone}</a> · {SITE.founder}, founder</p>
          <p class="pt-1"><a href="/intelligence/scope/" class="text-teal-400 hover:text-teal-300 print:text-navy-900">Scope it in 60 seconds: icsgroup.ai/intelligence/scope →</a></p>
        </div>
      </div>
      <div class="reveal rounded-xl border border-brass-300 bg-white p-6 text-center" style="--reveal-delay: 80ms">
        <p class="font-display text-sm font-bold text-navy-900">Save the founder to your phone</p>
        <img src="/images/card-qr.png" alt="QR code — scan to open the ICS digital card" width="140" height="140" class="mx-auto mt-3 h-36 w-36" loading="lazy" />
        <p class="mt-3 text-xs leading-relaxed text-ink-500">
          Scan to open the digital card — one tap to call, text, or save {SITE.founder} to your contacts.
        </p>
        <a href="/card/" class="mt-2 inline-block text-xs font-semibold text-brass-600 hover:text-brass-500 print:hidden">icsgroup.ai/card →</a>
      </div>
    </div>

    <p class="mt-10 text-xs leading-relaxed text-ink-500 print:mt-6">
      {SITE.license}. ICS conducts open-source research from public records and lawful methods. We are not attorneys
      and nothing here is legal advice; we do not provide consumer reports under the FCRA. This brief is an
      introduction to the practice — every engagement proceeds under a written scope. Full practice:
      <span class="font-semibold text-teal-600">icsgroup.ai/intelligence</span>.
    </p>
  </section>
</Base>

<style>
  @media print {
    :global(header),
    :global(footer),
    :global(#money-bar) {
      display: none !important;
    }
    :global(body) {
      background: white !important;
    }
    :global(.reveal) {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  function initBrief() {
    const btn = document.getElementById('print-brief');
    if (!btn || btn.dataset.ready) return;
    btn.dataset.ready = '1';
    btn.addEventListener('click', () => window.print());
  }
  document.addEventListener('astro:page-load', initBrief);
</script>
