---
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { SITE } from '../../config';

const title = 'The Deep Dossier — Premier Intelligence Tier | ICS';
const description =
  'Institutional-grade due-diligence dossiers on public figures, officials, organizations, and the principals behind a deal: full public-record aggregation, beneficial-ownership mapping, sanctions and PEP screening, financial-exposure analysis from the public record, digital and web-archive forensics, and image provenance. Public sources, lawful methods, every finding sourced.';

const capabilities = [
  {
    name: 'Full public-record aggregation',
    body: 'Corporate registrations, civil and criminal dockets, property and tax records, UCC filings, judgments, liens, bankruptcies, and regulatory actions — pulled across every state and county where the subject or entity has operated, not just the convenient ones.',
  },
  {
    name: 'Beneficial-ownership & entity mapping',
    body: 'The web behind the name: LLCs, holding companies, officers, registered agents, and related parties, drawn as a network you can read at a glance. The shell three entities deep that actually holds the asset — surfaced and diagrammed.',
  },
  {
    name: 'Sanctions, PEP & watchlist screening',
    body: 'The screen institutions run before they wire a dollar: OFAC and consolidated sanctions lists, politically-exposed-person databases, debarment and exclusion lists, and adverse-media review. Standard for banks; rare for the deals that actually need it.',
  },
  {
    name: 'Financial exposure, from the public record',
    body: 'Not private banking — the lawful signals of solvency and obligation: judgments, tax liens, UCC secured positions, bankruptcies, regulatory and securities filings, corporate financials where published, and property encumbrances. What a balance sheet would hint at, assembled from records anyone can lawfully pull.',
  },
  {
    name: 'Digital footprint & web-archive forensics',
    body: 'The subject’s public trail across time: affiliations, statements, and positions — including pages deleted years ago but preserved in public web archives, clipped and timestamped. Contradictions don’t disappear; they get archived.',
  },
  {
    name: 'Image verification & provenance',
    body: 'Forensic method on public images: reverse-image tracing to find every place a photo appears, metadata and geolocation analysis of publicly posted images, and authenticity assessment for signs of manipulation. Is the image real, when and where was it taken, and where else has it surfaced.',
  },
];

const exclusions = [
  'Public and business capacity only — we build dossiers on public figures, officials, organizations, and the principals behind a transaction. Not private individuals’ personal lives.',
  'No private financial or banking records, ever — those are obtainable only with consent or legal process, and we never pretext, impersonate, or misuse credentialed databases to reach them.',
  'No surveillance, hacking, device access, or location tracking — the methods are open-source and lawful, full stop.',
  'No consumer reports — we do not produce dossiers for hiring, tenant-screening, or credit decisions governed by the FCRA. Those are regulated instruments and belong with licensed providers.',
  'Every finding sourced and confidence-rated — if the record can’t carry it, it isn’t in the dossier.',
];
---

<Base title={title} description={description}>
  <section class="bg-navy-950">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.25em] text-brass-300">Premier tier · The intelligence practice</p>
      <h1 class="reveal mt-4 max-w-3xl text-4xl font-bold leading-tight text-white sm:text-5xl" style="--reveal-delay: 100ms">
        The Deep Dossier.
      </h1>
      <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-navy-100/90" style="--reveal-delay: 200ms">
        When the decision is large enough that "we looked them up" isn’t enough, this is the institutional-grade
        file: every lawful record, the ownership web behind the name, the financial exposure the public record
        reveals, and the digital trail across time — assembled with the discipline a bank uses before it wires the
        money. On public figures, officials, organizations, and the people behind your deal.
      </p>
      <p class="reveal mt-4 max-w-2xl text-base leading-relaxed text-brass-200/90" style="--reveal-delay: 260ms">
        Built to the analytic standards professional intelligence work is held to: every source graded, every
        finding rated for confidence, every conclusion tested against the innocent explanation before it reaches you.
      </p>
      <p class="reveal mt-4 max-w-2xl text-sm font-semibold uppercase tracking-wide text-navy-100/70" style="--reveal-delay: 320ms">
        No padding. No guesswork dressed as fact. No finding we can't put a source and a confidence level behind.
      </p>
      <div class="reveal mt-8 flex flex-wrap gap-4" style="--reveal-delay: 300ms">
        <a href={`mailto:${SITE.email}?subject=${encodeURIComponent('Deep Dossier — confidential inquiry')}`} class="rounded-md bg-brass-500 px-6 py-3 font-semibold text-navy-950 transition-colors hover:bg-brass-300">
          Request a Confidential Scope
        </a>
        <a href="/intelligence/" class="rounded-md border border-white/25 px-6 py-3 font-semibold text-white transition-colors hover:border-brass-300 hover:text-brass-300">
          The Full Practice
        </a>
      </div>
      <p class="reveal mt-6 text-xs text-navy-100/50" style="--reveal-delay: 380ms">
        Scoped privately · written scope before any commitment · confidential both directions
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <SectionHeading
      eyebrow="The capability stack"
      heading="Six disciplines, one file"
      body="Each is a professional capability in its own right. The dossier runs all six against the same subject and reconciles them into one sourced, confidence-rated document."
      align="center"
    />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        capabilities.map((c, i) => (
          <div class="reveal lift flex flex-col rounded-xl border border-navy-100 bg-white p-7 shadow-sm" style={`--reveal-delay: ${(i % 3) * 60}ms`}>
            <p class="font-mono text-xs font-bold text-teal-600">{String(i + 1).padStart(2, '0')}</p>
            <h2 class="mt-1 text-lg font-bold text-navy-900">{c.name}</h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-500">{c.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- THE TRADECRAFT -->
  <section class="bg-paper">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <SectionHeading
        eyebrow="The tradecraft"
        heading="Anyone can gather. The craft is in the grading."
        body="A pile of records is not a dossier. What separates professional intelligence work from a search-engine dump is the discipline applied to every finding — the same analytic standards used across intelligence and investigative work, applied here to lawful open sources."
        align="center"
      />
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          [
            ['Source reliability grading', 'Every source carries a grade on the A–F / 1–6 reliability-and-credibility scale used across professional intelligence and law enforcement — reliability of the source, credibility of the information, scored separately — and the grade travels with the finding. You see not just what we found, but exactly how much weight it can bear.'],
            ['Confidence levels, stated', 'Each conclusion carries an explicit confidence level — high, moderate, or low — the way recognized analytic standards require. A "maybe" is labeled a maybe. We never dress a guess as a fact, because the one that blows up is always the one that was overstated.'],
            ['Competing hypotheses', 'The core discipline of the craft: we test the damaging explanation against the innocent one, and the file states which the evidence actually supports — and how strongly. It’s what keeps a dossier from becoming a story hunting for facts to fit it.'],
            ['Fact separated from assessment', 'The record is one column; our analysis is another, clearly marked. You always know where the document ends and our judgment begins — so you can weigh both, and defend both.'],
            ['Key assumptions, surfaced', 'We state the assumptions the assessment rests on and name exactly what would change the conclusion. The gaps are flagged, not hidden — a finding is only as strong as what holds it up.'],
            ['Secure handling', 'Need-to-know distribution, confidential delivery, and no retention of the working file beyond the engagement. The subject never learns we looked; the fact that you asked is itself protected.'],
          ].map(([h, b], i) => (
            <div class="reveal flex flex-col rounded-xl border border-navy-100 bg-white p-6 shadow-sm" style={`--reveal-delay: ${(i % 3) * 60}ms`}>
              <h3 class="font-display text-base font-bold text-navy-900">{h}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-500">{b}</p>
            </div>
          ))
        }
      </div>
      <p class="mx-auto mt-8 max-w-2xl text-center text-sm leading-relaxed text-ink-500">
        The point of the method isn’t ceremony. It’s that a finding graded, rated, and tested survives the one
        moment that matters: when someone on the other side tries to tear it apart.
      </p>
    </div>
  </section>

  <!-- THE LINES -->
  <section class="bg-navy-900">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
      <SectionHeading
        eyebrow="The lines — published on purpose"
        heading="Premier doesn’t mean lawless. It means thorough."
        body="The capabilities above are powerful precisely because they stay inside the law. Here is exactly where the work stops — and why those limits are what make a dossier you can actually act on."
        align="center"
        dark
      />
      <ul class="mt-10 space-y-4">
        {
          exclusions.map((x) => (
            <li class="reveal flex items-start gap-3 rounded-xl border border-white/10 bg-navy-950 p-5">
              <span class="mt-0.5 shrink-0 font-mono text-sm font-bold text-teal-400">✓</span>
              <p class="text-sm leading-relaxed text-navy-100/85">{x}</p>
            </li>
          ))
        }
      </ul>
      <p class="mx-auto mt-8 max-w-2xl text-center text-sm font-semibold text-navy-100/70">
        A dossier that was gathered cleanly can be used anywhere — in a negotiation, in front of counsel, in a
        boardroom. That’s the whole point of doing it right.
      </p>
    </div>
  </section>

  <!-- DELIVERABLE + CTA -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="grid items-start gap-10 lg:grid-cols-2">
      <div class="reveal">
        <SectionHeading
          eyebrow="The deliverable"
          heading="What arrives"
          body="Not a data dump you have to interpret under deadline. A finished product, written to be read once and acted on — and to hold when the other side comes at it."
        />
        <ul class="mt-6 space-y-3 text-sm leading-relaxed text-ink-700">
          <li class="flex gap-3"><span class="mt-0.5 text-brass-600">◆</span> A BLUF executive summary — bottom line up front: the three things that decide it, before a single supporting page.</li>
          <li class="flex gap-3"><span class="mt-0.5 text-brass-600">◆</span> The beneficial-ownership network, diagrammed.</li>
          <li class="flex gap-3"><span class="mt-0.5 text-brass-600">◆</span> Findings in priority order, each footnoted to a pullable source and rated for confidence.</li>
          <li class="flex gap-3"><span class="mt-0.5 text-brass-600">◆</span> Source exhibits and a methods note — so the file holds up when someone checks it.</li>
          <li class="flex gap-3"><span class="mt-0.5 text-brass-600">◆</span> Delivered confidentially and walked through with you personally.</li>
        </ul>
        <p class="mt-6 text-sm leading-relaxed text-ink-500">
          For the political application of this same discipline — candidates, committees, and ballot campaigns — see
          the <a href="/political/" class="font-semibold text-teal-600 hover:text-teal-700">political research desk</a>.
        </p>
      </div>
      <div class="reveal rounded-xl bg-navy-900 p-8" style="--reveal-delay: 80ms">
        <h3 class="text-xl font-bold text-white">Start with a scope, not a sales pitch</h3>
        <p class="mt-3 text-sm leading-relaxed text-navy-100/85">
          Tell us the subject and the decision riding on it. We’ll tell you what the lawful record can deliver, what
          it can’t, and what the dossier would cost — in writing, before you commit a dollar. Premier engagements are
          scoped privately.
        </p>
        <div class="mt-6 flex flex-col gap-3">
          <a href={`mailto:${SITE.email}?subject=${encodeURIComponent('Deep Dossier — confidential inquiry')}`} class="rounded-md bg-brass-500 px-5 py-3 text-center text-sm font-semibold text-navy-950 transition-colors hover:bg-brass-300">
            Email Privately
          </a>
          <a href={`tel:${SITE.phone.replace(/[^\d+]/g, '')}`} class="rounded-md border border-white/25 px-5 py-3 text-center text-sm font-semibold text-white transition-colors hover:border-brass-300 hover:text-brass-300">
            Call {SITE.founder} — {SITE.phone}
          </a>
        </div>
        <p class="mt-4 text-xs leading-relaxed text-navy-100/50">
          ICS conducts open-source research from public records. We are not attorneys and nothing here is legal
          advice; we do not provide consumer reports under the FCRA.
        </p>
      </div>
    </div>
  </section>
</Base>
