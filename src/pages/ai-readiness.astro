---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaSection from '../components/CtaSection.astro';
import ReadinessScore from '../components/ReadinessScore.astro';
import { SITE } from '../config';

const title = 'Free AI Readiness Score — 10 Questions, 2 Minutes | ICS';
const description =
  'Score your business against the systems benchmark: lead response speed, review velocity, back-office automation, and search visibility. Ten questions, instant score, and a printable 90-day action plan — free, from Innovative Commercial Strategies.';

const dims = [
  ['Lead Response Speed', 'Jobs go to whoever answers first. We score what happens to a lead at 7pm on a Tuesday — and three days after the quote goes quiet.'],
  ['Reviews & Reputation', "Review velocity is the currency of local search and AI recommendations. We score how many you're earning and whether anyone actually asks."],
  ['Back-Office Automation', 'Quoting, invoicing, scheduling — where owners bleed 15–25 hours a month. We score how much of it runs without you.'],
  ['Search & AI Visibility', "Where you rank when your town searches your service — and whether AI assistants can even find you to recommend you."],
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'AI Readiness Score',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    provider: { '@type': 'Organization', name: SITE.name },
    description,
  },
];
---

<Base title={title} description={description} schema={schema}>
  <section class="bg-navy-900">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.25em] text-teal-400">Free assessment</p>
      <h1 class="reveal mt-4 max-w-3xl text-4xl font-bold leading-tight text-white sm:text-5xl" style="--reveal-delay: 100ms">
        Find out exactly where your business leaks revenue.
      </h1>
      <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-navy-100/90" style="--reveal-delay: 200ms">
        Ten questions score you against the systems benchmark — the response speed, review velocity, automation, and
        visibility that the best-run businesses in your market already have. Instant score, printable 90-day plan.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="reveal">
      <ReadinessScore />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <SectionHeading eyebrow="What we score" heading="Four dimensions. One honest number." align="center" />
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        dims.map(([name, body], i) => (
          <div class="reveal lift rounded-xl border border-navy-100 bg-white p-6 shadow-sm" style={`--reveal-delay: ${i * 60}ms`}>
            <h3 class="text-lg font-bold text-navy-900">{name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-500">{body}</p>
          </div>
        ))
      }
    </div>
    <p class="mx-auto mt-8 max-w-2xl text-center text-sm text-ink-500">
      This is the same assessment that opens every <strong class="text-navy-900">Operator Session</strong> and every
      "AI for Main Street" <a href="/workshops/" class="font-semibold text-teal-600 hover:text-teal-500">workshop</a> —
      the difference is that in person, we build the fix list with you on a whiteboard.
    </p>
  </section>

  <CtaSection
    heading="Scored lower than you'd like?"
    body="Good — that's fixable, fast, and measurable. Book the call and we'll turn your three weakest categories into a system with a written 90-day target."
    primaryLabel="Book a Free Strategy Call"
    secondaryLabel="See Published Pricing"
    secondaryHref="/pricing/"
  />
</Base>
