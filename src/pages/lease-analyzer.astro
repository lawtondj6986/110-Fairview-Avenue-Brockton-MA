---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';

const title = 'Lease Deal Analyzer — Net Effective Rent for Landlords and Tenants | ICS';
const description =
  'Free, no-email lease analyzer: turn a face rent, escalations, free months, TI allowance, and commission into what the lease actually costs the tenant and nets the landlord — net effective rent per square foot, total deal value, and the real discount off asking. Your numbers, nothing sent anywhere.';
---

<Base title={title} description={description}>
  <section class="bg-navy-900">
    <div class="mx-auto max-w-4xl px-4 py-12 text-center sm:px-6 sm:py-16">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.25em] text-teal-400">Free · 1 minute · No email</p>
      <h1 class="reveal mx-auto mt-4 max-w-2xl text-4xl font-bold leading-tight text-white sm:text-5xl" style="--reveal-delay: 100ms">
        The face rent is not the rent.
      </h1>
      <p class="reveal mx-auto mt-4 max-w-xl text-lg leading-relaxed text-navy-100/90" style="--reveal-delay: 200ms">
        Free months, a TI allowance, annual bumps, and a commission turn "$18 a foot" into two different numbers —
        one for the tenant, one for the landlord. This shows both. Your figures, nothing sent anywhere.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <div id="lda" class="rounded-2xl border border-navy-100 bg-white p-6 shadow-lg sm:p-8">
      <div class="grid gap-8 lg:grid-cols-2">
        <div>
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-teal-600">The space and the face rent</p>
          <div class="mt-4 grid gap-3">
            <div class="grid grid-cols-2 gap-3">
              <div><label for="lda-sf" class="lda-label">Rentable area (SF)</label><input id="lda-sf" type="number" min="0" step="250" value="5000" class="lda-input" /></div>
              <div><label for="lda-rent" class="lda-label">Base rent ($/SF/yr)</label><input id="lda-rent" type="number" min="0" step="0.5" value="18" class="lda-input" /></div>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div><label for="lda-esc" class="lda-label">Annual escalation (%)</label><input id="lda-esc" type="number" min="0" step="0.5" value="3" class="lda-input" /></div>
              <div><label for="lda-term" class="lda-label">Term (years)</label><input id="lda-term" type="number" min="1" step="1" value="5" class="lda-input" /></div>
            </div>
          </div>

          <p class="mt-6 font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-teal-600">The concessions</p>
          <div class="mt-4 grid grid-cols-2 gap-3">
            <div><label for="lda-free" class="lda-label">Free rent (months)</label><input id="lda-free" type="number" min="0" step="1" value="3" class="lda-input" /></div>
            <div><label for="lda-ti" class="lda-label">TI allowance ($/SF)</label><input id="lda-ti" type="number" min="0" step="1" value="20" class="lda-input" /></div>
          </div>

          <p class="mt-6 font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-teal-600">The landlord's cost of the deal</p>
          <div class="mt-4"><label for="lda-comm" class="lda-label">Leasing commission (% of total base rent)</label><input id="lda-comm" type="number" min="0" step="0.5" value="5" class="lda-input" /></div>
        </div>

        <div class="flex flex-col justify-between rounded-xl border border-teal-500/40 bg-navy-950 p-6">
          <div>
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-navy-100/60">Net effective rent — what the tenant really pays</p>
            <p id="lda-ner" class="mt-2 font-display text-4xl font-bold text-teal-400">—</p>
            <p id="lda-disc" class="mt-1 text-sm font-semibold text-white"></p>
            <div id="lda-lines" class="mt-5 space-y-2 border-t border-white/10 pt-4 font-mono text-xs text-navy-100/80"></div>
          </div>
          <div class="mt-6">
            <p class="text-[11px] leading-relaxed text-navy-100/70">
              Planning estimate, undiscounted (no time value of money). Base rent only — NNN expenses, utilities, and
              operating pass-throughs are additional for the tenant and separate for the landlord. Free rent is valued
              at year-one rent. We model the actual proposal on a call.
            </p>
            <div class="mt-4 flex flex-wrap gap-3">
              <a id="lda-cta" href="/contact/" class="rounded-md bg-teal-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-teal-500">
                Bring This Number to Us →
              </a>
              <a href="/lease-vs-buy/" class="rounded-md border border-white/25 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-teal-400 hover:text-teal-400">
                Should You Buy Instead?
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-3 print:hidden">
      <button id="lda-share" type="button" class="rounded-md border border-navy-100 px-4 py-2 text-sm font-semibold text-navy-800 transition-colors hover:border-teal-500 hover:text-teal-600">
        Copy a shareable link
      </button>
      <button id="lda-print" type="button" class="rounded-md border border-navy-100 px-4 py-2 text-sm font-semibold text-navy-800 transition-colors hover:border-teal-500 hover:text-teal-600">
        Print / Save as PDF
      </button>
      <span id="lda-copied" class="hidden text-sm font-semibold text-teal-600">Link copied — send it across the table ✓</span>
    </div>

    <p class="mt-6 text-center text-xs text-ink-500 print:hidden">
      We represent both sides of the lease — never in the same deal. <a href="/commercial-real-estate/" class="font-semibold text-teal-600 hover:text-teal-500">Tenant and landlord representation →</a> ·
      <a href="/deal-tools/" class="font-semibold text-teal-600 hover:text-teal-500">Every seat at the table</a>
    </p>
  </section>
</Base>

<style>
  .lda-input {
    width: 100%;
    border-radius: 0.375rem;
    border: 1px solid #dbe4f0;
    background: #fff;
    color: #0b1f3a;
    padding: 0.5rem 0.65rem;
    font-size: 0.875rem;
  }
  .lda-input:focus { outline: none; border-color: #14b8a6; box-shadow: 0 0 0 2px rgba(20,184,166,0.2); }
  .lda-label { display: block; margin-bottom: 0.25rem; font-size: 0.7rem; font-weight: 500; color: #5a6b82; }
  @media print {
    :global(header),
    :global(footer),
    :global(#money-bar) { display: none !important; }
    :global(body) { background: white !important; }
    :global(.reveal) { opacity: 1 !important; transform: none !important; }
    #lda { box-shadow: none; border-color: #dbe4f0; }
  }
</style>

<script>
  function initLDA() {
    const root = document.getElementById('lda');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const num = (id: string) => Math.max(0, +$(id).value || 0);
    const money = (n: number) => (n < 0 ? '-$' : '$') + Math.round(Math.abs(n)).toLocaleString('en-US');
    const psf = (n: number) => '$' + n.toFixed(2) + '/SF/yr';

    const PARAMS: Record<string, string> = {
      'lda-sf': 'sf', 'lda-rent': 'r', 'lda-esc': 'e', 'lda-term': 't', 'lda-free': 'f', 'lda-ti': 'ti', 'lda-comm': 'c',
    };
    const fields = Object.keys(PARAMS);
    try {
      const q = new URLSearchParams(window.location.search);
      fields.forEach((id) => { const v = q.get(PARAMS[id]); if (v !== null && v !== '' && !Number.isNaN(+v)) $(id).value = v; });
    } catch { /* no-op */ }
    function shareUrl() {
      const q = new URLSearchParams();
      fields.forEach((id) => q.set(PARAMS[id], $(id).value));
      return `${window.location.pathname}?${q.toString()}`;
    }
    function syncUrl() {
      try { history.replaceState(null, '', shareUrl()); } catch { /* no-op */ }
    }
    // "Bring your number": the contact CTA carries the scenario and its link into the form.
    function setCta(summary: string) {
      const cta = document.getElementById('lda-cta') as HTMLAnchorElement | null;
      if (!cta) return;
      const message = `${summary}\nScenario link: ${window.location.origin}${shareUrl()}`;
      cta.href = `/contact/?${new URLSearchParams({ interest: 'Selling or leasing my property', message }).toString()}`;
    }

    function update() {
      const sf = num('lda-sf');
      const rent = num('lda-rent');
      const esc = num('lda-esc') / 100;
      const term = Math.max(1, Math.round(num('lda-term')));
      const freeMo = num('lda-free');
      const ti = num('lda-ti');
      const comm = num('lda-comm') / 100;

      // Total base rent over the term with annual escalations.
      let totalBase = 0;
      for (let y = 0; y < term; y++) totalBase += sf * rent * Math.pow(1 + esc, y);
      const year1 = sf * rent;
      const freeValue = year1 * (freeMo / 12);
      const tiTotal = sf * ti;
      const concessions = freeValue + tiTotal;
      const tenantNet = totalBase - concessions;
      const commission = totalBase * comm;
      const landlordNet = tenantNet - commission;

      const nerTenant = sf > 0 ? tenantNet / term / sf : 0;
      const nerLandlord = sf > 0 ? landlordNet / term / sf : 0;
      const avgFace = sf > 0 ? totalBase / term / sf : 0;
      const discount = avgFace > 0 ? (1 - nerTenant / avgFace) * 100 : 0;

      const nerEl = document.getElementById('lda-ner')!;
      const discEl = document.getElementById('lda-disc')!;
      nerEl.textContent = psf(nerTenant);
      if (tenantNet <= 0) {
        nerEl.className = 'mt-2 font-display text-4xl font-bold text-amber-400';
        discEl.textContent = 'Concessions exceed the rent — the landlord is paying the tenant to occupy.';
      } else {
        nerEl.className = 'mt-2 font-display text-4xl font-bold text-teal-400';
        discEl.textContent = `${discount.toFixed(0)}% below the ${psf(avgFace)} average face rent · landlord nets ${psf(nerLandlord)}`;
      }

      const row = (l: string, v: string, strong = false) =>
        `<div class="flex justify-between gap-3${strong ? ' mt-1 border-t border-white/10 pt-2 font-bold text-white' : ''}"><span class="${strong ? '' : 'text-navy-100/60'}">${l}</span><span>${v}</span></div>`;
      document.getElementById('lda-lines')!.innerHTML =
        row('Starting rent (monthly)', money(year1 / 12)) +
        row(`Total base rent, ${term} yrs (with bumps)`, money(totalBase)) +
        row(`Free rent (${freeMo} mo)`, '-' + money(freeValue)) +
        row('TI allowance', '-' + money(tiTotal)) +
        row('Tenant: total net cost', money(tenantNet), true) +
        row('Tenant: net effective rent', psf(nerTenant)) +
        row('Leasing commission', '-' + money(commission)) +
        row('Landlord: net over term', money(landlordNet), true) +
        row('Landlord: net effective rent', psf(nerLandlord));
      setCta(`Lease scenario — ${sf.toLocaleString('en-US')} SF at $${rent}/SF, ${term} yrs, ${freeMo} free months, $${ti}/SF TI: tenant net effective ${psf(nerTenant)}, landlord net effective ${psf(nerLandlord)}, total base rent ${money(totalBase)}.`);
    }

    fields.forEach((id) => $(id).addEventListener('input', () => { update(); syncUrl(); }));
    const copied = document.getElementById('lda-copied');
    document.getElementById('lda-share')?.addEventListener('click', async () => {
      syncUrl();
      try { await navigator.clipboard.writeText(window.location.href); } catch { /* address bar still carries it */ }
      copied?.classList.remove('hidden');
      window.setTimeout(() => copied?.classList.add('hidden'), 3500);
    });
    document.getElementById('lda-print')?.addEventListener('click', () => window.print());
    update();
  }
  document.addEventListener('astro:page-load', initLDA);
</script>
