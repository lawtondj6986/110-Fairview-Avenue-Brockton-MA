---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaSection from '../components/CtaSection.astro';
import { SITE } from '../config';

const title = 'AI Services for Small Business | Launch, Operate & Scale Packages | ICS';
const description =
  'Done-for-you AI systems for South Shore MA businesses: AI-built websites, CRM and follow-up automation, AI receptionists, review engines, AI marketing, SEO and answer-engine optimization. Fixed-scope Launch, Operate, and Scale packages.';

const tiers = [
  {
    name: 'Launch',
    price: '$3,000–$4,500 setup',
    monthly: '+ $250–$400/mo',
    outcome: 'A professional digital presence live in under 30 days, with measurable lead flow.',
    audience: 'For businesses whose online presence doesn’t match the quality of their work — or who just signed a lease on a new location.',
    items: [
      'AI-built website or full rebuild',
      'Google Business Profile optimization',
      'Automated review requests',
      'Basic lead-capture chatbot',
      'Analytics dashboard — see every lead',
    ],
    featured: false,
  },
  {
    name: 'Operate',
    price: '$5,500–$8,000 setup',
    monthly: '+ $650–$1,100/mo',
    outcome: 'Admin time cut 15–25 hours a month; every lead followed up in minutes, not days.',
    audience: 'For businesses winning work but drowning in follow-up, quoting, scheduling, and paperwork.',
    items: [
      'Everything in Launch',
      'CRM implementation + follow-up automation',
      'AI receptionist & booking',
      'Quote & invoice automation',
      'Email/SMS nurture sequences',
    ],
    featured: true,
  },
  {
    name: 'Scale',
    price: '$9,000–$14,000 setup',
    monthly: '+ $1,600–$2,400/mo',
    outcome: 'Operations that support growth without hiring another office person.',
    audience: 'For established businesses ready to systematize — more crews, more locations, more volume, same overhead.',
    items: [
      'Everything in Operate',
      'Custom AI workflows & internal copilots',
      'Document & proposal automation',
      'Integrations: accounting, scheduling, industry tools',
      'Quarterly strategy reviews',
    ],
    featured: false,
  },
];

const marketing = [
  {
    name: 'AI Content Systems',
    price: '$500–$1,500/mo',
    body: 'Always-on content production — posts, email, short-video scripts — tuned to your voice and reviewed before anything ships.',
  },
  {
    name: 'Paid Media with AI Creative',
    price: '$750–$2,000/mo + ad spend',
    body: 'Meta and Google campaigns with AI-generated, continuously tested creative. Management fee, transparent spend.',
  },
  {
    name: 'SEO / AEO',
    price: '$600–$1,500/mo',
    body: 'Be found by Google and recommended by AI assistants. Answer-engine optimization is the pitch almost no local competitor is making yet.',
  },
  {
    name: 'Conversion & Operations Optimization',
    price: '$1,500–$5,000/project',
    body: 'Funnel audits, A/B testing, pricing and margin analytics, process automation. Project-based or as an add-on to Scale.',
  },
];

const faqs = [
  {
    q: 'Do I need to be a real estate client to buy AI services?',
    a: 'No. The AI practice stands on its own — most clients start with a Launch or Operate package with no property transaction involved. The combination is there when you need it.',
  },
  {
    q: 'What do you actually measure?',
    a: 'Every proposal states expected outcomes up front: lead volume, response time, review velocity, hours saved, revenue impact. You get a dashboard, and we review the numbers with you — AI is the tool; measurable business results are the product.',
  },
  {
    q: 'Do I have to learn new software?',
    a: 'No. We build on tools you already use where possible, install and configure everything, and train your team on the handful of things they touch. The point is less work for you, not more.',
  },
  {
    q: 'How fast can we start?',
    a: 'Launch packages typically go live in under 30 days. The first step is a free strategy call and an AI readiness assessment of your current lead flow, follow-up, and online presence.',
  },
  {
    q: 'Is there a long-term contract?',
    a: 'Retainers are month-to-month after an initial term, billed on the 1st. We keep clients by producing numbers, not by locking them in.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Business AI Integration',
    provider: { '@type': 'Organization', name: SITE.name },
    areaServed: 'South Shore, Massachusetts',
    description,
    offers: tiers.map((t) => ({ '@type': 'Offer', name: `${t.name} package`, description: t.outcome })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base title={title} description={description} schema={schema}>
  <section class="bg-navy-900">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-teal-400">AI Systems &amp; Marketing</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-bold leading-tight text-white sm:text-5xl">
        Enterprise-grade AI, packaged for Main Street.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-navy-100/90">
        The national consultancies won't return your call, and the local agencies don't build automation. ICS installs
        practical AI systems — lead capture, follow-up, booking, quoting, reviews — measured in leads, hours saved, and
        revenue.
      </p>
      <a
        href="/contact/"
        class="mt-8 inline-block rounded-md bg-teal-600 px-6 py-3 font-semibold text-white shadow-lg hover:bg-teal-500"
      >
        Get a Free AI Readiness Assessment
      </a>
    </div>
  </section>

  <!-- PACKAGES -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <SectionHeading
      eyebrow="Fixed-scope packages"
      heading="Pick the tier that matches where your business is"
      body="No vague consulting hours. Each package has a defined scope, a defined price band, and a defined outcome — finalized in a written proposal before you commit a dollar."
      align="center"
    />
    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {
        tiers.map((tier) => (
          <div
            class:list={[
              'relative flex flex-col rounded-xl border p-8',
              tier.featured ? 'border-teal-500 bg-navy-900 shadow-xl' : 'border-navy-100 bg-white shadow-sm',
            ]}
          >
            {tier.featured && (
              <span class="absolute -top-3 left-8 rounded-full bg-teal-600 px-3 py-1 text-xs font-bold uppercase tracking-wider text-white">
                Most popular
              </span>
            )}
            <h2 class:list={['text-2xl font-bold', tier.featured ? 'text-white' : 'text-navy-900']}>{tier.name}</h2>
            <p class:list={['mt-3 font-display text-xl font-bold', tier.featured ? 'text-teal-400' : 'text-navy-900']}>
              {tier.price}
            </p>
            <p class:list={['text-sm font-medium', tier.featured ? 'text-navy-100/70' : 'text-ink-500']}>{tier.monthly}</p>
            <p class:list={['mt-4 text-sm font-semibold leading-relaxed', tier.featured ? 'text-white' : 'text-navy-900']}>
              {tier.outcome}
            </p>
            <p class:list={['mt-2 text-sm leading-relaxed', tier.featured ? 'text-navy-100/75' : 'text-ink-500']}>
              {tier.audience}
            </p>
            <ul class:list={['mt-6 flex-1 space-y-2.5 text-sm', tier.featured ? 'text-navy-100/90' : 'text-ink-700']}>
              {tier.items.map((item) => (
                <li class="flex gap-2">
                  <span class="text-teal-500">✓</span> {item}
                </li>
              ))}
            </ul>
            <a
              href="/contact/"
              class:list={[
                'mt-8 rounded-md px-5 py-2.5 text-center text-sm font-semibold transition-colors',
                tier.featured
                  ? 'bg-teal-600 text-white hover:bg-teal-500'
                  : 'border border-navy-900 text-navy-900 hover:bg-navy-900 hover:text-white',
              ]}
            >
              Start with {tier.name}
            </a>
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-center text-sm text-ink-500">
      Pricing shown as planning bands; every engagement gets a fixed written quote. Setup fees 50% upfront; retainers
      billed monthly on the 1st.
    </p>
  </section>

  <!-- MARKETING SERVICES -->
  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <SectionHeading
        eyebrow="Growth engine"
        heading="AI marketing & optimization"
        body="Add-on services for businesses that want the phone ringing, not just the systems running."
        align="center"
      />
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {
          marketing.map((svc) => (
            <div class="rounded-xl border border-navy-100 bg-paper p-6">
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="text-lg font-bold text-navy-900">{svc.name}</h3>
                <span class="shrink-0 font-display text-sm font-bold text-teal-600">{svc.price}</span>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-ink-500">{svc.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
    <SectionHeading eyebrow="Questions" heading="Straight answers" align="center" />
    <div class="mt-10 space-y-4">
      {
        faqs.map((faq) => (
          <details class="group rounded-xl border border-navy-100 bg-white p-6 shadow-sm">
            <summary class="cursor-pointer list-none font-semibold text-navy-900 [&::-webkit-details-marker]:hidden">
              <span class="flex items-center justify-between gap-4">
                {faq.q}
                <span class="text-teal-600 transition-transform group-open:rotate-45">+</span>
              </span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-ink-500">{faq.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <CtaSection
    heading="Find out what AI should be doing for your business"
    body="Book a free strategy call. We'll audit your lead flow, follow-up, and online presence — and tell you plainly which package fits, or whether you need one at all."
    primaryLabel="Get a Free AI Readiness Assessment"
  />
</Base>
