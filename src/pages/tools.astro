---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaSection from '../components/CtaSection.astro';

const title = 'Free Tools — The Whole Shelf, No Email Gates | ICS';
const description =
  "Every free tool ICS gives away, on one shelf: the 45-second Fit Finder, QuoteBrain satellite quoting, the AI Readiness Score, a free building valuation, the Revenue Leak calculator, the printable 90-Day Playbook, straight answers with real prices, and the honest DIY-vs-agency comparison.";

const tools = [
  {
    type: 'Match',
    time: '45 seconds',
    name: 'The Fit Finder',
    body: 'Three questions route you to the right system with its published price and the proof to check. The fastest honest answer on the site.',
    href: '/start/',
    cta: 'Find your fit',
  },
  {
    type: 'Live demo',
    time: '60 seconds',
    name: 'QuoteBrain™ 2.0',
    body: 'Measure a real lot on satellite imagery and watch a professional written estimate assemble itself. The instant-quote engine, demonstrated on your own property.',
    href: '/quotebrain/',
    cta: 'Measure something',
  },
  {
    type: 'Assessment',
    time: '2 minutes',
    name: 'AI Readiness Score',
    body: 'Ten questions across lead response, reputation, operations, and visibility — graded, with a 90-day action plan for the gaps it finds.',
    href: '/ai-readiness/',
    cta: 'Score your business',
  },
  {
    type: 'Valuation',
    time: 'Instant band + 48h written',
    name: "What's My Building Worth?",
    body: 'An instant value band from your own numbers, then a free broker opinion of value — walked in person, built on real comparables, written within 48 hours.',
    href: '/building-worth/',
    cta: 'Value your building',
  },
  {
    type: 'Calculator',
    time: '1 minute',
    name: 'The Revenue Leak',
    body: 'What slow response and dead follow-up cost you per year, computed from your own job value and lead flow — assumptions shown, pitch optional.',
    href: '/ai-services/#leak',
    cta: 'Run your numbers',
  },
  {
    type: 'Guide',
    time: '90 days of work, free',
    name: 'The 90-Day Playbook',
    body: 'Our complete method — twelve moves from invisible to chosen — printable, checkbox-formatted, genuinely do-it-yourself. The whole play, given away.',
    href: '/playbook/',
    cta: 'Get the playbook',
  },
  {
    type: 'Answers',
    time: 'Browse',
    name: 'Straight Answers',
    body: 'Nineteen real questions answered with real numbers: costs, guarantees, timelines, ownership, what AI can and can\'t do for a small business.',
    href: '/answers/',
    cta: 'Read the answers',
  },
  {
    type: 'Comparison',
    time: '3 minutes',
    name: 'DIY vs Agency vs ICS',
    body: 'The comparison nobody else will publish, including where we\'re NOT the right choice. Qualify us — or disqualify us — before a single phone call.',
    href: '/compare/',
    cta: 'Compare your options',
  },
];
---

<Base title={title} description={description}>
  <section class="bg-navy-900">
    <div class="mx-auto max-w-6xl px-4 py-14 text-center sm:px-6 sm:py-16">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.25em] text-teal-400">Free tools · Zero email gates · All of it</p>
      <h1 class="reveal mx-auto mt-4 max-w-3xl text-4xl font-bold leading-tight text-white sm:text-5xl" style="--reveal-delay: 100ms">
        Agencies gate everything behind a demo. We put the tools on the counter.
      </h1>
      <p class="reveal mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-navy-100/90" style="--reveal-delay: 200ms">
        Eight working tools, free, no email required for any of them. Use them, keep the results, hire nobody.
        If one of them convinces you there's a bigger win — you know where the phone is.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        tools.map((tool, i) => (
          <a
            href={tool.href}
            class="reveal lift group flex flex-col rounded-xl border border-navy-100 bg-white p-6 shadow-sm"
            style={`--reveal-delay: ${(i % 4) * 60}ms`}
          >
            <div class="flex items-center justify-between">
              <span class="rounded-full bg-teal-100 px-2.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider text-teal-700">{tool.type}</span>
              <span class="font-mono text-[10px] text-ink-500">{tool.time}</span>
            </div>
            <h2 class="mt-3 text-lg font-bold text-navy-900 group-hover:text-teal-600">{tool.name}</h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-500">{tool.body}</p>
            <p class="mt-4 text-sm font-semibold text-teal-600">{tool.cta} →</p>
          </a>
        ))
      }
    </div>

    <div class="mx-auto mt-12 max-w-2xl rounded-xl border border-navy-100 bg-paper p-6 text-center">
      <h2 class="font-display text-lg font-bold text-navy-900">Why is all of this free?</h2>
      <p class="mt-2 text-sm leading-relaxed text-ink-700">
        Because the tools are the pitch. Every one of them answers instantly, works at 2am, and asks smart questions —
        which is exactly what we install inside businesses, for money. If the free shelf runs this well, imagine the
        machine behind the counter. <a href="/pricing/" class="font-semibold text-teal-600 hover:text-teal-500">That one has published pricing too →</a>
      </p>
    </div>
  </section>

  <CtaSection
    heading="Used a tool? Then you already know how we build."
    body="Bring your result to a free strategy call — your readiness score, your leak number, your building band — and we'll turn it into a plan with a price."
  />
</Base>
