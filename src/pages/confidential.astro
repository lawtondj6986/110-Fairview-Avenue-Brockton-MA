---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { SITE } from '../config';

const title = 'Discretion & Confidentiality — How We Handle Sensitive Work | ICS';
const description =
  'For private clients, candidates, and anyone commissioning intelligence work: how ICS protects a confidential engagement — both directions. Need-to-know handling, secure delivery, no retention beyond the engagement, conflict walls, and the promise that nobody learns we looked, and nobody learns you asked.';

const commitments = [
  {
    name: 'Confidential, both directions',
    body: 'The subject never learns we looked. And nobody learns you asked — not a competitor, not a counterparty, not an opponent. Your identity and the existence of the engagement are protected as carefully as the findings themselves.',
  },
  {
    name: 'Need-to-know, by default',
    body: 'One accountable person does the work — the founder. No account team passing your file around, no junior analyst, no offshore desk. Fewer hands is not a limitation here; it is the security model.',
  },
  {
    name: 'Secure delivery, no loose copies',
    body: 'The Brief is delivered to you directly and confidentially — in person or by secure link, never a group email or a shared drive. We walk you through it, then it is yours.',
  },
  {
    name: 'We keep only what we must',
    body: 'The working file is retained only as long as you need it for reference, then securely destroyed or archived on your instruction. We do not stockpile dossiers, and we do not reuse your engagement as inventory.',
  },
];

const handling = [
  ['Conflict walls', 'Before we take a matter we run a conflict check, and we work one side only. We will never take an opposing engagement in the same contest or dispute — and because we log every matter, that exclusivity is provable, not just promised.'],
  ['Anonymized in our own records', 'For our files and any marketing, an engagement becomes "a legislative campaign in Massachusetts" or "a buyer in a mid-market acquisition." The specifics never leave the matter.'],
  ['Nothing obtained improperly', 'Public sources and lawful methods only. We do not pretext, surveil, or touch private financial, phone, or medical records — which also means nothing in your file can be challenged over how it was gathered.'],
  ['Your counsel, when it matters', 'For privileged or litigation-adjacent work, we are comfortable taking direction through your attorney, so the work sits where it should. We are researchers, not lawyers, and we stay in our lane.'],
];

const never = [
  'Sell, share, or trade your data — to anyone, for any price.',
  'Work both sides of the same contest or dispute.',
  'Confirm to a third party that you are a client, or that an engagement exists.',
  'Keep what the engagement does not require, or repurpose it later.',
  'Produce consumer reports for hiring, tenant, or credit decisions — those are regulated, and not what we do.',
];
---

<Base title={title} description={description}>
  <section class="bg-navy-950">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.25em] text-brass-300">Discretion · How sensitive work is handled</p>
      <h1 class="reveal mt-4 max-w-3xl text-4xl font-bold leading-tight text-white sm:text-5xl" style="--reveal-delay: 100ms">
        The work only matters if it stays quiet.
      </h1>
      <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-navy-100/90" style="--reveal-delay: 200ms">
        Before anyone commissions an intelligence brief, a private-client mandate, or opposition research, they ask
        the same question they rarely say out loud: <em>can I trust this person with something this sensitive?</em>
        Here is the honest, complete answer — because discretion isn't a feature of this practice. It's the premise.
      </p>
      <div class="reveal mt-8 flex flex-wrap gap-4" style="--reveal-delay: 300ms">
        <a href={`mailto:${SITE.email}?subject=${encodeURIComponent('Confidential inquiry')}`} class="rounded-md bg-brass-500 px-6 py-3 font-semibold text-navy-950 transition-colors hover:bg-brass-300">
          Start a Confidential Conversation
        </a>
        <a href={`tel:${SITE.phone.replace(/[^\d+]/g, '')}`} class="rounded-md border border-white/25 px-6 py-3 font-semibold text-white transition-colors hover:border-brass-300 hover:text-brass-300">
          Call {SITE.founder} Directly
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <SectionHeading eyebrow="The commitments" heading="What confidential actually means here" align="center" />
    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        commitments.map((c, i) => (
          <div class="reveal lift rounded-xl border border-navy-100 bg-white p-7 shadow-sm" style={`--reveal-delay: ${(i % 2) * 70}ms`}>
            <h2 class="text-xl font-bold text-navy-900">{c.name}</h2>
            <p class="mt-3 text-sm leading-relaxed text-ink-500">{c.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-navy-900">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <SectionHeading
        eyebrow="The handling"
        heading="How a sensitive engagement is actually run"
        body="Not a privacy policy written by a lawyer to be ignored — the specific practices that protect the work from the first inquiry to the last copy."
        align="center"
        dark
      />
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {
          handling.map(([h, b], i) => (
            <div class="reveal rounded-xl border border-white/10 bg-navy-950 p-6" style={`--reveal-delay: ${(i % 2) * 70}ms`}>
              <h3 class="font-display text-lg font-bold text-brass-300">{h}</h3>
              <p class="mt-2 text-sm leading-relaxed text-navy-100/80">{b}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <SectionHeading eyebrow="The bright lines" heading="What we will never do" align="center" />
    <ul class="mt-10 space-y-3">
      {
        never.map((n, i) => (
          <li class="reveal flex items-start gap-3 rounded-xl border border-navy-100 bg-white p-5 shadow-sm" style={`--reveal-delay: ${(i % 2) * 60}ms`}>
            <span class="mt-0.5 shrink-0 font-mono text-sm font-bold text-brass-600">✕</span>
            <p class="text-sm leading-relaxed text-ink-700">{n}</p>
          </li>
        ))
      }
    </ul>
    <p class="mx-auto mt-8 max-w-2xl text-center text-sm leading-relaxed text-ink-500">
      These lines are published on purpose. A practice that writes its limits down, in public, is a practice you can
      hold to them. See also the <a href="/intelligence/" class="font-semibold text-teal-600 hover:text-teal-500">intelligence practice</a>,
      the <a href="/political/" class="font-semibold text-teal-600 hover:text-teal-500">political desk's methods code</a>, and
      <a href="/private-clients/" class="font-semibold text-teal-600 hover:text-teal-500"> private client services</a>.
    </p>
  </section>

  <section class="bg-navy-950">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brass-300">Reaching us quietly</p>
      <h2 class="mx-auto mt-3 max-w-xl text-3xl font-bold text-white">
        One person answers. The conversation stays between us.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-navy-100/85">
        No intake team, no CRM blast, no trace you'd rather not leave. Call or email {SITE.founder} directly — tell us
        only what you're comfortable putting in a first message, and we'll take the sensitive specifics on the phone.
        If we're not the right fit, or we're conflicted out, we'll say so and it ends there.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href={`mailto:${SITE.email}?subject=${encodeURIComponent('Confidential inquiry')}`} class="rounded-md bg-brass-500 px-6 py-3 font-semibold text-navy-950 transition-colors hover:bg-brass-300">
          Email Privately
        </a>
        <a href={`tel:${SITE.phone.replace(/[^\d+]/g, '')}`} class="rounded-md border border-white/25 px-6 py-3 font-semibold text-white transition-colors hover:border-brass-300 hover:text-brass-300">
          {SITE.phone}
        </a>
      </div>
      <p class="mx-auto mt-6 max-w-xl text-xs leading-relaxed text-navy-100/50">
        ICS conducts research from public records by lawful methods. We are not attorneys and nothing here is legal
        advice. Confidentiality terms are set in writing in each engagement.
      </p>
    </div>
  </section>
</Base>
