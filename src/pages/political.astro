---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { SITE } from '../config';
import PoliticalInquiry from '../components/PoliticalInquiry.astro';

const title = 'Political Research — Opposition Research & Vulnerability Audits | ICS';
const description =
  'Public-record political research for candidates, committees, and ballot campaigns: vulnerability self-audits, opposition research books, rapid-response fact desks, and issue landscapes. Documented, sourced, lawful — with published pricing, from the ICS intelligence practice.';

const services = [
  {
    name: 'The Vulnerability Audit',
    price: '$3,500–$7,500',
    tagline: 'Know your own file before anyone else reads it.',
    body: "We research you the way a motivated opponent would — voting and attendance records, campaign finance filings, court and property records, business history, press archive, every public statement that can be clipped. You get the full book, the three things that will hurt, and the honest read on how to get ahead of each one. Every serious campaign does this first; the ones that don't find out in October.",
  },
  {
    name: 'The Opposition Book',
    price: '$7,500–$15,000 · statewide scoped separately',
    tagline: 'The public record, assembled and sourced.',
    body: "A complete public-record profile of the opposing candidate or committee: votes and flip-flops, donors and spending, litigation and liens, business conduct, statements versus actions. Every claim footnoted to a verifiable source — because research your committee can't defend at a press conference is worse than no research at all.",
  },
  {
    name: 'The Rapid-Response Desk',
    price: '$2,000–$4,000/mo through Election Day',
    tagline: 'When the attack lands at 4pm, the receipts land by 7.',
    body: 'A standing research desk for the live phase of the race: fact-checking claims in both directions, sourcing rebuttals, monitoring filings and public records as they update, and briefing your spokesperson with documents — not vibes — before the next news cycle.',
  },
  {
    name: 'The Issue Landscape',
    price: '$5,000–$10,000',
    tagline: 'Ballot questions and policy fights, mapped.',
    body: "For ballot committees and advocacy campaigns: who funds each side, what the filings show, how the issue has played in comparable towns and states, and where the public record supports — or undercuts — each argument. The brief your steering committee reads before it spends a dollar.",
  },
];

const code = [
  ['Public records. Lawful methods. Full stop.', 'Votes, filings, dockets, deeds, licenses, archives, and published statements. No pretexting, no hacking, no surveillance, no going through anyone\'s private life beyond the public record. If it isn\'t lawfully public, it isn\'t in the book.'],
  ['Sourced or it doesn\'t ship', 'Every claim footnoted to a document a reporter could pull tomorrow. We flag the difference between what the record proves and what it merely suggests — and we\'ll tell you plainly when a "hit" isn\'t usable.'],
  ['Research, never disinformation', 'We document what is true. We do not fabricate, distort, astroturf, or build attacks we know are misleading — for any client, at any price. The work has to survive a fact-check, because it will get one.'],
  ['One client per race', 'Conflict check before engagement, confidentiality both directions, and we never work both sides of the same contest. Ever.'],
  ['Public roles, not private people', 'Candidates, committees, and officials acting in public capacities. We decline work targeting private individuals, and anything whose purpose is harassment rather than informed voters.'],
  ['Your counsel leads on compliance', 'Committees handle their own campaign-finance reporting of vendor payments; we invoice as professional research and keep clean records. Nothing we produce is legal advice.'],
];

const faqs = [
  {
    q: 'Is opposition research legal?',
    a: "Done our way, it's not just legal — it's a standard part of American campaigns at every level. Assembling and verifying the public record on people seeking public office is vetting, and voters are better off for it. What's not acceptable is surveillance, pretexting, or distortion — which is why our methods code is published on this page.",
  },
  {
    q: 'Why hire an OSINT firm instead of a political consultant?',
    a: "Most local and state campaigns can't afford the big oppo shops, so they get either nothing or a volunteer with a search bar. Our day job is open-source intelligence — property records, corporate filings, litigation histories, digital footprints — done with AI-accelerated pipelines that make professional-depth research affordable at down-ballot budgets. Same discipline we sell to businesses, applied to the public record of a race.",
  },
  {
    q: 'Will you take any campaign as a client?',
    a: "No. We conflict-check every race, work one side only, and decline engagements that fail the methods code — including 'just find me dirt' requests with no interest in whether it's true. We also happily do the most honorable job in the field: researching you, for you, before your opponent does.",
  },
  {
    q: 'What does the deliverable look like?',
    a: 'A written, footnoted research book with an executive summary, the documented findings in priority order, source exhibits, and an honest usability assessment of each item — there is a fully fictional sample page at icsgroup.ai/political/sample. Rapid-response clients get standing briefs. Everything is confidential and yours.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Political research and opposition research from public records',
    name: 'Political Research & Opposition Research',
    provider: { '@type': 'RealEstateAgent', name: SITE.name, telephone: SITE.phone },
    areaServed: 'Massachusetts',
    audience: { '@type': 'Audience', audienceType: 'Candidates, campaign committees, PACs, and ballot-question committees' },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base title={title} description={description} schema={schema}>
  <section class="bg-navy-950">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.25em] text-brass-300">Political research · From the ICS intelligence practice</p>
      <h1 class="reveal mt-4 max-w-3xl text-4xl font-bold leading-tight text-white sm:text-5xl" style="--reveal-delay: 100ms">
        Everything findable will be found. The only question is by whom.
      </h1>
      <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-navy-100/90" style="--reveal-delay: 200ms">
        Assume the other side is already reading. Our OSINT practice goes through the lawful record the way a
        prosecutor goes through discovery — every vote, every dollar, every docket, every archived sentence —
        and hands you the book first. Documented, footnoted, and priced in the open. For candidates, committees,
        and ballot campaigns that intend to win.
      </p>
      <div class="reveal mt-8 flex flex-wrap gap-4" style="--reveal-delay: 300ms">
        <a href="#inquiry" class="rounded-md bg-brass-500 px-6 py-3 font-semibold text-navy-950 transition-colors hover:bg-brass-300">
          Confidential Inquiry
        </a>
        <a href={`tel:${SITE.phone.replace(/[^\d+]/g, '')}`} class="rounded-md border border-white/25 px-6 py-3 font-semibold text-white transition-colors hover:border-brass-300 hover:text-brass-300">
          Call {SITE.founder} Directly
        </a>
      </div>
      <p class="reveal mt-6 text-xs text-navy-100/50" style="--reveal-delay: 380ms">
        Conflict check before any engagement · one client per race · confidential both directions
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <SectionHeading
      eyebrow="The services · Published pricing, as always"
      heading="Four ways the record gets put to work"
      body="Ranges below are for local and legislative races; larger contests are scoped in writing. Every engagement starts with a written scope and a conflict check."
      align="center"
    />
    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        services.map((s, i) => (
          <div class="reveal lift flex flex-col rounded-xl border border-navy-100 bg-white p-7 shadow-sm" style={`--reveal-delay: ${(i % 2) * 70}ms`}>
            <h2 class="text-xl font-bold text-navy-900">{s.name}</h2>
            <p class="mt-0.5 font-mono text-xs font-semibold text-teal-600">{s.price}</p>
            <p class="mt-2 text-sm font-semibold italic text-brass-600">{s.tagline}</p>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-500">{s.body}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-8 text-center text-sm">
      <a href="/political/sample/" class="font-semibold text-teal-600 hover:text-teal-500">
        See a sample page of The Book — findings, footnotes, and usability ratings →
      </a>
    </p>
  </section>

  <!-- WHAT GETS PULLED -->
  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <SectionHeading
        eyebrow="The depth · This is what thorough means"
        heading="What gets pulled when we say 'the record'"
        body="Amateurs run a search and call it research. A book that decides a race goes to the bottom of the lawful record — the places that take weeks, not minutes."
        align="center"
      />
      <div class="mt-10 grid gap-3 sm:grid-cols-2">
        {
          [
            'Every vote, every absence, every reversal — the full legislative and board record, cross-referenced against what was said at the time',
            'Every reported donor, every expenditure, every committee transfer — and who those donors are',
            'Litigation, liens, and judgments pulled county by county, everywhere they\'ve lived and done business',
            'Corporate filings, failed ventures, dissolutions, and the officers who rode them down',
            'Property, tax, and assessment records — including the ones that contradict the stump speech',
            'Licensing boards, regulatory actions, and public enforcement histories',
            'The press archive to microfilm depth — not just what Google surfaces',
            'The archived internet: pages deleted years ago, old positions, vanished promises — lawfully preserved in public archives, clipped and timestamped',
          ].map((item, i) => (
            <div class="reveal flex items-start gap-3 rounded-lg border border-navy-100 bg-paper px-4 py-3" style={`--reveal-delay: ${(i % 2) * 60}ms`}>
              <span class="mt-0.5 font-mono text-xs font-bold text-brass-600">▸</span>
              <p class="text-sm leading-relaxed text-ink-700">{item}</p>
            </div>
          ))
        }
      </div>
      <p class="mx-auto mt-8 max-w-2xl text-center text-sm font-semibold text-navy-900">
        The operating assumption of every book we build: anything findable <em>will</em> be found before Election Day.
        We make sure you're the one holding it.
      </p>
    </div>
  </section>

  <!-- THE METHODS CODE -->
  <section id="methods-code" class="scroll-mt-20 bg-navy-900">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <SectionHeading
        eyebrow="The methods code · Published on purpose"
        heading="Ruthless inside the lines"
        body="We don't cross lines because we don't need to — the lawful record is deeper than most careers can survive. And because this code is public, the work can't be discredited by how it was gathered: your campaign points to the code, and the findings stand."
        align="center"
        dark
      />
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          code.map(([h, b], i) => (
            <div class="reveal rounded-xl border border-white/10 bg-navy-950 p-6" style={`--reveal-delay: ${(i % 3) * 60}ms`}>
              <h3 class="font-display text-base font-bold text-teal-400">{h}</h3>
              <p class="mt-2 text-sm leading-relaxed text-navy-100/80">{b}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <SectionHeading eyebrow="Straight answers" heading="The questions campaigns actually ask" align="center" />
    <div class="mt-8 space-y-3">
      {
        faqs.map((faq) => (
          <details class="group rounded-xl border border-navy-100 bg-white p-6 shadow-sm">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-navy-900 [&::-webkit-details-marker]:hidden">
              {faq.q}
              <span class="shrink-0 text-teal-600 transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-ink-500">{faq.a}</p>
          </details>
        ))
      }
    </div>
    <p class="mt-8 text-center text-sm">
      <a href="/insights/what-does-opposition-research-cost/" class="font-semibold text-teal-600 hover:text-teal-500">
        Deep dive: what opposition research actually costs in 2026 — real numbers, for once →
      </a>
    </p>
    <p class="mt-6 text-center text-xs leading-relaxed text-ink-500">
      ICS provides research services from public records for lawful campaign purposes. We are not attorneys and
      nothing here is legal advice; committees should consult counsel on compliance and reporting. The broader
      intelligence practice — including business diligence and digital-exposure work — lives at
      <a href="/intelligence/" class="font-semibold text-teal-600 hover:text-teal-500">icsgroup.ai/intelligence</a>.
    </p>
  </section>

  <!-- CONTACT: the confidential intake -->
  <section id="inquiry" class="scroll-mt-20 bg-navy-950">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[1fr_1.15fr] lg:items-start">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brass-300">A quiet first conversation</p>
        <h2 class="mt-3 max-w-xl text-3xl font-bold leading-tight text-white sm:text-4xl">
          Every race has someone who did the reading. Be on their side.
        </h2>
        <p class="mt-4 max-w-xl text-navy-100/85">
          Thirty minutes, confidential, no obligation — including the honest answer when the smartest first strike is
          researching yourself. One client per race, so the side that calls first is the side we work for. If we're
          conflicted out, we'll say so on the call.
        </p>
        <ol class="mt-8 space-y-4">
          {
            [
              ['Conflict check', 'Within one business day we confirm we can take your side of the race — or tell you we can\'t.'],
              ['Thirty-minute call', 'What worries you, what the calendar looks like, and what the record is likely to hold.'],
              ['Written scope', 'A fixed scope and a price from the published ranges before any work starts.'],
            ].map(([h, b], i) => (
              <li class="flex gap-4">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-brass-300/60 font-mono text-sm font-bold text-brass-300">{i + 1}</span>
                <span>
                  <span class="block font-semibold text-white">{h}</span>
                  <span class="block text-sm leading-relaxed text-navy-100/75">{b}</span>
                </span>
              </li>
            ))
          }
        </ol>
        <p class="mt-8 text-sm text-navy-100/70">
          Rather talk now? <a href={`tel:${SITE.phone.replace(/[^\d+]/g, '')}`} class="font-semibold text-brass-300 hover:text-white">Call or text {SITE.phone}</a>
        </p>
      </div>
      <PoliticalInquiry />
    </div>
  </section>
</Base>
