---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';

const title = 'Daniel Lawton — Digital Card | Innovative Commercial Strategies';
const description =
  'The digital business card for Daniel Lawton, founder of Innovative Commercial Strategies: one tap to call, text, email, or save the contact — plus the free tools and the live proof.';

const tel = SITE.phone.replace(/[^\d+]/g, '');
---

<Base title={title} description={description}>
  <section class="bg-navy-950">
    <div class="mx-auto flex min-h-[70vh] max-w-lg flex-col items-center justify-center px-4 py-14 text-center sm:px-6">
      <div class="w-full rounded-2xl border border-white/10 bg-navy-900 p-8 shadow-2xl">
        <img
          src="/images/daniel-lawton.jpg"
          alt={SITE.founder}
          class="mx-auto h-28 w-28 rounded-full border-2 border-teal-500/60 object-cover object-top"
          width="800"
          height="1524"
        />
        <h1 class="mt-4 text-2xl font-bold text-white">{SITE.founder}</h1>
        <p class="mt-1 text-sm font-semibold text-teal-400">Founder · CRE Advisor · AI Systems Builder</p>
        <p class="mt-1 text-xs text-navy-100/60">{SITE.name} · Brockton, MA</p>
        <p class="mt-1 text-[11px] text-navy-100/50">{SITE.license}</p>

        <div class="mt-6 grid grid-cols-3 gap-2">
          <a href={`tel:${tel}`} class="rounded-lg bg-teal-600 px-3 py-3 text-sm font-semibold text-white transition-colors hover:bg-teal-500">Call</a>
          <a href={`sms:${tel}`} class="rounded-lg bg-teal-600 px-3 py-3 text-sm font-semibold text-white transition-colors hover:bg-teal-500">Text</a>
          <a href={`mailto:${SITE.email}`} class="rounded-lg bg-teal-600 px-3 py-3 text-sm font-semibold text-white transition-colors hover:bg-teal-500">Email</a>
        </div>
        <a
          href="/daniel-lawton.vcf"
          download="Daniel-Lawton-ICS.vcf"
          class="mt-3 block rounded-lg border border-brass-300/60 bg-brass-500/10 px-4 py-3 text-sm font-bold text-brass-300 transition-colors hover:bg-brass-500/20"
        >
          ⬇ Save Contact to Phone
        </a>

        <div class="mt-6 space-y-2 border-t border-white/10 pt-5 text-left">
          {
            [
              ['The 45-second Fit Finder', '/start/'],
              ['Free tools — the whole shelf', '/tools/'],
              ['The Group: practices & ventures', '/group/'],
              ['Published pricing', '/pricing/'],
            ].map(([label, href]) => (
              <a href={href} class="flex items-center justify-between rounded-lg border border-white/10 px-4 py-2.5 text-sm font-semibold text-navy-100/90 transition-colors hover:border-teal-400 hover:text-teal-400">
                {label} <span aria-hidden="true">→</span>
              </a>
            ))
          }
        </div>
      </div>

      <div class="mt-8 rounded-xl border border-white/10 bg-white p-4">
        <img src="/images/card-qr.png" alt="QR code linking to this card" width="348" height="348" class="h-36 w-36" />
      </div>
      <p class="mt-3 max-w-xs text-xs leading-relaxed text-navy-100/60">
        Passing this along? Let them point a camera at the code — it lands right here.
      </p>
    </div>
  </section>
</Base>
