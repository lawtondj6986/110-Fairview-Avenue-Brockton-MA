---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaSection from '../../components/CtaSection.astro';
import FounderCard from '../../components/FounderCard.astro';
import { SITE } from '../../config';
import { founderRef } from '../../lib/founder';

export async function getStaticPaths() {
  const posts = await getCollection('insights', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, faqs } = post.data;

// "Keep reading": the articles that share the most vocabulary with this one
// (title + description, stemmed), with the same category and recency as tie-breaks.
const STOP = new Set(['the', 'a', 'an', 'and', 'or', 'of', 'to', 'in', 'on', 'for', 'with', 'is', 'are', 'what', 'how', 'why', 'when', 'who', 'your', 'you', 'it', 'its', 'this', 'that', 'here', 'from', 'by', 'at', 'as', 'be', 'we', 'our', 'not', 'before', 'after', 'into', 'than', 'one', 'they', 'their', 'which', 'about', 'does', 'do', 'can', 'should', 'actually', 'every', 'most', 'all', 'any', 'plus', 'own', 'ics']);
const words = (t: string) =>
  new Set(
    t
      .toLowerCase()
      .replace(/[^a-z0-9\s]/g, ' ')
      .split(/\s+/)
      .filter((w) => w.length > 2 && !STOP.has(w))
      .map((w) => w.replace(/(ing|ers|er|es|s)$/, ''))
  );
const mine = words(`${title} ${description}`);
const others = (await getCollection('insights', ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .map((p) => {
    const theirs = words(`${p.data.title} ${p.data.description}`);
    let shared = 0;
    theirs.forEach((w) => mine.has(w) && shared++);
    return { p, score: shared * 10 + Number(p.data.category === post.data.category) * 3 };
  })
  .sort((a, b) => b.score - a.score || b.p.data.date.valueOf() - a.p.data.date.valueOf())
  .slice(0, 3)
  .map((x) => x.p);

// "Tools in this article": the free tools the body links to, surfaced as a strip.
const TOOL_NAMES: Record<string, string> = {
  '/buyer-brief/': 'Build a Buyer Brief',
  '/proposal/': 'Build Your Own Proposal',
  '/payback/': 'The Payback Calculator',
  '/first-90-days/': 'The First 90 Days',
  '/monthly-report/sample/': 'The Monthly Report, a sample',
  '/market-sheets/': 'Market Sheets',
  '/corridors/': 'Corridor Guides',
  '/territories/': 'The Territory Board',
  '/south-shore/compare/': 'Town Compare',
  '/cap-rate/': 'Cap Rate & NOI',
  '/seller-net/': 'Seller Net Proceeds',
  '/lease-vs-buy/': 'Lease vs. Buy',
  '/lease-analyzer/': 'Lease Deal Analyzer',
  '/building-worth/': "What's My Building Worth?",
  '/ai-readiness/': 'AI Readiness Score',
  '/quotebrain/': 'QuoteBrain',
  '/playbook/': 'The 90-Day Playbook',
  '/start/': 'The Fit Finder',
  '/ai-services/#leak': 'The Revenue Leak',
  '/glossary/': 'The Glossary',
  '/deal-tools/': 'Five CRE Deal Tools',
  '/intelligence/scope/': 'The Intelligence Scoper',
  '/political/self-check/': 'The Political Self-Check',
};
const linked = new Set(Array.from(post.body?.matchAll(/\]\((\/[^)\s]*)\)/g) ?? []).map((m) => m[1]));
const tools = Object.entries(TOOL_NAMES).filter(([href]) => linked.has(href));

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const schema: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    datePublished: date.toISOString(),
    author: founderRef(),
    publisher: { '@id': `${SITE.url}/#business` },
  },
];

if (faqs && faqs.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<Base title={`${title} | ICS Insights`} description={description} schema={schema} ogType="article">
  <article>
    <header class="bg-navy-900">
      <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-teal-400">{fmt(date)} · <a href="/about/" class="hover:text-teal-300">{SITE.founder}</a></p>
        <h1 class="mt-4 text-3xl font-bold leading-tight text-white sm:text-4xl">{title}</h1>
      </div>
    </header>
    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
      <div class="prose-ics">
        <Content />
      </div>

      {
        faqs && faqs.length > 0 && (
          <section class="mt-12 border-t border-navy-100 pt-8">
            <h2 class="font-mono text-xs font-semibold uppercase tracking-[0.25em] text-teal-600">Common questions</h2>
            <dl class="mt-5 space-y-5">
              {faqs.map((f) => (
                <div>
                  <dt class="text-base font-bold text-navy-900">{f.q}</dt>
                  <dd class="mt-1.5 text-sm leading-relaxed text-ink-700">{f.a}</dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      {
        tools.length > 0 && (
          <aside class="mt-10 rounded-xl border border-brass-300 bg-paper p-5" aria-label="Tools in this article">
            <p class="font-mono text-[11px] font-bold uppercase tracking-[0.25em] text-brass-600">Tools in this article · free, no email</p>
            <ul class="mt-3 flex flex-wrap gap-2">
              {tools.map(([href, name]) => (
                <li><a href={href} class="inline-block rounded-full border border-navy-100 bg-white px-3 py-1.5 text-sm font-semibold text-navy-900 hover:border-teal-500 hover:text-teal-700">{name} →</a></li>
              ))}
            </ul>
          </aside>
        )
      }

      <FounderCard variant="byline" />
    </div>
  </article>

  {
    others.length > 0 && (
      <section class="mx-auto max-w-3xl px-4 pb-14 sm:px-6">
        <h2 class="font-mono text-xs font-semibold uppercase tracking-[0.25em] text-teal-600">Keep reading</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-3">
          {others.map((p) => (
            <a href={`/insights/${p.id}/`} class="lift group rounded-xl border border-navy-100 bg-white p-5 shadow-sm">
              <p class="text-sm font-bold leading-snug text-navy-900 group-hover:text-teal-600">{p.data.title}</p>
              <p class="mt-2 line-clamp-3 text-xs leading-relaxed text-ink-500">{p.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <CtaSection
    heading="Want this applied to your business?"
    body="Book a free strategy call — we'll turn the ideas in this article into a concrete plan with numbers attached."
  />
</Base>
