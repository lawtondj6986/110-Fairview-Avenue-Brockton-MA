---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaSection from '../../components/CtaSection.astro';
import FounderCard from '../../components/FounderCard.astro';
import { SITE } from '../../config';

export async function getStaticPaths() {
  const posts = await getCollection('insights', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, faqs } = post.data;

// "Keep reading": same category first, then newest of the rest.
const others = (await getCollection('insights', ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .sort(
    (a, b) =>
      Number(b.data.category === post.data.category) - Number(a.data.category === post.data.category) ||
      b.data.date.valueOf() - a.data.date.valueOf()
  )
  .slice(0, 2);

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const schema: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    datePublished: date.toISOString(),
    author: { '@type': 'Person', name: SITE.founder },
    publisher: { '@type': 'Organization', name: SITE.name },
  },
];

if (faqs && faqs.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<Base title={`${title} | ICS Insights`} description={description} schema={schema} ogType="article">
  <article>
    <header class="bg-navy-900">
      <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-teal-400">{fmt(date)} · {SITE.founder}</p>
        <h1 class="mt-4 text-3xl font-bold leading-tight text-white sm:text-4xl">{title}</h1>
      </div>
    </header>
    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
      <div class="prose-ics">
        <Content />
      </div>

      {
        faqs && faqs.length > 0 && (
          <section class="mt-12 border-t border-navy-100 pt-8">
            <h2 class="font-mono text-xs font-semibold uppercase tracking-[0.25em] text-teal-600">Common questions</h2>
            <dl class="mt-5 space-y-5">
              {faqs.map((f) => (
                <div>
                  <dt class="text-base font-bold text-navy-900">{f.q}</dt>
                  <dd class="mt-1.5 text-sm leading-relaxed text-ink-700">{f.a}</dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      <FounderCard variant="byline" />
    </div>
  </article>

  {
    others.length > 0 && (
      <section class="mx-auto max-w-3xl px-4 pb-14 sm:px-6">
        <h2 class="font-mono text-xs font-semibold uppercase tracking-[0.25em] text-teal-600">Keep reading</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {others.map((p) => (
            <a href={`/insights/${p.id}/`} class="lift group rounded-xl border border-navy-100 bg-white p-5 shadow-sm">
              <p class="text-sm font-bold leading-snug text-navy-900 group-hover:text-teal-600">{p.data.title}</p>
              <p class="mt-2 line-clamp-3 text-xs leading-relaxed text-ink-500">{p.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <CtaSection
    heading="Want this applied to your business?"
    body="Book a free strategy call — we'll turn the ideas in this article into a concrete plan with numbers attached."
  />
</Base>
