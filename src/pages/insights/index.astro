---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaSection from '../../components/CtaSection.astro';

const posts = (await getCollection('insights', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const categoryLabels: Record<string, string> = {
  'market-notes': 'Market Notes',
  'ai-for-business': 'AI for Business',
  reports: 'Reports',
};

const title = 'Insights | South Shore Market Notes & AI for Business | ICS';
const description =
  'Commercial real estate market notes for the South Shore of Massachusetts and practical AI tactics for small business owners — from Innovative Commercial Strategies.';

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={title} description={description}>
  <section class="bg-navy-900">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-teal-400">Insights</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-bold leading-tight text-white sm:text-5xl">
        The South Shore market, decoded. AI, demystified.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-navy-100/90">
        Weekly notes on the commercial market nobody else covers, plus practical AI tactics you can use this month —
        the same material from our newsletter and workshops.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <a href="/glossary/" class="lift group mb-8 flex flex-col gap-3 rounded-xl border border-brass-400/50 bg-navy-950 p-6 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="font-mono text-[11px] font-bold uppercase tracking-[0.25em] text-brass-300">The glossary · 417 terms</p>
        <p class="mt-1 font-display text-xl font-bold text-white group-hover:text-brass-300">Every word they use on you, defined.</p>
        <p class="mt-1 text-sm text-navy-100/80">Cap rate, NNN, speed to lead, source grading: plain English, the South Shore angle, and two straight answers each.</p>
      </div>
      <span class="shrink-0 text-sm font-semibold text-teal-400">Open the glossary →</span>
    </a>
    <div class="mb-6 flex flex-wrap items-center gap-2" id="ins-filter">
      <button type="button" class="ins-chip rounded-full border border-navy-100 bg-white px-3 py-1.5 text-sm font-semibold text-navy-900 hover:border-teal-500 aria-pressed:border-teal-600 aria-pressed:bg-teal-600 aria-pressed:text-white" data-cat="all" aria-pressed="true">All {posts.length}</button>
      {Object.entries(categoryLabels).map(([k, l]) => <button type="button" class="ins-chip rounded-full border border-navy-100 bg-white px-3 py-1.5 text-sm font-semibold text-navy-900 hover:border-teal-500 aria-pressed:border-teal-600 aria-pressed:bg-teal-600 aria-pressed:text-white" data-cat={k} aria-pressed="false">{l} {posts.filter((p) => p.data.category === k).length}</button>)}
      <label class="ml-auto min-w-[12rem] flex-1 sm:flex-none"><span class="sr-only">Search the Insights</span><input id="ins-q" type="search" placeholder="Search: lease, reviews, Route 24…" autocomplete="off" class="w-full rounded-md border border-navy-100 bg-white px-3 py-1.5 text-sm text-navy-900 placeholder:text-ink-500 focus:border-teal-500 focus:outline-none" /></label>
    </div>
    <p id="ins-empty" class="mb-6 hidden text-sm text-ink-500">Nothing matches. Try a shorter word, or ask in the search bar at the top of the site.</p>
    <div class="space-y-6" id="ins-list">
      {
        posts.map((post) => (
          <a
            href={`/insights/${post.id}/`}
            class="ins-card lift group block rounded-xl border border-navy-100 bg-white p-6 shadow-sm sm:p-8"
            data-cat={post.data.category}
            data-text={`${post.data.title} ${post.data.description}`.toLowerCase()}
          >
            <p class="text-xs font-semibold uppercase tracking-widest text-teal-600">
              {categoryLabels[post.data.category]} · {fmt(post.data.date)}
            </p>
            <h2 class="mt-2 text-2xl font-bold text-navy-900 group-hover:text-teal-600">{post.data.title}</h2>
            <p class="mt-2 leading-relaxed text-ink-500">{post.data.description}</p>
            <p class="mt-4 text-sm font-semibold text-teal-600">
              Read more <span aria-hidden="true">→</span>
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <CtaSection
    heading="Get this in your inbox instead"
    body="One email a week: a South Shore commercial market note and one practical AI tactic. No fluff, unsubscribe anytime — just reach out and we'll add you."
    primaryLabel="Subscribe via Contact Form"
    secondaryLabel="Attend a Workshop"
    secondaryHref="/workshops/"
  />
</Base>

<script>
  function initInsightsFilter() {
    const bar = document.getElementById('ins-filter');
    if (!bar || bar.dataset.ready) return;
    bar.dataset.ready = '1';
    const q = document.getElementById('ins-q') as HTMLInputElement;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.ins-card'));
    const chips = Array.from(bar.querySelectorAll<HTMLElement>('.ins-chip'));
    let cat = new URLSearchParams(location.search).get('cat') || 'all';
    if (!chips.some((c) => c.dataset.cat === cat)) cat = 'all';
    q.value = new URLSearchParams(location.search).get('q') || '';
    const apply = () => {
      const term = q.value.trim().toLowerCase();
      let shown = 0;
      cards.forEach((c) => {
        const on = (cat === 'all' || c.dataset.cat === cat) && (!term || (c.dataset.text || '').includes(term));
        c.hidden = !on;
        if (on) shown++;
      });
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.cat === cat)));
      document.getElementById('ins-empty')!.classList.toggle('hidden', shown > 0);
      const u = new URL(location.href);
      cat === 'all' ? u.searchParams.delete('cat') : u.searchParams.set('cat', cat);
      term ? u.searchParams.set('q', term) : u.searchParams.delete('q');
      history.replaceState(null, '', u.pathname + u.search);
    };
    chips.forEach((c) => c.addEventListener('click', () => { cat = c.dataset.cat!; apply(); }));
    q.addEventListener('input', apply);
    apply();
  }
  initInsightsFilter();
  document.addEventListener('astro:page-load', initInsightsFilter);
</script>
