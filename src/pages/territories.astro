---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { SITE } from '../config';
import { TOWNS } from '../lib/towns';
import { INDUSTRIES } from '../lib/industries';

const title = 'The Territory Board — Market Lock Exclusivity, Town by Town | ICS';
const description =
  'Market Lock is territory-exclusive: one business per category, per town. The Territory Board shows every South Shore town and every category we serve — pick yours, see whether it is open, and lock it before a competitor does. Published pricing, 12-month exclusivity, in writing.';

/**
 * Locked territories. When a Market Lock client signs, add { town, industry }
 * using the slugs from src/lib/towns.ts and src/lib/industries.ts. The board
 * shows the territory as locked — never the client's name.
 */
const claimed: { town: string; industry: string }[] = [];

const total = TOWNS.length * INDUSTRIES.length;
const locked = claimed.length;
const open = total - locked;

const faqs = [
  {
    q: 'What does "territory-exclusive" actually mean?',
    a: 'For the life of your Market Lock engagement, ICS will not build or run a Market Lock system for another business in your category in your town. Your competitor calling us gets a no — in writing. Exclusivity is by category and town, so a roofer and a dentist can both hold Brockton; two roofers cannot.',
  },
  {
    q: 'How long does a lock last?',
    a: 'Market Lock is a 12-month exclusive engagement, with first right to renew. If you choose not to renew, the territory reopens.',
  },
  {
    q: 'Can I lock more than one town or category?',
    a: 'Yes — multi-territory locks are priced per territory and scoped together, which is how a multi-location operator holds a corridor instead of a single town.',
  },
  {
    q: 'What does Market Lock cost?',
    a: 'Published: $20,000–$30,000 to build, plus $3,500–$6,000 per month, on a 12-month exclusive term. It includes the full Lead Engine (sub-60-second response, CRM, follow-up), paid media, a monthly content system, and answer-engine optimization for the territory.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base title={title} description={description} schema={schema}>
  <section class="bg-navy-950">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.25em] text-brass-300">Market Lock · Territory exclusivity · Published pricing</p>
      <h1 class="reveal mt-4 max-w-3xl text-4xl font-bold leading-tight text-white sm:text-5xl" style="--reveal-delay: 100ms">
        One business per category, per town. Whoever locks it first, keeps it.
      </h1>
      <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-navy-100/90" style="--reveal-delay: 200ms">
        Market Lock is the only system we sell that we refuse to sell twice. {TOWNS.length} South Shore towns times
        {INDUSTRIES.length} categories is {total} exclusive territories. Every one of them goes to exactly one business —
        the one that calls first. This board shows which are still open.
      </p>
      <div class="reveal mt-10 grid max-w-2xl grid-cols-3 gap-6" style="--reveal-delay: 300ms">
        {
          [
            [String(total), 'Exclusive territories'],
            [String(locked), 'Locked'],
            [String(open), 'Still open'],
          ].map(([v, l]) => (
            <div>
              <p class="font-display text-4xl font-bold text-brass-300">{v}</p>
              <p class="mt-1 text-sm text-navy-100/70">{l}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- THE BOARD -->
  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <div id="board" data-claimed={JSON.stringify(claimed)} class="rounded-2xl border border-navy-100 bg-white p-6 shadow-lg sm:p-8">
      <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-brass-600">Check a territory</p>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div>
          <label for="tb-town" class="mb-1 block text-sm font-medium text-navy-900">Town</label>
          <select id="tb-town" class="w-full rounded-md border border-navy-100 bg-white px-3 py-2.5 text-sm text-navy-900 focus:border-brass-500 focus:outline-none focus:ring-2 focus:ring-brass-500/20">
            <option value="">Select a town…</option>
            {TOWNS.map((t) => <option value={t.slug}>{t.name}</option>)}
          </select>
        </div>
        <div>
          <label for="tb-cat" class="mb-1 block text-sm font-medium text-navy-900">Category</label>
          <select id="tb-cat" class="w-full rounded-md border border-navy-100 bg-white px-3 py-2.5 text-sm text-navy-900 focus:border-brass-500 focus:outline-none focus:ring-2 focus:ring-brass-500/20">
            <option value="">Select a category…</option>
            {INDUSTRIES.map((i) => <option value={i.slug}>{i.name}</option>)}
          </select>
        </div>
      </div>

      <div id="tb-result" class="mt-6 hidden rounded-xl border border-brass-400/50 bg-navy-950 p-6">
        <p id="tb-status" class="font-mono text-[11px] font-bold uppercase tracking-[0.2em] text-brass-300"></p>
        <p id="tb-headline" class="mt-2 font-display text-2xl font-bold text-white"></p>
        <p id="tb-body" class="mt-2 text-sm leading-relaxed text-navy-100/85"></p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a id="tb-cta" href="/contact/" class="rounded-md bg-brass-500 px-5 py-2.5 text-sm font-semibold text-navy-950 transition-colors hover:bg-brass-300"></a>
          <a href="/pricing/" class="rounded-md border border-white/25 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-brass-300 hover:text-brass-300">Market Lock pricing</a>
          <a id="tb-town-link" href="/south-shore/" class="rounded-md border border-white/25 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-brass-300 hover:text-brass-300">The town page</a>
        </div>
      </div>

      <p id="tb-hint" class="mt-4 text-xs text-ink-500">Pick a town and a category. Open territories go to the first business that locks them — in writing, for 12 months.</p>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="bg-paper">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <SectionHeading
        eyebrow="How exclusivity works"
        heading="A territory is a promise we make in writing — and one we can only make once."
        body="Most agencies will happily run the same playbook for you and your competitor across the street, and take both checks. Market Lock is built on the opposite rule."
        align="center"
      />
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          [
            ['01 · One per category, per town', 'A roofer and a dentist can both hold Brockton. Two roofers cannot. The lock is by category and town, and it is written into the engagement.'],
            ['02 · Your competitor gets a no', 'While you hold the territory, a competitor in your category calling us for Market Lock is declined — and told why.'],
            ['03 · Twelve months, first right to renew', 'The term is a year. You renew first. If you walk away, the territory reopens to the next business that calls.'],
            ['04 · The whole machine, behind the lock', 'Lead Engine (sub-60-second response, CRM, follow-up), paid media, a monthly content system, and answer-engine optimization — the full stack, pointed at one territory.'],
          ].map(([h, b], i) => (
            <div class="reveal rounded-xl border border-navy-100 bg-white p-6 shadow-sm" style={`--reveal-delay: ${(i % 4) * 60}ms`}>
              <p class="font-mono text-xs font-bold text-brass-600">{h.split(' · ')[0]}</p>
              <h3 class="mt-1 text-base font-bold text-navy-900">{h.split(' · ')[1]}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-500">{b}</p>
            </div>
          ))
        }
      </div>
      <p class="mx-auto mt-8 max-w-2xl text-center text-sm text-ink-700">
        <strong class="text-navy-900">Published:</strong> $20,000–$30,000 to build + $3,500–$6,000/month · 12-month exclusive ·
        <a href="/guarantees/" class="font-semibold text-teal-600 hover:text-teal-700">written guarantees</a> apply.
      </p>
    </div>
  </section>

  <!-- THE MAP -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <SectionHeading
      eyebrow="The map"
      heading={`${TOWNS.length} towns. ${INDUSTRIES.length} categories each.`}
      body="Every town below has its own market page, written corridor by corridor. Every category has its own playbook. The lock is the intersection."
      align="center"
    />
    <div class="mt-10 grid gap-3 sm:grid-cols-3 lg:grid-cols-4">
      {
        TOWNS.map((t) => {
          const taken = claimed.filter((c) => c.town === t.slug).length;
          return (
            <a href={`/south-shore/${t.slug}/`} class="group flex items-center justify-between rounded-lg border border-navy-100 bg-white px-4 py-3 transition-colors hover:border-brass-400">
              <span class="text-sm font-semibold text-navy-900 group-hover:text-brass-600">{t.name}</span>
              <span class={`font-mono text-[11px] font-bold ${taken ? 'text-brass-600' : 'text-teal-600'}`}>{INDUSTRIES.length - taken} open</span>
            </a>
          );
        })
      }
    </div>
    <div class="mt-8 flex flex-wrap justify-center gap-2">
      {INDUSTRIES.map((i) => <a href={`/industries/${i.slug}/`} class="rounded-full border border-navy-100 bg-paper px-3 py-1 text-xs font-semibold text-navy-900 transition-colors hover:border-brass-400 hover:text-brass-600">{i.name}</a>)}
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-paper">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
      <h2 class="font-mono text-xs font-semibold uppercase tracking-[0.25em] text-brass-600">Common questions</h2>
      <dl class="mt-5 space-y-5">
        {faqs.map((f) => (
          <div>
            <dt class="text-base font-bold text-navy-900">{f.q}</dt>
            <dd class="mt-1.5 text-sm leading-relaxed text-ink-700">{f.a}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-8 text-center text-xs text-ink-500">
        Not ready for exclusivity? The <a href="/ai-services/" class="font-semibold text-teal-600 hover:text-teal-700">Lead Engine</a> runs the same response machine without the territory. Call {SITE.phone}.
      </p>
    </div>
  </section>
</Base>

<script>
  function initBoard() {
    const root = document.getElementById('board');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const claimed: { town: string; industry: string }[] = JSON.parse(root.dataset.claimed || '[]');
    const town = document.getElementById('tb-town') as HTMLSelectElement;
    const cat = document.getElementById('tb-cat') as HTMLSelectElement;
    const result = document.getElementById('tb-result')!;
    const hint = document.getElementById('tb-hint')!;

    function update() {
      if (!town.value || !cat.value) { result.classList.add('hidden'); hint.classList.remove('hidden'); return; }
      const townName = town.selectedOptions[0].textContent || '';
      const catName = cat.selectedOptions[0].textContent || '';
      const isLocked = claimed.some((c) => c.town === town.value && c.industry === cat.value);
      const status = document.getElementById('tb-status')!;
      const headline = document.getElementById('tb-headline')!;
      const body = document.getElementById('tb-body')!;
      const cta = document.getElementById('tb-cta') as HTMLAnchorElement;
      (document.getElementById('tb-town-link') as HTMLAnchorElement).href = `/south-shore/${town.value}/`;

      if (isLocked) {
        status.textContent = 'Locked';
        status.className = 'font-mono text-[11px] font-bold uppercase tracking-[0.2em] text-brass-300';
        headline.textContent = `${catName} in ${townName} is held by an ICS client.`;
        body.textContent = 'This territory is under a 12-month exclusive. We can put you first in line for renewal, or lock a neighboring town or an adjacent category today.';
        cta.textContent = 'Get in line for this territory →';
        cta.href = `/contact/?${new URLSearchParams({ interest: 'AI systems & marketing', message: `Market Lock — waitlist for ${catName} in ${townName}, MA. Please notify me if it reopens, and tell me what's adjacent.` }).toString()}`;
      } else {
        status.textContent = 'Open';
        status.className = 'font-mono text-[11px] font-bold uppercase tracking-[0.2em] text-teal-400';
        headline.textContent = `${catName} in ${townName} is open.`;
        body.textContent = `Nobody holds this territory. The first ${catName.toLowerCase()} business in ${townName} to lock it gets the whole machine — and a written no to every competitor who calls after.`;
        cta.textContent = `Lock ${catName} in ${townName} →`;
        cta.href = `/contact/?${new URLSearchParams({ interest: 'AI systems & marketing', message: `Market Lock — I want to lock ${catName} in ${townName}, MA. Published pricing is fine; let's talk scope and the 12-month term.` }).toString()}`;
      }
      try { (window as unknown as { va?: (e: string, o: unknown) => void }).va?.('event', { name: 'territory-check', data: { town: town.value, industry: cat.value, locked: isLocked } }); } catch { /* best-effort */ }
      hint.classList.add('hidden');
      result.classList.remove('hidden');
    }
    town.addEventListener('change', update);
    cat.addEventListener('change', update);
  }
  document.addEventListener('astro:page-load', initBoard);
</script>
