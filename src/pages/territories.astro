---
import Base from '../layouts/Base.astro';
import TerritoryBoard from '../components/TerritoryBoard.astro';
import { SITE } from '../config';
import { TOWNS } from '../lib/towns';
import { INDUSTRIES } from '../lib/industries';

const title = 'The Territory Board — Market Lock Exclusivity, Town by Town | ICS';
const description =
  'Market Lock is territory-exclusive: one business per category, per town. The Territory Board shows every South Shore town and every category we serve — pick yours, see whether it is open, and lock it before a competitor does. Published pricing, 12-month exclusivity, in writing.';

/**
 * Locked South Shore territories. When a Market Lock client signs, add
 * { place: '<town slug>', industry: '<industry slug>' }. The board shows the
 * territory as locked — never the client's name.
 */
const claimed: { place: string; industry: string }[] = [];

const places = TOWNS.map((t) => ({ slug: t.slug, name: t.name }));
const total = places.length * INDUSTRIES.length;
const locked = claimed.length;

const faqs = [
  { q: 'What does "territory-exclusive" actually mean?', a: 'For the life of your Market Lock engagement, ICS will not build or run a Market Lock system for another business in your category in your town. Your competitor calling us gets a no — in writing. Exclusivity is by category and town, so a roofer and a dentist can both hold Brockton; two roofers cannot.' },
  { q: 'How long does a lock last?', a: 'Market Lock is a 12-month exclusive engagement, with first right to renew. If you choose not to renew, the territory reopens.' },
  { q: 'Can I lock more than one town or category?', a: 'Yes — multi-territory locks are priced per territory and scoped together, which is how a multi-location operator holds a corridor instead of a single town.' },
  { q: 'What does Market Lock cost?', a: 'Published: $20,000–$30,000 to build, plus $3,500–$6,000 per month, on a 12-month exclusive term. It includes the full Lead Engine (sub-60-second response, CRM, follow-up), paid media, a monthly content system, and answer-engine optimization for the territory.' },
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---

<Base title={title} description={description} schema={schema}>
  <section class="bg-navy-950">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.25em] text-brass-300">Market Lock · The South Shore, MA · Published pricing</p>
      <h1 class="reveal mt-4 max-w-3xl text-4xl font-bold leading-tight text-white sm:text-5xl" style="--reveal-delay: 100ms">
        One business per category, per town. Whoever locks it first, keeps it.
      </h1>
      <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-navy-100/90" style="--reveal-delay: 200ms">
        Market Lock is the only system we sell that we refuse to sell twice. {places.length} South Shore towns times
        {INDUSTRIES.length} categories is {total} exclusive territories. Every one of them goes to exactly one business —
        the one that calls first. This board shows which are still open.
      </p>
      <div class="reveal mt-10 grid max-w-2xl grid-cols-3 gap-6" style="--reveal-delay: 300ms">
        {[[String(total), 'Exclusive territories'], [String(locked), 'Locked'], [String(total - locked), 'Still open']].map(([v, l]) => (
          <div><p class="font-display text-4xl font-bold text-brass-300">{v}</p><p class="mt-1 text-sm text-navy-100/70">{l}</p></div>
        ))}
      </div>
      <p class="reveal mt-8 text-sm text-navy-100/60" style="--reveal-delay: 360ms">
        South Florida business? <a href="/broward/territories/" class="font-semibold text-brass-300 hover:text-brass-200">The Broward County board →</a>
      </p>
    </div>
  </section>

  <TerritoryBoard market="the South Shore" state="MA" placeNoun="town" places={places} placeHrefBase="/south-shore/" claimed={claimed} />

  <section class="bg-paper">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
      <h2 class="font-mono text-xs font-semibold uppercase tracking-[0.25em] text-brass-600">Common questions</h2>
      <dl class="mt-5 space-y-5">
        {faqs.map((f) => (
          <div><dt class="text-base font-bold text-navy-900">{f.q}</dt><dd class="mt-1.5 text-sm leading-relaxed text-ink-700">{f.a}</dd></div>
        ))}
      </dl>
      <p class="mt-8 text-center text-xs text-ink-500">
        Not ready for exclusivity? The <a href="/ai-services/" class="font-semibold text-teal-600 hover:text-teal-700">Lead Engine</a> runs the same response machine without the territory. Call {SITE.phone}.
      </p>
    </div>
  </section>
</Base>
