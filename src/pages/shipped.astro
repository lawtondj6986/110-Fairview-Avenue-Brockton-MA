---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaSection from '../components/CtaSection.astro';

const title = 'The Ship Log — What ICS Built, Dated | Innovative Commercial Strategies';
const description =
  "We publish prices, guarantees, and a scoreboard — so we also publish velocity. A dated log of everything shipped on the ICS platform since launch: tools, pages, systems, and ventures. This is the tempo your project gets.";

const log: { period: string; items: { what: string; href?: string }[] }[] = [
  {
    period: 'November 18',
    items: [
      { what: 'A site index — the whole site as a directory on one page, built from the same data the pages are: every page and tool, the industries with playbooks, all eighty-one towns and cities with their sheets, the corridor guides, the comparisons, every Insight, and all 417 glossary terms by category, with Ask ICS at the top. Linked from every footer', href: '/site-index/' },
      { what: 'The 972 territory pages gained the trade map opened on the town — one map that uses both new ideas at once: colored for that category across the whole market, selected on this place with the neighbors lit, every dot a territory page, satellite underneath — and a one-click written proposal prefilled with the system, the place, and the trade from the published pricing', href: '/south-shore/rockland/medical-dental/' },
      { what: 'Every town and city page now carries the map, opened on that place — the MarketMap learned a focus: the page\'s town is selected, its neighbors are lit, the side panel reads it first, every other dot is one tap away, and the satellite layer sits underneath. Forty-one South Shore towns, twenty-four Broward cities, sixteen Palm Beach cities', href: '/south-shore/rockland/' },
      { what: 'The corridors and the articles joined the territory network — every corridor guide now ends with "which trades are open on this road": twelve rows, one chip per town, teal open or red held, each chip the territory page itself, with the open count per trade; and every Insight now lists the places it names (whole-word, in order of first mention, all three markets) as links to their pages, and recognizes sixteen more tools in its tools strip', href: '/corridors/route-18/' },
      { what: 'A map per trade — every industry page carries the South Shore map colored for that one category (teal open, red held), every dot linking straight to that town\'s territory page, the side panel reading the status for the trade, with the satellite layer underneath. The MarketMap learned an industry prop to do it; the three market maps and the corridor and board maps are unchanged', href: '/industries/trades-home-services/' },
      { what: 'The Fit Finder lands on your territory — after the four questions, a South Shore or South Florida business picks its town and its trade and the match becomes the exact territory page, with the open-or-held status right there (the trade is pre-guessed from the answers). Also fixed the finder\'s "28 towns" to the forty-one it actually serves', href: '/start/' },
      { what: 'This Month — one page that answers "what should my trade be doing right now": one line per industry for the current month from the playbooks, South Shore or South Florida, with the number to watch and the first thing to switch on, flip ahead to any month (?m=mar) and the page updates itself on the first. Ask ICS answers "what should I do this month" with it, and a town-plus-trade question now lands on that territory\'s own page first', href: '/this-month/' },
      { what: 'Every territory has its own page — 972 of them, one per trade per town at /south-shore/[town]/[industry]/: the live Market Lock status for that pair, the town\'s business read and corridors, where that trade leaks money with the monthly number, the three-system install with published prices, what the season is doing this month with the first three KPIs, the same trade in the towns next door with their status, three answered questions, and Service, FAQPage, and BreadcrumbList schema. Then the same for Florida: 288 Broward and 192 Palm Beach pages at /broward/[city]/[industry]/ and /palm-beach/[city]/[industry]/, with the South Florida season, the systems-only line, and the Florida broker disclosure. Linked from every town and city page (twelve categories with status) and every industry page (forty-one towns and forty Florida cities with status); each shares its industry\'s card', href: '/south-shore/rockland/trades-home-services/' },
      { what: 'Six corridor-cluster market notes — the Route 18 spine from Weymouth to Bridgewater, the 3A coast from Hull to Plymouth, the Taunton ring, Route 139 and the Hanover-Rockland retail spine, Route 106 inland from Mansfield to Plympton, and Brockton\'s commercial core with what the MBTA Communities Act does to its parking lots. Each written from the town reads, linked to the town pages and corridor guides it covers, with a worked example in typical numbers and the week\'s moves', href: '/insights/' },
      { what: 'The Tour Scorecard — the twenty-fourth free tool, built for a phone in a parking lot: twenty-three things to look at when you walk a commercial building (access, visibility, parking, yard, zoning, clear height, loading, roof, structure, power, HVAC, sprinklers, septic, environmental, permits, title, accessibility, leases, expenses, capital needs, financeability), each weighted for your seat (flex, retail, office, investor) with what good looks like and the red flag. Score up to three buildings side by side; the page totals each to 100 with a verdict, names the heavy items that scored low, writes the seller questions from them, and carries it all in the link and on the device', href: '/tour-scorecard/' },
      { what: 'The Seller Brief — the Buyer Brief\'s twin and the twenty-third free tool: ten answers about the building you own (town, type, size, occupancy, leases, sewer or septic, environmental file, condition, timing, price in mind, goal) and the page writes the sale plan: the 120-day timeline with real dates that stretch for septic, a missing Phase I, estoppels, or rough condition; the file to assemble before anyone asks; how the building will be priced (income, owner-user, or land); the first three moves; the town\'s property read; and the right tools prefilled (seller net sheet with your price, cap rate, valuation, the Decoder from the landlord\'s chair). Lives in the link, sends to the founder in one click, prints. On the Free Shelf and Deal Tools (now seven seats); Ask ICS answers "sell my building"', href: '/seller-brief/' },
      { what: 'The playbooks learned the South Florida year — every industry playbook now carries a second twelve-month season for Broward and Palm Beach County (season November to April, spring break, boat-show weeks, back to school in mid-August, hurricane watch from June 1, the Fort Lauderdale show at the end of October), behind a market toggle with ?market=fl deep links; the Florida hubs point their operators at it', href: '/industries/marine-boat-services/playbook/?market=fl' },
      { what: 'The market maps now sit on satellite imagery — a Satellite toggle on all three maps (South Shore, Broward, Palm Beach) lays the existing overlay of towns, corridors, and territory layers on Esri World Imagery, the same source QuoteBrain measures on. The map was re-projected to Web Mercator so the schematic and the ground truth share one projection and line up exactly; tiles load only when asked for (nothing added to page weight otherwise), fade in as they arrive under a navy veil that keeps labels legible, the choice is remembered on the device, and ?view=satellite deep-links to it. Attribution switches with the layer', href: '/south-shore/?view=satellite' },
      { what: 'Six intelligence Insights, every one on the lawful public-records line — how to research a landlord before you sign, how to vet a contractor in Massachusetts with public records (CSL and HIC lookups, the Guaranty Fund, liens, court records), what a Deep Dossier contains section by section and what it never does, how to file a Massachusetts public records request that gets answered (the ten-day clock, fee limits, appeals), what research on a local ballot question looks like on the South Shore, and how to read an OCPF campaign finance report in fifteen minutes', href: '/insights/' },
      { what: 'Glossary wave three — sixty more terms, 417 in all: thirty on public-records craft and Massachusetts civic records (independent expenditures and PACs, Statements of Financial Interests, the conflict of interest law, Land Court, homestead declarations, judgment and mechanic\'s liens, lis pendens, permit and code-violation histories, license lookups, and the analyst\'s discipline: base rates, disconfirming evidence, structured analytic techniques, devil\'s advocacy) and thirty on development, valuation, and retail real estate (adaptive reuse, assemblage, the three appraisal approaches, entitlements, density bonuses, drive-thru stacking, TOD, truck courts, underwriting, property tax abatements)', href: '/glossary/' },
      { what: 'Twelve long-form Insights in one night, each 1,300 to 1,500 words with four answered questions and the tools linked in the body — six for operators (how missed-call text-back actually works, the 25-point Google Business Profile audit, why review velocity beats review count, texting customers legally in Massachusetts, the first hour after a bad review, the South Shore small-business marketing calendar) and six market notes (the MBTA Communities Act for commercial owners, how to read an offering memorandum in twenty minutes, the 120-day timeline for selling a South Shore building, Route 24 or Route 3 by trade and customer, what a tenant does the week the building sells, and flex space for a 5,000-square-foot owner-user)', href: '/insights/' },
      { what: 'Six honest head-to-heads at /compare/[slug]/ — ICS against buying shared leads, a human answering service, hiring a marketing person, the franchise marketing program, buying the software yourself, and a freelancer or a friend. Each: what the alternative is in a fair paragraph, typical cost against the published price, an eight-row side-by-side, when the alternative is the right call and when it is not, the costs that never show on the invoice, four questions to ask them (and us), three straight answers, and a worked South Shore example with numbers. Linked from the comparison hub; Ask ICS answers "angi", "answering service", "franchise", "hubspot", and "my nephew"; each has its own share card', href: '/compare/' },
      { what: 'Glossary wave two — sixty more terms, 357 in all: thirty commercial real estate terms from as-built drawings and bridge loans to kick-out clauses, work letters, building class, and cross-default (every clause the Lease Clause Decoder links to now has its page), and thirty AI and operations terms from API integration and call-recording consent (Massachusetts is all-party) to AI Overviews, text-to-pay, and unit economics', href: '/glossary/' },
      { what: 'The Lease Clause Decoder — the twenty-second free tool: forty clauses from a South Shore commercial lease in plain English, each with what the tenant wants, what the landlord wants, the red flags, the sample language you will recognize on the page, the exact ask (copy button), and the glossary terms behind it. Pick your chair and the page highlights your side; filter by group or "worth the fight"; search. Tick the clauses in your lease and it assembles the questions list for your attorney, in the link, on the device, copyable and printable. Linked from the Free Shelf and Deal Tools; Ask ICS knows "clause", "guaranty", "holdover", and friends', href: '/lease-clauses/' },
      { what: 'The glossary grew from 175 terms to 297 — 122 new entries in one night, each with the South Shore angle, a worked example with numbers, and two answered questions: 60 commercial real estate terms (rent abatement to waterfall distribution, with the Massachusetts land-use set: MBTA Communities Act, Chapter 40R, Conservation Commission and Orders of Conditions, AULs, perc tests, municipal lien certificates), 40 AI and marketing terms (AI receptionist to zero-click search, with TCPA consent and review gating stated plainly), 22 intelligence-craft terms (adverse media to web archives, every one on the lawful public-records line), and eight platform terms (canonical URLs, robots.txt, PWAs, WCAG). The Fluency Test pool, the answers index (1,208 entries), related-term links, and llms.txt grew with it', href: '/glossary/' },
      { what: 'Twelve industry playbooks — one per vertical at /industries/[slug]/playbook/: the twelve-month South Shore season with the current month marked, the five numbers with typical baselines and 90-day targets, the intake questions in order, the exact text scripts the system sends (copy buttons), the first thirty days in order, the four mistakes, owner FAQs, and the revenue leak computed from the trade\'s own numbers with a prefilled link into the Payback Calculator. Printable, shareable, linked from every industry page and the industry index, Ask ICS offers the playbook on any industry intent, and each has its own share card', href: '/industries/trades-home-services/playbook/' },
      { what: 'Palm Beach County doubled — Riviera Beach, Lake Park, North Palm Beach, Juno Beach, Tequesta, Royal Palm Beach, Greenacres, and Palm Springs join the eight: sixteen cities, 192 exclusive territories, each page written corridor by corridor. The map runs I-95 and US-1 north to Tequesta, adds Northlake Boulevard and Lake Worth Road with their own corridor guides, and every downstream system (sheets, board, City Compare, Ask ICS with nicknames like Juno and Riviera, share cards) grew on the same build', href: '/palm-beach/' },
      { what: 'Twelve more towns, the ring around Brockton — Hull, Milton, Canton, Sharon, Mansfield, Norton, Taunton, Raynham, Lakeville, Carver, Wareham, and Dedham, each written corridor by corridor with the property side, the business side, and the operator\'s read: forty-one South Shore towns, 492 exclusive territories. Every system that reads the town list grew with it on the same build: 12 new market sheets (73 total, each still one Letter page), the Territory Board, Town Compare, the Buyer Brief\'s map, Ask ICS, and the share cards. The map gained Route 138, Route 44, Route 140, the I-93 and 128 belt, and Route 228 to Hull, each with its own corridor guide (25 guides), and Routes 24, 28, and 106 now run to Taunton, Wareham, and Mansfield', href: '/south-shore/' },
    ],
  },
  {
    period: 'November 4',
    items: [
      { what: 'The share kit — every tool result can now jump to another device: a native share sheet on phones, "Send to a phone" that draws a QR code of the live URL with everything the tool has in it (the encoder loads only when asked), and text and email links with the link in the body. On the Proposal Builder, Buyer Brief, Payback Calculator, First 90 Days, all three compare tools, every market sheet, the sample report, the fluency test, every corridor guide, and the digital card. Hold the laptop up at the counter; the prospect scans; the sheet is on their phone', href: '/market-sheets/' },
      { what: 'Every seat, every market, and your voice — City Compare for Broward and Palm Beach (any two of the 32 Florida cities side by side, with open-category counts, linked from every city page and both hubs); the Buyer Brief gains the tenant seat, so a business leasing space builds a space brief with lease-side first moves (net effective rent, term and options, the use clause) and the Lease Deal Analyzer as its tool, linked from both lease calculators; and Ask ICS can be spoken to: a microphone in the palette where the browser supports it, "compare Boca and Delray" or "leasing space in Abington" said aloud lands on the right tool', href: '/broward/compare/' },
      { what: 'The Fluency Test — the twenty-first free tool and the fastest way through the glossary: ten definitions drawn at random from the 175 terms, four options from the same category, a score with a straight verdict, and a two-minute read linked for every miss. Three tracks (the deal, the pitch, the file) plus mixed, a shareable score sentence on the clipboard, and nothing recorded anywhere. Built from the glossary collection at compile time, so every new term joins the pool. Ask ICS knows "quiz" and "test"', href: '/fluency/' },
      { what: 'ICS installs like an app and works without signal — a web manifest with icons and five shortcuts (Market Sheets, Buyer Brief, Proposal, Territory Board, Call), an "Install ICS on this device" button that appears only when the browser offers it, and a service worker written at every build: pages you have opened keep working offline, hashed assets are cached once, and a new build quietly replaces the old cache. On Market Sheets, "Save all sheets for offline" pulls every one of the 61 sheets and their assets onto the phone, with progress, for a day in the field; an offline page lists what is saved on the device. The privacy page says exactly what is stored and that it never leaves the device', href: '/market-sheets/' },
      { what: 'Five articles for the day\'s tools, and smarter reading: what a buyer brief is and why an off-market hunt starts with one; what a monthly marketing report should actually show you; Route 28 or Brockton, how South Shore customers describe where they are; when a lead-response system pays for itself, the honest math; and ten questions to ask any marketing vendor before you sign, with our answers. Each carries FAQ schema, so Ask ICS learned nineteen new answers. Every article now ends with a "tools in this article" strip built from the links in its own body, and "keep reading" picks the three articles that share the most vocabulary instead of the newest two', href: '/insights/' },
      { what: 'Ask ICS does things — the ⌘K palette now recognizes what you are asking for and offers the tool that does it, pre-filled: "find me a flex building in Brockton" opens the Buyer Brief with Brockton selected; "print the Boca Raton sheet" opens the market sheet; "is medical open in Quincy" deep-links the Territory Board to that town and category; "compare Abington and Rockland" opens Town Compare; "when does Lead Engine pay back" opens the Payback Calculator on that system; a corridor name opens its guide; a town alone offers its page, sheet, board, and brief. Sixty-one places with aliases (Boca, Ft Lauderdale, West Palm), twelve industries by the words people use (plumber, dentist, marina), twenty corridors, and the three systems, all compiled from the same data files the tools read. Enter opens the first action. Plus the Fit Finder result now links the first ninety days and the payback for its match', href: '/?ask=Find+me+a+flex+building+in+Brockton' },
      { what: 'The Payback Calculator — the twentieth free tool and the other side of the Revenue Leak: your average job, your margin, your own assumption about extra jobs a month, against the published prices for all three systems at once; the page shows how many extra jobs cover each retainer, the month the build pays back, and the first-year net at the low and high ends of every range, with a twelve-month cumulative cash chart (click a system to bring it forward, hover a month), a table view, a shareable link, print, and a one-click "bring these numbers to Daniel." It reads the same price table as the pricing page and says plainly that nothing here is a revenue guarantee', href: '/payback/' },
      { what: 'The First 90 Days — the second question after price, answered in order with dates: pick a system and read the ninety days phase by phase (what we do, what we need from you, what you have at the end, and the written guarantee that attaches), with a kickoff access checklist that remembers your ticks in your browser and turns into a message to the founder listing what is ready and what is not. Linked from the Proposal Builder\'s kickoff line (system carried over), the pricing band, the Operator Session card, the sample monthly report, and the footer', href: '/first-90-days/' },
      { what: 'Corridor Guides — twenty pages for the named routes that organize commerce on the three maps (seven South Shore routes from Route 3 to Route 106, eight Broward corridors, five in Palm Beach County): the read on the road, who does business along it, the advisor\'s note, the towns or cities on it in order with market page, market sheet, and open-category count, listings on the route, and the interactive map with that corridor lit and its places matched (a new highlight mode: hovers borrow the light and hand it back). Every town and city page now links its corridor guides; the hubs list them under the map; Massachusetts corridors open a buyer brief with their towns pre-selected', href: '/corridors/' },
      { what: 'Build a Buyer Brief — the nineteenth free tool and the real estate side\'s Proposal Builder: pick your seat (owner-user or investor), property types, size, budget, must-haves, timing, and financing, and your towns on the interactive map in select mode (tap to add, tap to remove). The page writes the one-page brief we would take into an off-market hunt: the spec, each chosen town\'s corridors and property read with its market sheet, the first moves tailored to the brief (SBA framed before the offer, Phase I on automotive, zoning first on land), and the right deal tool for the seat. Shareable link, print, one-click send to the founder with the brief in the message. Linked from the CRE page, every town page with the town pre-selected, the deal-tools hub, the tools shelf, and the footer', href: '/buyer-brief/' },
      { what: 'The Monthly Report, a sample — what the first of the month looks like for a Lead Engine client, shown on a fictional Abington HVAC company with invented numbers and labeled as such three times: the bottom line up front, the 60-second guarantee as a hero number with a meter and the full response-time distribution, six stat tiles with deltas, leads by source and the lead-to-booked pipeline as ranked bars, a six-month trend with the go-live line and a crosshair, review velocity, money attributed, flags, what we did, what we do next, and the review date. Three months to switch between, hover and keyboard tooltips on every mark, a table view under every chart, prints to two Letter pages. Linked from the AI Systems page, the Proposal Builder, and the footer', href: '/monthly-report/sample/' },
      { what: 'Market Sheets — the eighteenth free tool and the leave-behind: one print-ready US Letter page for every one of the 61 towns and cities we serve (29 South Shore, 24 Broward, 8 Palm Beach). Each sheet draws from live data only: a schematic mini-map with the place and its neighbors, the corridors, who buys there, the property side (Massachusetts), the operator\'s read, the twelve Market Lock categories marked open or held, the three systems at published pricing with the written guarantees, and a QR code generated at build time back to the live page. Print or copy-link toolbar on screen; site chrome hidden in print. Linked from every town and city page, the Proposal Builder\'s territory line, Town Compare, the tools shelf, and the footer', href: '/market-sheets/' },
    ],
  },
  {
    period: 'October 30',
    items: [
      { what: 'Palm Beach County, Boca Raton first — the second South Florida practice: a practice page, eight city pages written corridor by corridor (Boca Raton, Delray Beach, Boynton Beach, Lake Worth Beach, West Palm Beach, Palm Beach Gardens, Jupiter, Wellington), a Palm Beach Territory Board with 96 exclusive territories, the interactive map with I-95, the Turnpike, Military Trail, and Southern Boulevard, Palm Beach cities in the Proposal Builder, path memory, and the Fit Finder. Brokerage stays Massachusetts-licensed and every page says so', href: '/palm-beach/' },
      { what: 'The map, gone hard — one component now draws both markets (29 South Shore towns and 24 Broward cities with their corridors), with a find box, three layers (places, open territories, where we\'ve worked), corridor hover that lights up every town on the route, keyboard access, and ?town= deep links. On both Territory Boards the map sits above the board in select mode: click a town and the board picks it', href: '/territories/' },
      { what: 'The South Shore, as a map — a schematic SVG of all 29 towns with Routes 3, 3A, 18, 24, 28, 106, and 139 threaded through them; hover or tap a town for its read and how many Market Lock categories are still open, click through to its page or compare it. Plus the founder portrait now ships as responsive WebP (about 22 KB for an avatar instead of 177 KB) on every page it appears', href: '/south-shore/' },
      { what: 'Build Your Own Proposal — the seventeenth free tool: pick a system, a town or Broward city, and an industry, and the page writes a one-page proposal from the published pricing, the written guarantees, the timeline, the industry\'s own "why this system" copy, and live territory status, dated and signed, with print-to-PDF, a shareable link, and a one-click written-quote request. The homepage "just want numbers?" door now leads here', href: '/proposal/' },
      { what: 'Town Compare — the sixteenth free tool: any two South Shore towns side by side (corridors, property mix, business mix, the operator\'s read, neighbors) with a shareable link and a one-click "bring these two towns to Daniel." Plus live territory status on every town, industry, and Broward city page: how many Market Lock categories are still open right here, each chip deep-linking into the board', href: '/south-shore/compare/' },
    ],
  },
  {
    period: 'October 29',
    items: [
      { what: 'Ask ICS, everywhere it is needed — an inline question box on the glossary, the answers page, the contact page (ask before you write), and the 404; a question with no instant answer becomes a pre-written message to the founder in one click, and every question asked is logged as an analytics event so we learn what people actually want to know. Plus a larger, framed founder portrait on the mobile hero', href: '/answers/' },
      { what: 'The Glossary teaches while you read — a build-time pass over every article, case study, and glossary entry links the first mention of any of the 175 terms to its page, with the one-line definition on hover. Hundreds of contextual links, zero authoring, and a term can only ever link to a page that exists', href: '/insights/how-to-read-a-commercial-lease/' },
      { what: 'The Glossary — 170-plus terms from the deal, the pitch, and the file (cap rate to speed to lead to source grading), each with a plain definition, why it matters on the South Shore, and two straight answers that feed Ask ICS automatically. Plus 24 Broward city pages written corridor by corridor, the Territory Board deep-linking to each, and five new long-form articles: reading a commercial lease, cap rates on the South Shore, Phase I assessments in Massachusetts, speed to lead, and NNN versus gross leases', href: '/glossary/' },
      { what: 'The short version — ten seconds of truth under the hero of nine long selling pages (AI systems, CRE, intelligence, political, retail, platforms, Broward, partners, private clients): one number, three facts, and "skip to" links to pricing, proof, the tool, or the call. Read it and leave, or read it and keep going. Nothing below it got longer', href: '/ai-services/' },
      { what: 'Ask ICS — the ⌘K search now answers questions. Every FAQ on the site (44 pages\' worth) and every published price are gathered at build time into one static index, so typing "what does Lead Engine cost?" or "is ICS licensed in Florida?" returns the answer itself, citing the page it lives on, before the page results. Five suggested questions to start; a ?ask= link opens the box pre-asked. Runs in the browser, no backend, can\'t say anything the site doesn\'t', href: '/?ask=What+does+Lead+Engine+cost%3F' },
      { what: 'The site remembers you — browser-only path memory: every page notes which practice you were in, the Fit Finder notes your match, and a return visit to the homepage gets one quiet line ("Welcome back. Last time you were looking at AI revenue systems — the Fit Finder matched you with Lead Engine") with the hub, the one best next step, and "Forget this." The contact form pre-selects your interest from the same memory. Nothing leaves your browser; the privacy page says so', href: '/' },
    ],
  },
  {
    period: 'October 19',
    items: [
      { what: 'The attention diet — the homepage went from fourteen sections, 2,067 words, and 43 links to a ten-beat story (hero, three doors, two engines, proof, pricing, territory, guarantees, the other desks, the letter, the call). Case studies, owners\' words, and the two live platforms share one proof section; four practices became one quiet row. The footer\'s 70-link column became three short columns plus a fold-away town list, and the top nav dropped from nine items to seven. Nothing was deleted from the site — only from the first screen', href: '/' },
    ],
  },
  {
    period: 'October 14',
    items: [
      { what: 'A Letter from Daniel — the founder in the first person, on the homepage where the about-teaser used to be and at its own shareable, printable address: what he believes, what he built, why he publishes prices and answers his own phone. "Reply to this letter" lands in the contact form already addressed to him', href: '/letter/' },
      { what: 'The founder\'s page, rebuilt as a bio — Boston University School of Management \'08 (Entrepreneurship & Marketing), serial founder, licensed advisor, builder: a credentials grid, the three operating ventures, five "who is Daniel Lawton" questions with FAQ schema, and a full schema.org Person (alumniOf, degree and license credentials, affiliations) that every article byline and the business record now point at by one @id. Also reachable at /daniel-lawton/', href: '/about/' },
    ],
  },
  {
    period: 'October 12',
    items: [
      { what: 'The Deep Dossier premier tier — public-figure and deal files with a published analytic-tradecraft layer: source grading, confidence levels, competing hypotheses, BLUF briefings', href: '/intelligence/dossier/' },
      { what: 'A sample Deep Dossier — a fully fictional, clearly-labeled excerpt showing the standard: BLUF, a beneficial-ownership map, A–F/1–6 source grades, stated confidence, and a worked competing-hypotheses finding', href: '/intelligence/dossier/sample/' },
      { what: 'The Intelligence Scoper — a free, no-email, 60-second router that matches your situation to the right desk (commercial brief, Deep Dossier, political, self-check, or a confidential scope) with an indicative price band', href: '/intelligence/scope/' },
      { what: 'The Confidential Capabilities Brief — a one-page, print-ready leave-behind for the intelligence practice: the four desks and their price bands, the analytic standards, the lines, the proof, and a QR to save the founder — one link to send or hand across a table', href: '/intelligence/brief/' },
      { what: 'Rebuilt the contact form — a real, progressively-enhanced lead form with inline validation, a spam honeypot, and an inline success state: pre-fills your email app today, and flips to one-click hosted capture the moment an endpoint is set', href: '/contact/' },
      { what: 'What an AI lead-response system actually costs — an answer-engine strike article with real market ranges and published pricing, plus a reusable FAQ-schema upgrade so every future article carries FAQPage structured data', href: '/insights/what-does-ai-lead-response-cost/' },
      { what: 'Seller Net Proceeds calculator — a free CRE tool answering every seller\'s first question: after payoff, commission, MA transfer tax, and closing costs, what you actually walk away with — the thirteenth tool on the Free Shelf', href: '/seller-net/' },
      { what: 'Answer-engine hardening — published pricing made machine-readable (a schema.org OfferCatalog with real price ranges on the homepage and pricing page), plus a robots.txt that explicitly welcomes AI crawlers and points them at llms.txt. So ChatGPT, Perplexity, and Google AI can cite our actual numbers', href: '/pricing/' },
      { what: 'How much is a commercial real estate commission in Massachusetts? — an answer-engine strike article demystifying brokerage fees (ranges, who pays, what\'s negotiable), with FAQ schema, pairing with the Seller Net calculator', href: '/insights/commercial-real-estate-commission-massachusetts/' },
      { what: 'Shareable, printable calculator results — the Seller Net and Lease vs. Buy tools now encode your scenario in the link, so you can copy it to a partner or accountant (they land on the same numbers) or save it as a PDF', href: '/seller-net/' },
      { what: 'Every lead form on the site now best-in-class — the political desk\'s confidential intake joins the contact form with an in-place submit and inline confirmation, so nobody is bounced off-site; plus a full integrity sweep after ten rapid builds', href: '/political/' },
      { what: 'How to vet a business partner before a deal, and what it costs — the commercial-intelligence desk gets its top-of-funnel: the six public-record checks, honest market price tiers, the legal lines, with FAQ schema, feeding the checklist, calculator, scoper, and Deep Dossier', href: '/insights/how-to-vet-a-business-partner-before-a-deal/' },
