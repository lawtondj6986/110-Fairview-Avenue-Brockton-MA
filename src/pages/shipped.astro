---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaSection from '../components/CtaSection.astro';

const title = 'The Ship Log — What ICS Built, Dated | Innovative Commercial Strategies';
const description =
  "We publish prices, guarantees, and a scoreboard — so we also publish velocity. A dated log of everything shipped on the ICS platform since launch: tools, pages, systems, and ventures. This is the tempo your project gets.";

const log: { period: string; items: { what: string; href?: string }[] }[] = [
  {
    period: 'October 14',
    items: [
      { what: 'The founder\'s page, rebuilt as a bio — Boston University School of Management \'08 (Entrepreneurship & Marketing), serial founder, licensed advisor, builder: a credentials grid, the three operating ventures, five "who is Daniel Lawton" questions with FAQ schema, and a full schema.org Person (alumniOf, degree and license credentials, affiliations) that every article byline and the business record now point at by one @id. Also reachable at /daniel-lawton/', href: '/about/' },
    ],
  },
  {
    period: 'October 12',
    items: [
      { what: 'The Deep Dossier premier tier — public-figure and deal files with a published analytic-tradecraft layer: source grading, confidence levels, competing hypotheses, BLUF briefings', href: '/intelligence/dossier/' },
      { what: 'A sample Deep Dossier — a fully fictional, clearly-labeled excerpt showing the standard: BLUF, a beneficial-ownership map, A–F/1–6 source grades, stated confidence, and a worked competing-hypotheses finding', href: '/intelligence/dossier/sample/' },
      { what: 'The Intelligence Scoper — a free, no-email, 60-second router that matches your situation to the right desk (commercial brief, Deep Dossier, political, self-check, or a confidential scope) with an indicative price band', href: '/intelligence/scope/' },
      { what: 'The Confidential Capabilities Brief — a one-page, print-ready leave-behind for the intelligence practice: the four desks and their price bands, the analytic standards, the lines, the proof, and a QR to save the founder — one link to send or hand across a table', href: '/intelligence/brief/' },
      { what: 'Rebuilt the contact form — a real, progressively-enhanced lead form with inline validation, a spam honeypot, and an inline success state: pre-fills your email app today, and flips to one-click hosted capture the moment an endpoint is set', href: '/contact/' },
      { what: 'What an AI lead-response system actually costs — an answer-engine strike article with real market ranges and published pricing, plus a reusable FAQ-schema upgrade so every future article carries FAQPage structured data', href: '/insights/what-does-ai-lead-response-cost/' },
      { what: 'Seller Net Proceeds calculator — a free CRE tool answering every seller\'s first question: after payoff, commission, MA transfer tax, and closing costs, what you actually walk away with — the thirteenth tool on the Free Shelf', href: '/seller-net/' },
      { what: 'Answer-engine hardening — published pricing made machine-readable (a schema.org OfferCatalog with real price ranges on the homepage and pricing page), plus a robots.txt that explicitly welcomes AI crawlers and points them at llms.txt. So ChatGPT, Perplexity, and Google AI can cite our actual numbers', href: '/pricing/' },
      { what: 'How much is a commercial real estate commission in Massachusetts? — an answer-engine strike article demystifying brokerage fees (ranges, who pays, what\'s negotiable), with FAQ schema, pairing with the Seller Net calculator', href: '/insights/commercial-real-estate-commission-massachusetts/' },
      { what: 'Shareable, printable calculator results — the Seller Net and Lease vs. Buy tools now encode your scenario in the link, so you can copy it to a partner or accountant (they land on the same numbers) or save it as a PDF', href: '/seller-net/' },
      { what: 'Every lead form on the site now best-in-class — the political desk\'s confidential intake joins the contact form with an in-place submit and inline confirmation, so nobody is bounced off-site; plus a full integrity sweep after ten rapid builds', href: '/political/' },
      { what: 'How to vet a business partner before a deal, and what it costs — the commercial-intelligence desk gets its top-of-funnel: the six public-record checks, honest market price tiers, the legal lines, with FAQ schema, feeding the checklist, calculator, scoper, and Deep Dossier', href: '/insights/how-to-vet-a-business-partner-before-a-deal/' },
      { what: 'Lead capture and booking now switch on from the Vercel dashboard — one environment variable flips every form on the site (contact, listings, political intake) to live hosted capture, no code edit, no git. The last lever, reduced to a paste' },
      { what: 'llms-full.txt — the entire site\'s text in one file for answer engines, regenerated from the finished HTML at every build so it can never go stale. The companion to llms.txt, linked from it and from robots.txt', href: '/llms-full.txt' },
      { what: 'Core Web Vitals pass — found and fixed a font-swap layout shift on prose pages (CLS 0.150 → 0.000 by preloading the two brand fonts) and a squeezed header logo; Lighthouse now 100 / 100 / 96 / 100 on the pages that matter, and the CI gate was widened to guard the new pages', href: '/shipped/' },
      { what: 'Accessibility to 100 — three real barriers fixed: the site-wide search button\'s accessible name now contains its visible label (speech-input users), the small assumption notes on every dark calculator panel now meet contrast, and the contact form\'s heading sits correctly under the page title', href: '/contact/' },
      { what: 'Eight new town market pages — Randolph, Holbrook, Weymouth, Braintree, Hingham, Hanover, Norwell, Pembroke — written corridor by corridor, cross-linked to their neighbors, with the schema service area synced: twenty-four South Shore towns total', href: '/south-shore/' },
      { what: 'Five new industry pages for the AI-systems line — Fitness & Studios, Veterinary & Pet Services, Childcare & Early Education, Marine & Boat Services (the coastal niche), and licensed Cannabis & Regulated Retail — each mapping that vertical\'s revenue leaks to the install: twelve industries total', href: '/industries/' },
      { what: 'Why serious candidates research themselves first — the political desk\'s second answer-engine article: what a vulnerability study is, what it finds, why it saves campaigns, when to run it, and the published price, with FAQ schema, feeding the Vulnerability Audit and the free self-check', href: '/insights/why-candidates-research-themselves-first/' },
      { what: 'Quincy and the coast — five more town market pages (Quincy, Marshfield, Duxbury, Scituate, Cohasset), closing the gap the marine-services page opened and adding the South Shore\'s largest city: twenty-nine towns total', href: '/south-shore/' },
      { what: 'Cap Rate & NOI calculator — the investor\'s first-pass underwrite: NOI, going-in cap rate, debt service, cash flow, cash-on-cash, DSCR flagged against what lenders want, and the value at your target cap; shareable and printable — the fourteenth tool on the Free Shelf', href: '/cap-rate/' },
      { what: 'Every Seat at the Table — the Lease Deal Analyzer (net effective rent from both chairs: free months, TI, escalations, commission) completes the CRE toolset, and a new hub organizes all five by seat — buyer, seller, occupier, owner, landlord & tenant — each paired with the representation that follows', href: '/deal-tools/' },
      { what: '"Bring your number" is now one click — every CRE calculator\'s contact button carries the scenario and its shareable link into the contact form, pre-filled, so a lead arrives already saying what the building pencils at; the deal-tools hub is also linked from the homepage', href: '/cap-rate/' },
      { what: '"Bring your number," every desk — the Revenue Leak result now pre-fills the contact form, the Cost of Not Knowing exposure pre-fills a confidential inquiry, and the Vulnerability Self-Check carries its band and score straight into the political desk\'s intake. No result on the site ends at a blank form anymore', href: '/tools/' },
      { what: 'Run the numbers on this building — every listing now hands its own figures to the calculators: a sale listing gets "Underwrite it" (cap rate at the asking price) and "Own it vs. keep leasing"; a lease listing gets "Analyze this lease" (net effective rent on its SF and rate) and "Lease it vs. own instead." Inventory and tools, finally in the same room', href: '/listings/' },
      { what: 'OM requests now say which building — the lead form learned its context: a listing\'s "Request the offering memorandum" carries the property, address, and price in the subject, the body, and a hidden field (both email and hosted modes), with the buyer interest pre-selected; and the Ship Log\'s days-since-launch is computed at build so it can never go stale again', href: '/listings/' },
      { what: 'The Territory Board — Market Lock finally has a page and a mechanism: 29 towns × 12 categories = 348 exclusive territories; pick yours, see if it\'s open, lock it (the inquiry arrives naming the town and category). Locked territories show as locked, never who holds them', href: '/territories/' },
      { what: 'Custom Platforms — the six-figure practice gets its service page: "When the business is the software, we build the business." Two live proofs, six kinds of build, the Discovery Sprint → Build → Operate engagement, and the ownership rule; the Fit Finder now routes platform ventures here', href: '/platforms/' },
      { what: 'Partners & Referrals — a channel, for the first time: referral partners (fee in writing), a brokerage alliance for broker-to-broker referrals between licensed professionals, white-label systems for agencies and brokerages, and co-marketing with lenders, attorneys, and accountants', href: '/partners/' },
      { what: 'Fort Lauderdale & Broward County — the second market opens: AI revenue systems, retail platforms, and custom builds at the same published pricing, on the ground seasonally; brokerage stays Massachusetts-licensed and the page says so plainly', href: '/broward/' },
      { what: 'Scarcity, front and center — the Territory Board now sits on the homepage and inside the AI-systems page where Market Lock is sold: 348 exclusive territories, whoever locks it first keeps it', href: '/territories/' },
      { what: 'The Broward Territory Board — the exclusivity engine became a reusable component and the second market got its own board: 24 Broward cities × 12 categories = 288 more exclusive territories, Fort Lauderdale to Parkland, same published pricing', href: '/broward/territories/' },
      { what: 'The Fit Finder learned where you are — a fourth question (South Shore · Broward · elsewhere) routes Florida leads to the Broward practice, states honestly that brokerage is Massachusetts-only, and carries the location into the inquiry', href: '/start/' },
      { what: 'What "territory-exclusive" marketing actually means — an answer-engine article on the conflict of interest agencies don\'t disclose, the four parts of a real exclusivity clause, and the published Market Lock terms, feeding both Territory Boards', href: '/insights/what-territory-exclusive-marketing-means/' },
      { what: 'The founder, front and center — the homepage hero now carries a prominent portrait of the face of the business on the right, with the operator line and a path to the story', href: '/' },
      { what: 'The founder IS the brand, everywhere — a reusable "who you\'ll actually work with" card with the portrait now sits on all thirteen selling pages (AI systems, CRE, intelligence, political, platforms, partners, Broward, deal tools, both territory boards, pricing, retail, private clients), every article carries an author card with the portrait and bio, and every social share image now shows the founder\'s face with his name — and the card build went from 4.5 minutes to 16 seconds after profiling found resvg rasterizing one box-shadow blur 108 times', href: '/about/' },
      { what: 'Discretion & Confidentiality — the trust layer for sensitive work: confidential both directions, need-to-know handling, conflict walls, published bright lines', href: '/confidential/' },
      { what: 'Candidate Vulnerability Self-Check — a free, no-email assessment that scores a candidate’s own public-record exposure and routes to the audit', href: '/political/self-check/' },
      { what: 'Surfaced the whole intelligence practice on the homepage, and turned the intelligence page into the four-desk hub', href: '/intelligence/' },
      { what: 'The Cost of Not Knowing — a free due-diligence calculator for the intelligence arm: exposure math versus the price of a brief', href: '/intelligence/cost-of-not-knowing/' },
      { what: 'The Pre-Signing Due-Diligence Checklist — a free, printable guide to the public-record items to verify before any deal, with HowTo schema', href: '/intelligence/due-diligence-checklist/' },
      { what: 'Lease vs. Buy calculator — a free tool for the commercial real estate arm: the real multi-year cost of leasing versus owning your space', href: '/lease-vs-buy/' },
    ],
  },
  {
    period: 'October 11',
    items: [
      { what: 'The political desk — opposition research, vulnerability audits, and rapid-response from the OSINT practice, under a published methods code', href: '/political/' },
      { what: 'Campaigns added to the Fit Finder; SEO strike: "What does opposition research actually cost?" with the rate card nobody publishes', href: '/insights/what-does-opposition-research-cost/' },
      { what: 'The sample Book page — a fully fictional excerpt showing findings, footnotes, and usability ratings, DO NOT USE items included', href: '/political/sample/' },
      { what: '"What the record can document" — six finding categories on the political desk, each with its labeling discipline', href: '/political/' },
      { what: 'The Integrity Scan — the off-season product for officials and future candidates — plus the confidential intake form, merged from a parallel session', href: '/political/' },
      { what: 'The Deep Dossier — the premier intelligence tier: institutional-grade files on public figures and deals, lawful methods only', href: '/intelligence/dossier/' },
    ],
  },
  {
    period: 'October 7',
    items: [
      { what: 'Founder signature on the homepage hero — the face behind the operator line', href: '/' },
      { what: 'Press & Media Kit — boilerplate, bios, assets, and four pre-researched story angles', href: '/press/' },
    ],
  },
  {
    period: 'October 5',
    items: [
      { what: 'The Group — the holding-company view: five practices, two live ventures, the expansion map', href: '/group/' },
      { what: 'Straight Answers hub — 19 real questions answered with real numbers, structured for answer engines', href: '/answers/' },
      { what: 'Six new town market pages: Plymouth, Kingston, Halifax, Hanson, Rockland, Avon — sixteen towns total', href: '/south-shore/' },
      { what: 'Founder photo across the site — About, homepage, contact. The operator thing isn\'t a metaphor', href: '/about/' },
      { what: 'Smarter 404: site search, Fit Finder, and answers from any dead end' },
      { what: 'The Ship Log — this page. Velocity, published' },
      { what: 'The 90-Day Playbook — the whole method, free and printable, no email gate', href: '/playbook/' },
      { what: 'The Free Shelf — all the free tools on one counter', href: '/tools/' },
      { what: 'The digital card — one tap to call, text, or save the founder to your phone', href: '/card/' },
      { what: 'Full-site inspection (26/26 quality runs green), RSS feed for Insights, and "keep reading" on every article', href: '/rss.xml' },
      { what: 'The Welcome Mat — three doors under the homepage hero: new here, just browsing, just want numbers' },
    ],
  },
  {
    period: 'October 4',
    items: [
      { what: '⌘K command palette — instant search across every page, zero dependencies', },
      { what: 'Industries hub — seven vertical landing pages, each mapping that business\'s revenue leaks to the install', href: '/industries/' },
      { what: 'The Fit Finder — three questions, 45 seconds, matched system with published price. No email gate', href: '/start/' },
      { what: 'AfriPulse Times investor brief — printable, shareable, one link', href: '/afripulse/' },
      { what: 'SEO strike page: Shopify alternatives for firearms dealers — the honest comparison', href: '/insights/shopify-alternatives-firearms-dealers/' },
      { what: 'AfriPulse Times flagship showcase — case study, homepage spotlight, ventures story', href: '/case-studies/afripulse-times-media-platform/' },
      { what: 'Scoreboard upgrade: two live platforms anyone can verify, mid-page', href: '/scoreboard/' },
    ],
  },
  {
    period: 'September 24',
    items: [
      { what: 'Retail Consultants vertical — live-inventory platforms, regulated retail welcome', href: '/retail/' },
      { what: 'Outback Arms case study — named client, store-reported 300%, browsable proof', href: '/case-studies/outback-arms-retail-platform/' },
      { what: '"We didn\'t study this counter. We work it." — the counter story, published' },
      { what: 'Retail Consultants added to main navigation' },
    ],
  },
  {
    period: 'September 20–23',
    items: [
      { what: 'QuoteBrain™ 2.0 — measure a lot on satellite imagery, priced quote in 60 seconds', href: '/quotebrain/' },
      { what: 'AI Readiness Score — ten questions, graded, with a 90-day plan', href: '/ai-readiness/' },
      { what: "What's My Building Worth — free broker opinion of value, gated by nothing", href: '/building-worth/' },
      { what: 'Revenue Leak calculator — what doing nothing costs, from your own numbers', href: '/ai-services/' },
      { what: 'Ten town market pages, written corridor by corridor', href: '/south-shore/' },
      { what: 'The honest comparison page — DIY vs agency vs ICS', href: '/compare/' },
      { what: 'Private Clients practice + Commercial Intelligence (OSINT) desk', href: '/private-clients/' },
      { what: 'Social-card pipeline: every page gets a branded share image, generated at build' },
      { what: 'Quality gate: automated Lighthouse + broken-link checks on every deploy' },
    ],
  },
  {
    period: 'September 20',
    items: [
      { what: 'icsgroup.ai launched — full site live on the domain, day one', href: '/' },
    ],
  },
];

const totalShips = log.reduce((n, g) => n + g.items.length, 0);
// Days since launch (September 20, 2026), computed at build so the stat never goes stale.
const daysSinceLaunch = Math.max(1, Math.round((Date.now() - new Date('2026-09-20T12:00:00Z').getTime()) / 86400000));
---

<Base title={title} description={description}>
  <section class="bg-navy-950">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <p class="reveal font-mono text-xs font-semibold uppercase tracking-[0.25em] text-teal-400">The ship log · Updated as we ship</p>
      <h1 class="reveal mt-4 max-w-3xl text-4xl font-bold leading-tight text-white sm:text-5xl" style="--reveal-delay: 100ms">
        We publish prices. We publish results. So we publish velocity too.
      </h1>
      <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-navy-100/90" style="--reveal-delay: 200ms">
        Most agencies show you a portfolio of last year. Here's our log since launch day — every tool, page, and
        system, dated. When we guarantee your site live in 21 days, this is the operating tempo behind the promise.
      </p>
      <div class="reveal mt-10 grid max-w-2xl grid-cols-3 gap-6" style="--reveal-delay: 300ms">
        {
          [
            [`${totalShips}`, 'Ships logged since launch'],
            [`${daysSinceLaunch} days`, 'Since launch day'],
            ['2', 'Ventures running in production'],
          ].map(([v, l]) => (
            <div>
              <p class="font-display text-4xl font-bold text-teal-400">{v}</p>
              <p class="mt-1 text-sm text-navy-100/70">{l}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <div class="relative border-l-2 border-teal-500/30 pl-8">
      {
        log.map((group) => (
          <div class="relative mb-12">
            <span class="absolute -left-[41px] top-1 h-4 w-4 rounded-full border-2 border-teal-500 bg-white" aria-hidden="true" />
            <h2 class="font-mono text-sm font-bold uppercase tracking-[0.2em] text-teal-600">{group.period}</h2>
            <ul class="mt-4 space-y-3">
              {group.items.map((item) => (
                <li class="reveal flex items-start gap-3 rounded-lg border border-navy-100 bg-white p-4 shadow-sm">
                  <span class="mt-0.5 font-mono text-xs font-bold text-teal-600">▲</span>
                  <span class="text-sm leading-relaxed text-ink-700">
                    {item.what}
                    {item.href && (
                      <a href={item.href} class="ml-2 whitespace-nowrap font-semibold text-teal-600 hover:text-teal-700">
                        see it →
                      </a>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <p class="rounded-xl border border-navy-100 bg-paper p-5 text-center text-sm text-ink-700">
      The log only counts what's live — if it's listed, you can click it on this site right now.
      Client work ships on the same tempo and lands on the <a href="/scoreboard/" class="font-semibold text-teal-600 hover:text-teal-700">scoreboard</a>.
    </p>
  </section>

  <CtaSection
    heading="Your project, at this tempo."
    body="21 days to launch isn't a stretch goal — it's the pace you just scrolled through. Book the call and put your business on the log."
  />
</Base>
