---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { SITE } from '../config';

const title = 'Private Clients & Mid-Size Companies | Innovative Commercial Strategies';
const description =
  'Quiet, portfolio-level service for high-net-worth property owners, family companies, and mid-size operations on the South Shore and beyond: discreet representation, portfolio opinions of value, and revenue systems built across locations — scoped privately, measured honestly.';

const pillars = [
  {
    name: 'Portfolio & asset strategy',
    body: 'Opinions of value across a portfolio, not one building at a time. Acquisition and disposition sequencing, hold-versus-sell analysis with real numbers, and marketing built for the asset — not the template. We think in decades because our clients do.',
  },
  {
    name: 'Discreet representation',
    body: "Some mandates should never appear on a website — including this one. Off-market acquisition and quiet disposition, qualified counterparties only, confidentiality as the default rather than the exception. Much of our best work is invisible here, by design.",
  },
  {
    name: 'Open-source intelligence (OSINT)',
    body: 'Decision-grade research before you commit: property histories and ownership chains, permits, liens and litigation records, counterparty and vendor vetting, competitive landscapes — and an honest read on what the open internet and AI assistants say about you. Public sources, lawful methods, findings in writing.',
  },
  {
    name: 'Systems across the whole operation',
    body: 'The same revenue systems we install for Main Street, engineered for scale: multi-location rollouts, operations automation across teams, portfolio-level dashboards, and AI visibility programs that cover every market you operate in.',
  },
];

const principles = [
  ['Written scope, always', 'Private engagements are scoped to the mandate rather than a menu — but you will always know cost, deliverables, and the measure of success in writing before committing.'],
  ['Measured, even in private', 'The public scoreboard covers our standard systems. Private work is held to the same habit: agreed metrics, reviewed on a schedule, reported plainly — including when we miss.'],
  ['Everything remains yours', 'Entities, data, code, accounts, relationships. Our written ownership guarantee applies at every scale, and it matters more at this one.'],
  ['One accountable person', "You work with the founder. Where the mandate needs specialists — counsel, appraisers, 1031 intermediaries, lenders — we coordinate them, but accountability never diffuses."],
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Private Client & Mid-Market Services',
    provider: { '@type': 'RealEstateAgent', name: SITE.name, telephone: SITE.phone },
    areaServed: 'South Shore, Massachusetts',
    audience: { '@type': 'Audience', audienceType: 'High-net-worth property owners, family companies, mid-size businesses' },
    description,
  },
];
---

<Base title={title} description={description} schema={schema}>
  <section class="bg-navy-950">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.25em] text-brass-300">Private clients · Mid-size companies</p>
      <h1 class="reveal mt-4 max-w-3xl text-4xl font-bold leading-tight text-white sm:text-5xl" style="--reveal-delay: 100ms">
        For owners with more at stake.
      </h1>
      <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-navy-100/90" style="--reveal-delay: 200ms">
        Portfolios, family companies, and multi-location operations ask different questions than a single storefront —
        and deserve quieter answers. This is the part of our practice built for them: scoped privately, measured
        honestly, and carried personally by the founder.
      </p>
      <div class="reveal mt-8 flex flex-wrap gap-4" style="--reveal-delay: 300ms">
        <a href="/contact/" class="rounded-md bg-brass-500 px-6 py-3 font-semibold text-navy-950 transition-colors hover:bg-brass-300">
          Request a Private Conversation
        </a>
        <a href={`tel:${SITE.phone.replace(/[^\d+]/g, '')}`} class="rounded-md border border-white/25 px-6 py-3 font-semibold text-white transition-colors hover:border-brass-300 hover:text-brass-300">
          Call {SITE.founder} Directly
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <SectionHeading
      eyebrow="The practice"
      heading="Four ways we serve at this altitude"
      align="center"
    />
    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        pillars.map((p, i) => (
          <div class="reveal lift rounded-xl border border-navy-100 bg-white p-7 shadow-sm" style={`--reveal-delay: ${(i % 2) * 70}ms`}>
            <h2 class="text-xl font-bold text-navy-900">{p.name}</h2>
            <p class="mt-3 text-sm leading-relaxed text-ink-500">{p.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- MID-SIZE TRACK -->
  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <div class="grid items-start gap-10 lg:grid-cols-2">
        <div class="reveal">
          <SectionHeading
            eyebrow="For growing & multi-location companies"
            heading="Beyond Market Lock"
            body="Our standard systems carry a business from invisible to dominant in one market. Mid-size companies need the next chapter:"
          />
          <ul class="mt-6 space-y-3">
            {
              [
                'Multi-location rollouts — one system, every branch, each market measured on its own',
                'Operations automation across teams: quoting, dispatch, invoicing, reporting',
                'AI visibility (AEO) programs covering your entire footprint, town by town',
                'Leadership dashboards that make the whole operation legible in one screen',
              ].map((item) => (
                <li class="flex gap-3 text-sm leading-relaxed text-ink-700">
                  <span class="mt-0.5 text-teal-600">→</span>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="reveal rounded-xl bg-navy-900 p-8" style="--reveal-delay: 80ms">
          <h3 class="text-xl font-bold text-white">Why there are no prices on this page</h3>
          <p class="mt-3 text-sm leading-relaxed text-navy-100/85">
            We publish pricing for our standard systems because transparency is how we prefer to work — that hasn't
            changed. Private and mid-market mandates are scoped to the situation, so a menu here would be a guess
            dressed up as a number.
          </p>
          <p class="mt-3 text-sm leading-relaxed text-navy-100/85">
            The principle survives the altitude: before you commit anything, you'll hold a written scope with cost,
            deliverables, and how we'll both know it worked. Engagements at this level typically begin with a paid
            leadership working session, credited in full if we proceed.
          </p>
          <a href="/pricing/" class="mt-5 inline-block text-sm font-semibold text-teal-400 hover:text-teal-500">
            Our published pricing, for reference →
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <SectionHeading
      eyebrow="Same principles, different altitude"
      heading="What doesn't change when the stakes go up"
      align="center"
    />
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        principles.map(([h, b], i) => (
          <div class="reveal rounded-xl border border-navy-100 bg-white p-6 shadow-sm" style={`--reveal-delay: ${i * 60}ms`}>
            <h3 class="text-lg font-bold text-navy-900">{h}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-500">{b}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-navy-950">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brass-300">A quiet first conversation</p>
      <h2 class="mx-auto mt-3 max-w-xl text-3xl font-bold text-white">
        Tell us what you're holding, and what you want it to become.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-navy-100/85">
        No deck, no pitch, no obligation — a working conversation with {SITE.founder} about the portfolio or the
        company, under confidentiality if you prefer. If we're not the right fit, we'll say so and point you to who is.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href={`mailto:${SITE.email}?subject=${encodeURIComponent('Private conversation — ICS')}`} class="rounded-md bg-brass-500 px-6 py-3 font-semibold text-navy-950 transition-colors hover:bg-brass-300">
          Email Privately
        </a>
        <a href={`tel:${SITE.phone.replace(/[^\d+]/g, '')}`} class="rounded-md border border-white/25 px-6 py-3 font-semibold text-white transition-colors hover:border-brass-300 hover:text-brass-300">
          {SITE.phone}
        </a>
      </div>
    </div>
  </section>
</Base>
