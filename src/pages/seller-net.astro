---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';

const title = 'Seller Net Proceeds Calculator — What Will You Walk Away With? | ICS';
const description =
  'Selling your commercial property? A free, no-email calculator for the question every seller asks first: after the loan payoff, the commission, Massachusetts transfer tax, and closing costs — what actually lands in your pocket? Your numbers, nothing sent anywhere.';
---

<Base title={title} description={description}>
  <section class="bg-navy-900">
    <div class="mx-auto max-w-4xl px-4 py-12 text-center sm:px-6 sm:py-16">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.25em] text-teal-400">Free · 1 minute · No email</p>
      <h1 class="reveal mx-auto mt-4 max-w-2xl text-4xl font-bold leading-tight text-white sm:text-5xl" style="--reveal-delay: 100ms">
        What will you actually walk away with?
      </h1>
      <p class="reveal mx-auto mt-4 max-w-xl text-lg leading-relaxed text-navy-100/90" style="--reveal-delay: 200ms">
        Every seller's first question — and the one listing presentations skate past. Here's the honest number after
        the payoff, the commission, Massachusetts transfer tax, and closing costs. Your figures, nothing sent anywhere.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <div id="snp" class="rounded-2xl border border-navy-100 bg-white p-6 shadow-lg sm:p-8">
      <div class="grid gap-8 lg:grid-cols-2">
        <div>
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-teal-600">The sale</p>
          <div class="mt-4 grid gap-3">
            <div><label for="snp-price" class="snp-label">Expected sale price ($)</label><input id="snp-price" type="number" min="0" step="25000" value="750000" class="snp-input" /></div>
            <div><label for="snp-payoff" class="snp-label">Remaining loan / mortgage payoff ($)</label><input id="snp-payoff" type="number" min="0" step="10000" value="300000" class="snp-input" /></div>
          </div>

          <p class="mt-6 font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-teal-600">The costs of selling</p>
          <div class="mt-4 grid gap-3">
            <div class="grid grid-cols-2 gap-3">
              <div><label for="snp-comm" class="snp-label">Broker commission (%)</label><input id="snp-comm" type="number" min="0" max="15" step="0.25" value="5" class="snp-input" /></div>
              <div><label for="snp-transfer" class="snp-label">Transfer/excise tax (%)</label><input id="snp-transfer" type="number" min="0" step="0.01" value="0.456" class="snp-input" /></div>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div><label for="snp-legal" class="snp-label">Legal &amp; closing ($)</label><input id="snp-legal" type="number" min="0" step="250" value="3500" class="snp-input" /></div>
              <div><label for="snp-credits" class="snp-label">Repairs / credits ($)</label><input id="snp-credits" type="number" min="0" step="500" value="0" class="snp-input" /></div>
            </div>
          </div>
        </div>

        <div class="flex flex-col justify-between rounded-xl border border-teal-500/40 bg-navy-950 p-6">
          <div>
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-navy-100/60"><span id="snp-head">Estimated net proceeds</span></p>
            <p id="snp-net" class="mt-2 font-display text-4xl font-bold text-teal-400">—</p>
            <p id="snp-keep" class="mt-1 text-sm font-semibold text-white"></p>
            <div id="snp-lines" class="mt-5 space-y-2 border-t border-white/10 pt-4 font-mono text-xs text-navy-100/80"></div>
          </div>
          <div class="mt-6">
            <p class="text-[11px] leading-relaxed text-navy-100/70">
              Planning estimate. Massachusetts excise tax defaults to $4.56 per $1,000 (0.456%); Barnstable County and a
              few towns differ — adjust the field. Excludes capital-gains or depreciation-recapture tax, prorated
              property taxes and rents, and any payoff penalty. We walk the exact figures on a call.
            </p>
            <div class="mt-4 flex flex-wrap gap-3">
              <a href="/building-worth/" class="rounded-md bg-teal-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-teal-500">
                Free: What's My Building Worth? →
              </a>
              <a href="/contact/" class="rounded-md border border-white/25 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-teal-400 hover:text-teal-400">
                Talk Through a Sale
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-3 print:hidden">
      <button id="snp-share" type="button" class="rounded-md border border-navy-100 px-4 py-2 text-sm font-semibold text-navy-800 transition-colors hover:border-teal-500 hover:text-teal-600">
        Copy a shareable link
      </button>
      <button id="snp-print" type="button" class="rounded-md border border-navy-100 px-4 py-2 text-sm font-semibold text-navy-800 transition-colors hover:border-teal-500 hover:text-teal-600">
        Print / Save as PDF
      </button>
      <span id="snp-copied" class="hidden text-sm font-semibold text-teal-600">Link copied — send it to your partner or accountant ✓</span>
    </div>

    <p class="mt-6 text-center text-xs text-ink-500 print:hidden">
      Thinking about selling? <a href="/commercial-real-estate/" class="font-semibold text-teal-600 hover:text-teal-500">See how we market and represent sellers →</a>
    </p>
  </section>
</Base>

<style>
  @media print {
    :global(header),
    :global(footer),
    :global(#money-bar) { display: none !important; }
    :global(body) { background: white !important; }
    :global(.reveal) { opacity: 1 !important; transform: none !important; }
    #snp { box-shadow: none; border-color: #dbe4f0; }
  }
</style>

<style>
  .snp-input {
    width: 100%;
    border-radius: 0.375rem;
    border: 1px solid #dbe4f0;
    background: #fff;
    color: #0b1f3a;
    padding: 0.5rem 0.65rem;
    font-size: 0.875rem;
  }
  .snp-input:focus { outline: none; border-color: #14b8a6; box-shadow: 0 0 0 2px rgba(20,184,166,0.2); }
  .snp-label { display: block; margin-bottom: 0.25rem; font-size: 0.7rem; font-weight: 500; color: #5a6b82; }
</style>

<script>
  function initSNP() {
    const root = document.getElementById('snp');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const num = (id: string) => Math.max(0, +$(id).value || 0);
    const fmt = (n: number) => (n < 0 ? '-$' : '$') + Math.round(Math.abs(n)).toLocaleString('en-US');

    // URL state: short param per input, so a result is a shareable link.
    const PARAMS: Record<string, string> = {
      'snp-price': 'p', 'snp-payoff': 'pay', 'snp-comm': 'c',
      'snp-transfer': 't', 'snp-legal': 'l', 'snp-credits': 'r',
    };
    const fields = Object.keys(PARAMS);
    try {
      const q = new URLSearchParams(window.location.search);
      fields.forEach((id) => {
        const v = q.get(PARAMS[id]);
        if (v !== null && v !== '' && !Number.isNaN(+v)) $(id).value = v;
      });
    } catch { /* no-op */ }

    function syncUrl() {
      try {
        const q = new URLSearchParams();
        fields.forEach((id) => q.set(PARAMS[id], $(id).value));
        history.replaceState(null, '', `${window.location.pathname}?${q.toString()}`);
      } catch { /* no-op */ }
    }

    function update() {
      const price = num('snp-price');
      const payoff = num('snp-payoff');
      const commission = price * (num('snp-comm') / 100);
      const transfer = price * (num('snp-transfer') / 100);
      const legal = num('snp-legal');
      const credits = num('snp-credits');

      const totalCosts = commission + transfer + legal + credits;
      const net = price - payoff - totalCosts;
      const keepPct = price > 0 ? (net / price) * 100 : 0;

      const headEl = document.getElementById('snp-head')!;
      const netEl = document.getElementById('snp-net')!;
      const keepEl = document.getElementById('snp-keep')!;

      if (net < 0) {
        headEl.textContent = 'Estimated shortfall at closing';
        netEl.className = 'mt-2 font-display text-4xl font-bold text-amber-400';
        keepEl.textContent = 'The sale would not cover the payoff and costs — worth a conversation before listing.';
      } else {
        headEl.textContent = 'Estimated net proceeds';
        netEl.className = 'mt-2 font-display text-4xl font-bold text-teal-400';
        keepEl.textContent = `You keep about ${keepPct.toFixed(0)}% of the sale price`;
      }
      netEl.textContent = fmt(net);

      document.getElementById('snp-lines')!.innerHTML =
        `<div class="flex justify-between gap-3"><span class="text-navy-100/60">Sale price</span><span>${fmt(price)}</span></div>` +
        `<div class="flex justify-between gap-3"><span class="text-navy-100/60">Loan payoff</span><span>-${fmt(payoff)}</span></div>` +
        `<div class="flex justify-between gap-3"><span class="text-navy-100/60">Commission</span><span>-${fmt(commission)}</span></div>` +
        `<div class="flex justify-between gap-3"><span class="text-navy-100/60">Transfer/excise tax</span><span>-${fmt(transfer)}</span></div>` +
        `<div class="flex justify-between gap-3"><span class="text-navy-100/60">Legal &amp; closing</span><span>-${fmt(legal)}</span></div>` +
        (credits > 0 ? `<div class="flex justify-between gap-3"><span class="text-navy-100/60">Repairs / credits</span><span>-${fmt(credits)}</span></div>` : '') +
        `<div class="mt-1 flex justify-between gap-3 border-t border-white/10 pt-2 font-bold text-white"><span>Net to you</span><span>${fmt(net)}</span></div>`;
    }
    fields.forEach((id) => $(id).addEventListener('input', () => { update(); syncUrl(); }));

    const shareBtn = document.getElementById('snp-share');
    const copied = document.getElementById('snp-copied');
    shareBtn?.addEventListener('click', async () => {
      syncUrl();
      try {
        await navigator.clipboard.writeText(window.location.href);
      } catch {
        /* clipboard unavailable — the URL in the address bar still carries the scenario */
      }
      copied?.classList.remove('hidden');
      window.setTimeout(() => copied?.classList.add('hidden'), 3500);
    });
    document.getElementById('snp-print')?.addEventListener('click', () => window.print());

    update();
  }
  document.addEventListener('astro:page-load', initSNP);
</script>
