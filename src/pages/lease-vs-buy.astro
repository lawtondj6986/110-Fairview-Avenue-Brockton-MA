---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';

const title = 'Lease vs. Buy Your Commercial Space — Free Calculator | ICS';
const description =
  'Should your business lease or buy its commercial building? A free, no-email calculator that compares the real multi-year cost of leasing against owning — mortgage, equity, appreciation, and carrying costs — so you can see which wins over your actual time horizon.';
---

<Base title={title} description={description}>
  <section class="bg-navy-900">
    <div class="mx-auto max-w-4xl px-4 py-12 text-center sm:px-6 sm:py-16">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.25em] text-teal-400">Free · 1 minute · No email</p>
      <h1 class="reveal mx-auto mt-4 max-w-2xl text-4xl font-bold leading-tight text-white sm:text-5xl" style="--reveal-delay: 100ms">
        Lease it, or own it?
      </h1>
      <p class="reveal mx-auto mt-4 max-w-xl text-lg leading-relaxed text-navy-100/90" style="--reveal-delay: 200ms">
        The biggest real-estate decision most business owners ever make — and most make it on a gut feeling. Here's
        the math over your actual time horizon. Your numbers, nothing sent anywhere.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <div id="lvb" class="rounded-2xl border border-navy-100 bg-white p-6 shadow-lg sm:p-8">
      <div class="grid gap-8 lg:grid-cols-2">
        <div>
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-teal-600">If you buy</p>
          <div class="mt-4 grid gap-3">
            <div><label for="lvb-price" class="lvb-label">Purchase price ($)</label><input id="lvb-price" type="number" min="0" step="25000" value="600000" class="lvb-input" /></div>
            <div class="grid grid-cols-2 gap-3">
              <div><label for="lvb-down" class="lvb-label">Down payment (%)</label><input id="lvb-down" type="number" min="0" max="100" step="1" value="20" class="lvb-input" /></div>
              <div><label for="lvb-rate" class="lvb-label">Loan rate (%)</label><input id="lvb-rate" type="number" min="0" step="0.1" value="7" class="lvb-input" /></div>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div><label for="lvb-term" class="lvb-label">Loan term (years)</label><input id="lvb-term" type="number" min="1" step="1" value="25" class="lvb-input" /></div>
              <div><label for="lvb-appr" class="lvb-label">Appreciation (%/yr)</label><input id="lvb-appr" type="number" step="0.5" value="3" class="lvb-input" /></div>
            </div>
            <div><label for="lvb-carry" class="lvb-label">Owner carrying cost (%/yr — tax, maintenance, insurance)</label><input id="lvb-carry" type="number" min="0" step="0.5" value="2.5" class="lvb-input" /></div>
          </div>

          <p class="mt-6 font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-teal-600">If you lease</p>
          <div class="mt-4 grid grid-cols-2 gap-3">
            <div><label for="lvb-lease" class="lvb-label">Rent ($/month)</label><input id="lvb-lease" type="number" min="0" step="250" value="4000" class="lvb-input" /></div>
            <div><label for="lvb-years" class="lvb-label">Years you'll occupy</label><input id="lvb-years" type="number" min="1" step="1" value="10" class="lvb-input" /></div>
          </div>
        </div>

        <div class="flex flex-col justify-between rounded-xl border border-teal-500/40 bg-navy-950 p-6">
          <div>
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-navy-100/60">Over <span id="lvb-n">10</span> years, the cheaper path is</p>
            <p id="lvb-winner" class="mt-2 font-display text-4xl font-bold text-teal-400">—</p>
            <p id="lvb-delta" class="mt-1 text-sm font-semibold text-white"></p>
            <div id="lvb-lines" class="mt-5 space-y-2 border-t border-white/10 pt-4 font-mono text-xs text-navy-100/80"></div>
          </div>
          <div class="mt-6">
            <p class="text-[11px] leading-relaxed text-navy-100/70">
              Planning estimate. Owning includes ~4% transaction costs, the mortgage, carrying costs, and the equity
              and appreciation you keep. It excludes tax deductions (depreciation, interest), which usually favor
              owning further. Leasing assumes level rent. We model your real numbers on a call.
            </p>
            <div class="mt-4 flex flex-wrap gap-3">
              <a id="lvb-cta" href="/contact/" class="rounded-md bg-teal-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-teal-500">
                Bring This Number to Us →
              </a>
              <a href="/building-worth/" class="rounded-md border border-white/25 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-teal-400 hover:text-teal-400">
                What's a Building Worth?
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-3 print:hidden">
      <button id="lvb-share" type="button" class="rounded-md border border-navy-100 px-4 py-2 text-sm font-semibold text-navy-800 transition-colors hover:border-teal-500 hover:text-teal-600">
        Copy a shareable link
      </button>
      <button id="lvb-print" type="button" class="rounded-md border border-navy-100 px-4 py-2 text-sm font-semibold text-navy-800 transition-colors hover:border-teal-500 hover:text-teal-600">
        Print / Save as PDF
      </button>
      <span id="lvb-copied" class="hidden text-sm font-semibold text-teal-600">Link copied — send it to your co-owner or partner ✓</span>
    </div>

    <p class="mt-6 text-center text-xs text-ink-500 print:hidden">
      Thinking about buying your space? <a href="/commercial-real-estate/" class="font-semibold text-teal-600 hover:text-teal-500">See how we represent owner-users →</a>
    </p>
  </section>
</Base>

<style>
  .lvb-input {
    width: 100%;
    border-radius: 0.375rem;
    border: 1px solid #dbe4f0;
    background: #fff;
    color: #0b1f3a;
    padding: 0.5rem 0.65rem;
    font-size: 0.875rem;
  }
  .lvb-input:focus { outline: none; border-color: #14b8a6; box-shadow: 0 0 0 2px rgba(20,184,166,0.2); }
  .lvb-label { display: block; margin-bottom: 0.25rem; font-size: 0.7rem; font-weight: 500; color: #5a6b82; }
  @media print {
    :global(header),
    :global(footer),
    :global(#money-bar) { display: none !important; }
    :global(body) { background: white !important; }
    :global(.reveal) { opacity: 1 !important; transform: none !important; }
    #lvb { box-shadow: none; border-color: #dbe4f0; }
  }
</style>

<script>
  function initLVB() {
    const root = document.getElementById('lvb');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const $ = (id) => document.getElementById(id);
    const num = (id) => Math.max(0, +$(id).value || 0);
    const fmt = (n) => '$' + Math.round(n).toLocaleString('en-US');

    const PARAMS = {
      'lvb-price': 'pr', 'lvb-down': 'dp', 'lvb-rate': 'rt', 'lvb-term': 'tm',
      'lvb-appr': 'ap', 'lvb-carry': 'cy', 'lvb-lease': 'ls', 'lvb-years': 'yr',
    };
    const fields = Object.keys(PARAMS);
    try {
      const q = new URLSearchParams(window.location.search);
      fields.forEach((id) => {
        const v = q.get(PARAMS[id]);
        if (v !== null && v !== '' && !Number.isNaN(+v)) $(id).value = v;
      });
    } catch (e) { /* no-op */ }

    function shareUrl() {
      const q = new URLSearchParams();
      fields.forEach((id) => q.set(PARAMS[id], $(id).value));
      return window.location.pathname + '?' + q.toString();
    }
    function syncUrl() {
      try { history.replaceState(null, '', shareUrl()); } catch (e) { /* no-op */ }
    }
    // "Bring your number": the contact CTA carries the scenario and its link into the form.
    function setCta(summary) {
      const cta = document.getElementById('lvb-cta');
      if (!cta) return;
      const message = summary + '\nScenario link: ' + window.location.origin + shareUrl();
      cta.href = '/contact/?' + new URLSearchParams({ interest: 'Buying commercial property', message }).toString();
    }

    function update() {
      const price = num('lvb-price');
      const downPct = num('lvb-down') / 100;
      const rate = num('lvb-rate') / 100 / 12;
      const termN = Math.max(1, num('lvb-term')) * 12;
      const appr = num('lvb-appr') / 100;
      const carry = num('lvb-carry') / 100;
      const lease = num('lvb-lease');
      const years = Math.max(1, num('lvb-years'));
      $('lvb-n').textContent = String(years);

      const loan = price * (1 - downPct);
      const down = price * downPct;
      const closing = price * 0.04;
      const powN = Math.pow(1 + rate, termN);
      const M = rate > 0 ? (loan * rate * powN) / (powN - 1) : loan / termN;
      const k = Math.min(years * 12, termN);
      const powK = Math.pow(1 + rate, k);
      const balance = rate > 0 ? (loan * (powN - powK)) / (powN - 1) : loan * (1 - k / termN);
      const mortgagePaid = M * k;
      const valueEnd = price * Math.pow(1 + appr, years);
      const equity = valueEnd - balance;
      const avgValue = price * Math.pow(1 + appr, years / 2);
      const carrying = avgValue * carry * years;
      const cashOutOwn = down + closing + mortgagePaid + carrying;
      const netOwn = cashOutOwn - equity;
      const netLease = lease * 12 * years;

      const ownWins = netOwn < netLease;
      $('lvb-winner').textContent = ownWins ? 'Owning' : 'Leasing';
      $('lvb-delta').textContent = `by about ${fmt(Math.abs(netOwn - netLease))} over ${years} years`;
      $('lvb-lines').innerHTML =
        `<div class="flex justify-between gap-3"><span class="text-navy-100/60">Net cost to own</span><span>${fmt(netOwn)}</span></div>` +
        `<div class="flex justify-between gap-3"><span class="text-navy-100/60">Net cost to lease</span><span>${fmt(netLease)}</span></div>` +
        `<div class="flex justify-between gap-3"><span class="text-navy-100/60">Monthly mortgage (P&I)</span><span>${fmt(M)}</span></div>` +
        `<div class="flex justify-between gap-3"><span class="text-navy-100/60">Equity kept at year ${years}</span><span>${fmt(equity)}</span></div>`;
      setCta(`Lease vs. buy scenario — price ${fmt(price)}, rent ${fmt(lease)}/mo, ${years} years: ${ownWins ? 'owning' : 'leasing'} wins by about ${fmt(Math.abs(netOwn - netLease))} (net cost to own ${fmt(netOwn)}, to lease ${fmt(netLease)}).`);
    }
    fields.forEach((id) => $(id).addEventListener('input', () => { update(); syncUrl(); }));

    const copied = document.getElementById('lvb-copied');
    document.getElementById('lvb-share')?.addEventListener('click', async () => {
      syncUrl();
      try { await navigator.clipboard.writeText(window.location.href); } catch (e) { /* address bar still carries it */ }
      copied?.classList.remove('hidden');
      window.setTimeout(() => copied?.classList.add('hidden'), 3500);
    });
    document.getElementById('lvb-print')?.addEventListener('click', () => window.print());

    update();
  }
  document.addEventListener('astro:page-load', initLVB);
</script>
