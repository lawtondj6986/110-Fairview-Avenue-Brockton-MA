---
/**
 * One page per Market Lock territory on the South Shore: 41 towns x 12
 * categories = 492 pages. See components/TerritoryPage.astro.
 */
import Base from '../../../layouts/Base.astro';
import TerritoryPage from '../../../components/TerritoryPage.astro';
import { TOWNS } from '../../../lib/towns';
import { INDUSTRIES } from '../../../lib/industries';
import { CLAIMED_MA, isLocked } from '../../../lib/claimed';

export function getStaticPaths() {
  return TOWNS.flatMap((town) => INDUSTRIES.map((industry) => ({ params: { town: town.slug, industry: industry.slug }, props: { town, industry } })));
}
const { town, industry } = Astro.props;
const places = TOWNS.map((t) => ({ slug: t.slug, name: t.name, county: `${t.county} County`, position: t.position, corridors: t.corridors, businessMix: t.businessMix, angle: t.angle, neighbors: t.neighbors, propertyMix: t.propertyMix }));
const place = places.find((p) => p.slug === town.slug)!;
const locked = isLocked(CLAIMED_MA, town.slug, industry.slug);
const title = `${industry.name} in ${town.name}, MA: Market Lock ${locked ? 'Held' : 'Open'} | ICS`;
const description = `${industry.name} in ${town.name}: the territory is ${locked ? 'held' : 'open'}. The local read, the install with published prices, this month's season, and the towns next door.`;
---

<Base title={title} description={description}>
  <TerritoryPage market="MA" place={place} industry={industry} places={places} claimed={CLAIMED_MA} base="/south-shore/" boardHref="/territories/" hubName="South Shore" noun="town" />
</Base>
