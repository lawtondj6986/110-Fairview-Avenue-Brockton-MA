---
import Base from '../../../layouts/Base.astro';
import MarketSheet from '../../../components/MarketSheet.astro';
import { getSheetPlace, sheetParams } from '../../../lib/sheets';
import { INDUSTRIES } from '../../../lib/industries';
import { CLAIMED_MA, lockedInPlace } from '../../../lib/claimed';
import { SITE } from '../../../config';

export async function getStaticPaths() {
  return sheetParams('MA', 'town');
}

const place = getSheetPlace('MA', Astro.params.town as string)!;
const open = INDUSTRIES.length - lockedInPlace(CLAIMED_MA, place.slug);
const title = `${place.name}, MA Market Sheet — One Printable Page | ICS`;
const description = `The one-page market sheet for ${place.name}, Massachusetts: corridors (${place.corridors.slice(0, 3).join(', ')}), who buys here, the property side, the operator's read, ${open} of ${INDUSTRIES.length} Market Lock categories open, and published pricing. Print it or save it as a PDF.`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: `${place.name}, MA Market Sheet`,
    description,
    url: `${SITE.url}${place.sheetHref}`,
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: { '@type': 'City', name: `${place.name}, Massachusetts` },
    mainEntityOfPage: `${SITE.url}${place.pageHref}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'South Shore', item: `${SITE.url}/south-shore/` },
      { '@type': 'ListItem', position: 2, name: place.name, item: `${SITE.url}${place.pageHref}` },
      { '@type': 'ListItem', position: 3, name: 'Market Sheet', item: `${SITE.url}${place.sheetHref}` },
    ],
  },
];
---

<Base title={title} description={description} schema={schema}>
  <MarketSheet market="MA" slug={place.slug} />
</Base>
