---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import CtaSection from '../../components/CtaSection.astro';
import { TOWNS, getTown } from '../../lib/towns';
import { SITE } from '../../config';

export async function getStaticPaths() {
  return TOWNS.map((t) => ({ params: { town: t.slug } }));
}

const town = getTown(Astro.params.town as string)!;
const neighbors = town.neighbors.map((slug) => getTown(slug)!).filter(Boolean);

const recentWins = (await getCollection('case-studies', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const title = `Commercial Real Estate & AI Systems in ${town.name}, MA | ICS`;
const description = `Commercial property sales, leasing, and AI revenue systems for ${town.name} MA business owners — ${town.corridors.slice(0, 3).join(', ')}. Local broker + AI builder in one advisor. Published pricing, real guarantees.`;

const faqs = [
  {
    q: `Do you handle commercial real estate in ${town.name}?`,
    a: `Yes — buyer, seller, tenant, and landlord representation across ${town.name} and the surrounding ${town.county} County towns, with a focus on sub-$3M owner-user and investment property: ${town.corridors.slice(0, 3).join(', ')} and the surrounding commercial pockets. ${SITE.license}.`,
  },
  {
    q: `What do your AI systems cost for a ${town.name} business?`,
    a: `The same published pricing we show everyone: JobSite from $6,500, Lead Engine from $12,000, Market Lock from $20,000 — each with monthly retainers and written guarantees, detailed on our pricing page. You get an exact written quote within 48 hours of a call.`,
  },
  {
    q: `Do you actually come out to ${town.name}, or is this remote?`,
    a: `We're based in Brockton and work ${town.name} in person — property walks, listing photography, on-site strategy sessions at your shop or office. The in-person Operator Session is a half-day working audit of your lead flow and operations, and it's $1,500 fully credited toward any system.`,
  },
  {
    q: `How fast can a ${town.name} business get a new website and lead system live?`,
    a: `21 days from kickoff for a JobSite build — guaranteed in writing, or we credit $1,000 per week we run late. AI lead-response systems answer every inquiry in under 60 seconds from the day they switch on.`,
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `Commercial Real Estate & AI Systems — ${town.name}, MA`,
    provider: { '@type': 'RealEstateAgent', name: SITE.name, telephone: SITE.phone, email: SITE.email },
    areaServed: { '@type': 'City', name: `${town.name}, Massachusetts` },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'South Shore', item: new URL('/south-shore/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: town.name, item: new URL(`/south-shore/${town.slug}/`, Astro.site).toString() },
    ],
  },
];
---

<Base title={title} description={description} schema={schema}>
  <section class="bg-navy-900">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-18">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.25em] text-teal-400">
        <a href="/south-shore/" class="hover:text-teal-500">South Shore</a> · {town.name}, MA · {town.county} County
      </p>
      <h1 class="reveal mt-4 max-w-3xl text-4xl font-bold leading-tight text-white sm:text-5xl" style="--reveal-delay: 100ms">
        Commercial real estate &amp; AI systems in {town.name}.
      </h1>
      <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-navy-100/90" style="--reveal-delay: 200ms">
        {town.position} One advisor who negotiates the building <em>and</em> builds the systems that make it produce —
        based in Brockton, working {town.name} in person.
      </p>
      <div class="reveal mt-8 flex flex-wrap gap-4" style="--reveal-delay: 300ms">
        <a href="/contact/" class="rounded-md bg-teal-600 px-6 py-3 font-semibold text-white shadow-lg transition-colors hover:bg-teal-500">
          Book a Free Strategy Call
        </a>
        <a href="/pricing/" class="rounded-md border border-white/25 px-6 py-3 font-semibold text-white transition-colors hover:border-teal-400 hover:text-teal-400">
          See Published Pricing
        </a>
      </div>
    </div>
  </section>

  <!-- MARKET SNAPSHOT -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <SectionHeading eyebrow="Market snapshot" heading={`How we read the ${town.name} market`} />
    <div class="mt-6 flex flex-wrap gap-2">
      {
        town.corridors.map((c) => (
          <span class="rounded-full border border-navy-100 bg-white px-4 py-1.5 text-sm font-medium text-ink-700">{c}</span>
        ))
      }
    </div>
    <div class="mt-8 grid gap-8 lg:grid-cols-2">
      <div class="reveal">
        <h3 class="font-display text-lg font-bold text-navy-900">The property side</h3>
        <p class="mt-3 leading-relaxed text-ink-500">{town.propertyMix}</p>
      </div>
      <div class="reveal" style="--reveal-delay: 80ms">
        <h3 class="font-display text-lg font-bold text-navy-900">The business side</h3>
        <p class="mt-3 leading-relaxed text-ink-500">{town.businessMix}</p>
      </div>
    </div>
    <div class="reveal mt-8 rounded-xl border-l-4 border-teal-500 bg-white p-6 shadow-sm">
      <p class="text-sm font-semibold uppercase tracking-widest text-teal-600">The ICS take</p>
      <p class="mt-2 text-lg font-medium leading-relaxed text-navy-900">{town.angle}</p>
      <p class="mt-2 text-xs text-ink-500">— {SITE.founder}, founder</p>
    </div>
  </section>

  <!-- WHAT WE DO HERE -->
  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <SectionHeading eyebrow={`For ${town.name} owners`} heading="Both engines, on your side of the table" align="center" />
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <div class="reveal lift rounded-xl border border-navy-100 bg-paper p-7">
          <h3 class="text-xl font-bold text-navy-900">Buying, selling, or leasing in {town.name}</h3>
          <ul class="mt-4 space-y-2.5 text-sm text-ink-700">
            <li class="flex gap-2"><span class="text-teal-600">✓</span> Off-market hunting across {town.corridors[0]} and the surrounding pockets</li>
            <li class="flex gap-2"><span class="text-teal-600">✓</span> Listings marketed with offering memoranda, drone media &amp; targeted campaigns</li>
            <li class="flex gap-2"><span class="text-teal-600">✓</span> Site selection with traffic, demographic &amp; comparable data</li>
            <li class="flex gap-2"><span class="text-teal-600">✓</span> SBA and financing framed before you offer</li>
          </ul>
          <a href="/commercial-real-estate/" class="mt-5 inline-block font-semibold text-teal-600 hover:text-teal-500">CRE services →</a>
          <a href="/building-worth/" class="ml-4 mt-5 inline-block font-semibold text-brass-600 hover:text-brass-500">Selling? Free opinion of value →</a>
        </div>
        <div class="reveal lift rounded-xl border border-navy-100 bg-paper p-7" style="--reveal-delay: 80ms">
          <h3 class="text-xl font-bold text-navy-900">AI systems for your {town.name} business</h3>
          <ul class="mt-4 space-y-2.5 text-sm text-ink-700">
            <li class="flex gap-2"><span class="text-teal-600">✓</span> Conversion website live in 21 days — guaranteed</li>
            <li class="flex gap-2"><span class="text-teal-600">✓</span> Every lead answered in under 60 seconds, 24/7</li>
            <li class="flex gap-2"><span class="text-teal-600">✓</span> Review engines &amp; quote follow-up that never forgets</li>
            <li class="flex gap-2"><span class="text-teal-600">✓</span> Found by Google — and recommended by AI assistants</li>
          </ul>
          <a href="/ai-services/" class="mt-5 inline-block font-semibold text-teal-600 hover:text-teal-500">AI systems →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- RECENT RESULTS -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading eyebrow="Nearby proof" heading="Recent South Shore results" />
      <a href="/case-studies/" class="font-semibold text-teal-600 hover:text-teal-500">All case studies →</a>
    </div>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {recentWins.map((entry) => <CaseStudyCard entry={entry} />)}
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
      <SectionHeading eyebrow={`${town.name} questions`} heading="Straight answers" align="center" />
      <div class="mt-8 space-y-4">
        {
          faqs.map((faq) => (
            <details class="group rounded-xl border border-navy-100 bg-paper p-6">
              <summary class="cursor-pointer list-none font-semibold text-navy-900 [&::-webkit-details-marker]:hidden">
                <span class="flex items-center justify-between gap-4">
                  {faq.q}
                  <span class="text-teal-600 transition-transform duration-150 group-open:rotate-45">+</span>
                </span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-ink-500">{faq.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- NEIGHBORS -->
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-widest text-teal-600">Also serving</p>
    <div class="mt-4 flex flex-wrap gap-3">
      {
        neighbors.map((n) => (
          <a href={`/south-shore/${n.slug}/`} class="rounded-full border border-navy-100 bg-white px-4 py-1.5 text-sm font-medium text-ink-700 transition-colors hover:border-teal-500 hover:text-teal-600">
            {n.name}
          </a>
        ))
      }
      <a href="/south-shore/" class="rounded-full border border-teal-500 px-4 py-1.5 text-sm font-semibold text-teal-600 transition-colors hover:bg-teal-600 hover:text-white">
        Full service area →
      </a>
    </div>
  </section>

  <CtaSection
    heading={`Talk to someone who actually works ${town.name}.`}
    body="One call: a straight read on your property or your systems — usually both — from the advisor who'll do the work personally."
  />
</Base>
