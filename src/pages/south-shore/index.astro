---
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CtaSection from '../../components/CtaSection.astro';
import { TOWNS } from '../../lib/towns';
import { SITE } from '../../config';

const title = 'South Shore Service Area — Commercial Real Estate & AI Systems | ICS';
const description =
  'ICS serves the South Shore of Massachusetts in person: Brockton, Abington, Whitman, Bridgewater, West Bridgewater, East Bridgewater, Stoughton, Easton, Middleborough, and Plympton — commercial property and AI revenue systems, one advisor.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'South Shore Commercial Real Estate & AI Systems',
    provider: { '@type': 'RealEstateAgent', name: SITE.name },
    areaServed: TOWNS.map((t) => ({ '@type': 'City', name: `${t.name}, Massachusetts` })),
    description,
  },
];
---

<Base title={title} description={description} schema={schema}>
  <section class="bg-navy-900">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-18">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.25em] text-teal-400">Service area</p>
      <h1 class="reveal mt-4 max-w-3xl text-4xl font-bold leading-tight text-white sm:text-5xl" style="--reveal-delay: 100ms">
        We don't "cover" the South Shore. We work it.
      </h1>
      <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-navy-100/90" style="--reveal-delay: 200ms">
        Ten towns, in person — property walks, listing shoots, and on-site strategy sessions from Brockton out. Every
        market below has its own page because every market below actually reads differently on the ground.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <SectionHeading eyebrow="Pick your town" heading="Local pages, written by someone who's been there" align="center" />
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        TOWNS.map((t, i) => (
          <a
            href={`/south-shore/${t.slug}/`}
            class="reveal lift group flex flex-col rounded-xl border border-navy-100 bg-white p-6 shadow-sm"
            style={`--reveal-delay: ${(i % 3) * 60}ms`}
          >
            <p class="text-xs font-semibold uppercase tracking-widest text-teal-600">{t.county} County</p>
            <h2 class="mt-1.5 text-xl font-bold text-navy-900 group-hover:text-teal-600">{t.name}, MA</h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-500">{t.position}</p>
            <p class="mt-4 text-xs text-ink-500">{t.corridors.slice(0, 3).join(' · ')}</p>
            <p class="mt-3 text-sm font-semibold text-teal-600">
              {t.name} market page <span aria-hidden="true">→</span>
            </p>
          </a>
        ))
      }
    </div>
    <p class="mt-8 text-center text-sm text-ink-500">
      Plus the surrounding Plymouth, Norfolk &amp; Bristol County communities — if you're near the map, call anyway.
    </p>
  </section>

  <CtaSection
    heading="Not sure your town is 'commercial enough'? It is."
    body="Sub-$3M deals and Main Street businesses are exactly what the big firms skip and exactly what we do. One call gets you a straight read."
  />
</Base>
