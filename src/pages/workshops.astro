---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaSection from '../components/CtaSection.astro';

const title = 'AI for Main Street Workshops | Free Small Business AI Training | ICS';
const description =
  'Free 45-minute "AI for Main Street" workshops for South Shore business owners — hosted with local chambers of commerce in Brockton, Bridgewater, Stoughton, and Easton. Practical AI tactics, no hype.';
---

<Base title={title} description={description}>
  <section class="bg-navy-900">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-teal-400">Workshops</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-bold leading-tight text-white sm:text-5xl">
        AI for Main Street — free, practical, no hype.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-navy-100/90">
        A 45-minute working session for South Shore business owners: what AI can actually do for a contractor, shop, or
        office today — shown live, with real examples from local businesses.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <SectionHeading
          eyebrow="What you'll leave with"
          heading="Walk out with three things you can do this month"
        />
        <ul class="mt-6 space-y-4">
          {
            [
              ['A live look at real systems', 'Actual lead-capture, review automation, and quoting workflows running in businesses like yours — not slideware.'],
              ['Your AI readiness score', 'A quick self-assessment of your lead flow, follow-up, and online presence, and where the fastest wins are.'],
              ['Three do-it-now tactics', 'Concrete steps you can implement yourself this month, whether or not you ever hire us.'],
            ].map(([heading, body]) => (
              <li class="flex gap-4">
                <span class="mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-teal-100 font-display text-sm font-bold text-teal-600">✓</span>
                <div>
                  <p class="font-semibold text-navy-900">{heading}</p>
                  <p class="mt-1 text-sm leading-relaxed text-ink-500">{body}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <p class="mt-8 text-sm text-ink-500">
          Hosted with local chambers of commerce and business groups across Brockton, Bridgewater, Stoughton, Easton,
          and neighboring towns. Sessions are free; seats are limited to keep them practical.
        </p>
      </div>

      <div class="rounded-xl bg-navy-900 p-8">
        <h2 class="text-xl font-bold text-white">Upcoming sessions</h2>
        <p class="mt-3 text-sm leading-relaxed text-navy-100/85">
          <!-- TODO: replace with real event list as workshops are scheduled -->
          The next round of chamber workshops is being scheduled now. Register your interest and we'll notify you the
          moment dates are confirmed — or request a private session for your team, association, or chamber.
        </p>
        <a
          href="/contact/"
          class="mt-6 inline-block rounded-md bg-teal-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-teal-500"
        >
          Register Interest / Request a Session
        </a>
        <div class="mt-8 border-t border-white/10 pt-6">
          <p class="text-sm font-semibold uppercase tracking-wider text-teal-400">For chambers &amp; groups</p>
          <p class="mt-2 text-sm leading-relaxed text-navy-100/85">
            We bring the whole session to you — projector-ready, tailored to your members' industries, and genuinely
            useful whether or not anyone ever becomes a client.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CtaSection
    heading="Can't wait for a workshop?"
    body="Book a free one-on-one strategy call and get the same assessment, tailored entirely to your business."
  />
</Base>
