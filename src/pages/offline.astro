---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';

const title = 'Offline | ICS';
const description = 'You are offline. Pages you have opened before, and any market sheets you saved, still work. Everything else is one bar of signal away.';
---

<Base title={title} description={description}>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <p class="font-mono text-xs font-semibold uppercase tracking-[0.25em] text-brass-600">No signal · Saved pages still work</p>
    <h1 class="mt-4 text-3xl font-bold text-navy-900 sm:text-4xl">You're offline. The sheets you saved are not.</h1>
    <p class="mt-4 text-lg text-ink-700">
      Pages you have opened on this device still open, and any market sheets you saved for offline are listed below. The
      rest of the site is back the moment you have a bar of signal.
    </p>
    <div class="mt-8 rounded-xl border border-navy-100 bg-white p-6 shadow-sm">
      <p class="font-mono text-[11px] font-bold uppercase tracking-widest text-teal-600">Saved on this device</p>
      <ul id="offline-list" class="mt-3 grid gap-2 text-sm sm:grid-cols-2"><li class="text-ink-500">Checking…</li></ul>
      <p class="mt-4 text-xs text-ink-500">To save every market sheet for a day in the field, open <a href="/market-sheets/" class="font-semibold text-teal-600">Market Sheets</a> while you have signal and tap "Save all sheets for offline."</p>
    </div>
    <p class="mt-8 text-sm text-ink-700">Need {SITE.founder} now? Call or text <a href={`tel:${SITE.phone.replace(/\D/g, '')}`} class="font-semibold text-teal-600">{SITE.phone}</a>. Phones work without the website.</p>
    <button type="button" id="offline-retry" class="mt-6 rounded-md bg-navy-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-teal-600">Try again</button>
  </section>
</Base>

<script>
  async function initOffline() {
    const list = document.getElementById('offline-list');
    if (!list || list.dataset.ready) return;
    list.dataset.ready = '1';
    document.getElementById('offline-retry')?.addEventListener('click', () => location.reload());
    try {
      const keys = (await caches.keys()).filter((k) => k.startsWith('ics-pages-'));
      const items: { url: string; title: string }[] = [];
      for (const k of keys) {
        const c = await caches.open(k);
        for (const req of await c.keys()) {
          const u = new URL(req.url);
          if (u.origin !== location.origin || u.pathname === '/offline/' || !u.pathname.endsWith('/')) continue;
          const res = await c.match(req);
          const html = res ? await res.text() : '';
          const m = html.match(/<title>([^<]*)<\/title>/);
          items.push({ url: u.pathname, title: m ? m[1].replace(/\s*\|.*$/, '') : u.pathname });
        }
      }
      items.sort((a, b) => a.title.localeCompare(b.title));
      list.textContent = '';
      if (!items.length) {
        const li = document.createElement('li');
        li.className = 'text-ink-500';
        li.textContent = 'Nothing saved yet on this device.';
        list.appendChild(li);
        return;
      }
      for (const it of items.slice(0, 120)) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = it.url;
        a.className = 'font-semibold text-navy-900 hover:text-teal-700';
        a.textContent = it.title;
        li.appendChild(a);
        list.appendChild(li);
      }
    } catch {
      list.textContent = '';
      const li = document.createElement('li');
      li.className = 'text-ink-500';
      li.textContent = 'This browser does not expose saved pages.';
      list.appendChild(li);
    }
  }
  initOffline();
  document.addEventListener('astro:page-load', initOffline);
</script>
