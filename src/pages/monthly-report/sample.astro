  const TREND = {
    labels: ['May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct'],
    leads: [31, 38, 52, 64, 79, 87],
    booked: [9, 12, 17, 22, 29, 34],
    liveIndex: 2,
  };

  const $ = (sel: string) => document.querySelector<HTMLElement>(sel)!;
  const money = (n: number) => '$' + n.toLocaleString('en-US');
  const fmtDelta = (cur: number, prev: number | undefined, upGood = true, suffix = '') => {
    if (prev === undefined) return { text: 'first month tracked', good: null as boolean | null };
    const d = cur - prev;
    const sign = d > 0 ? '+' : d < 0 ? '−' : '±';
    return { text: `${sign}${Math.abs(d)}${suffix} vs ${'prior month'}`, good: d === 0 ? null : upGood ? d > 0 : d < 0 };
  };

  let tip: HTMLElement;
  function bindTips(root: HTMLElement) {
    root.querySelectorAll<HTMLElement>('[data-tip]').forEach((el) => {
      const show = (e: Event) => {
        tip.textContent = el.dataset.tip || '';
        tip.classList.remove('hidden');
        const r = el.getBoundingClientRect();
        const pe = e as PointerEvent;
        const x = pe.clientX ? pe.clientX : r.left + r.width / 2;
        const y = pe.clientY ? pe.clientY : r.top;
        tip.style.left = Math.min(x + 12, window.innerWidth - tip.offsetWidth - 8) + 'px';
        tip.style.top = Math.max(8, y - tip.offsetHeight - 10) + 'px';
      };
      const hide = () => tip.classList.add('hidden');
      el.addEventListener('pointermove', show);
      el.addEventListener('pointerenter', show);
      el.addEventListener('pointerleave', hide);
      el.addEventListener('focus', show);
      el.addEventListener('blur', hide);
    });
  }

  function table(sel: string, head: string[], rows: (string | number)[][]) {
    const t = document.querySelector<HTMLTableElement>(sel)!;
    t.textContent = '';
    const thead = document.createElement('thead');
    const tr = document.createElement('tr');
    head.forEach((h) => {
      const th = document.createElement('th');
      th.textContent = h;
      tr.appendChild(th);
    });
    thead.appendChild(tr);
    t.appendChild(thead);
    const tb = document.createElement('tbody');
    rows.forEach((r) => {
      const tr2 = document.createElement('tr');
      r.forEach((c) => {
        const td = document.createElement('td');
        td.textContent = String(c);
        tr2.appendChild(td);
      });
      tb.appendChild(tr2);
    });
    t.appendChild(tb);
  }

  function hbars(sel: string, rows: [string, number][], total: number, unit: string) {
    const root = $(sel);
    root.textContent = '';
    const max = Math.max(...rows.map((r) => r[1]));
    rows.forEach(([label, v]) => {
      const row = document.createElement('div');
      row.className = 'row';
      const l = document.createElement('span');
      l.className = 'truncate text-sm text-ink-700';
      l.textContent = label;
      const track = document.createElement('div');
      track.className = 'track';
      const fill = document.createElement('div');
      fill.className = 'fill';
      fill.style.width = Math.max(1.5, (v / max) * 100) + '%';
      fill.tabIndex = 0;
      fill.setAttribute('role', 'img');
      const pct = Math.round((v / total) * 100);
      fill.setAttribute('aria-label', `${label}: ${v} ${unit}, ${pct} percent`);
      fill.dataset.tip = `${v} ${unit} · ${label} · ${pct}%`;
      track.appendChild(fill);
      const val = document.createElement('span');
      val.className = 'text-right text-sm font-semibold text-navy-950';
      val.style.fontVariantNumeric = 'tabular-nums';
      val.textContent = String(v);
      row.append(l, track, val);
      root.appendChild(row);
    });
    bindTips(root);
  }

  function columns(sel: string, rows: [string, number][]) {
    const root = $(sel);
    root.textContent = '';
    const cols = document.createElement('div');
    cols.className = 'cols';
    const max = Math.max(...rows.map((r) => r[1]));
    rows.forEach(([label, v], i) => {
      const col = document.createElement('div');
      col.className = 'col';
      const cap = document.createElement('span');
      cap.className = 'mb-1 text-xs font-semibold text-navy-950';
      cap.textContent = v + '%';
      const bar = document.createElement('div');
      bar.className = 'bar' + (i >= 2 ? ' late' : '');
      bar.style.height = Math.max(2, (v / max) * 100) + '%';
      bar.tabIndex = 0;
      bar.setAttribute('role', 'img');
      bar.setAttribute('aria-label', `${label}: ${v} percent of leads`);
      bar.dataset.tip = `${v}% of leads · ${label}${i >= 2 ? ' · outside the guarantee' : ''}`;
      col.append(cap, bar);
      cols.appendChild(col);
    });
    const labels = document.createElement('div');
    labels.className = 'labels';
    rows.forEach(([label]) => {
      const s = document.createElement('span');
      s.textContent = label;
      labels.appendChild(s);
    });
    const key = document.createElement('p');
    key.className = 'mt-2 flex flex-wrap gap-3 text-[11px] text-ink-500';
    const k1 = document.createElement('span');
    k1.innerHTML = '<span class="mr-1 inline-block h-2 w-2 rounded-sm bg-teal-600"></span>inside the 60-second guarantee';
    const k2 = document.createElement('span');
    k2.innerHTML = '<span class="mr-1 inline-block h-2 w-2 rounded-sm bg-brass-500"></span>outside it';
    key.append(k1, k2);
    root.append(cols, labels, key);
    bindTips(root);
  }

  function trend(sel: string) {
    const root = $(sel);
    root.textContent = '';
    const W = 720;
    const H = 240;
    const P = { l: 36, r: 64, t: 16, b: 28 };
    const n = TREND.labels.length;
    const max = 100;
    const x = (i: number) => P.l + (i * (W - P.l - P.r)) / (n - 1);
    const y = (v: number) => P.t + (1 - v / max) * (H - P.t - P.b);
    const ns = 'http://www.w3.org/2000/svg';
    const svg = document.createElementNS(ns, 'svg');
    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
    svg.setAttribute('class', 'h-auto w-full');
    svg.setAttribute('role', 'img');
    svg.setAttribute('aria-label', 'Leads and booked jobs per month, May through October');
    const el = (tag: string, attrs: Record<string, string | number>, text?: string) => {
      const e = document.createElementNS(ns, tag);
      for (const k in attrs) e.setAttribute(k, String(attrs[k]));
      if (text !== undefined) e.textContent = text;
      svg.appendChild(e);
      return e;
    };
    [0, 25, 50, 75, 100].forEach((v) => {
      el('line', { x1: P.l, x2: W - P.r, y1: y(v), y2: y(v), stroke: '#dbe4f0', 'stroke-width': 1 });
      el('text', { x: P.l - 8, y: y(v) + 4, 'text-anchor': 'end', 'font-size': 11, fill: '#64748b' }, String(v));
    });
    // Go-live marker
    el('line', { x1: x(TREND.liveIndex), x2: x(TREND.liveIndex), y1: P.t, y2: H - P.b, stroke: '#c9a227', 'stroke-width': 1.5, 'stroke-dasharray': '3 3' });
    el('text', { x: x(TREND.liveIndex) + 6, y: P.t + 10, 'font-size': 11, fill: '#856a14', 'font-weight': 600 }, 'Lead Engine live');
    TREND.labels.forEach((l, i) => el('text', { x: x(i), y: H - 8, 'text-anchor': 'middle', 'font-size': 11, fill: '#64748b' }, l));
    const path = (vals: number[]) => vals.map((v, i) => `${i ? 'L' : 'M'}${x(i)},${y(v)}`).join(' ');
    el('path', { d: path(TREND.leads), fill: 'none', stroke: '#94a3b8', 'stroke-width': 2, 'stroke-linejoin': 'round', 'stroke-linecap': 'round' });
    el('path', { d: path(TREND.booked), fill: 'none', stroke: '#0f766e', 'stroke-width': 2, 'stroke-linejoin': 'round', 'stroke-linecap': 'round' });
    const last = n - 1;
    el('circle', { cx: x(last), cy: y(TREND.leads[last]), r: 4.5, fill: '#94a3b8', stroke: '#fff', 'stroke-width': 2 });
    el('circle', { cx: x(last), cy: y(TREND.booked[last]), r: 4.5, fill: '#0f766e', stroke: '#fff', 'stroke-width': 2 });
    el('text', { x: x(last) + 10, y: y(TREND.leads[last]) + 4, 'font-size': 12, 'font-weight': 600, fill: '#334155' }, `${TREND.leads[last]} leads`);
    el('text', { x: x(last) + 10, y: y(TREND.booked[last]) + 4, 'font-size': 12, 'font-weight': 600, fill: '#334155' }, `${TREND.booked[last]} booked`);
    // Crosshair + hit zones
    const cross = el('line', { x1: 0, x2: 0, y1: P.t, y2: H - P.b, stroke: '#0b1f3a', 'stroke-width': 1, opacity: 0 });
    const d1 = el('circle', { cx: 0, cy: 0, r: 5, fill: '#94a3b8', stroke: '#fff', 'stroke-width': 2, opacity: 0 });
    const d2 = el('circle', { cx: 0, cy: 0, r: 5, fill: '#0f766e', stroke: '#fff', 'stroke-width': 2, opacity: 0 });
    const band = (W - P.l - P.r) / (n - 1);
    TREND.labels.forEach((l, i) => {
      const hit = el('rect', { x: x(i) - band / 2, y: P.t, width: band, height: H - P.t - P.b, fill: 'transparent', tabindex: 0, role: 'img', 'aria-label': `${l}: ${TREND.leads[i]} leads, ${TREND.booked[i]} booked` });
      const show = (e: Event) => {
        cross.setAttribute('x1', String(x(i)));
        cross.setAttribute('x2', String(x(i)));
        cross.setAttribute('opacity', '1');
        d1.setAttribute('cx', String(x(i)));
        d1.setAttribute('cy', String(y(TREND.leads[i])));
        d1.setAttribute('opacity', '1');
        d2.setAttribute('cx', String(x(i)));
        d2.setAttribute('cy', String(y(TREND.booked[i])));
        d2.setAttribute('opacity', '1');
        tip.textContent = `${l} 2026 · ${TREND.booked[i]} booked · ${TREND.leads[i]} leads`;
        tip.classList.remove('hidden');
        const r = (e.target as Element).getBoundingClientRect();
        const pe = e as PointerEvent;
        const cx = pe.clientX || r.left + r.width / 2;
        tip.style.left = Math.min(cx + 12, window.innerWidth - tip.offsetWidth - 8) + 'px';
        tip.style.top = Math.max(8, r.top + 8) + 'px';
      };
      const hide = () => {
        cross.setAttribute('opacity', '0');
        d1.setAttribute('opacity', '0');
        d2.setAttribute('opacity', '0');
        tip.classList.add('hidden');
      };
      hit.addEventListener('pointermove', show);
      hit.addEventListener('pointerenter', show);
      hit.addEventListener('pointerleave', hide);
      hit.addEventListener('focus', show);
      hit.addEventListener('blur', hide);
    });
    root.appendChild(svg);
    table('[data-table="trend"]', ['Month', 'Leads', 'Booked jobs'], TREND.labels.map((l, i) => [l + ' 2026', TREND.leads[i], TREND.booked[i]]));
  }

  function spark(sel: string, vals: number[]) {
    const root = $(sel);
    root.textContent = '';
    const W = 240;
    const H = 44;
    const max = Math.max(...vals, 1);
    const ns = 'http://www.w3.org/2000/svg';
    const svg = document.createElementNS(ns, 'svg');
    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
    svg.setAttribute('class', 'h-11 w-full max-w-[240px]');
    const bw = W / vals.length - 4;
    vals.forEach((v, i) => {
      const r = document.createElementNS(ns, 'rect');
      const h = Math.max(2, (v / max) * (H - 6));
      r.setAttribute('x', String(i * (W / vals.length) + 2));
      r.setAttribute('y', String(H - h));
      r.setAttribute('width', String(bw));
      r.setAttribute('height', String(h));
      r.setAttribute('rx', '2');
      r.setAttribute('fill', i === vals.length - 1 ? '#0f766e' : '#cbd5e1');
      const t = document.createElementNS(ns, 'title');
      t.textContent = `Week ${i + 1}: ${v} new review${v === 1 ? '' : 's'}`;
      r.appendChild(t);
      svg.appendChild(r);
    });
    root.appendChild(svg);
    const cap = document.createElement('p');
    cap.className = 'mt-1 text-[11px] text-ink-500';
    cap.textContent = 'New reviews per week, last twelve weeks. Current week in teal.';
    root.appendChild(cap);
  }

  function list(sel: string, items: string[]) {
    const root = $(sel);
    root.textContent = '';
    items.forEach((t) => {
      const li = document.createElement('li');
      li.className = 'flex gap-2';
      const mark = document.createElement('span');
      mark.className = 'text-teal-600';
      mark.textContent = '✓';
      const s = document.createElement('span');
      s.textContent = t;
      li.append(mark, s);
      root.appendChild(li);
    });
  }

  function flags(sel: string, items: Month['flags']) {
    const root = $(sel);
    root.textContent = '';
    items.forEach((f) => {
      const li = document.createElement('li');
      li.className = 'flex gap-2';
      const icon = document.createElement('span');
      icon.className = 'mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full text-[10px] font-bold text-white ' + (f.level === 'good' ? 'bg-teal-600' : 'bg-brass-600');
      icon.textContent = f.level === 'good' ? '✓' : '!';
      icon.setAttribute('aria-hidden', 'true');
      const s = document.createElement('span');
      const b = document.createElement('strong');
      b.className = 'text-navy-950';
      b.textContent = f.level === 'good' ? 'Good. ' : 'Watch. ';
      s.append(b, document.createTextNode(f.text));
      li.append(icon, s);
      root.appendChild(li);
    });
  }

  function kpis(m: Month, prev: Month | undefined) {
    const root = $('[data-chart="kpis"]');
    root.textContent = '';
    const items: [string, string, ReturnType<typeof fmtDelta>][] = [
      ['Leads', String(m.leads), fmtDelta(m.leads, prev?.leads)],
      ['Median first response', `${m.median} s`, fmtDelta(m.median, prev?.median, false, ' s')],
      ['Quotes sent', String(m.quoted), fmtDelta(m.quoted, prev?.quoted)],
      ['Jobs booked', String(m.booked), fmtDelta(m.booked, prev?.booked)],
      ['Quote to booked', `${Math.round((m.booked / m.quoted) * 100)}%`, fmtDelta(Math.round((m.booked / m.quoted) * 100), prev ? Math.round((prev.booked / prev.quoted) * 100) : undefined, true, ' pts')],
      ['New reviews', String(m.reviews), fmtDelta(m.reviews, prev?.reviews)],
    ];
    items.forEach(([label, value, d]) => {
      const card = document.createElement('div');
      card.className = 'rounded-lg border border-navy-100 p-3';
      const l = document.createElement('p');
      l.className = 'text-[11px] text-ink-500';
      l.textContent = label;
      const v = document.createElement('p');
      v.className = 'mt-1 text-2xl font-bold text-navy-950';
      v.textContent = value;
      const dd = document.createElement('p');
      dd.className = 'mt-0.5 text-[11px] font-semibold ' + (d.good === null ? 'text-ink-500' : d.good ? 'text-teal-700' : 'text-brass-600');
      dd.textContent = d.text;
      card.append(l, v, dd);
      root.appendChild(card);
    });
  }

  function render(key: string, push = true) {
    const idx = MONTHS.findIndex((m) => m.key === key);
    const m = MONTHS[idx < 0 ? MONTHS.length - 1 : idx];
    const prev = MONTHS[(idx < 0 ? MONTHS.length - 1 : idx) - 1];
    document.querySelectorAll<HTMLButtonElement>('.mr-month').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.month === m.key)));
    const set = (k: string, v: string) => document.querySelectorAll<HTMLElement>(`[data-mr="${k}"]`).forEach((e) => (e.textContent = v));
    set('monthLong', m.long);
    set('monthNo', String(m.no));
    set('bluf', m.bluf);
    set('median', String(m.median));
    set('under60', String(m.under60));
    set('reviews', String(m.reviews));
    set('rating', m.rating);
    set('reviewTotal', String(m.reviewTotal));
    set('revenue', money(m.revenue));
    set('avgJob', money(Math.round(m.revenue / m.booked)));
    set('adSpend', money(m.adSpend));
    set('retainer', money(m.retainer) + ' per month');
    set('cpb', money(Math.round((m.adSpend + m.retainer) / m.booked)));
    set('reviewDate', m.reviewDate);
    const md = fmtDelta(m.median, prev?.median, false, ' s');
    const mdEl = $('[data-mr="medianDelta"]');
    mdEl.textContent = md.text;
    mdEl.className = 'ml-2 rounded-full px-2 py-0.5 text-xs font-semibold ' + (md.good === null ? 'bg-paper text-ink-700' : md.good ? 'bg-teal-100 text-teal-700' : 'bg-brass-300/30 text-brass-600');
    const meter = $('.mr-meter');
    meter.setAttribute('aria-valuenow', String(m.median));
    $('[data-mr="meterFill"]').style.width = Math.min(100, (m.median / 60) * 100) + '%';
    $('[data-mr="guaranteeStatus"]').className = 'mt-3 flex items-center gap-2 text-sm font-semibold ' + (m.median < 60 ? 'text-teal-700' : 'text-brass-600');

    columns('[data-chart="buckets"]', m.buckets);
    table('[data-table="buckets"]', ['Time to first response', 'Share of leads'], m.buckets.map(([l, v]) => [l, v + '%']));
    hbars('[data-chart="sources"]', m.sources, m.leads, 'leads');
    table('[data-table="sources"]', ['Source', 'Leads', 'Share'], m.sources.map(([l, v]) => [l, v, Math.round((v / m.leads) * 100) + '%']));
    const pipe: [string, number][] = [['Leads', m.leads], ['Answered in under 60 s', Math.round((m.leads * m.under60) / 100)], ['Quoted', m.quoted], ['Booked', m.booked], ['Completed this month', m.completed]];
    hbars('[data-chart="pipeline"]', pipe, m.leads, '');
    table('[data-table="pipeline"]', ['Step', 'Count', 'Of leads'], pipe.map(([l, v]) => [l, v, Math.round((v / m.leads) * 100) + '%']));
    kpis(m, prev);
    spark('[data-chart="reviewSpark"]', m.spark);
    flags('[data-chart="flags"]', m.flags);
    list('[data-chart="did"]', m.did);
    list('[data-chart="next"]', m.next);
    if (push) {
      const u = new URL(location.href);
      u.searchParams.set('month', m.key);
      history.replaceState(null, '', u);
    }
  }

  function init() {
    const root = document.getElementById('report');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    tip = $('#mr-tip');
    trend('[data-chart="trend"]');
    const q = new URLSearchParams(location.search).get('month') || '2026-10';
    render(q, false);
    document.querySelectorAll<HTMLButtonElement>('.mr-month').forEach((b) => b.addEventListener('click', () => render(b.dataset.month!)));
    $('#mr-print').addEventListener('click', () => window.print());
    const copy = $('#mr-copy');
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(location.href);
        copy.textContent = 'Link copied';
      } catch {
        copy.textContent = location.href;
      }
      setTimeout(() => (copy.textContent = 'Copy link'), 1800);
    });
    const va = (window as unknown as { va?: (...a: unknown[]) => void }).va;
    if (va) va('event', { name: 'monthly-report-sample' });
  }
  document.addEventListener('astro:page-load', init);
</script>
