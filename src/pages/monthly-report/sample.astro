---
/**
 * The Monthly Report, sample — what a Lead Engine client receives on the first
 * of every month. Every number on this page is invented to show the format;
 * the page says so in three places. Charts are drawn in the browser from the
 * data block below so the month switcher re-renders everything together.
 */
import Base from '../../layouts/Base.astro';
import CtaSection from '../../components/CtaSection.astro';
import ShareKit from '../../components/ShareKit.astro';
import { SITE } from '../../config';
import { getSystem } from '../../lib/systems';

const le = getSystem('leadengine')!;

const title = 'The Monthly Report, a Sample — What an ICS Client Sees on the First of the Month | ICS';
const description =
  'A fully illustrative sample of the monthly report every Lead Engine and Market Lock client receives: median first-response time against the 60-second guarantee, leads by source, the quote-to-booked pipeline, a six-month trend, review velocity, what we did, and what we will do next. Every number on the page is invented to show the format.';

const faqs = [
  {
    q: 'Is this a real client?',
    a: 'No. Northline Heating & Air is a fictional Abington, Massachusetts HVAC company and every number on this page is invented to show the format. Real client reports are private; the Scoreboard publishes aggregate figures across clients.',
  },
  {
    q: 'When does the report arrive?',
    a: 'On the first business day of the month, as a link to the live dashboard and a one-page PDF, followed by a 30-minute monthly review call. The dashboard itself is live all month; the report is the month closed out and read for you.',
  },
  {
    q: 'What does "measured monthly" mean for the 60-second guarantee?',
    a: 'Median first-response time across every inbound lead that month, calls, forms, and messages, 24 hours a day. If the median is over 60 seconds, the retainer for that month is credited. The distribution chart shows the whole picture, not just the median.',
  },
  {
    q: 'Who owns the data?',
    a: `You do. The CRM, the call tracking, the review platform, and the dashboard are in accounts you own. If we parted ways tomorrow, the report would keep arriving from your own systems. ${SITE.founder} reads it with you; he does not hold it.`,
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'The Monthly Report, a sample',
    description,
    url: `${SITE.url}/monthly-report/sample/`,
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: { '@type': 'Service', name: 'Lead Engine', url: `${SITE.url}${le.href}` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base title={title} description={description} schema={schema}>
  <section class="bg-navy-950">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.25em] text-brass-300">Illustrative sample · Every number on this page is invented</p>
      <h1 class="reveal mt-4 max-w-3xl text-4xl font-bold leading-tight text-white sm:text-5xl" style="--reveal-delay: 100ms">
        The Monthly Report. This is what the first of the month looks like.
      </h1>
      <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-navy-100/90" style="--reveal-delay: 200ms">
        Every Lead Engine and Market Lock client gets this page about their own business: the guarantee measured, leads by
        source, the pipeline from first ring to booked job, the trend, the reviews, what we did, and what we do next.
        Agencies send a PDF nobody reads. We send a scoreboard and then sit down and read it with you.
      </p>
      <div class="reveal mt-8 flex flex-wrap gap-3" style="--reveal-delay: 300ms">
        <a href="#report" class="rounded-md bg-brass-500 px-6 py-3 font-semibold text-navy-950 transition-colors hover:bg-brass-300">Read the sample ↓</a>
        <a href="/ai-services/" class="rounded-md border border-white/25 px-6 py-3 font-semibold text-white transition-colors hover:border-teal-400 hover:text-teal-400">The systems that produce it</a>
      </div>
    </div>
  </section>

  <div id="report" class="bg-navy-100/40 px-2 py-8 sm:px-4 sm:py-12">
    <article class="mr mx-auto max-w-5xl rounded-xl bg-white text-navy-900 shadow-xl ring-1 ring-navy-100" aria-label="Sample monthly report">
      <!-- Report masthead -->
      <header class="mr-mast flex flex-wrap items-start justify-between gap-4 rounded-t-xl bg-navy-950 px-6 py-5 text-white sm:px-8">
        <div class="flex items-center gap-3">
          <img src="/images/ics-logo-mark.jpg" alt="" width="160" height="160" class="h-10 w-10 rounded-md object-cover" />
          <div>
            <p class="font-display text-[11px] font-bold uppercase tracking-[0.22em] text-brass-300">Innovative Commercial Strategies</p>
            <p class="text-xs text-navy-100/80">Monthly Report · Lead Engine · <span data-mr="monthLong">October 2026</span></p>
          </div>
        </div>
        <div class="text-right text-xs text-navy-100/80">
          <p class="font-semibold text-white">Northline Heating &amp; Air <span class="font-normal text-navy-100/70">(fictional)</span></p>
          <p>Abington, MA · Month <span data-mr="monthNo">4</span> of the engagement</p>
        </div>
      </header>

      <div class="px-6 py-6 sm:px-8">
        <p class="rounded-md border border-brass-300 bg-brass-300/15 px-3 py-2 text-xs text-ink-700">
          <strong class="text-navy-950">Sample.</strong> Northline Heating &amp; Air is fictional and every figure below is invented to show the format. Your report shows your numbers, from accounts you own.
        </p>

        <!-- Filter row: month -->
        <div class="no-print mt-5 flex flex-wrap items-center gap-2" role="group" aria-label="Choose the month">
          <span class="mr-2 font-mono text-[11px] font-bold uppercase tracking-widest text-ink-500">Month</span>
          <button type="button" data-month="2026-08" class="mr-month rounded-md border border-navy-100 px-3 py-1.5 text-sm font-semibold text-navy-900 hover:border-teal-500" aria-pressed="false">August</button>
          <button type="button" data-month="2026-09" class="mr-month rounded-md border border-navy-100 px-3 py-1.5 text-sm font-semibold text-navy-900 hover:border-teal-500" aria-pressed="false">September</button>
          <button type="button" data-month="2026-10" class="mr-month rounded-md border border-navy-100 px-3 py-1.5 text-sm font-semibold text-navy-900 hover:border-teal-500" aria-pressed="true">October</button>
          <span class="ml-auto flex gap-2">
            <button type="button" id="mr-copy" class="rounded-md border border-navy-100 bg-white px-3 py-1.5 text-sm font-semibold text-navy-900 hover:border-teal-500 hover:text-teal-700">Copy link</button>
            <button type="button" id="mr-print" class="rounded-md bg-navy-900 px-3.5 py-1.5 text-sm font-semibold text-white hover:bg-teal-600">Print / save as PDF</button>
          </span>
          <span class="basis-full"><ShareKit what="the sample ICS monthly report" compact /></span>
        </div>

        <!-- BLUF -->
        <div class="mt-6 border-l-4 border-teal-500 bg-paper px-4 py-3">
          <p class="font-mono text-[11px] font-bold uppercase tracking-widest text-teal-600">Bottom line up front</p>
          <p class="mt-1 text-base font-medium leading-snug text-navy-900" data-mr="bluf"></p>
        </div>

        <!-- Hero: the guarantee -->
        <section class="mt-6 grid gap-5 lg:grid-cols-[1.1fr_1fr]" data-print-cols="2" aria-labelledby="mr-h-guarantee">
          <div class="rounded-xl border border-navy-100 p-5">
            <h2 id="mr-h-guarantee" class="font-mono text-[11px] font-bold uppercase tracking-widest text-brass-600">The guarantee, measured</h2>
            <p class="mt-2 text-sm text-ink-700">Median first response to every inbound lead, 24/7. Under 60 seconds or the month is credited.</p>
            <p class="mt-3 flex items-baseline gap-2">
              <span class="mr-hero text-[52px] font-bold leading-none text-navy-950" data-mr="median">42</span>
              <span class="text-lg font-semibold text-ink-700">seconds</span>
              <span class="ml-2 rounded-full px-2 py-0.5 text-xs font-semibold" data-mr="medianDelta"></span>
            </p>
            <div class="mt-4">
              <div class="flex justify-between font-mono text-[10px] uppercase tracking-wider text-ink-500"><span>0 s</span><span>60 s guarantee</span></div>
              <div class="mr-meter mt-1 h-2.5 w-full rounded-full bg-teal-100" role="meter" aria-valuemin="0" aria-valuemax="60" aria-valuenow="42" aria-label="Median first response against the 60-second guarantee">
                <div class="h-2.5 rounded-full bg-teal-600" data-mr="meterFill" style="width:70%"></div>
              </div>
            </div>
            <p class="mt-3 flex items-center gap-2 text-sm font-semibold text-teal-700" data-mr="guaranteeStatus">
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="8" fill="currentColor" /><path d="M4.5 8.5l2.2 2.2L11.5 6" stroke="#fff" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span>Guarantee met: <span data-mr="under60"></span>% of leads answered in under 60 seconds</span>
            </p>
          </div>

          <div class="rounded-xl border border-navy-100 p-5">
            <h2 class="font-mono text-[11px] font-bold uppercase tracking-widest text-brass-600">How fast, lead by lead</h2>
            <p class="mt-2 text-sm text-ink-700">Share of the month's leads by time to first response.</p>
            <div class="mr-cols mt-4" data-chart="buckets" role="img" aria-label="Distribution of first-response times"></div>
            <details class="mt-3 text-xs text-ink-700"><summary class="cursor-pointer font-semibold text-teal-700">Table view</summary><table class="mt-2 w-full text-left" data-table="buckets"></table></details>
          </div>
        </section>

        <!-- KPI row -->
        <section class="mt-6" aria-label="Headline numbers">
          <div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-6" data-print-cols="6" data-chart="kpis"></div>
        </section>

        <!-- Sources + pipeline -->
        <section class="mt-6 grid gap-5 lg:grid-cols-2" data-print-cols="2">
          <div class="rounded-xl border border-navy-100 p-5">
            <h2 class="font-mono text-[11px] font-bold uppercase tracking-widest text-brass-600">Leads by source</h2>
            <p class="mt-2 text-sm text-ink-700">Where this month's leads came from, largest first.</p>
            <div class="mr-bars mt-4" data-chart="sources" role="img" aria-label="Leads by source, ranked"></div>
            <details class="mt-3 text-xs text-ink-700"><summary class="cursor-pointer font-semibold text-teal-700">Table view</summary><table class="mt-2 w-full text-left" data-table="sources"></table></details>
          </div>
          <div class="rounded-xl border border-navy-100 p-5">
            <h2 class="font-mono text-[11px] font-bold uppercase tracking-widest text-brass-600">From first ring to booked job</h2>
            <p class="mt-2 text-sm text-ink-700">Every lead this month, step by step. The drop between steps is where next month's work is.</p>
            <div class="mr-bars mt-4" data-chart="pipeline" role="img" aria-label="Pipeline from lead to completed job"></div>
            <details class="mt-3 text-xs text-ink-700"><summary class="cursor-pointer font-semibold text-teal-700">Table view</summary><table class="mt-2 w-full text-left" data-table="pipeline"></table></details>
          </div>
        </section>

        <!-- Trend -->
        <section class="mt-6 rounded-xl border border-navy-100 p-5">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <div>
              <h2 class="font-mono text-[11px] font-bold uppercase tracking-widest text-brass-600">Six months: leads and booked jobs</h2>
              <p class="mt-2 text-sm text-ink-700">Two months before Lead Engine went live, and every month since. Hover for the values.</p>
            </div>
            <ul class="flex gap-4 text-xs text-ink-700" aria-label="Legend">
              <li class="flex items-center gap-1.5"><span class="inline-block h-0.5 w-5 rounded bg-teal-600"></span>Booked jobs</li>
              <li class="flex items-center gap-1.5"><span class="inline-block h-0.5 w-5 rounded bg-[#94a3b8]"></span>Leads</li>
            </ul>
          </div>
          <div class="relative mt-4" data-chart="trend"></div>
          <details class="mt-3 text-xs text-ink-700"><summary class="cursor-pointer font-semibold text-teal-700">Table view</summary><table class="mt-2 w-full text-left" data-table="trend"></table></details>
        </section>

        <!-- Reviews + money -->
        <section class="mt-6 grid gap-5 lg:grid-cols-3" data-print-cols="3">
          <div class="rounded-xl border border-navy-100 p-5">
            <h2 class="font-mono text-[11px] font-bold uppercase tracking-widest text-brass-600">Reviews</h2>
            <p class="mt-3 text-3xl font-bold text-navy-950"><span data-mr="reviews"></span> <span class="text-base font-semibold text-ink-700">new this month</span></p>
            <p class="mt-1 text-sm text-ink-700">Google rating <strong data-mr="rating"></strong> on <span data-mr="reviewTotal"></span> reviews. Asked automatically after every completed job.</p>
            <div class="mt-3" data-chart="reviewSpark" role="img" aria-label="New reviews per week, last twelve weeks"></div>
          </div>
          <div class="rounded-xl border border-navy-100 p-5">
            <h2 class="font-mono text-[11px] font-bold uppercase tracking-widest text-brass-600">Money</h2>
            <dl class="mt-3 space-y-2 text-sm">
              <div class="flex justify-between gap-3"><dt class="text-ink-700">Revenue booked, attributed</dt><dd class="font-semibold text-navy-950" data-mr="revenue"></dd></div>
              <div class="flex justify-between gap-3"><dt class="text-ink-700">Average booked job</dt><dd class="font-semibold text-navy-950" data-mr="avgJob"></dd></div>
              <div class="flex justify-between gap-3"><dt class="text-ink-700">Paid search (your spend, tracked by the system)</dt><dd class="font-semibold text-navy-950" data-mr="adSpend"></dd></div>
              <div class="flex justify-between gap-3"><dt class="text-ink-700">Lead Engine retainer</dt><dd class="font-semibold text-navy-950" data-mr="retainer"></dd></div>
              <div class="flex justify-between gap-3 border-t border-navy-100 pt-2"><dt class="text-ink-700">Cost per booked job, all in</dt><dd class="font-semibold text-navy-950" data-mr="cpb"></dd></div>
            </dl>
            <p class="mt-3 text-[11px] text-ink-500">Attributed means the lead was tracked from first contact to a booked job in the CRM you own. Nothing is estimated.</p>
          </div>
          <div class="rounded-xl border border-navy-100 p-5">
            <h2 class="font-mono text-[11px] font-bold uppercase tracking-widest text-brass-600">Flags</h2>
            <ul class="mt-3 space-y-2.5 text-sm text-ink-700" data-chart="flags"></ul>
          </div>
        </section>

        <!-- Did / next -->
        <section class="mt-6 grid gap-5 lg:grid-cols-2" data-print-cols="2">
          <div class="rounded-xl bg-paper p-5">
            <h2 class="font-mono text-[11px] font-bold uppercase tracking-widest text-brass-600">What we did this month</h2>
            <ul class="mt-3 space-y-2 text-sm text-ink-700" data-chart="did"></ul>
          </div>
          <div class="rounded-xl bg-paper p-5">
            <h2 class="font-mono text-[11px] font-bold uppercase tracking-widest text-brass-600">What we do next month</h2>
            <ul class="mt-3 space-y-2 text-sm text-ink-700" data-chart="next"></ul>
          </div>
        </section>

        <footer class="mt-6 flex flex-wrap items-end justify-between gap-4 border-t-2 border-navy-950 pt-4 text-sm">
          <div>
            <p class="font-display text-lg font-bold text-navy-950">Monthly review: <span data-mr="reviewDate"></span>, 30 minutes, your office.</p>
            <p class="mt-1 text-ink-700">Read by {SITE.founder} before it reaches you. Questions before then: {SITE.phone}.</p>
          </div>
          <p class="text-xs text-ink-500">Sample report · all figures fictional · format current as of November 2026</p>
        </footer>
      </div>
    </article>
    <div id="mr-tip" class="pointer-events-none fixed z-50 hidden rounded-md bg-navy-950 px-2.5 py-1.5 text-xs text-white shadow-lg" role="tooltip"></div>
  </div>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-3">
      <div class="prose-ics lg:col-span-2">
        <h2>Why the report looks like this</h2>
        <p>
          A report is read for about ninety seconds, so the first line says whether the month was good and why. The guarantee
          comes next because it is the promise you paid for, and it is shown as a distribution, not a single number, because a
          median can hide a bad week. Leads by source tells you which channel to feed. The pipeline tells you where leads die.
          The six-month line is the only chart that matters to a lender or a buyer. And the two lists at the bottom are the
          contract for next month, in writing.
        </p>
        <h2>What it is built from</h2>
        <ul>
          {le.includes.map((i) => <li>{i}</li>)}
        </ul>
        <p>
          Lead Engine is {le.setup} to build plus {le.monthly}; the report is included, and so is the monthly review.
          <a href="/proposal/?system=leadengine">Build the proposal</a> or <a href="/pricing/">see all published pricing</a>.
        </p>
      </div>
      <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-xl border border-navy-100 bg-white p-6 shadow-sm">
          <p class="font-mono text-[11px] font-bold uppercase tracking-widest text-teal-600">Common questions</p>
          <dl class="mt-3 space-y-4">
            {faqs.map((f) => (
              <div><dt class="text-sm font-bold text-navy-900">{f.q}</dt><dd class="mt-1 text-xs leading-relaxed text-ink-700">{f.a}</dd></div>
            ))}
          </dl>
        </div>
        <div class="rounded-xl bg-navy-900 p-6 text-sm">
          <p class="font-semibold uppercase tracking-wider text-teal-400">Related</p>
          <ul class="mt-3 space-y-1.5">
            <li><a href="/first-90-days/?system=leadengine" class="text-navy-100/85 hover:text-teal-400">The first 90 days that come before this report →</a></li>
            <li><a href="/scoreboard/" class="text-navy-100/85 hover:text-teal-400">The public Scoreboard, aggregate results →</a></li>
            <li><a href="/guarantees/" class="text-navy-100/85 hover:text-teal-400">The guarantees, in writing →</a></li>
            <li><a href="/case-studies/" class="text-navy-100/85 hover:text-teal-400">Case studies with real numbers →</a></li>
            <li><a href="/intelligence/dossier/sample/" class="text-navy-100/85 hover:text-teal-400">Another sample: the Deep Dossier →</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <CtaSection heading="Want this report about your business?" body="One call, a straight answer on fit, and a written quote within 48 hours. The first report arrives on the first of the month after launch." />
</Base>

<style>
  .mr-hero {
    font-variant-numeric: normal;
  }
  .mr-month[aria-pressed='true'] {
    background: var(--color-navy-900);
    border-color: var(--color-navy-900);
    color: #fff;
  }
  .mr-bars :global(.row) {
    display: grid;
    grid-template-columns: minmax(7rem, 11rem) 1fr 3.5rem;
    align-items: center;
    gap: 0.6rem;
    padding: 0.2rem 0;
  }
  .mr-bars :global(.track) {
    height: 18px;
    position: relative;
  }
  .mr-bars :global(.fill) {
    height: 18px;
    border-radius: 0 4px 4px 0;
    background: var(--color-teal-600);
    transition: width 0.4s ease;
    outline: none;
  }
  .mr-bars :global(.fill:hover),
  .mr-bars :global(.fill:focus-visible) {
    filter: brightness(1.15);
    box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--color-teal-600);
  }
  .mr-cols :global(.cols) {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 6px;
    align-items: end;
    height: 150px;
    border-bottom: 1px solid var(--color-navy-100);
  }
  .mr-cols :global(.col) {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    height: 100%;
  }
  .mr-cols :global(.bar) {
    width: 100%;
    max-width: 24px;
    border-radius: 4px 4px 0 0;
    background: var(--color-teal-600);
    transition: height 0.4s ease;
    outline: none;
  }
  .mr-cols :global(.bar.late) {
    background: var(--color-brass-500);
  }
  .mr-cols :global(.bar:hover),
  .mr-cols :global(.bar:focus-visible) {
    filter: brightness(1.15);
    box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--color-teal-600);
  }
  .mr-cols :global(.labels) {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 6px;
    margin-top: 6px;
    text-align: center;
    font-size: 11px;
    color: var(--color-ink-500);
  }
  .mr :global(table) {
    border-collapse: collapse;
  }
  .mr :global(td),
  .mr :global(th) {
    padding: 0.25rem 0.5rem 0.25rem 0;
    border-bottom: 1px solid var(--color-navy-100);
    font-variant-numeric: tabular-nums;
  }
  .mr-mast {
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  @media print {
    @page {
      size: letter;
      margin: 0.4in;
    }
    :global(header:not(.mr-mast)),
    :global(footer:not(.mr footer)),
    :global(#money-bar),
    :global(#path-bar),
    :global(#palette),
    :global(main#main > *:not(#report)),
    .no-print,
    #mr-tip {
      display: none !important;
    }
    .mr section > div,
    .mr section.rounded-xl {
      break-inside: avoid;
    }
    .mr [data-print-cols='2'] {
      grid-template-columns: 1fr 1fr !important;
    }
    .mr [data-print-cols='3'] {
      grid-template-columns: 1fr 1fr 1fr !important;
    }
    .mr [data-print-cols='6'] {
      grid-template-columns: repeat(6, 1fr) !important;
    }
    :global(body),
    #report {
      background: white !important;
      padding: 0 !important;
    }
    .mr {
      box-shadow: none !important;
      max-width: none !important;
      zoom: 0.72;
    }
    .mr :global(details) {
      display: none;
    }
    :global(.reveal) {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  type Month = {
    key: string;
    long: string;
    no: number;
    leads: number;
    median: number;
    under60: number;
    quoted: number;
    booked: number;
    completed: number;
    revenue: number;
    reviews: number;
    rating: string;
    reviewTotal: number;
    adSpend: number;
    retainer: number;
    sources: [string, number][];
    buckets: [string, number][];
    spark: number[];
    bluf: string;
    flags: { level: 'good' | 'watch'; text: string }[];
    did: string[];
    next: string[];
    reviewDate: string;
  };

  const MONTHS: Month[] = [
    {
      key: '2026-08',
      long: 'August 2026',
      no: 2,
      leads: 64,
      median: 58,
      under60: 71,
      quoted: 44,
