---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';

const title = 'Cap Rate & NOI Calculator — Underwrite a Commercial Property in a Minute | ICS';
const description =
  'Buying an investment property? A free, no-email quick-underwrite: net operating income, cap rate, annual debt service, cash flow, cash-on-cash return, DSCR, and what the building is worth at your target cap rate — from your own numbers, nothing sent anywhere.';
---

<Base title={title} description={description}>
  <section class="bg-navy-900">
    <div class="mx-auto max-w-4xl px-4 py-12 text-center sm:px-6 sm:py-16">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.25em] text-teal-400">Free · 1 minute · No email</p>
      <h1 class="reveal mx-auto mt-4 max-w-2xl text-4xl font-bold leading-tight text-white sm:text-5xl" style="--reveal-delay: 100ms">
        Does the building actually pencil?
      </h1>
      <p class="reveal mx-auto mt-4 max-w-xl text-lg leading-relaxed text-navy-100/90" style="--reveal-delay: 200ms">
        The first-pass underwrite every investor runs before the second call: income, expenses, the loan, and
        the three numbers that decide it — cap rate, cash-on-cash, and whether a lender will say yes. Your figures,
        nothing sent anywhere.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <div id="cap" class="rounded-2xl border border-navy-100 bg-white p-6 shadow-lg sm:p-8">
      <div class="grid gap-8 lg:grid-cols-2">
        <div>
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-teal-600">The property</p>
          <div class="mt-4 grid gap-3">
            <div><label for="cap-price" class="cap-label">Purchase price ($)</label><input id="cap-price" type="number" min="0" step="25000" value="1200000" class="cap-input" /></div>
            <div class="grid grid-cols-2 gap-3">
              <div><label for="cap-rent" class="cap-label">Gross annual rent ($)</label><input id="cap-rent" type="number" min="0" step="5000" value="150000" class="cap-input" /></div>
              <div><label for="cap-vac" class="cap-label">Vacancy &amp; credit loss (%)</label><input id="cap-vac" type="number" min="0" max="100" step="1" value="5" class="cap-input" /></div>
            </div>
            <div><label for="cap-opex" class="cap-label">Annual operating expenses ($ — taxes, insurance, maintenance, management; not the mortgage)</label><input id="cap-opex" type="number" min="0" step="1000" value="52000" class="cap-input" /></div>
          </div>

          <p class="mt-6 font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-teal-600">The loan</p>
          <div class="mt-4 grid grid-cols-3 gap-3">
            <div><label for="cap-down" class="cap-label">Down (%)</label><input id="cap-down" type="number" min="0" max="100" step="1" value="25" class="cap-input" /></div>
            <div><label for="cap-rate" class="cap-label">Rate (%)</label><input id="cap-rate" type="number" min="0" step="0.1" value="7" class="cap-input" /></div>
            <div><label for="cap-term" class="cap-label">Term (yrs)</label><input id="cap-term" type="number" min="1" step="1" value="25" class="cap-input" /></div>
          </div>

          <p class="mt-6 font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-teal-600">Your target</p>
          <div class="mt-4"><label for="cap-target" class="cap-label">Target cap rate (%) — what the building would be worth to you</label><input id="cap-target" type="number" min="0.1" step="0.25" value="7.5" class="cap-input" /></div>
        </div>

        <div class="flex flex-col justify-between rounded-xl border border-teal-500/40 bg-navy-950 p-6">
          <div>
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-navy-100/60">Going-in cap rate</p>
            <p id="cap-caprate" class="mt-2 font-display text-4xl font-bold text-teal-400">—</p>
            <p id="cap-verdict" class="mt-1 text-sm font-semibold text-white"></p>
            <div id="cap-lines" class="mt-5 space-y-2 border-t border-white/10 pt-4 font-mono text-xs text-navy-100/80"></div>
          </div>
          <div class="mt-6">
            <p class="text-[11px] leading-relaxed text-navy-100/70">
              First-pass estimate. NOI excludes debt service, depreciation, and capital reserves; cash-on-cash is
              before tax and before closing costs. Lenders commonly look for DSCR of about 1.25 or better. We
              underwrite the real rent roll and expenses on a call.
            </p>
            <div class="mt-4 flex flex-wrap gap-3">
              <a href="/listings/" class="rounded-md bg-teal-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-teal-500">
                See Current Listings →
              </a>
              <a id="cap-cta" href="/contact/" class="rounded-md border border-white/25 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-teal-400 hover:text-teal-400">
                Bring This Number to Us →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-3 print:hidden">
      <button id="cap-share" type="button" class="rounded-md border border-navy-100 px-4 py-2 text-sm font-semibold text-navy-800 transition-colors hover:border-teal-500 hover:text-teal-600">
        Copy a shareable link
      </button>
      <button id="cap-print" type="button" class="rounded-md border border-navy-100 px-4 py-2 text-sm font-semibold text-navy-800 transition-colors hover:border-teal-500 hover:text-teal-600">
        Print / Save as PDF
      </button>
      <span id="cap-copied" class="hidden text-sm font-semibold text-teal-600">Link copied — send it to your partner or lender ✓</span>
    </div>

    <p class="mt-6 text-center text-xs text-ink-500 print:hidden">
      Buying investment property on the South Shore? <a href="/commercial-real-estate/" class="font-semibold text-teal-600 hover:text-teal-500">See how we represent buyers →</a> ·
      Selling one? <a href="/seller-net/" class="font-semibold text-teal-600 hover:text-teal-500">What would you net?</a>
    </p>
  </section>
</Base>

<style>
  .cap-input {
    width: 100%;
    border-radius: 0.375rem;
    border: 1px solid #dbe4f0;
    background: #fff;
    color: #0b1f3a;
    padding: 0.5rem 0.65rem;
    font-size: 0.875rem;
  }
  .cap-input:focus { outline: none; border-color: #14b8a6; box-shadow: 0 0 0 2px rgba(20,184,166,0.2); }
  .cap-label { display: block; margin-bottom: 0.25rem; font-size: 0.7rem; font-weight: 500; color: #5a6b82; }
  @media print {
    :global(header),
    :global(footer),
    :global(#money-bar) { display: none !important; }
    :global(body) { background: white !important; }
    :global(.reveal) { opacity: 1 !important; transform: none !important; }
    #cap { box-shadow: none; border-color: #dbe4f0; }
  }
</style>

<script>
  function initCap() {
    const root = document.getElementById('cap');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const num = (id: string) => Math.max(0, +$(id).value || 0);
    const money = (n: number) => (n < 0 ? '-$' : '$') + Math.round(Math.abs(n)).toLocaleString('en-US');
    const pct = (n: number) => (Number.isFinite(n) ? n.toFixed(2) + '%' : '—');

    const PARAMS: Record<string, string> = {
      'cap-price': 'p', 'cap-rent': 'r', 'cap-vac': 'v', 'cap-opex': 'x',
      'cap-down': 'd', 'cap-rate': 'i', 'cap-term': 't', 'cap-target': 'c',
    };
    const fields = Object.keys(PARAMS);
    try {
      const q = new URLSearchParams(window.location.search);
      fields.forEach((id) => { const v = q.get(PARAMS[id]); if (v !== null && v !== '' && !Number.isNaN(+v)) $(id).value = v; });
    } catch { /* no-op */ }
    function shareUrl() {
      const q = new URLSearchParams();
      fields.forEach((id) => q.set(PARAMS[id], $(id).value));
      return `${window.location.pathname}?${q.toString()}`;
    }
    function syncUrl() {
      try { history.replaceState(null, '', shareUrl()); } catch { /* no-op */ }
    }
    // "Bring your number": the contact CTA carries the scenario and its link into the form.
    function setCta(summary: string) {
      const cta = document.getElementById('cap-cta') as HTMLAnchorElement | null;
      if (!cta) return;
      const message = `${summary}\nScenario link: ${window.location.origin}${shareUrl()}`;
      cta.href = `/contact/?${new URLSearchParams({ interest: 'Buying commercial property', message }).toString()}`;
    }

    function update() {
      const price = num('cap-price');
      const rent = num('cap-rent');
      const vac = num('cap-vac') / 100;
      const opex = num('cap-opex');
      const down = num('cap-down') / 100;
      const rate = num('cap-rate') / 100 / 12;
      const n = Math.max(1, num('cap-term')) * 12;
      const target = num('cap-target') / 100;

      const egi = rent * (1 - vac);
      const noi = egi - opex;
      const capRate = price > 0 ? (noi / price) * 100 : NaN;
      const loan = price * (1 - down);
      const equity = price * down;
      const powN = Math.pow(1 + rate, n);
      const monthly = loan > 0 ? (rate > 0 ? (loan * rate * powN) / (powN - 1) : loan / n) : 0;
      const debt = monthly * 12;
      const cashFlow = noi - debt;
      const coc = equity > 0 ? (cashFlow / equity) * 100 : NaN;
      const dscr = debt > 0 ? noi / debt : NaN;
      const implied = target > 0 ? noi / target : NaN;

      const capEl = document.getElementById('cap-caprate')!;
      const verdict = document.getElementById('cap-verdict')!;
      capEl.textContent = pct(capRate);

      if (noi <= 0) {
        capEl.className = 'mt-2 font-display text-4xl font-bold text-amber-400';
        verdict.textContent = 'Expenses exceed income — the building loses money before the mortgage.';
      } else if (Number.isFinite(dscr) && dscr < 1) {
        capEl.className = 'mt-2 font-display text-4xl font-bold text-amber-400';
        verdict.textContent = `Negative cash flow after debt (DSCR ${dscr.toFixed(2)}) — a lender would likely require more equity.`;
      } else if (Number.isFinite(dscr) && dscr < 1.25) {
        capEl.className = 'mt-2 font-display text-4xl font-bold text-teal-400';
        verdict.textContent = `Pencils, but thin: DSCR ${dscr.toFixed(2)} is under the ~1.25 most lenders want.`;
      } else {
        capEl.className = 'mt-2 font-display text-4xl font-bold text-teal-400';
        verdict.textContent = debt > 0 ? `Pencils — DSCR ${dscr.toFixed(2)}, ${pct(coc)} cash-on-cash.` : `All-cash: ${pct(capRate)} unlevered return.`;
      }

      const row = (l: string, v: string, strong = false) =>
        `<div class="flex justify-between gap-3${strong ? ' mt-1 border-t border-white/10 pt-2 font-bold text-white' : ''}"><span class="${strong ? '' : 'text-navy-100/60'}">${l}</span><span>${v}</span></div>`;
      document.getElementById('cap-lines')!.innerHTML =
        row('Effective gross income', money(egi)) +
        row('Operating expenses', '-' + money(opex)) +
        row('Net operating income (NOI)', money(noi), true) +
        row('Annual debt service', debt > 0 ? '-' + money(debt) : '—') +
        row('Cash flow before tax', money(cashFlow), true) +
        row('Cash-on-cash return', pct(coc)) +
        row('DSCR', Number.isFinite(dscr) ? dscr.toFixed(2) : '—') +
        row(`Value at ${num('cap-target')}% cap`, Number.isFinite(implied) ? money(implied) : '—', true);
      setCta(`Cap rate scenario — price ${money(price)}, NOI ${money(noi)}, going-in cap ${pct(capRate)}, DSCR ${Number.isFinite(dscr) ? dscr.toFixed(2) : '—'}, cash-on-cash ${pct(coc)}, value at ${num('cap-target')}% cap ${Number.isFinite(implied) ? money(implied) : '—'}.`);
    }

    fields.forEach((id) => $(id).addEventListener('input', () => { update(); syncUrl(); }));
    const copied = document.getElementById('cap-copied');
    document.getElementById('cap-share')?.addEventListener('click', async () => {
      syncUrl();
      try { await navigator.clipboard.writeText(window.location.href); } catch { /* address bar still carries it */ }
      copied?.classList.remove('hidden');
      window.setTimeout(() => copied?.classList.add('hidden'), 3500);
    });
    document.getElementById('cap-print')?.addEventListener('click', () => window.print());
    update();
  }
  document.addEventListener('astro:page-load', initCap);
</script>
