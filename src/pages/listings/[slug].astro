---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import { SITE } from '../../config';

export async function getStaticPaths() {
  const entries = await getCollection('listings', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, address, town, state, price, dealType, propertyType, sqft, lotSize, status, highlights, image, sample } =
  entry.data;

const description = `${title} — ${propertyType} property ${dealType === 'sale' ? 'for sale' : 'for lease'} in ${town}, ${state}. ${price}${sqft ? ` · ${sqft} SF` : ''}. Represented by ${SITE.name}.`;

// "Run the numbers on this building": hand the listing's figures to the free
// calculators (they read these URL params). Sale price is in dollars; lease
// price is $/SF/yr. Only rendered when the figures parse.
const num = (s?: string) => parseFloat((s ?? '').replace(/[^0-9.]/g, '')) || 0;
const priceNum = num(price);
const sfNum = num(sqft);
const monthlyRent = dealType === 'lease' && priceNum && sfNum ? Math.round((priceNum * sfNum) / 12) : 0;
const dealTools =
  dealType === 'sale' && priceNum
    ? [
        { href: `/cap-rate/?p=${priceNum}`, label: 'Underwrite it — does it pencil?', sub: `Cap rate, cash-on-cash, DSCR at ${price}` },
        { href: `/lease-vs-buy/?pr=${priceNum}`, label: 'Own it vs. keep leasing', sub: 'The multi-year math at this price' },
      ]
    : dealType === 'lease' && priceNum && sfNum
      ? [
          { href: `/lease-analyzer/?sf=${sfNum}&r=${priceNum}`, label: 'Analyze this lease', sub: `Net effective rent on ${sqft} SF at ${price}` },
          { href: `/lease-vs-buy/?ls=${monthlyRent}`, label: 'Lease it vs. own instead', sub: `About $${monthlyRent.toLocaleString('en-US')}/mo base rent` },
        ]
      : [];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'RealEstateListing',
    name: title,
    description,
    url: new URL(`/listings/${entry.id}/`, Astro.site).toString(),
    address: { '@type': 'PostalAddress', streetAddress: address, addressLocality: town, addressRegion: state },
  },
];
---

<Base title={`${title} | ${town}, ${state} | ICS Listings`} description={description} schema={schema}>
  <article>
    <header class="bg-navy-900">
      <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-teal-400 capitalize">
          {propertyType.replace('-', ' ')} · {dealType === 'sale' ? 'For Sale' : 'For Lease'} · {town}, {state}
        </p>
        <h1 class="mt-3 max-w-3xl text-3xl font-bold leading-tight text-white sm:text-4xl">{title}</h1>
        <p class="mt-2 text-navy-100/75">{address}, {town}, {state}</p>
        <div class="mt-6 flex flex-wrap items-center gap-x-8 gap-y-3">
          <span class="font-display text-3xl font-bold text-teal-400">{price}</span>
          {sqft && <span class="text-navy-100/85"><strong class="text-white">{sqft}</strong> SF building</span>}
          {lotSize && <span class="text-navy-100/85"><strong class="text-white">{lotSize}</strong> lot</span>}
          <span class="rounded-full border border-teal-400/40 px-3 py-1 text-sm font-semibold capitalize text-teal-400">
            {status.replace('-', ' ')}
          </span>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <div class="grid gap-10 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <div class="overflow-hidden rounded-xl border border-navy-100">
            <img src={image} alt={`${title} — ${address}, ${town} ${state}`} class="w-full object-cover" />
          </div>

          {
            highlights.length > 0 && (
              <div class="mt-8">
                <h2 class="text-xl font-bold text-navy-900">Highlights</h2>
                <ul class="mt-4 grid gap-3 sm:grid-cols-2">
                  {highlights.map((h) => (
                    <li class="flex gap-2 text-sm leading-relaxed text-ink-700">
                      <span class="mt-0.5 text-teal-600">✓</span> {h}
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          <div class="prose-ics mt-8">
            <Content />
          </div>
        </div>

        <aside class="lg:sticky lg:top-24 lg:self-start">
          <LeadForm
            heading="Request the offering memorandum"
            compact
            context={`${title} — ${address}, ${town}, ${state} · ${price}`}
            interest={dealType === 'sale' ? 'Buying commercial property' : ''}
          />
          {dealTools.length > 0 && (
            <div class="mt-5 rounded-xl border border-navy-100 bg-paper p-5">
              <p class="font-mono text-[11px] font-bold uppercase tracking-[0.2em] text-brass-600">Run the numbers on this building</p>
              <p class="mt-1 text-xs leading-relaxed text-ink-500">Free, no email — the listing's figures are already filled in.</p>
              <ul class="mt-3 space-y-2">
                {dealTools.map((t) => (
                  <li>
                    <a href={t.href} class="group block rounded-lg border border-navy-100 bg-white px-3 py-2.5 transition-colors hover:border-teal-500">
                      <span class="block text-sm font-semibold text-navy-900 group-hover:text-teal-600">{t.label} →</span>
                      <span class="block text-xs text-ink-500">{t.sub}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          <p class="mt-4 text-xs text-ink-500">
            Direct line: <a href={`tel:${SITE.phone.replace(/[^\d+]/g, '')}`} class="font-semibold text-teal-600">{SITE.phone}</a> ·
            <a href={`mailto:${SITE.email}`} class="font-semibold text-teal-600">{SITE.email}</a>
          </p>
          {
            sample && (
              <p class="mt-4 rounded-lg bg-white p-4 text-xs text-ink-500 border border-navy-100">
                This is a sample listing shown to demonstrate the ICS property marketing format.
              </p>
            )
          }
        </aside>
      </div>
    </div>
  </article>
</Base>
