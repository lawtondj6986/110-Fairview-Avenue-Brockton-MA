---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaSection from '../components/CtaSection.astro';
import { SITE } from '../config';

const title = 'Every Seat at the Table — Free Commercial Real Estate Deal Tools | ICS';
const description =
  'Five free, no-email calculators for every seat in a commercial real estate deal: the buyer underwriting a purchase (cap rate & NOI), the seller pricing a sale (net proceeds), the occupier deciding to lease or buy, the owner who wants a number (free valuation), and the landlord and tenant negotiating a lease (net effective rent). Run the math first; then bring it to the advisor who negotiates both the building and the systems inside it.';

const seats = [
  {
    seat: 'The Buyer',
    question: 'Does the building actually pencil?',
    body: 'NOI, going-in cap rate, debt service, cash-on-cash, DSCR against what lenders want, and what the building is worth at your target cap — the first-pass underwrite before the second call.',
    href: '/cap-rate/',
    cta: 'Underwrite it',
    rep: 'Buyer representation: we find the off-market building and negotiate the price the math supports.',
  },
  {
    seat: 'The Seller',
    question: 'What will I actually walk away with?',
    body: 'After the loan payoff, the commission, Massachusetts transfer tax, and closing costs — the net, itemized, with a shortfall warning if the sale would not cover the payoff.',
    href: '/seller-net/',
    cta: 'See what you net',
    rep: 'Seller representation: institutional-grade marketing on every listing, and a commission conversation held in the open, up front.',
  },
  {
    seat: 'The Occupier',
    question: 'Should my business lease or own its space?',
    body: 'Full amortization, equity, appreciation, and carrying costs against level rent — over the years you will actually occupy. The cheaper path, in dollars.',
    href: '/lease-vs-buy/',
    cta: 'Run the comparison',
    rep: 'Owner-user representation: the building as a means to an end — more room, more revenue, less chaos.',
  },
  {
    seat: 'The Owner',
    question: 'What is my building worth right now?',
    body: 'An instant value band from your own numbers, then a free broker opinion of value — walked in person, built on real comparables, written within 48 hours.',
    href: '/building-worth/',
    cta: 'Value your building',
    rep: 'No listing agreement required. The opinion is free; what you do with it is yours.',
  },
  {
    seat: 'The Landlord & the Tenant',
    question: 'What does this lease really cost — and net?',
    body: 'Face rent, escalations, free months, TI allowance, and commission, resolved into net effective rent from both chairs — what the tenant truly pays and what the landlord truly keeps.',
    href: '/lease-analyzer/',
    cta: 'Analyze the lease',
    rep: 'Tenant and landlord representation — never both sides of the same deal.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Free commercial real estate deal tools',
    itemListElement: seats.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${s.seat}: ${s.question}`,
      url: `${SITE.url}${s.href}`,
    })),
  },
];
---

<Base title={title} description={description} schema={schema}>
  <section class="bg-navy-900">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.25em] text-teal-400">Commercial real estate · Five free tools · No email gates</p>
      <h1 class="reveal mt-4 max-w-3xl text-4xl font-bold leading-tight text-white sm:text-5xl" style="--reveal-delay: 100ms">
        Every seat at the table has a number. Run yours first.
      </h1>
      <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-navy-100/90" style="--reveal-delay: 200ms">
        Buyer, seller, occupier, owner, landlord, tenant — every side of a commercial deal walks in with a question
        that has a math answer. Most people get that answer from the other side's broker. Here it is for free, from
        your own figures, before anyone sits down. Then bring it to the advisor who negotiates the building
        <em>and</em> builds the systems that make it produce.
      </p>
      <div class="reveal mt-8 flex flex-wrap gap-4" style="--reveal-delay: 300ms">
        <a href="#seats" class="rounded-md bg-teal-600 px-6 py-3 font-semibold text-white shadow-lg transition-colors hover:bg-teal-700">Pick your seat ↓</a>
        <a href="/commercial-real-estate/" class="rounded-md border border-white/25 px-6 py-3 font-semibold text-white transition-colors hover:border-teal-400 hover:text-teal-400">How we represent you</a>
      </div>
    </div>
  </section>

  <section id="seats" class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        seats.map((s, i) => (
          <article class="reveal lift flex flex-col rounded-xl border border-navy-100 bg-white p-7 shadow-sm" style={`--reveal-delay: ${(i % 3) * 70}ms`}>
            <p class="font-mono text-[11px] font-bold uppercase tracking-[0.2em] text-brass-600">{s.seat}</p>
            <h2 class="mt-2 text-xl font-bold leading-snug text-navy-900">{s.question}</h2>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-500">{s.body}</p>
            <a href={s.href} class="mt-5 inline-block rounded-md bg-teal-600 px-5 py-2.5 text-center text-sm font-semibold text-white transition-colors hover:bg-teal-700">
              {s.cta} →
            </a>
            <p class="mt-4 border-t border-navy-100 pt-3 text-xs leading-relaxed text-ink-500">{s.rep}</p>
          </article>
        ))
      }
      <div class="reveal flex flex-col justify-center rounded-xl bg-navy-900 p-7" style="--reveal-delay: 140ms">
        <p class="font-mono text-[11px] font-bold uppercase tracking-[0.2em] text-teal-400">Why we give these away</p>
        <p class="mt-3 text-sm leading-relaxed text-navy-100/85">
          Because a client who walks in knowing their number is a better client — and because the tools are the
          pitch. They answer instantly, work at 2am, and ask the right questions, which is exactly what we install
          inside businesses for money. Every result is shareable by link and printable; nothing is sent anywhere.
        </p>
        <a href="/tools/" class="mt-4 text-sm font-semibold text-teal-400 hover:text-teal-300">The whole Free Shelf — fifteen tools →</a>
      </div>
    </div>
  </section>

  <section class="bg-paper">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
      <SectionHeading
        eyebrow="Then the table"
        heading="The math gets you to the room. Representation gets you the deal."
        body="A calculator can tell you the building pencils at $1.2M. It can't find the one that's not listed yet, hold the price when the inspection turns something up, or structure the lease so the free rent lands where it helps. That's the licensed work — and it's done by the same advisor who then builds the revenue systems inside the building."
        align="center"
      />
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/commercial-real-estate/" class="rounded-md bg-teal-600 px-6 py-3 font-semibold text-white transition-colors hover:bg-teal-700">Commercial real estate advisory →</a>
        <a href="/listings/" class="rounded-md border border-navy-100 bg-white px-6 py-3 font-semibold text-navy-900 transition-colors hover:border-teal-500 hover:text-teal-600">Current listings</a>
        <a href="/south-shore/" class="rounded-md border border-navy-100 bg-white px-6 py-3 font-semibold text-navy-900 transition-colors hover:border-teal-500 hover:text-teal-600">Twenty-nine South Shore towns</a>
      </div>
      <p class="mt-6 text-center text-xs text-ink-500">{SITE.license} · Buyer, seller, tenant, and landlord representation for sub-$3M owner-user and investment property.</p>
    </div>
  </section>

  <CtaSection
    heading="Ran your number? Bring it."
    body="A free strategy call turns the calculator's answer into a plan with a price — the building, the deal, and the systems that come after it."
  />
</Base>
