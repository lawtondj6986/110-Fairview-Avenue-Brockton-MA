---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaSection from '../components/CtaSection.astro';
import QuoteBrain2 from '../components/QuoteBrain2.astro';
import IndustryTicker from '../components/IndustryTicker.astro';
import { SITE } from '../config';

const title = 'QuoteBrain 2.0 — Instant Quotes for Any Service Business | ICS';
const description =
  'QuoteBrain gives your customers a serious number in 60 seconds — built around your services, your pricing logic, your branding, feeding your pipeline. Try the live demo, then imagine it quoting your business.';

const steps = [
  ['01', 'Your customer opens your site', 'No phone tag, no "we\'ll get back to you Thursday" — the quote engine is right there, working nights and weekends.'],
  ['02', 'They describe the job in taps', 'Your services, your options, your questions — sized, selected, or measured (the demo below literally measures property on satellite imagery).'],
  ['03', 'Your pricing brain answers', 'Real logic — your rates, minimums, and volume breaks — produces an honest planning range in seconds, with the math you choose to show.'],
  ['04', 'The lead lands in your pipeline', 'Name and phone unlock the written estimate; you get the full job details before your competitor has checked voicemail.'],
];

const imagine = [
  { biz: 'Landscaping & lawn care', inputs: ['Lawn size (measured on the map)', 'Mowing frequency', 'Spring/fall cleanups'], payoff: 'Season contracts priced before the first visit.' },
  { biz: 'Roofing', inputs: ['Roof footprint from satellite', 'Pitch & material', 'Tear-off vs. overlay'], payoff: 'Serious ballparks that pre-qualify every appointment.' },
  { biz: 'Cleaning services', inputs: ['Home or office size', 'Rooms & bathrooms', 'One-time vs. weekly'], payoff: 'Recurring revenue quoted and booked in one visit.' },
  { biz: 'Painting', inputs: ['Rooms or exterior sq ft', 'Prep condition', 'Timeline'], payoff: 'Estimates while the inspiration is still fresh.' },
  { biz: 'Junk removal & hauling', inputs: ['Load size', 'Access & stairs', 'Same-day option'], payoff: 'Price certainty that wins the impulse call.' },
  { biz: 'Med spas & salons', inputs: ['Service menu', 'Packages & memberships', 'First-visit offers'], payoff: 'Bookings captured at 11pm, when people actually browse.' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'QuoteBrain 2.0',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    provider: { '@type': 'Organization', name: SITE.name },
    description,
  },
];
---

<Base title={title} description={description} schema={schema}>
  <section class="bg-navy-900">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.25em] text-teal-400">QuoteBrain™ 2.0</p>
      <h1 class="reveal mt-4 max-w-3xl text-4xl font-bold leading-tight text-white sm:text-5xl" style="--reveal-delay: 100ms">
        Your competitor will call back Thursday. Your website answers in 60 seconds.
      </h1>
      <p class="reveal mt-4 font-mono text-sm font-semibold uppercase tracking-[0.15em] text-teal-400" style="--reveal-delay: 180ms">
        Instant quotes for <IndustryTicker class="text-brass-300" />
      </p>
      <p class="reveal mt-4 max-w-2xl text-lg leading-relaxed text-navy-100/90" style="--reveal-delay: 260ms">
        QuoteBrain is an instant-quote engine built around <em>your</em> services and <em>your</em> pricing logic —
        installed on your website, capturing leads while you work. Below is a live demo from one industry. As you play
        with it, picture the version that quotes what <em>you</em> sell.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <p class="mb-3 text-center font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-ink-500">
      Live demo · pavement maintenance edition · yours would quote your services
    </p>
    <div class="reveal">
      <QuoteBrain2 />
    </div>
    <p class="mt-3 text-center text-xs text-ink-500">
      Imagery © Esri · Geocoding © OpenStreetMap contributors · Demo shows planning ranges, not a contract.
    </p>
  </section>

  <!-- IMAGINE YOURS -->
  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <SectionHeading
        eyebrow="Let it run wild"
        heading="What would yours quote?"
        body="Every install starts from a blank slate: your service menu, your rates, your qualifying questions. A few of the builds we can spin up — and if your industry isn't here, that's the fun part."
        align="center"
      />
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          imagine.map((card, i) => (
            <div class="reveal lift flex flex-col rounded-xl border border-navy-100 bg-paper p-6" style={`--reveal-delay: ${(i % 3) * 60}ms`}>
              <h3 class="text-lg font-bold text-navy-900">{card.biz}</h3>
              <p class="mt-3 text-xs font-semibold uppercase tracking-widest text-teal-600">Your customers would tap</p>
              <ul class="mt-2 flex-1 space-y-1.5">
                {card.inputs.map((inp) => (
                  <li class="flex gap-2 text-sm text-ink-700">
                    <span class="text-teal-600">·</span>
                    {inp}
                  </li>
                ))}
              </ul>
              <p class="mt-4 border-t border-navy-100 pt-3 text-sm font-medium leading-relaxed text-navy-900">{card.payoff}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-8 text-center text-sm text-ink-500">
        Sell something else entirely? Good. Bring us the weirdest pricing logic you've got —
        <a href="/contact/" class="font-semibold text-teal-600 hover:text-teal-500">that's a fun call for us</a>.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <SectionHeading eyebrow="How it works" heading="Four steps, no phone tag" align="center" />
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map(([n, t, b], i) => (
          <div class="reveal rounded-xl border border-navy-100 bg-white p-6 shadow-sm" style={`--reveal-delay: ${i * 60}ms`}>
            <p class="font-mono text-sm font-bold text-teal-600">{n}</p>
            <h3 class="mt-2 text-lg font-bold text-navy-900">{t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-500">{b}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <div class="reveal rounded-xl bg-navy-950 p-8 text-center sm:p-10">
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brass-300">Ready when you are</p>
        <h2 class="mx-auto mt-3 max-w-2xl text-3xl font-bold text-white">
          Get QuoteBrain built for <em class="not-italic text-teal-400">your</em> business
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-navy-100/85">
          QuoteBrain installs ship with every JobSite system — your services, your pricing brain, your branding,
          feeding your CRM. While your competitor's customers wait for a callback, yours get a serious number in one
          minute.
        </p>
        <a href="/contact/" class="mt-7 inline-block rounded-md bg-teal-600 px-6 py-3 font-semibold text-white transition-colors hover:bg-teal-500">
          Start the Conversation
        </a>
      </div>
    </div>
  </section>

  <CtaSection
    heading="Prefer a human number?"
    body="Skip the calculator entirely — call or email and Daniel will price it with you personally, usually within 48 hours."
  />
</Base>
