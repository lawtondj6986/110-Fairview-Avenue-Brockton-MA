---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import { SITE } from '../config';

const title = 'Contact | Book a Free Strategy Call | Innovative Commercial Strategies';
const description =
  'Book a free strategy call with Innovative Commercial Strategies — commercial real estate advisory and AI systems for South Shore MA business owners. Response within one business day.';
---

<Base title={title} description={description}>
  <section class="bg-navy-900">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-teal-400">Contact</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-bold leading-tight text-white sm:text-5xl">
        One call. A straight answer. A concrete next step.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-navy-100/90">
        Whether it's a building, your marketing, your operations — or all three — the first strategy call is free and
        you'll leave knowing exactly what we'd do and what it would cost.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-5">
      <div class="lg:col-span-3">
        <LeadForm heading="Send a message" />
      </div>
      <aside class="space-y-5 lg:col-span-2">
        <div class="rounded-xl bg-navy-900 p-6">
          <h2 class="text-lg font-bold text-white">Prefer to book directly?</h2>
          <p class="mt-2 text-sm leading-relaxed text-navy-100/85">
            Grab a time that works for you — calls are 30–45 minutes, by phone or video.
          </p>
          <a
            href={SITE.bookingUrl}
            rel="noopener"
            class="mt-4 inline-block rounded-md bg-teal-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-teal-500"
          >
            Book a Strategy Call
          </a>
        </div>
        <div class="rounded-xl border border-navy-100 bg-white p-6 shadow-sm">
          <h2 class="text-lg font-bold text-navy-900">Direct</h2>
          <div class="mt-3 space-y-2 text-sm">
            <p>
              <span class="text-ink-500">Email:</span>
              <a href={`mailto:${SITE.email}`} class="font-semibold text-teal-600 hover:text-teal-500">{SITE.email}</a>
            </p>
            <p>
              <span class="text-ink-500">Phone:</span>
              <a href={`tel:${SITE.phone.replace(/[^\d+]/g, '')}`} class="font-semibold text-teal-600 hover:text-teal-500">{SITE.phone}</a>
            </p>
            <p><span class="text-ink-500">Based in:</span> <span class="font-semibold text-navy-900">Brockton, MA</span></p>
          </div>
          <p class="mt-4 text-xs text-ink-500">{SITE.license}</p>
        </div>
        <div class="rounded-xl border border-navy-100 bg-white p-6 shadow-sm">
          <h2 class="text-lg font-bold text-navy-900">What happens next</h2>
          <ol class="mt-3 space-y-2 text-sm text-ink-700">
            <li class="flex gap-2"><span class="font-display font-bold text-teal-600">1.</span> We reply within one business day.</li>
            <li class="flex gap-2"><span class="font-display font-bold text-teal-600">2.</span> A 30–45 min call about your business, not a sales pitch.</li>
            <li class="flex gap-2"><span class="font-display font-bold text-teal-600">3.</span> A written recommendation with scope, price, and expected outcomes.</li>
          </ol>
        </div>
      </aside>
    </div>
  </section>
</Base>
