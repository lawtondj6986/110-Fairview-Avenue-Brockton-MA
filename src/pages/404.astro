---
import Base from '../layouts/Base.astro';

const title = 'Page Not Found | Innovative Commercial Strategies';
const description = 'The page you were looking for could not be found.';
---

<Base title={title} description={description}>
  <section class="mx-auto flex max-w-3xl flex-col items-center px-4 py-28 text-center sm:px-6">
    <p class="font-display text-6xl font-bold text-navy-900">404</p>
    <h1 class="mt-4 text-2xl font-bold text-navy-900">This page moved, sold, or never existed.</h1>
    <p class="mt-3 max-w-md text-ink-500">
      Like the best off-market buildings, what you're looking for isn't at this address. Let's get you somewhere
      useful.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <button
        type="button"
        data-open-search
        class="rounded-md bg-teal-600 px-6 py-3 font-semibold text-white hover:bg-teal-500"
      >
        Search the Site (⌘K)
      </button>
      <a href="/start/" class="rounded-md border border-navy-900 px-6 py-3 font-semibold text-navy-900 hover:bg-navy-900 hover:text-white">
        45-Second Fit Finder
      </a>
      <a href="/" class="rounded-md border border-navy-100 px-6 py-3 font-semibold text-ink-500 hover:border-teal-500 hover:text-teal-600">
        Back Home
      </a>
    </div>
    <p class="mt-6 text-sm text-ink-500">
      Or just ask: <a href="/answers/" class="font-semibold text-teal-600 hover:text-teal-500">straight answers live here →</a>
    </p>
  </section>
</Base>
