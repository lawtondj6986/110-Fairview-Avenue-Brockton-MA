---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config';

const title = 'Candidate Vulnerability Self-Check — Free, 2 Minutes | ICS';
const description =
  'How exposed is your campaign? A free, no-email self-assessment: score your own public-record vulnerability across the ten things an opponent researches — votes, donors, litigation, business history, statements, and more — and see where you stand before anyone pulls your file.';

const questions = [
  ['You have held elected or appointed office, or cast votes on a public board or committee.', 'A voting record is the first thing researched — and the easiest to quote against you.'],
  ['There are meetings you missed, or positions you have changed over time.', 'Attendance gaps and reversals are documented in minutes and clip cleanly into an attack.'],
  ['You have accepted campaign contributions — especially from donors with business before your body.', 'Finance filings cross-referenced against your votes are the classic pay-to-play timeline.'],
  ['You, or a business you have owned, has been party to a lawsuit, lien, judgment, or bankruptcy.', 'Court and registry records are public, permanent, and pulled county by county.'],
  ['You have owned, operated, or been an officer of a business, LLC, or partnership.', 'Corporate filings reveal affiliations, failed ventures, and officer histories.'],
  ['You own property or hold interests that appear in public records or disclosure filings.', 'Deeds, assessments, and financial-interest disclosures surface conflicts you may have forgotten.'],
  ['You have years of public statements, interviews, or social-media posts online.', 'The archived internet keeps deleted pages and old positions, timestamped.'],
  ['Your bio makes specific claims — degrees, titles, "lifelong resident," service, business success.', 'Every verifiable claim is a claim that can be checked — and narrative fraud is the deadliest hit.'],
  ['No one has professionally assembled your own public file the way an opponent would.', 'If you have not read your own book, you are reading it for the first time in October — in an attack ad.'],
  ['Your likely opponent has money, a consultant, or a real motive to do the research.', 'Exposure only matters if someone is looking. Assume they are.'],
];

const bands = [
  { min: 0, max: 2, label: 'Low profile', tone: 'text-teal-600', note: 'A limited public footprint — but "limited" is not "none," and a thin record can still hide one sharp item. A focused audit is inexpensive insurance.' },
  { min: 3, max: 5, label: 'Moderate exposure', tone: 'text-brass-600', note: 'A normal amount of public record for someone stepping up — which means there is enough material for an opponent to build a case. Knowing what is in it changes how you campaign.' },
  { min: 6, max: 8, label: 'High exposure', tone: 'text-brass-600', note: 'A long, researchable trail. The question is no longer whether there are findings — it is whether you see them before your opponent does. Get ahead of it now.' },
  { min: 9, max: 10, label: 'Maximum exposure', tone: 'text-red-700', note: 'Assume your file is already being pulled. Every thread checked above is one someone can follow. A vulnerability audit is not optional at this level — it is the first move.' },
];
---

<Base title={title} description={description}>
  <section class="bg-navy-950">
    <div class="mx-auto max-w-4xl px-4 py-12 text-center sm:px-6 sm:py-16">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.25em] text-brass-300">Free · 2 minutes · No email</p>
      <h1 class="reveal mx-auto mt-4 max-w-2xl text-4xl font-bold leading-tight text-white sm:text-5xl" style="--reveal-delay: 100ms">
        How exposed is your campaign?
      </h1>
      <p class="reveal mx-auto mt-4 max-w-xl text-lg leading-relaxed text-navy-100/90" style="--reveal-delay: 200ms">
        Check every statement that is true. You are scoring your own public-record exposure — the same ten things an
        opponent researches. Nothing is sent anywhere; the result appears right here.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <div id="vcheck" class="rounded-2xl border border-navy-100 bg-white p-6 shadow-lg sm:p-8">
      <div class="space-y-2">
        {
          questions.map(([q, why], i) => (
            <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-navy-100 bg-paper px-4 py-3 transition-colors has-[:checked]:border-brass-400 has-[:checked]:bg-brass-500/10">
              <input type="checkbox" class="vq mt-1 h-4 w-4 shrink-0 accent-brass-600" data-why={why} />
              <span>
                <span class="text-sm font-semibold text-navy-900">{q}</span>
                <span class="vwhy mt-1 hidden text-xs leading-relaxed text-ink-500">{why}</span>
              </span>
            </label>
          ))
        }
      </div>

      <div class="mt-6 flex items-center justify-between gap-4 border-t border-navy-100 pt-5">
        <p class="text-sm text-ink-500">Exposure flags: <span id="vc-count" class="font-mono font-bold text-navy-900">0</span> / 10</p>
        <button id="vc-run" type="button" class="rounded-md bg-brass-500 px-5 py-2.5 text-sm font-semibold text-navy-950 transition-colors hover:bg-brass-300">
          See My Exposure →
        </button>
      </div>

      <div id="vc-result" class="mt-6 hidden rounded-xl border border-navy-100 bg-navy-950 p-6 text-center">
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-brass-300">Your exposure</p>
        <p id="vc-band" class="mt-2 font-display text-3xl font-bold text-white"></p>
        <p id="vc-score" class="mt-1 font-mono text-sm text-navy-100/60"></p>
        <p id="vc-note" class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-navy-100/85"></p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a id="vc-cta" href="/political/" class="rounded-md bg-brass-500 px-5 py-2.5 text-sm font-semibold text-navy-950 transition-colors hover:bg-brass-300">
            The Vulnerability Audit →
          </a>
          <a href={`mailto:${SITE.email}?subject=${encodeURIComponent('Vulnerability audit — confidential inquiry')}`} class="rounded-md border border-white/25 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-brass-300 hover:text-brass-300">
            Talk to {SITE.founder}
          </a>
        </div>
        <p class="mt-4 text-[11px] leading-relaxed text-navy-100/50">
          A self-check is not a research product — it tells you where to look. The audit is where we actually look,
          under the <a href="/political/" class="font-semibold text-brass-300 hover:text-brass-200">published methods code</a>, one client per race.
        </p>
      </div>
    </div>

    <p class="mt-6 text-center text-xs text-ink-500">
      Every candidate should read their own book first. <a href="/political/" class="font-semibold text-teal-600 hover:text-teal-500">How the political desk works →</a>
    </p>
  </section>
</Base>

<script
  define:vars={{ bands }}
>
  function initVCheck() {
    const root = document.getElementById('vcheck');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';

    const boxes = Array.from(root.querySelectorAll('.vq'));
    const count = document.getElementById('vc-count');

    function tally() {
      const n = boxes.filter((b) => b.checked).length;
      count.textContent = String(n);
      // reveal the "why" under any checked item
      root.querySelectorAll('.vq').forEach((b) => {
        const why = b.closest('label').querySelector('.vwhy');
        if (why) why.classList.toggle('hidden', !b.checked);
      });
      return n;
    }

    boxes.forEach((b) => b.addEventListener('change', tally));

    document.getElementById('vc-run').addEventListener('click', () => {
      const n = tally();
      const band = bands.find((x) => n >= x.min && n <= x.max) || bands[bands.length - 1];
      document.getElementById('vc-band').textContent = band.label;
      document.getElementById('vc-score').textContent = `${n} of 10 exposure flags`;
      document.getElementById('vc-note').textContent = band.note;
      const res = document.getElementById('vc-result');
      res.classList.remove('hidden');
      res.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      try {
        // @ts-ignore
        window.va && window.va('event', { name: 'lead_vuln_selfcheck', data: { score: n, band: band.label } });
      } catch (e) { /* analytics never blocks */ }
    });

    tally();
  }
  document.addEventListener('astro:page-load', initVCheck);
</script>
