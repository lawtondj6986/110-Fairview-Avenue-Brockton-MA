---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import CtaSection from '../components/CtaSection.astro';
import { SITE } from '../config';

const retailWins = (await getCollection('case-studies', ({ data }) => !data.draft && data.vertical === 'retail'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const title = 'Retail Consultants — Real-Time Inventory Online, Run From One Panel | ICS';
const description =
  'Retail consultants and platform builders for South Shore MA stores — including firearms dealers and other regulated retail: real-time inventory on your website, an admin panel you run yourself, reserve-and-pickup flows built around your compliance process, and visibility where ad platforms say no.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Retail consulting and retail platform development',
    name: 'Retail Consultants & Systems',
    provider: { '@type': 'RealEstateAgent', name: SITE.name, telephone: SITE.phone },
    areaServed: 'South Shore, Massachusetts',
    audience: { '@type': 'Audience', audienceType: 'Independent retailers, including firearms dealers and regulated retail' },
    description,
  },
];

const stack = [
  {
    name: 'Your live inventory, on your website',
    body: "What's on the shelf is on the site — stock, pricing, photos — synced in real time. Customers check before they drive, call about what's actually there, and buy with confidence. The storefront keeps selling after the counter closes.",
  },
  {
    name: 'An admin panel you actually run',
    body: 'List a product, change a price, mark it sold — in minutes, from the counter, with no developer and no ticket queue. You own the panel, the data, and the pace. Our job was making it powerful; our other job was making it yours.',
  },
  {
    name: 'Reserve & pick up, built around your process',
    body: 'Customers commit online; the transaction completes in your store, inside your process. For regulated goods that means the paperwork happens exactly where the law says it does — the website accelerates the sale without ever shortcutting the counter.',
  },
  {
    name: 'Found by search — and by AI',
    body: "Product-level SEO, structured data, and answer-engine visibility, so 'who has X in stock near me' finds your live shelf. For categories the ad platforms restrict, owned visibility isn't a nice-to-have — it's the whole game.",
  },
];

const regulated = [
  ['Payment processing that sticks', 'Mainstream processors routinely drop firearms merchants mid-stream. We architect around processors that genuinely serve the category, so your checkout doesn\'t vanish on a compliance sweep.'],
  ['Platforms that won\'t evict you', 'Shopify and the big site builders prohibit or restrict firearm sales — a store built there is a store built on borrowed land. We build on open code you own, where the rules are the law, not a platform policy.'],
  ['Marketing inside the restrictions', 'Meta and Google won\'t run your product ads. Fine — the winners in this category are built on local SEO, answer-engine visibility, review velocity, and an owned audience. That happens to be exactly our toolkit.'],
  ['Compliance-aware by design', 'Reserve online, complete in store: background checks, transfers, and paperwork happen at the counter, per your process and your license. We build with your compliance workflow, never around it — and where questions get legal, your attorney leads.'],
];
---

<Base title={title} description={description} schema={schema}>
  <section class="bg-navy-900">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.25em] text-teal-400">Retail consultants · Including regulated retail</p>
      <h1 class="reveal mt-4 max-w-3xl text-4xl font-bold leading-tight text-white sm:text-5xl" style="--reveal-delay: 100ms">
        Your whole store, online. Run from one panel.
      </h1>
      <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-navy-100/90" style="--reveal-delay: 200ms">
        We build retail platforms where the website shows the real shelf — live inventory, owner-run admin, and
        pickup flows shaped to your process. Proven in one of the hardest categories on the internet: a Massachusetts
        firearms dealer reporting business up <strong class="text-teal-400">300%</strong> since launch.
      </p>
      <div class="reveal mt-8 flex flex-wrap gap-4" style="--reveal-delay: 300ms">
        <a href="/contact/" class="rounded-md bg-teal-600 px-6 py-3 font-semibold text-white shadow-lg transition-colors hover:bg-teal-500">
          Talk About Your Store
        </a>
        <a href="/case-studies/outback-arms-retail-platform/" class="rounded-md border border-white/25 px-6 py-3 font-semibold text-white transition-colors hover:border-teal-400 hover:text-teal-400">
          The Outback Arms Story
        </a>
      </div>
      <p class="reveal mt-5 text-sm text-navy-100/70" style="--reveal-delay: 380ms">
        Or skip the case study and browse the live build yourself:
        <a href="https://outbackarms.com" rel="noopener" class="font-semibold text-teal-400 hover:text-teal-500">outbackarms.com →</a>
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <SectionHeading eyebrow="The retail stack" heading="Four pieces, one working store" align="center" />
    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        stack.map((s, i) => (
          <div class="reveal lift rounded-xl border border-navy-100 bg-white p-7 shadow-sm" style={`--reveal-delay: ${(i % 2) * 70}ms`}>
            <h2 class="text-xl font-bold text-navy-900">{s.name}</h2>
            <p class="mt-3 text-sm leading-relaxed text-ink-500">{s.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- REGULATED RETAIL -->
  <section class="bg-navy-950">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <SectionHeading
        eyebrow="Firearms & regulated retail"
        heading="The stores most agencies won't build for"
        body="Firearms dealers and other regulated retailers get told 'no' by platforms, processors, and ad networks — then get quoted double by the few agencies who'll try. We've shipped in this category — and we work behind a counter in it. These are the problems that actually decide who wins:"
        align="center"
        dark
      />
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {
          regulated.map(([h, b], i) => (
            <div class="reveal rounded-xl border border-white/10 bg-navy-900 p-7" style={`--reveal-delay: ${(i % 2) * 70}ms`}>
              <h3 class="font-display text-lg font-bold text-teal-400">{h}</h3>
              <p class="mt-2 text-sm leading-relaxed text-navy-100/80">{b}</p>
            </div>
          ))
        }
      </div>
      <p class="mx-auto mt-8 max-w-2xl text-center text-xs leading-relaxed text-navy-100/50">
        We build software and marketing systems for licensed dealers operating within federal and state law. Nothing
        here is legal advice — your license, your counsel, your compliance process lead every build.
      </p>
    </div>
  </section>

  <!-- INSIDE THE BUILD -->
  <section class="bg-paper">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <SectionHeading
        eyebrow="Inside the build"
        heading="High-end engineering. Zero learning curve."
        body="Two standards, held at the same time: the code is built to a level most local retail never sees — and the people using it every day never have to think about that. Every one of these is live right now at outbackarms.com."
        align="center"
      />
      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        <div class="reveal rounded-xl border border-navy-100 bg-white p-8 shadow-sm">
          <p class="text-xs font-semibold uppercase tracking-widest text-brass-600">The engineering</p>
          <h3 class="mt-2 text-2xl font-bold text-navy-900">Built like software, not a brochure</h3>
          <ul class="mt-5 space-y-3 text-sm leading-relaxed text-ink-700">
            {
              [
                ['Open code, fully owned', 'Custom-built on open code the store owns outright — no platform landlord, no policy rug-pull, no monthly ransom for your own storefront.'],
                ['Inventory as the source of truth', 'One live database drives the shelf, the website, and the panel. Change it once, it changes everywhere — the site can never disagree with the store.'],
                ['Fast on a phone in a parking lot', 'Most customers check stock from their truck, not a desktop. The site is engineered to load instantly on mobile, where the buying decision actually happens.'],
                ['Structured for search and AI', "Product-level structured data, so search engines and AI assistants can read the live shelf and answer 'who has one in stock near me' with this store."],
                ['Built to outlast trends', 'No dependence on any platform, plugin marketplace, or vendor that can change its rules. If we disappeared tomorrow, the store keeps running.'],
              ].map(([h, b]) => (
                <li class="flex gap-3">
                  <span class="mt-0.5 text-teal-600">✓</span>
                  <span><strong class="text-navy-900">{h}.</strong> {b}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="reveal rounded-xl border border-navy-100 bg-white p-8 shadow-sm" style="--reveal-delay: 80ms">
          <p class="text-xs font-semibold uppercase tracking-widest text-brass-600">The people using it</p>
          <h3 class="mt-2 text-2xl font-bold text-navy-900">If you can run a register, you can run this</h3>
          <ul class="mt-5 space-y-3 text-sm leading-relaxed text-ink-700">
            {
              [
                ['Plain-language panel', 'No dashboard jargon, no settings maze. List a product, change a price, mark it sold — the three things a counter actually does, right on top.'],
                ['Works between customers', "Designed for the real rhythm of a shop floor: a new arrival goes up, with photos, in the minutes between one customer and the next — from the device at the counter."],
                ['No developer, no ticket queue', 'Nobody emails an agency to fix a price. Staff make the change and it is live on the website that second.'],
                ['Hard to break on a busy Saturday', 'The panel is built so the fast, obvious action is also the correct one — a new hire can be trusted with it on day one.'],
                ['The shelf never lies', 'When something sells, it leaves the website — so no employee ever has to tell a customer who drove forty minutes that it sold on Tuesday.'],
              ].map(([h, b]) => (
                <li class="flex gap-3">
                  <span class="mt-0.5 text-teal-600">✓</span>
                  <span><strong class="text-navy-900">{h}.</strong> {b}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <p class="mt-8 text-center text-sm text-ink-500">
        Don't take the list's word for it —
        <a href="https://outbackarms.com" rel="noopener" class="font-semibold text-teal-600 hover:text-teal-500">browse the live storefront at outbackarms.com →</a>
      </p>
    </div>
  </section>

  <!-- THE COUNTER STORY -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.25em] text-teal-600">Why we get this category right</p>
      <h2 class="reveal mx-auto mt-3 max-w-xl font-display text-3xl font-bold text-navy-900" style="--reveal-delay: 80ms">
        We didn't study this counter. We work it.
      </h2>
      <p class="reveal mx-auto mt-5 max-w-2xl text-base leading-relaxed text-ink-700" style="--reveal-delay: 160ms">
        Our founder works the counter at Outback Arms in Plympton — the same store whose platform you can browse
        above. Transfers, paperwork, the Saturday rush, the customer who drove forty minutes to ask about something
        that sold on Tuesday. That last one is why real-time inventory isn't a feature on our list — it's the reason
        the platform exists.
      </p>
      <p class="reveal mx-auto mt-4 max-w-2xl text-base leading-relaxed text-ink-700" style="--reveal-delay: 220ms">
        When we say the admin panel takes minutes, it's because it gets used between customers. When we say
        reserve-and-pickup respects your compliance process, it's because that paperwork happens on our side of the
        counter too. And that's our disclosure, made proudly: the 300% story on this page is a store we know from the
        inside. Judge it yourself — <a href="https://outbackarms.com" rel="noopener" class="font-semibold text-teal-600 hover:text-teal-500">the shelf is live</a>.
      </p>
    </div>
  </section>

  <!-- PROOF -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading eyebrow="Retail proof" heading="Stores we've put online" />
      <a href="/case-studies/" class="font-semibold text-teal-600 hover:text-teal-500">All case studies →</a>
    </div>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {retailWins.map((entry) => <CaseStudyCard entry={entry} />)}
    </div>
  </section>

  <CtaSection
    heading="Put your shelf on the internet."
    body="One call: bring your inventory headaches, your platform horror stories, or just your ambition. We'll tell you plainly what a build would look like — and you can browse a live one working right now at outbackarms.com."
    primaryLabel="Talk About Your Store"
    secondaryLabel="See Published Pricing"
    secondaryHref="/pricing/"
  />
</Base>
