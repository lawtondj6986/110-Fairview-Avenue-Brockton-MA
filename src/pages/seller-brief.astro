---
import Base from '../layouts/Base.astro';
import CtaSection from '../components/CtaSection.astro';
import FounderCard from '../components/FounderCard.astro';
import ShareKit from '../components/ShareKit.astro';
import { TOWNS } from '../lib/towns';
import { SITE, FOUNDER } from '../config';

const title = 'Seller Brief — The 120-Day Sale Plan for Your South Shore Building, Written From Your Answers | Free ICS Tool';
const description =
  'Describe the building you own on the South Shore of Massachusetts: town, type, size, occupancy, leases, septic, environmental file, timing, and what you want out of it. The page writes the sale plan: the 120-day timeline with dates, the file to assemble before anyone asks, how the building will be priced, the first three moves, and the town\'s property read. Free, no email, shareable, printable.';

const TYPES = [
  ['retail', 'Retail or restaurant'],
  ['office', 'Office or medical'],
  ['flex', 'Flex, warehouse, or industrial'],
  ['mixed', 'Mixed-use'],
  ['multi', 'Multi-tenant plaza or building'],
  ['auto', 'Auto or service garage'],
  ['land', 'Land or redevelopment site'],
];
const SIZES = [
  ['s', 'Under 3,000 sq ft'],
  ['m', '3,000 to 10,000 sq ft'],
  ['l', '10,000 to 30,000 sq ft'],
  ['xl', 'Over 30,000 sq ft'],
];
const OCC = [
  ['owner', 'I occupy it (owner-user)'],
  ['single', 'One tenant'],
  ['multi', 'Several tenants'],
  ['vacant', 'Vacant'],
];
const LEASE = [
  ['nnn', 'Triple-net leases in place'],
  ['gross', 'Gross or modified gross leases'],
  ['mtm', 'Month-to-month or handshake'],
  ['none', 'No leases (owner-occupied or vacant)'],
];
const SEWER = [
  ['sewer', 'Municipal sewer'],
  ['septic', 'Septic system'],
  ['unsure', 'Not sure'],
];
const ENV = [
  ['phase1', 'A Phase I on file'],
  ['none', 'No environmental report'],
  ['known', 'A known 21E history or AUL'],
];
const COND = [
  ['turnkey', 'Turnkey'],
  ['fair', 'Fair, some deferred maintenance'],
  ['rough', 'Needs real work'],
];
const TIMING = [
  ['now', 'Ready to go to market now'],
  ['q', 'In three to six months'],
  ['year', 'Within a year'],
  ['explore', 'Just exploring'],
];
const GOALS = [
  ['sell', 'Sell outright'],
  ['slb', 'Sell and lease it back'],
  ['1031', 'Sell and exchange (1031)'],
  ['price', 'A number first, then decide'],
];
const PRICE = [
  ['', 'Not sure yet'],
  ['750000', 'Under $1M'],
  ['1500000', '$1M to $2M'],
  ['3000000', '$2M to $4M'],
  ['6000000', '$4M to $8M'],
  ['10000000', 'Over $8M'],
];
const townData = TOWNS.map((t) => ({ s: t.slug, n: t.name, c: t.county, p: t.propertyMix, r: t.corridors.slice(0, 3).join(' · ') })).sort((a, b) => a.n.localeCompare(b.n));
const today = new Date().toISOString().slice(0, 10);

const faqs = [
  { q: 'Is the Seller Brief a valuation?', a: 'No. It is the plan: the timeline, the file, the pricing approach, and the first moves, written from the facts you give it. The number comes from the free building valuation, which is walked in person and built on real comparables, or from the cap rate tool if the building is leased. The brief tells you which one applies.' },
  { q: 'How long does it really take to sell a South Shore commercial building?', a: 'About 120 days from the first call to the Registry when the file is ready and the price is right: two to three weeks of preparation, four to six weeks of marketing to a signed offer, and sixty to seventy-five days of due diligence, financing, and closing. Septic, environmental, and multi-tenant estoppels are what stretch it, which is why the brief asks about them first.' },
  { q: 'What does it cost to sell?', a: 'Massachusetts deeds excise is $4.56 per $1,000 of price, paid by the seller. Commission is negotiated and published on this site. Add a municipal lien certificate, legal fees, and any Title V or environmental work. The seller net sheet runs the whole number from your price.' },
  { q: 'Do I have to list it publicly?', a: 'No. A quiet sale to the buyers already hunting this type of building in your town is often the better outcome for an owner-user who does not want staff or tenants to know. The brief notes when a quiet process fits and when open marketing gets the better price.' },
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'ICS Seller Brief', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', url: `${SITE.url}/seller-brief/`, description, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, provider: { '@id': `${SITE.url}/#business` } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
const chip = 'sb-chip rounded-full border border-navy-100 bg-white px-3 py-1.5 text-xs font-semibold text-navy-900 hover:border-teal-500 aria-pressed:border-teal-600 aria-pressed:bg-teal-600 aria-pressed:text-white';
const select = 'w-full rounded-md border border-navy-100 bg-white px-3 py-2 text-sm text-navy-900 focus:border-teal-500 focus:outline-none';
---

<Base title={title} description={description} schema={schema}>
  <section class="bg-navy-950 print:hidden">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.25em] text-brass-300">Free tool · Seller Brief · South Shore MA · no email</p>
      <h1 class="reveal mt-4 max-w-3xl text-4xl font-bold leading-tight text-white sm:text-5xl" style="--reveal-delay: 100ms">Tell us the building. The page writes the sale plan.</h1>
      <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-navy-100/90" style="--reveal-delay: 200ms">
        Ten answers about the building you own, and you get the 120-day timeline with dates, the file to assemble before a buyer asks, how it will be priced, the first three moves, and the town's property read. Send it to yourself, your partner, or to {FOUNDER.firstName}.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6" id="sb" data-today={today}>
    <div class="grid gap-8 lg:grid-cols-[1fr_1.2fr]">
      <form class="space-y-6 print:hidden" id="sb-form" autocomplete="off">
        <div>
          <label for="sb-town" class="font-mono text-[11px] font-bold uppercase tracking-[0.25em] text-ink-500">The town</label>
          <select id="sb-town" class={`mt-2 ${select}`}>
            {townData.map((t) => <option value={t.s} selected={t.s === 'brockton'}>{t.n}</option>)}
          </select>
        </div>
        <div>
          <p class="font-mono text-[11px] font-bold uppercase tracking-[0.25em] text-ink-500">The building</p>
          <div class="mt-2 flex flex-wrap gap-2" data-group="type">{TYPES.map(([v, l], i) => <button type="button" class={chip} data-v={v} aria-pressed={i === 2 ? 'true' : 'false'}>{l}</button>)}</div>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="font-mono text-[11px] font-bold uppercase tracking-[0.25em] text-ink-500">Size</span><select id="sb-size" class={`mt-2 ${select}`}>{SIZES.map(([v, l]) => <option value={v} selected={v === 'm'}>{l}</option>)}</select></label>
          <label class="block"><span class="font-mono text-[11px] font-bold uppercase tracking-[0.25em] text-ink-500">Who is in it</span><select id="sb-occ" class={`mt-2 ${select}`}>{OCC.map(([v, l]) => <option value={v}>{l}</option>)}</select></label>
          <label class="block"><span class="font-mono text-[11px] font-bold uppercase tracking-[0.25em] text-ink-500">Leases</span><select id="sb-lease" class={`mt-2 ${select}`}>{LEASE.map(([v, l]) => <option value={v} selected={v === 'none'}>{l}</option>)}</select></label>
          <label class="block"><span class="font-mono text-[11px] font-bold uppercase tracking-[0.25em] text-ink-500">Sewer or septic</span><select id="sb-sewer" class={`mt-2 ${select}`}>{SEWER.map(([v, l]) => <option value={v}>{l}</option>)}</select></label>
          <label class="block"><span class="font-mono text-[11px] font-bold uppercase tracking-[0.25em] text-ink-500">Environmental file</span><select id="sb-env" class={`mt-2 ${select}`}>{ENV.map(([v, l]) => <option value={v} selected={v === 'none'}>{l}</option>)}</select></label>
          <label class="block"><span class="font-mono text-[11px] font-bold uppercase tracking-[0.25em] text-ink-500">Condition</span><select id="sb-cond" class={`mt-2 ${select}`}>{COND.map(([v, l]) => <option value={v} selected={v === 'fair'}>{l}</option>)}</select></label>
          <label class="block"><span class="font-mono text-[11px] font-bold uppercase tracking-[0.25em] text-ink-500">Timing</span><select id="sb-timing" class={`mt-2 ${select}`}>{TIMING.map(([v, l]) => <option value={v} selected={v === 'q'}>{l}</option>)}</select></label>
          <label class="block"><span class="font-mono text-[11px] font-bold uppercase tracking-[0.25em] text-ink-500">Price you have in mind</span><select id="sb-price" class={`mt-2 ${select}`}>{PRICE.map(([v, l]) => <option value={v}>{l}</option>)}</select></label>
        </div>
        <div>
          <p class="font-mono text-[11px] font-bold uppercase tracking-[0.25em] text-ink-500">What you want out of it</p>
          <div class="mt-2 flex flex-wrap gap-2" data-group="goal">{GOALS.map(([v, l], i) => <button type="button" class={chip} data-v={v} aria-pressed={i === 0 ? 'true' : 'false'}>{l}</button>)}</div>
        </div>
        <p class="text-xs text-ink-500">Nothing here is sent anywhere until you choose to send it. The brief lives in the link.</p>
      </form>

      <article class="rounded-2xl border border-navy-100 bg-white p-6 shadow-sm sm:p-8 print:border-0 print:p-0 print:shadow-none" id="sb-out">
        <p class="font-mono text-[11px] font-bold uppercase tracking-[0.25em] text-brass-600">Seller brief · prepared <span id="sb-date"></span></p>
        <h2 class="mt-2 font-display text-2xl font-bold leading-snug text-navy-900 sm:text-3xl" id="sb-headline"></h2>
        <p class="mt-2 text-sm text-ink-500" id="sb-sub"></p>

        <section class="mt-6">
          <h3 class="font-mono text-[11px] font-bold uppercase tracking-[0.25em] text-teal-700">The town's property read</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-700" id="sb-town-read"></p>
          <p class="mt-1 text-xs text-ink-500"><span id="sb-town-corr"></span> · <a id="sb-town-link" href="/south-shore/brockton/" class="font-semibold text-teal-600 hover:text-teal-700">The town page →</a></p>
        </section>

        <section class="mt-6">
          <h3 class="font-mono text-[11px] font-bold uppercase tracking-[0.25em] text-teal-700">The 120 days, with dates</h3>
          <ol class="mt-3 space-y-3 text-sm text-ink-700" id="sb-timeline"></ol>
        </section>

        <section class="mt-6">
          <h3 class="font-mono text-[11px] font-bold uppercase tracking-[0.25em] text-teal-700">The file to assemble before anyone asks</h3>
          <ul class="mt-3 grid gap-2 text-sm text-ink-700 sm:grid-cols-2" id="sb-file"></ul>
        </section>

        <section class="mt-6">
          <h3 class="font-mono text-[11px] font-bold uppercase tracking-[0.25em] text-teal-700">How it will be priced</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-700" id="sb-pricing"></p>
        </section>

        <section class="mt-6">
          <h3 class="font-mono text-[11px] font-bold uppercase tracking-[0.25em] text-teal-700">The first three moves</h3>
          <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-ink-700" id="sb-moves"></ol>
        </section>

        <section class="mt-6 rounded-xl border border-navy-100 bg-paper p-4 print:hidden">
          <p class="text-sm font-semibold text-navy-900">Run the numbers</p>
          <p class="mt-1 text-sm text-ink-700" id="sb-tools"></p>
        </section>

        <div class="mt-6 print:hidden">
          <a id="sb-send" href="/contact/" class="block rounded-md bg-brass-500 px-5 py-3 text-center font-semibold text-navy-950 hover:bg-brass-300">Send this brief to {FOUNDER.firstName} →</a>
          <div class="mt-3 flex flex-wrap gap-2">
            <button type="button" id="sb-share" class="rounded-md border border-navy-100 bg-white px-3 py-2 text-sm font-semibold text-navy-900 hover:border-teal-500">Copy a shareable link</button>
            <button type="button" id="sb-print" class="rounded-md border border-navy-100 bg-white px-3 py-2 text-sm font-semibold text-navy-900 hover:border-teal-500">Print</button>
          </div>
          <div class="mt-2"><ShareKit what="a seller brief I built on the ICS site" compact /></div>
        </div>
        <p class="mt-6 text-xs text-ink-500">Prepared by {FOUNDER.name}, Licensed MA Real Estate Salesperson #9082020. A plan, not legal or tax advice; your attorney and CPA sign off on the exchange, the taxes, and the P&amp;S.</p>
      </article>
    </div>
  </section>

  <section class="bg-paper">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
      <h2 class="text-center font-display text-2xl font-bold text-navy-900">Asked by owners before they sell</h2>
      <div class="mt-8 space-y-4">
        {faqs.map((f) => (
          <details class="rounded-xl border border-navy-100 bg-white p-5" open>
            <summary class="cursor-pointer list-none font-semibold text-navy-900">{f.q}</summary>
            <p class="mt-3 text-sm leading-relaxed text-ink-700">{f.a}</p>
          </details>
        ))}
      </div>
      <p class="mt-8 text-center text-sm text-ink-500">Buying instead? <a href="/buyer-brief/" class="font-semibold text-teal-600 hover:text-teal-700">The Buyer Brief →</a> <span class="mx-2">·</span> The whole timeline, explained: <a href="/insights/selling-a-south-shore-commercial-building-timeline/" class="font-semibold text-teal-600 hover:text-teal-700">Selling a South Shore building in 120 days →</a></p>
    </div>
  </section>

  <FounderCard heading="Who reads the brief" line="Every seller brief lands with the person who will walk the building, price it against real comparables, and run the sale. One advisor, Massachusetts-licensed, no handoff to a junior." />
  <CtaSection heading="Want the number to go with the plan?" body="Send the brief. You will get a free opinion of value within 48 hours of the walk-through, built on comparables you can check, and a straight read on whether now is the time." />
</Base>

<script define:vars={{ townData }}>
  function initSellerBrief() {
    const root = document.getElementById('sb');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const $ = (id) => document.getElementById(id);
    const TOWN = Object.fromEntries(townData.map((t) => [t.s, t]));
    const LABEL = {
      type: { retail: 'retail or restaurant building', office: 'office or medical building', flex: 'flex or industrial building', mixed: 'mixed-use building', multi: 'multi-tenant plaza', auto: 'auto or service garage', land: 'development site' },
      size: { s: 'under 3,000 square feet', m: '3,000 to 10,000 square feet', l: '10,000 to 30,000 square feet', xl: 'over 30,000 square feet' },
      occ: { owner: 'owner-occupied', single: 'single-tenant', multi: 'multi-tenant', vacant: 'vacant' },
      lease: { nnn: 'triple-net leases', gross: 'gross leases', mtm: 'month-to-month tenancies', none: 'no leases' },
      goal: { sell: 'an outright sale', slb: 'a sale-leaseback', '1031': 'a sale and 1031 exchange', price: 'a number before deciding' },
      timing: { now: 'now', q: 'in three to six months', year: 'within a year', explore: 'when the time is right' },
      cond: { turnkey: 'turnkey', fair: 'fair with some deferred maintenance', rough: 'in need of real work' },
    };
    const state = { town: 'brockton', type: 'flex', size: 'm', occ: 'owner', lease: 'none', sewer: 'sewer', env: 'none', cond: 'fair', timing: 'q', price: '', goal: 'sell' };
    const SHORT = { town: 't', type: 'b', size: 's', occ: 'o', lease: 'l', sewer: 'w', env: 'e', cond: 'c', timing: 'm', price: 'p', goal: 'g' };
    const SELECTS = ['town', 'size', 'occ', 'lease', 'sewer', 'env', 'cond', 'timing', 'price'];

    // Restore from URL
    const q = new URLSearchParams(location.search);
    for (const k of Object.keys(SHORT)) {
      const v = q.get(SHORT[k]);
      if (v !== null) state[k] = v;
    }
    SELECTS.forEach((k) => { const el = $('sb-' + k); if (el && [...el.options].some((o) => o.value === state[k])) el.value = state[k]; else state[k] = el.value; });

    const fmt = (d) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    const addDays = (n) => { const d = new Date(); d.setDate(d.getDate() + n); return d; };
    const li = (parent, html) => { const el = document.createElement('li'); el.innerHTML = html; parent.appendChild(el); };

    function paintChips() {
      document.querySelectorAll('[data-group]').forEach((g) => {
        const k = g.dataset.group;
        g.querySelectorAll('.sb-chip').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.v === state[k])));
      });
    }

    function render(push = true) {
      const t = TOWN[state.town] || TOWN.brockton;
      const leased = state.occ === 'single' || state.occ === 'multi';
      const septic = state.sewer === 'septic' || state.sewer === 'unsure';
      const startOffset = { now: 0, q: 90, year: 240, explore: 180 }[state.timing] ?? 90;
      const slow = (septic ? 14 : 0) + (state.env !== 'phase1' ? 14 : 0) + (state.occ === 'multi' ? 10 : 0) + (state.cond === 'rough' ? 7 : 0);
      const price = Number(state.price) || 0;

      $('sb-date').textContent = new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
      $('sb-headline').textContent = `${LABEL.occ[state.occ].replace(/^(\w)/, (c) => c.toUpperCase())} ${LABEL.type[state.type]} in ${t.n}, ${LABEL.goal[state.goal]}.`;
      $('sb-sub').textContent = `${LABEL.size[state.size].replace(/^(\w)/, (c) => c.toUpperCase())}, ${LABEL.cond[state.cond]}, ${LABEL.lease[state.lease]}, ${septic ? 'septic or unknown' : 'municipal sewer'}, ${state.env === 'phase1' ? 'Phase I on file' : state.env === 'known' ? 'a known environmental history' : 'no environmental report yet'}. Timing: ${LABEL.timing[state.timing]}.${price ? ` Price in mind: about $${price.toLocaleString('en-US')}.` : ''}`;

      $('sb-town-read').textContent = t.p;
      $('sb-town-corr').textContent = `${t.n}, ${t.c} County · ${t.r}`;
      $('sb-town-link').href = `/south-shore/${t.s}/`;

      // Timeline
      const tl = $('sb-timeline');
      tl.innerHTML = '';
      const d0 = startOffset;
      const phases = [
        [d0, d0 + 7, 'Walk-through and opinion of value', 'The building walked, comparables pulled, a value band in writing within 48 hours, and a straight read on whether the price in mind holds.'],
        [d0 + 7, d0 + 21 + slow, 'The file', `${septic ? 'Title V inspection ordered. ' : ''}${state.env !== 'phase1' ? 'Phase I commissioned (two to three weeks). ' : ''}${state.occ === 'multi' ? 'Leases abstracted and estoppels drafted. ' : ''}Rent roll, leases, plans, permits, and operating history assembled so no buyer question costs a week.`],
        [d0 + 21 + slow, d0 + 28 + slow, 'Price and process', `${state.occ === 'owner' && state.goal !== 'slb' ? 'Quiet process first: the owner-users and small investors already hunting this type in ' + t.n + '. ' : 'Open marketing with a prepared offering memorandum. '}Price set from the opinion of value, not from hope.`],
        [d0 + 28 + slow, d0 + 63 + slow, 'Marketing to a signed offer', 'Showings grouped, offers compared on terms as well as price, letter of intent negotiated, and a purchase and sale agreement signed with a defined due-diligence period.'],
        [d0 + 63 + slow, d0 + 120 + slow, 'Due diligence, financing, closing', `Buyer’s inspections and lender work${state.occ === 'multi' ? ', estoppels signed by every tenant' : ''}${state.goal === 'slb' ? ', your leaseback negotiated alongside the P&S' : ''}${state.goal === '1031' ? ', your replacement property identified within 45 days of closing' : ''}. Municipal lien certificate, deed, and Registry recording.`],
      ];
      phases.forEach(([a, b, name, text]) => li(tl, `<span class="font-mono text-[11px] font-bold text-brass-600">${fmt(addDays(a))} to ${fmt(addDays(b))}</span><br><span class="font-semibold text-navy-900">${name}.</span> ${text}`));

      // The file
      const file = $('sb-file');
      file.innerHTML = '';
      const items = ['Deed, plot plan, and the current tax bill', 'Three years of operating expenses and utility bills', 'Building permits and the certificate of occupancy', 'Roof, HVAC, and major-system ages with service records'];
      if (leased) items.push('Rent roll and every lease, amendment, and side letter', 'Security deposit ledger');
      if (state.occ === 'multi') items.push('Estoppel certificates, one per tenant', 'CAM reconciliations for the last two years');
      if (septic) items.push('Title V inspection report (required to transfer in Massachusetts)');
      if (state.env === 'none') items.push('Phase I Environmental Site Assessment');
      if (state.env === 'known') items.push('The 21E file, the AUL if any, and the LSP’s closure letters');
      if (state.type === 'auto' || state.type === 'flex') items.push('Floor drain, oil-water separator, and hazardous-materials storage records');
      if (state.type === 'land') items.push('Zoning determination, wetlands delineation, and any Order of Conditions');
      if (state.cond !== 'turnkey') items.push('Contractor estimates for the deferred items, so the buyer prices facts instead of fears');
      if (state.goal === 'slb') items.push('Your proposed leaseback terms: term, rent, and who carries what');
      items.push('Municipal lien certificate (ordered from the town collector before closing)');
      items.forEach((x) => li(file, `<span class="mr-2 font-mono text-xs font-bold text-teal-600">☐</span>${x}`));

      // Pricing
      $('sb-pricing').textContent =
        state.type === 'land'
          ? 'As a development site: on buildable yield under current zoning, with the entitlement risk priced in. Comparable land sales set the band; a zoning opinion and a conceptual site plan move the buyer’s number more than anything else.'
          : leased && state.lease !== 'mtm'
            ? 'As an income property: net operating income divided by the cap rate buyers are paying for this type in this corridor, checked against price per square foot on recent sales. Clean leases, real estoppels, and documented expenses tighten the cap rate; month-to-month tenancies and unreimbursed costs widen it.'
            : state.occ === 'owner' || state.occ === 'vacant' || state.lease === 'mtm'
              ? 'As an owner-user building: price per square foot against recent sales of comparable buildings, adjusted for condition, power, loading, parking, and the corridor, with an SBA 504 buyer’s payment in mind. Owner-user demand on the South Shore is the deepest buyer pool for buildings under 30,000 square feet.'
              : 'Two ways at once: income approach on the leases in place and sales comparison on the building itself, with the higher-supported number setting the ask.';

      // Moves
      const mv = $('sb-moves');
      mv.innerHTML = '';
      const moves = [];
      if (state.goal === '1031') moves.push('Line up the qualified intermediary and the replacement-property shortlist before you sign a P&S; the 45-day clock does not care about your schedule.');
      if (state.goal === 'slb') moves.push('Write your leaseback terms first: investors price the lease, so the lease is the product.');
      if (state.goal === 'price') moves.push('Take the free opinion of value first. Most owners who ask for a number first make a better decision about timing, whichever way it goes.');
      if (septic) moves.push('Order the Title V inspection this week; a failed system is a negotiation if you know first and a crisis if the buyer finds it.');
      if (state.env === 'none') moves.push('Commission the Phase I now. Three weeks of lead time is the difference between a 120-day sale and a 160-day one.');
      if (state.occ === 'multi') moves.push('Abstract every lease and draft the estoppels before marketing; the signatures take longer than you expect.');
      if (state.lease === 'mtm' && leased) moves.push('Decide whether to paper the tenancies before the sale. A signed three-year lease can add more to the price than a year of rent.');
      if (state.cond === 'rough') moves.push('Get two contractor estimates for the big items and decide what to fix and what to credit; unknowns cost more than repairs.');
      moves.push('Walk the building with Daniel and settle the price band before anything is printed.');
      moves.slice(0, 3).forEach((m) => li(mv, m));

      // Tools
      const tools = [];
      if (leased && state.lease !== 'mtm') tools.push(`<a href="/cap-rate/" class="font-semibold text-teal-600 hover:text-teal-700">Cap rate and NOI</a>`);
      tools.push(`<a href="/building-worth/" class="font-semibold text-teal-600 hover:text-teal-700">Free building valuation</a>`);
      tools.push(`<a href="/seller-net/${price ? '?p=' + price : ''}" class="font-semibold text-teal-600 hover:text-teal-700">Seller net sheet${price ? ' (prefilled)' : ''}</a>`);
      if (state.occ === 'multi' || leased) tools.push(`<a href="/lease-clauses/?seat=landlord" class="font-semibold text-teal-600 hover:text-teal-700">Lease Clause Decoder (estoppels, SNDA, assignment)</a>`);
      $('sb-tools').innerHTML = tools.join(' · ');

      // URL + send
      const u = new URL(location.href);
      Object.keys(SHORT).forEach((k) => (state[k] ? u.searchParams.set(SHORT[k], state[k]) : u.searchParams.delete(SHORT[k])));
      if (push) history.replaceState(null, '', u.pathname + u.search);
      $('sb-send').href = `/contact/?${new URLSearchParams({
        interest: 'Selling or leasing my property',
        message: `Seller brief: ${$('sb-headline').textContent}\n${$('sb-sub').textContent}\n\nI built this on your site: ${u.toString()}\n\nAddress (if you want to share it): \nBest time to call: `,
      }).toString()}`;
      paintChips();
    }

    document.querySelectorAll('[data-group] .sb-chip').forEach((b) => b.addEventListener('click', () => { state[b.closest('[data-group]').dataset.group] = b.dataset.v; render(); }));
    SELECTS.forEach((k) => $('sb-' + k).addEventListener('change', () => { state[k] = $('sb-' + k).value; render(); }));
    $('sb-share').addEventListener('click', async () => { const b = $('sb-share'); try { await navigator.clipboard.writeText(location.href); b.textContent = 'Link copied'; } catch { b.textContent = 'Copy the address bar'; } setTimeout(() => (b.textContent = 'Copy a shareable link'), 1600); });
    $('sb-print').addEventListener('click', () => window.print());
    render(false);
  }
  initSellerBrief();
  document.addEventListener('astro:page-load', initSellerBrief);
</script>
