---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
// Preload the two latin variable font files so text paints in the real
// fonts on first render — eliminates the font-swap layout shift (CLS) on
// prose-heavy pages. `?url` gives the hashed asset path Vite emits.
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import groteskWoff2 from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import SearchPalette from '../components/SearchPalette.astro';
import PathMemory from '../components/PathMemory.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import ogManifest from '../generated/og-manifest.json';
import { SITE, OFFERINGS } from '../config';
import { founderPerson } from '../lib/founder';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD objects for this page (LocalBusiness is included site-wide). */
  schema?: Record<string, unknown>[];
  ogType?: string;
  /** Attach the machine-readable published-pricing OfferCatalog (homepage, pricing). */
  offerCatalog?: boolean;
}

const { title, description, schema = [], ogType = 'website', offerCatalog = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(
  (ogManifest as Record<string, string>)[Astro.url.pathname] ?? '/images/og-default.jpg',
  Astro.site
);

const unitMap: Record<string, string> = { month: 'MON', setup: 'ANN', project: 'ANN' };
const offerCatalogNode = {
  '@type': 'OfferCatalog',
  name: 'Services and published pricing',
  itemListElement: OFFERINGS.map((o) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: o.name, url: `${SITE.url}${o.href}` },
    priceSpecification: {
      '@type': o.unit === 'month' ? 'UnitPriceSpecification' : 'PriceSpecification',
      priceCurrency: 'USD',
      minPrice: o.min,
      maxPrice: o.max,
      ...(o.unit === 'month' ? { unitCode: unitMap[o.unit], billingDuration: 1 } : {}),
    },
    description: o.note,
    url: `${SITE.url}${o.href}`,
    availability: 'https://schema.org/InStock',
  })),
};

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  '@id': `${SITE.url}/#business`,
  name: SITE.name,
  alternateName: SITE.shortName,
  slogan: SITE.tagline,
  description: SITE.description,
  url: SITE.url,
  logo: `${SITE.url}/images/ics-logo-full.jpg`,
  image: `${SITE.url}/images/ics-logo-full.jpg`,
  email: SITE.email,
  telephone: SITE.phone,
  priceRange: '$$',
  sameAs: [SITE.social.linkedin],
  ...(offerCatalog ? { hasOfferCatalog: offerCatalogNode } : {}),
  founder: founderPerson(),
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.address.locality,
    addressRegion: SITE.address.region,
    addressCountry: SITE.address.country,
  },
  areaServed: SITE.serviceAreas.map((town) => ({ '@type': 'City', name: `${town}, MA` })),
  knowsAbout: [
    'Commercial real estate',
    'Commercial property sales and leasing',
    'AI business automation',
    'AI marketing',
    'Local SEO and answer engine optimization',
  ],
};

const jsonLd = [localBusiness, ...schema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={groteskWoff2} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0b1f3a" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="ICS Insights" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <Header />
    <PathMemory />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileActionBar />
    <SearchPalette />
    <Analytics />
    <SpeedInsights />
    <script>
      // Scroll reveal + metric counters. Transform/opacity only; respects reduced motion.
      // Re-initializes on every client-side navigation (astro:page-load fires on
      // first load and after each ClientRouter swap).
      document.documentElement.classList.add('js');

      function initMotion() {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('is-in');
              const counter = e.target.querySelector<HTMLElement>('[data-count]') ?? (e.target as HTMLElement);
              if (counter?.dataset.count && !counter.dataset.done) runCounter(counter, reduced);
              io.unobserve(e.target);
            }
          },
          // Low threshold + early rootMargin so fast scrollers still trigger reveals
          { threshold: 0.05, rootMargin: '0px 0px 15% 0px' }
        );

        document.querySelectorAll('.reveal, [data-count]').forEach((el) => {
          const node = el.closest('.reveal') ?? el;
          io.observe(node);
        });
      }

      function runCounter(el: HTMLElement, reduced: boolean) {
        el.dataset.done = '1';
        const target = parseFloat(el.dataset.count || '0');
        const prefix = el.dataset.prefix || '';
        const suffix = el.dataset.suffix || '';
        const decimals = (el.dataset.count || '').includes('.') ? 1 : 0;
        if (reduced) {
          el.textContent = prefix + target.toLocaleString('en-US', { maximumFractionDigits: decimals }) + suffix;
          return;
        }
        const dur = 1200;
        const start = performance.now();
        const tick = (now: number) => {
          const p = Math.min((now - start) / dur, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent =
            prefix + (target * eased).toLocaleString('en-US', { maximumFractionDigits: decimals }) + suffix;
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }

      document.addEventListener('astro:page-load', initMotion);
    </script>
  </body>
</html>
